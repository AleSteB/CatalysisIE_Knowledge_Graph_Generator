        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UPLC</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rapid resolution liquid chromatograph</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rapid separation liquid chromatograph</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultra fast liquid chromatograph</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultra performance liquid chromatograph</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-20 Changed equivalentClass to subClass. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Liquid chromatograph that implements the ultra high-performance liquid chromatography. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultra high-performance liquid chromatograph</core:prefLabel>
    </owl:Class>
    


