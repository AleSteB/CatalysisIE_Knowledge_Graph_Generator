        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Controller role is a controlling role of some material entity that is controlling some other object or a process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">controller role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000006 -->

