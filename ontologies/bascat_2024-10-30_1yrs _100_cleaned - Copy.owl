        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transfer medium is the role of a material that carries the transferred flow. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transfer medium role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000091 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000091">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abstract role</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-13 Moved under continuant. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A general role is either a role that is realized in a process or a contextual role in that process. [Allotrope]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This defined class covers roles as abstractions that can be borne by material and information entities.</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000092 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000092">
