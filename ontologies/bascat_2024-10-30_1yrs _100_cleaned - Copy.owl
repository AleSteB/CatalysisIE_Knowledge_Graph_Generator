        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A repeated action role is a contextual role of an action specification that specifies the repeated action in a repeated action specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeated action role</core:prefLabel>
    </owl:Class>
    


