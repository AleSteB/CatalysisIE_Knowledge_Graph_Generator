        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evacuating is the removing of gasses from a container to create a vacuum. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evacuating (chem)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003787 -->

