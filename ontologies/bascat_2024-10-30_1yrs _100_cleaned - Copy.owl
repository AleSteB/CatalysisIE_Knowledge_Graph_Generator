        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dry gas role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dry gas role is the role of the gas devoid of the vapor in the dynamic vapor sorption process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dry gas role (DVS)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000531 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000531">
