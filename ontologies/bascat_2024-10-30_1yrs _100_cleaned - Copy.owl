        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The form in which active and/or inert ingredient(s) are physically presented. [NCI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pharmaceutical dosage form</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C42998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C42998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C45235"/>
        <pav:importedFrom rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/dosage-form"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet dosage form</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tab</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet dose form</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A table dosage form is a pharmaceutical dosage form that is a solid composed of a mixture of that active and/or inert ingredient(s) are pressed or compacted together, usually in the form of a relatively flat and round, square or oval shape. [NCI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet dosage form</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C45235 -->

