        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical output role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical output</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;Physical input&quot; is a role of a material or energy that is input in a process. [Allotrope]</core:definition>
