        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration item role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration item</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The calibration item role is the role of a material that is used in calibration for testing a measurement device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration item role</core:prefLabel>
    </owl:Class>
    


