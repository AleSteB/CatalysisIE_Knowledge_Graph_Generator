        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporting</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003730 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003730">
