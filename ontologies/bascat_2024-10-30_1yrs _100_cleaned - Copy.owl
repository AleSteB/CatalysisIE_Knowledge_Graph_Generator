        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disintegrating</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disintegration</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disintegrating is a break a material into small, separate parts. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disintegrating</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003808 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003808">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003332"/>
