        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diluted material role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diluted material is the dilution role of a material that is being diluted in the dilution process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diluted material role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000493 -->

