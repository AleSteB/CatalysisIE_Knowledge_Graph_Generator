        <cheb:formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C8H6O4</cheb:formula>
        <cheb:inchi rdf:datatype="http://www.w3.org/2001/XMLSchema#string">InChI=1S/C8H6O4/c9-7(10)5-1-2-6(4-3-5)8(11)12/h1-4H,(H,9,10)(H,11,12)</cheb:inchi>
        <cheb:inchikey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KKEYFWRCBNTPAC-UHFFFAOYSA-N</cheb:inchikey>
        <cheb:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">166.13084</cheb:mass>
