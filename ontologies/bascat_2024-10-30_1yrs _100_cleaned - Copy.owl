        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impurity type</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity type is a classification datum that classifies a peak by the impurity role played by the substance it is a proxy for in the chromatographic process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impurity chromatography peak type</core:prefLabel>
    </owl:Class>
    


