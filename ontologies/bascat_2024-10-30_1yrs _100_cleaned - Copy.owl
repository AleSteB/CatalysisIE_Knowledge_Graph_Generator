        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fast protein liquid chromatography</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FPLC</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fast protein liquid chromatography (FPLC) is a liquid chromatography that is used to analyze or purify mixtures of proteins. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fast protein liquid chromatography</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003795 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003795">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003454"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat flow process profile</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A heat flow process profile is a rate process profile that is the change in heat flow through a material entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat flow process profile</core:prefLabel>
    </owl:Class>
    


