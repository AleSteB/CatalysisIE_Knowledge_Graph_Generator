        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">end</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process boundary when the process ends. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">end</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003289 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003289">
