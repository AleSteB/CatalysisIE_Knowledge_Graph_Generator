        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weak anion-exchange column</rdfs:label>
