        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dosage form</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dose form</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drug dose form</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pharmaceutical dose form</core:altLabel>
