        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch identifier</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch ID</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch id</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lot ID</core:altLabel>
