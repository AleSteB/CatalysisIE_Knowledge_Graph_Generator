    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000553 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000553">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000085"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000552"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000554"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000085"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003348"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carrier role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A carrier role is the role of a material entity that supports another material or information localization process by keeping it moving or holding it at place. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a ship carrying goods</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">air carrying sound</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nitrogen carrying a sample in gc</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carrier role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000554 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000554">
