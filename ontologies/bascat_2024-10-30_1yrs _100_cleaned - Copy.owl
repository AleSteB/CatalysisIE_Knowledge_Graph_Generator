        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cooling medium</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat transfer fluid</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A role of a material that acts as a heat sink as it undergoes a phase change. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant role</core:prefLabel>
    </owl:Class>
    


