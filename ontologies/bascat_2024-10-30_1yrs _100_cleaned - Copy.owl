    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001285 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001285">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000957"/>
