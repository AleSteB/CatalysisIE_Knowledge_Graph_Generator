        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width analysis</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak analysis that determines the peak width following a specified algorithm. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width analysis</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003572 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003572">
