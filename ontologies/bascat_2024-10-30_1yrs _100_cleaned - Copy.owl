            </owl:Restriction>
        </rdfs:subClassOf>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://jcgm.bipm.org/vim/en/3.8.html</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor is a component of a measuring system that is directly affected by a phenomenon, body, or substance carrying a quantity to be measured. [Allotrope]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor can be a measuring device on its own, but is typically a part of it.</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002185 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002185">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002145"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement component</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement module</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement component is a component of a measuring system, that does measuring. [Allotrope]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The criteria is compromise. Some measurement components can be fully standalone measurement devices used in a component role, but are not typically used as such. A UV spectrometer is an electromagnetic absorbance measuring instrument and an elecctromagnetic absorbance detector has the same function, but it is used as part of a larger system, such as a HPLC-UV system.</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement component</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002186 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002186">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
