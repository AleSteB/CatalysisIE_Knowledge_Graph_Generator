        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no seal</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A no seal is a break code that denotes a failure to achieve a seal. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">no seal</core:prefLabel>
    </owl:NamedIndividual>
    


