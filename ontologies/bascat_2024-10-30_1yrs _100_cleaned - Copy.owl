        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An injection device  component is a component of an injection device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device component</core:prefLabel>
    </owl:Class>
    


