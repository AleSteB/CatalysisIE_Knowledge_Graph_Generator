        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing support</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing support role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nebulizer support role is a support role in converting liquid into aerosol mist. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizer support role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000510 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000510">
