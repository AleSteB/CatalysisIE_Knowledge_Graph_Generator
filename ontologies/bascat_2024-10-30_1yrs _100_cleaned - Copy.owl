        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process executed by a pump system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pump system process</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003678 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003678">
