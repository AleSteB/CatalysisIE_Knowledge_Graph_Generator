        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A thermal conductivity is a quality quantification facet that quantifies the disposition to spontaneous transfer of thermal energy from a region of higher temperature to a region of lower temperature. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermal conductivity</core:prefLabel>
    </owl:Class>
    


