        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">representation form</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A representation form is a type of information content entity that represents an entity in a certain way. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plot as representation form of a temperature profile</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">representation form</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000993 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000993">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
