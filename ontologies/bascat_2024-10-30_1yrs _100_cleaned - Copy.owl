        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated instrument role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated instrument</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unit under test</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unit under test role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calibrated instrument role is the role of a measurement device that is the target of a calibration. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated instrument role</core:prefLabel>
    </owl:Class>
    


