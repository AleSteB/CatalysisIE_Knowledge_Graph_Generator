        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photoelectron spectra</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of photoelectron count vs. kinetic energy. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photoelectron spectrum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000053 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
