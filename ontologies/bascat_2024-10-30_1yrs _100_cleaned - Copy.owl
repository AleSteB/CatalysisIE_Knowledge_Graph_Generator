                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/familyName"/>
        <prop:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#family-name"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Surname</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">family name</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">last name</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surname</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-10 Moved under written name [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A family name is a name that is the portion (in some cultures) of a personal name that indicates a person&apos;s family (or tribe or community, depending on the culture). [Wikipedia]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The family name is provided (alongside given name) for use when describing parts of people&apos;s names. Although these concepts do not capture the full range of personal naming styles found world-wide, they are commonly used and have some value. [FoaF]</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">family name</core:prefLabel>
    </owl:Class>
    


