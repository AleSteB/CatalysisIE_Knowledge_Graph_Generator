        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abrading role is a role of an entity that is realized in an abrading process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000561 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000561">
