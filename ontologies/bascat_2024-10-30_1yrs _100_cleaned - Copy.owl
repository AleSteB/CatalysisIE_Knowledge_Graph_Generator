        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio (ASTM E1657-98)</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A signal-to-noise ratio calculated using the ASTM E1657-98 method. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio (ASTM E1657-98)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001199 -->

