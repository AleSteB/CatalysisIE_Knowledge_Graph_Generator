        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bulk density for untapped powder sample. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">powder bulk density</core:prefLabel>
    </owl:Class>
    


