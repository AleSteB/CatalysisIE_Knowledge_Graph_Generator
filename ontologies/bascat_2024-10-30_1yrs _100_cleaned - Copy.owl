        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specified quality is the contextual role of an information object that describes a quality as part of an specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified quality</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000069 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000069">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000982"/>
