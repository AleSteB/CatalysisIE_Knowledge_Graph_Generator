        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assigning</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assigning is the producing of an assignment that asserts some relation between entities. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assigning</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003618 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003618">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003603"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak identification</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak assigning</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak assignment</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-08-01 Changed label and definition</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peak identification is an assigning of a peak to an analyte or portion of an analyte of interest. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak identification</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003619 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003619">
