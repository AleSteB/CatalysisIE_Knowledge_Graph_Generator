        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The matrix are the components of a sample other than the analyte. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrix role</core:prefLabel>
    </owl:Class>
    


