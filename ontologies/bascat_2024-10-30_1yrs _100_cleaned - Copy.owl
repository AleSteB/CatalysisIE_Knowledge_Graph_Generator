        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exhaust gas role is the role of the waste gas exhausted from the system in the dynamic vapor sorption process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exhaust gas role (DVS)</core:prefLabel>
    </owl:Class>
    


