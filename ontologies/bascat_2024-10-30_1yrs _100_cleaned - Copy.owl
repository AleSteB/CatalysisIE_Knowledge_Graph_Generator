        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified capability is the contextual role of an information object that specifies a capability. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified capability</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000068 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000068">
