        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A homogenizer is a device used for homogenization of various types of material. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">homogenizer</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000301 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000301">
