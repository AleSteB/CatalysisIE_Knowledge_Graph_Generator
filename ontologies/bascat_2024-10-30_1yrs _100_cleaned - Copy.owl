        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MetaCyc:Alpha-Amino-Acids</owl:annotatedTarget>
        <oboI:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SUBMITTER</oboI:source>
    </owl:Axiom>
