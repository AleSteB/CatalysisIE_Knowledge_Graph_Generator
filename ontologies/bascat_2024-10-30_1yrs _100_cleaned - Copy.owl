        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">display</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">display device</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A display is a device or element of an instrument serving to represent information. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">display</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000771 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000771">
