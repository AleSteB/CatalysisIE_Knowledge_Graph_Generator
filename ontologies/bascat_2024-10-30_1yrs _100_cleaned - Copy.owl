            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000042"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/plumbing"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plumbing maximum pressure</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum pressure</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plumbing pressure upper limit</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure upper limit</core:altLabel>
