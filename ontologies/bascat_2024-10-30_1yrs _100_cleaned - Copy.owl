        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">given name</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Christian name</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">first name</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forename</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-10 Moved under written name [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A given name is a name that is a part of a person&apos;s personal name. [Wikipedia]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The given name is provided (alongside family name) for use when describing parts of people&apos;s names. Although these concepts do not capture the full range of personal naming styles found world-wide, they are commonly used and have some value. [FoaF]</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">given name</core:prefLabel>
    </owl:Class>
    


