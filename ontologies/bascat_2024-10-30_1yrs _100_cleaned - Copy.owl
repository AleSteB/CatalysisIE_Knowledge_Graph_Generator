        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To keep a flow within limits. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vacuum bag contains debris vacuumed from a house. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to contain</core:prefLabel>
    </owl:Class>
    


