        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bulk density obtained by mechanically tapping a cylinder containing the powder sample until no more change in volume occurs. [NCI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">powder tap density</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003783 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003783">
