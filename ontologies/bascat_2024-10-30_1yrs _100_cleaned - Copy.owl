        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A read is a process boundary within a measuring where a data about the measured object is captured. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A read at regular time intervals during the measurement of a process profile. [Allotrope]</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiple reads for statistics and error corrections. [Allotrope]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003806 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003806">
