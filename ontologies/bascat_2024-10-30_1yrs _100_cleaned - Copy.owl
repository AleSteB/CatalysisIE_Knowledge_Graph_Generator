        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polarity adjustment</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polarity adjustment process</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Polarity control is a changing process that changes the polarity of some material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polarity control</core:prefLabel>
    </owl:Class>
    


