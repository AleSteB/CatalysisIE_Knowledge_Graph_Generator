        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To alter or govern the size or amplitude of a flow (material, energy, signal). [NIST]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to control</core:prefLabel>
    </owl:Class>
    


