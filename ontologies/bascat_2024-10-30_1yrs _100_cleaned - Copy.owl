        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">snapshot</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A snapshot is the contextual role of an information object that is about a point in time within the bounds of a process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">snapshot</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000030 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000167"/>
