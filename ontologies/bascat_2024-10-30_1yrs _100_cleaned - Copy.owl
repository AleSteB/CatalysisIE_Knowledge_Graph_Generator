        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002267"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weak cation-exchange column</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WCX column</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatography column where the stationary phase is a weak cation exchanger. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weak cation-exchange column</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000776 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000776">
