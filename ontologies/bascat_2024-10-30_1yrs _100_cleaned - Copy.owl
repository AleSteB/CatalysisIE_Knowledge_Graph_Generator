        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric resistivity is the is the quality quantification facet that quantifies the electric field strength divided by the current density when there is no electromotive force in a conductor. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric resistivity</core:prefLabel>
    </owl:Class>
    


