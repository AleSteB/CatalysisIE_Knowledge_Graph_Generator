        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/plumbing"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plumbing minimum pressure</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum pressure</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plumbing pressure lower limit</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure lower limit</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The plumbing minimum pressure is a specification of the minimum pressure that the plumbing system can operate with. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plumbing minimum pressure</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002225 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002225">
