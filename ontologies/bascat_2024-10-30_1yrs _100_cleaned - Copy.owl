        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jacket</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A jacket is a covering device that is placed around something. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pipe jacket, reactor jacket</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jacket</core:prefLabel>
    </owl:Class>
    


