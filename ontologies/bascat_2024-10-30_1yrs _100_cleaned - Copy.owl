        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant pressure mobile phase delivery</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constant pressure mobile phase delivery is a mobile phase delivery process whereby the mobile phase is delivered by maintaining a constant pressure of the mobile phase. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant pressure mobile phase delivery</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003716 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003716">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003275"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003475"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003475"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000395"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000275"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000399"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000275"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">combining material</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material combination</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Combining material is a combing process that combines two or more materials in to a new material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">combining material</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003717 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003717">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003282"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/calibration"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation (calibration)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interpolation is a calculation that calculates a calculated measure from a primary measure by applying a measurement function that is derived from a calibration curve. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation (calibration)</core:prefLabel>
        <core:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The measurement function of a calibration curve can be got by curve fitting a function to a set of calibration points. Applying the function at abscissa coordinates that are part of the discrete calibration points, can be interpreted as interpolation. [Allotrope]</core:scopeNote>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003719 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003719">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003566"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Nebulizer"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nebulizing is converting by of breaking up solutions and suspensions into small aerosol droplets. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003721 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003721">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003598"/>
        <term:source rdf:resource="http://bioassayontology.org"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">background correction</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Background correction is a data transformation designed to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation. [BAO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">background correction</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003722 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003722">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003598"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/NCIT_C44285"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data extraction</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data extraction is a data transformation process whereby specific data is taken out of a larger set of data and presented in a usable format. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data extraction</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003725 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003725">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003726"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high performance liquid chromatography system process</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPLC system process</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high performance liquid chromatography system process is a process that is executed on a high performance liquid chromatography system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high performance liquid chromatography system process</core:prefLabel>
        <core:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process is the technical implementation process on the HPLC system that implements the separation by HPLC. [Allotrope]</core:scopeNote>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003726 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003726">
