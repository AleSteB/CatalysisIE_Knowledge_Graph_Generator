        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type specification is a specification of a collection of things by the members of that collection being classified as instance of a class or concept, often with additional constraints. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a SHACL node shape.</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the humans that live in Berlin.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type specification</core:prefLabel>
    </owl:Class>
    


