        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calculation function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To calculate is a data transformation function to solve problems for numbers or quantities. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to calculate</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000028 -->

