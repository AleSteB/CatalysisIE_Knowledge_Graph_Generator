        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shaking is a mixing process involving short rapid motions of the material inside a container. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shaking</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003803 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003803">
