        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The role of a material that is the  flow by which means a linking process is established. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">linking medium role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000154 -->

