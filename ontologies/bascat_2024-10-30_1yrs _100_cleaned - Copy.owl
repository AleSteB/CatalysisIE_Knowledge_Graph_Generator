        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative pressure is a quality quantification facet that quantifies the pressure of a pure substance in a chamber relative to its saturation pressure. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative pressure (BET)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002118 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002118">
