        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device configuration</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection configuration</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device setting</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection setting</core:altLabel>
