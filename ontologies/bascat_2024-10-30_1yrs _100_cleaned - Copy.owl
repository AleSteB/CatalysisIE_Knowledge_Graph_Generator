        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A temperature setting is a setting that specifies some temperature configuration of a temperature controlling or monitoring device, that controls or monitors the target temperature at the site of some system component. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature setting</core:prefLabel>
    </owl:Class>
    


