        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material separation function which is realized by chromatography. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to separate material by chromatography</core:prefLabel>
