        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">series</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A series is a list (ordered collection) of literal values. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">series</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000163 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000163">
