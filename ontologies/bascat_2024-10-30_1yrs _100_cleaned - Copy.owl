        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Titrant standardization is the accurate and precise determination of the concentration of a titrant. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">titrant standardization</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003741 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003741">
