        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connecting device</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A connecting device is a device that has the function to connect things. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connecting device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002228 -->

