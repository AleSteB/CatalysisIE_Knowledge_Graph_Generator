    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002861 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002861">
        <rdfs:subPropertyOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000671"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum error exclusive</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">error min exclusive</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Minimum error exclusive is the absolute error amount (exclusive) by which the actual value could be lower than the stated value. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum error exclusive</core:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002862 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002862">
        <rdfs:subPropertyOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000675"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum error exclusive</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">error max exclusive</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum error exclusive is the absolute error amount (exclusive) by which the actual value could be higher than the stated value. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum error exclusive</core:prefLabel>
    </owl:DatatypeProperty>
    


