        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturation pressure</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturation pressure result</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturation vapor pressure (datum)</core:altLabel>
