        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A drying role role is a role realized in some drying process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000512 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000512">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000511"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying medium role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying agent</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying agent role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying medium</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A drying medium role is a drying role of a material that takes or transports the solvent from the material being dried. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying medium role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000513 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000513">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000511"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material dried role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dried material</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dried material role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material dried</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Material dried role is the drying role of the material being dried. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material dried role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000516 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000516">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000085"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000495"/>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reagent role (ms)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical ionization reagent gas</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reagent role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reagent role is the role of a gas that reacts with ions to produce product ions through ion/molecule reactions; for example, a gas such as methane, ammonia, or isobutane used in chemical ionization to create reagent ions or a gas used in ion traps or collision cells to perform gas-phase ion/molecule reactions. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reagent role (ms)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000517 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000517">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000495"/>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adduct ion role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adduct</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adduct ion</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adduct role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adduct ion role is the role of an ion formed by the interaction of a precursor ion with one or more atoms or molecules to form an ion containing all the constituent atoms of the precursor ion as well as the additional atoms from the associated atoms or molecules. [IUPAC]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For example, a Na+ adduct of a molecule (M) that is represented as [M + Na]+.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adduct ion role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000518 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000518">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000496"/>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fragment ion role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fragment</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fragment ion</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fragment ion role is a product ion role of an ion that results from the dissociation of a precursor ion. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fragment ion role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000519 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000519">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000004"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default condition role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default condition</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback condition</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback condition role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A default condition role is the condition role of an item in a collection of information content entities that applies (is true) if no other items apply (are false). [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default condition role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000520 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000520">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000064"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fallback role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A default role is a directive purpose that assigns a specification to be applied to a context if no other specification is asserted in that context. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000521 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000521">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000941"/>
