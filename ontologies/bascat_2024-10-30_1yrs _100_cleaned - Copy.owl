        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference value</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A value that used as a basis for comparison. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference value</core:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002705 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002705">
        <rdfs:domain rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000958"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor rank</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degree</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">order</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rank</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tensor rank is the total number of indices required to identify each component of a tensor uniquely. It is equal to the dimension of the tensor. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor rank</core:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002742 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002742">
        <rdfs:range>
