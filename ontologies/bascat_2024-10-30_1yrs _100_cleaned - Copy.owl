        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 606</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foam</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A foam is a colloid where the continuous phase is a liquid and the dispersed phase is a gas. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foam</core:prefLabel>
    </owl:Class>
    


