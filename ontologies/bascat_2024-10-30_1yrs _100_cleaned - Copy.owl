        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disintegrated</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disintegrated state is a state of an object when its has turned into an aggregate of small, separated pieces. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disintegrated state</core:prefLabel>
    </owl:Class>
    


