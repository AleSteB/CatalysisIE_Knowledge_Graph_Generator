        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Post injection needle washing is an injection needle washing that is done after using the needle for an injection. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">post injection needle washing</core:prefLabel>
    </owl:Class>
    


