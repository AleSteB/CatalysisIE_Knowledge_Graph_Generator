        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ldap id</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-20 Changed pref label, added alt labels. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An LDAP identifier is an online account managed by an LDAP server and follows the LDAP specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ldap identifier</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001070 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001070">
