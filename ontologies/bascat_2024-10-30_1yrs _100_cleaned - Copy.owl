        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMDAR antagonist</oboI:hasRelatedSynonym>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMDAR antagonists</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:60643</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMDA receptor antagonist</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60643"/>
