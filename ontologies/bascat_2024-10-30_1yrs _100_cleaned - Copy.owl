        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertical position (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertical position</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vertical position is a position in a vertical spacial direction. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertical position (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000334 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000334">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000333"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">above of (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">above</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">above of</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Above of is a vertical position if the bottom of the bearer&apos;s spatial extend along the vertical dimension is higher then then the top of the other. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">above of (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000335 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000335">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000333"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">below of (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">below</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">below of</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Below of is a vertical position if the top of the bearer&apos;s spatial extend along the vertical dimension is higher then then the bottom of the other. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">below of (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000337 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000337">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000036"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002722"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002723"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0001025"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure configuration</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure setting</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pressure configuration is a device configuration of a pressure controlling or monitoring device, that controls or monitors the target pressure at the site of some system component. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure configuration</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000338 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000338">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ion current (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ion current</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ion current is a summary quality of an ion flow by virtue of the electrical charge of the ions. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ion current (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000339 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000339">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000065"/>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Electrical_resistance_and_conductance"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1996, 68, 957. (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996))</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric impedance (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric impedance</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance (quality)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric impedance is the quality inhered in a conductor that is the complex representation of potential difference divided by the complex representation of the current. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric impedance (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000340 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000340">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000210"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stress (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stress</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stress is a mechanical quality representing the internal forces that neighboring particles of a continuous material exert on each other. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stress (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000341 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000341">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000005"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Young modulus (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Young modulus</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Young&apos;s modulus</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Young&apos;s modulus (quality)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youngs modulus</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Youngs modulus (quality)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modulus of elasticity</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modulus of elasticity (quality)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Young modulus is the ratio of tensile stress to tensile strain of a material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Young modulus (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000343 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000343">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000036"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling orientation</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sampling orientation is a system configuration of a separation device that is the direction of separation relative to the movement of the sampled material in the device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling orientation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000346 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Eccentricity_(mathematics)"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eccentricity (quality)</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The eccentricity of a conic section is a non-negative real number that uniquely characterizes its shape. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eccentricity (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000347 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000122"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/PATO_0000119"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 1-D extent quality inhering in a bearer by virtue of the bearer&apos;s vertical dimension of extension. [PATO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000348 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000348">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000065"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC. Compendium of Chemical Terminology, 2nd ed. (the &quot;Gold Book&quot;). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997).</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dielectric polarization (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dielectric polarization</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dielectric polarization is the quality inhered in a dielectric that is the difference between the electric displacement vector and the product of the electric field strength with the permittivity of vacuum. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dielectric polarization (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000349 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001300"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Gloss_(optics)"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gloss (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specular reflection</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gloss is an optical property which indicates how well a surface reflects light in a specular (mirror-like) direction. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gloss (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000351 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000351">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000036"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002722"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002242"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002723"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0002242"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">velocity configuration</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A velocity configuration is a device configuration of a controlling or monitoring device, that controls or monitors the velocity of some process at the site of some system component. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">velocity configuration</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000352 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000352">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000036"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002722"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000032"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002723"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000032"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distance configuration</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A distance configuration is a device configuration of a controlling or monitoring device, that controls or monitors the distance between of some materials at the site of some system component. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distance configuration</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000353 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000353">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000005"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative response (quality)</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative response is the ratio of an analytes device response signal to the device response signal of some reference material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative response (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000359 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001906"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rotational speed (quality)</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rotational speed is a movement quality inhering in a bearer by virtue of the bearer&apos;s frequency of rotation. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rotational speed (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000360 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circularity (quality)</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A circularity is a shape quality inhering in a bearer by virtue of the two-dimensional roundness of an entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circularity (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000361 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000361">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000181"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead cell density (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead cell density</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dead cell density is the cell density of the partition of dead cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead cell density (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000362 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000362">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000184"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000606"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive count (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive cell count</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescent tag positive cell count is the cell count of the partition of fluorescent tag positive cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive count (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000363 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000181"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive cell density (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive cell density</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fluorescent tag positive cell density is the cell density of the partition of fluorescent tag positive cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescent tag positive cell density (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000001 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000260"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">action</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">task</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An action is a unit element in a procedure and is a concretization of an action specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">action</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000002 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000260"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">procedure</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A procedure is plan containing multiple activities that are intended to be executed in an order following a procedure specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">procedure</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000003 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">situation</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of reality that is realized in some process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">situation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000004 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">configuration</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constitution</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physique</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">structure</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specific combination of qualities that the bearer realizes at some time. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">configuration</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000005 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental situation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environment</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A situation that is realized in a processes outside the system boundary of an operation situation of a device. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">example: humid conditions</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental situation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000006 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational situation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operation</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-09-20 Moved, an operational situation is not necessarily an environmental situation. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The situation when a device is performing its intended function. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operational situation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000007 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transition</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transition is a situation that is realized when one or more preceding processes end and the one or more succeeding processes begin. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000008 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000003"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trigger</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A realizable entity that when realized coincides with the start of some intended or causally dependent process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trigger</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000011 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical disposition</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical agent</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disposition of a portion of material to react with other materials in a specific way by nature of its chemical composition. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical disposition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000012 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000012">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27780"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000013"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27780"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/OMIT_0005178"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalence with http://purl.obolibrary.org/obo/CHEBI_27780 added automatically</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detergent</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surfactant (or a mixture containing one or more surfactants) disposed to having cleaning properties in dilute solutions. [ChEBI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detergent</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000013 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000013">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35195"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000014"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35195"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalence with http://purl.obolibrary.org/obo/CHEBI_35195 added automatically</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surfactant</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The disposition to lower the surface tension of the medium in which the material is dissolved, and/or the interfacial tension with other phases, and, accordingly, is positively adsorbed at the liquid/vapor and/or at other interfaces. [ChEBI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surfactant</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000014 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000011"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface-active disposition</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface-active agent</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surface-active agent is a disposition of a portion of material to react or interact with the surface of other materials. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surface-active disposition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000015 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000011"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical reaction disposition</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chemical reaction disposition is a disposition inhered in a reaction mixture. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical reaction disposition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000016 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000228"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction selectivity disposition</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reaction selectivity disposition is a disposition of a reaction mixture to have a reaction selectivity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction selectivity disposition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/realizable#AFRE_0000019 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/realizable#AFRE_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000182"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Hysteresis"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/dynamic-vapor-sorption"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hysteresis</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hysteresis is the time-based dependence of a system&apos;s output on present and past inputs. The dependence arises because the history affects the value of an internal state. To predict its future outputs, either its internal state or its history must be known. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hysteresis</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000001 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auger spectrum</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of intensity vs. kinetic energy obtained when a high energy photon ionizes a core electron and an electron from a higher energy level descends to take its place, releasing sufficient energy to eject a second so-called &apos;Auger&apos; electron. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auger spectrum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000007 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry curve</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC curve</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC heating curve</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC plot</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC thermogram</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC thermograms</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of enthalpy vs. temperature obtained by measuring the enthalpy required to increase the temperature of a sample as a function of temperature. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry curve</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000015 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000413"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatography peak</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatography peak is a peak that results from a detector&apos;s response to the presence of an analyte in the mobile phase eluting from a column in chromatography. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatography peak</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000020 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microwave spectrum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microwave spectra</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of emission vs. wavelength obtained through a Fourier transform of the time series of the radiation emitted by a sample of gas phase molecules that have been excited by a microwave-frequency pulse. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microwave spectrum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000023 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000490"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl-Fischer titration curve</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl Fischer titration curve</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Karl-Fischer titration curve is a titration curve of mass of water over time. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl-Fischer titration curve</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000024 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak assignment target</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The description of a chemical moiety or material that is assigned to a peak. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak assignment target</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000035 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000160"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002543"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/MS_1001472"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Mass_chromatogram"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography-ms"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">selected ion monitoring chromatogram</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIM chromatogram</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SIM spectrum</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A selected-ion monitoring (SIM) chromatogram is similar to an XIC, with the exception that the mass spectrometer is operated in SIM mode, such that only preselected m/z values are detected in the analysis. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">selected ion monitoring chromatogram</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000044 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conversion spectrum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conversion spectra</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of a quantity related to the absorption, for example absorbance or cross section, multiplied by the quantum yield for the process considered against a measure of photon energy such as frequency, wavenumber or wavelength. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conversion spectrum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000046 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
