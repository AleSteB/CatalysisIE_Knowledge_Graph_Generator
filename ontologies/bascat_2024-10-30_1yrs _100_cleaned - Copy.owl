        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pO2</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000196 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000196">
