        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A function that gives thermal energy to a recipient. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to heat</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000045 -->

