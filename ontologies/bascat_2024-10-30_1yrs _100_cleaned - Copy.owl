        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature setting</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature parameter</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-10 Changed definition. [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-10 Make a defined class. [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-10 Move from AFT to AFO. [Allotrope]</core:changeNote>
