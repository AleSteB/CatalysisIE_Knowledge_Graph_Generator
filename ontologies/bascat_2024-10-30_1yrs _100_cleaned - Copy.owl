        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statistical facet is a mathematical facet that is part of some statistics. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical facet</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001855 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000088"/>
