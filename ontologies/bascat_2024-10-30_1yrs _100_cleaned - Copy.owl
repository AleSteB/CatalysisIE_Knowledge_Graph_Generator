        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell diameter</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000195 -->

