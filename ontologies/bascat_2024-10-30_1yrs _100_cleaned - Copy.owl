    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000899 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000899">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000939"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
