        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material function is a type of function that is realized in a process that has material entity as input and/or output. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material function</core:prefLabel>
    </owl:Class>
    


