        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">positioning function</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to place</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To place a flow (material, energy, signal) into a specific location or orientation. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The coin slot on a soda machine positions the coin to begin the coin evaluation and transportation procedure. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to position</core:prefLabel>
    </owl:Class>
    


