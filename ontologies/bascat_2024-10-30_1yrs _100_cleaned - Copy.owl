        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a collection of observations, possibly organized into various slices, conforming to some common dimensional structure. [QB]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data cube</core:prefLabel>
    </owl:Class>
    


