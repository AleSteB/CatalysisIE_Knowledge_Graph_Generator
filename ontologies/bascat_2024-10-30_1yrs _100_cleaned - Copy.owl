        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">role specification</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-11-16 Allow contextual roles to be referenced as well has normal roles in role specifications. [Allotrope]</core:changeNote>
