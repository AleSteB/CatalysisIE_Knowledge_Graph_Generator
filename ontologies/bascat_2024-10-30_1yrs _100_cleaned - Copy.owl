            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An amino acid zwitterion obtained by transfer of a proton from the carboxy to the amino group of any alpha-amino acid; major species at pH 7.3.</obo:IAO_0000115>
        <cheb:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</cheb:charge>
        <cheb:formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C2H4NO2R</cheb:formula>
        <cheb:mass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">74.059</cheb:mass>
        <cheb:monoisotopicmass rdf:datatype="http://www.w3.org/2001/XMLSchema#string">74.02420</cheb:monoisotopicmass>
        <cheb:smiles rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[NH3+]C([*])C([O-])=O</cheb:smiles>
        <oboI:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:83409</oboI:hasAlternativeId>
        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MetaCyc:Alpha-Amino-Acids</oboI:hasDbXref>
        <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboI:hasOBONamespace>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">an alpha-amino acid</oboI:hasRelatedSynonym>
