        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatographic phase</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the portions of material between which the components to be separated are distributed in chromatography. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatographic phase</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000127 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000127">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000293"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
