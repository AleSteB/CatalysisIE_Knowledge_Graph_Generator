    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001906 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001906">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001927"/>
