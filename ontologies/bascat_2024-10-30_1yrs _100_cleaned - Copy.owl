        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultra-violet spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultra-violet spectrum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet spectrum</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of absorbance vs. wavelength obtained by measuring the amount of radiation absorbed by a sample as a function of the wavelength of incident radiation from the ultraviolet region (190-400 nm) range. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet spectrum</core:prefLabel>
    </owl:Class>
    


