        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A covering device is a device that has the function to cover something. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">covering device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002226 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002226">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002225"/>
