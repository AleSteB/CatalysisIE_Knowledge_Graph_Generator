        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location name</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A location name is a location facet that denotes a geographical place. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location name</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001087 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001087">
