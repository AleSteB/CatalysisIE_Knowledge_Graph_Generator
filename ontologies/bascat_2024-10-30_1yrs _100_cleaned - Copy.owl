        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified action</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified action is the role of information object that specifies an activity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified action</core:prefLabel>
    </owl:Class>
    


