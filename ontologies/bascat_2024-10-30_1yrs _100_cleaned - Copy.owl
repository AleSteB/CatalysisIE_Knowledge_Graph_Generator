        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">controlled lab reactor</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLR</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">controlled laboratory reactor</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-24 Moved to AFO. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A controlled lab reactor is a reactor that maintains temperature and other reaction parameters and has measuring devices. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">controlled lab reactor</core:prefLabel>
        <core:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In chemistry, a Controlled Lab Reactor or CLR is any reaction system where there is an element of automated control. Generally these devices refers to a jacketed glass vessel where a circulating chiller unit pumps a thermal control fluid through the jacket to accurately control the temperature of the vessel contents. Additional to this, it is common to have a series of sensors (temperature, pH, pressure) measuring and recording parameters about the reactor contents. It is additionally possible to control pumps to act on the reactor. [Wikipedia]</core:scopeNote>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001622 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001622">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001623"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry pan</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-23 Fixed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A differential scanning calorimetry pan is a pan for use in a differential scanning calorimeter that contains the sample under investigation. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TZero pan, TZero hermetic pan</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry pan</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001623 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001623">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000407"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pan</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pan is a flat container. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pan</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001671 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001671">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002148"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mass flow controller</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mass flow controller is a device that determines the mixture of different materials. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In DVS, the mass flow controller generates the required mixture of dry and saturated gas.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mass flow controller</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001695 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001695">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">computer</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">desktop computer</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A computer is a general-purpose device that can be programmed to carry out a set of arithmetic or logical operations automatically. Since a sequence of operations can be readily changed, the computer can solve more than one kind of problem. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">computer</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001703 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001703">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002148"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/plumbing"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure regulator</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pressure regulator is a controller that regulates a set pressure in a system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure regulator</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001711 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001711">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1989, 61, 1657 (Nomenclature for automated and mechanised analysis (Recommendations 1989))</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampler</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling unit</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample is a device that function to sample known amounts of material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampler</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001718 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001718">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002256"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Tablet_press"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/tablet-pressing"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet press</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tablet press is a mechanical device that compresses powder into tablets of uniform size and weight. To form a tablet, the granulated material must be metered into a cavity formed by two punches and a die, and then the punches must be pressed together to a set separation distance to allow the powder / granule to transform into a solid compact through compression. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tablet press</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001745 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001745">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optical device</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An optical device is a device that creates, manipulates, or measures electromagnetic radiation. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optical device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001747 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001747">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000407"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell holder</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cell holder is a type of container for samples in spectrophotometers. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell holder</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001754 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001754">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001755"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Excimer_lamp"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">excimer lamp</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UV/VIS lamp</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">excilamp</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An excimer lamp is a light source of ultraviolet light produced by spontaneous emission of excimer (exciplex) molecules. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">excimer lamp</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001755 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001755">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001875"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UV lamp</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A UV lamp is a light source with an ultraviolet wavelength range of 190 to 380 nm. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UV lamp</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001761 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001761">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002151"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000122"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tubing connector</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connector</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tubing connector is a part used to connect/install tubing, components, and accessories as part of a system flow path configuration. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tubing connector</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001763 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001763">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000217"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/OBI_0000570"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spin column</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spin concentrator</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A spin column is a column used for concentration of biological samples containing membranes for ultrafiltration. The solid phase is made up of silica to which the biological sample binds. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spin column</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001771 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001771">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001875"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible lamp</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A visible lamp is a light source with a visible wavelength range of 380 to 780 nm. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible lamp</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001772 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001772">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001755"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deuterium lamp</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A deuterium lamp is a low-pressure gas-discharge light source that emits light with a continuous spectrum mainly in the ultraviolet region. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deuterium lamp</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001774 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001774">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrette</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fibrette is a fiber optics device that consists of a thin fiber and defines the point where a beam of light is emitted into a sample. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrette</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001775 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001775">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrette coupler</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fibrette coupler connects a fibrette to a UV spectrophotometer and allows for precise adjustment of the path length. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrette coupler</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001797 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001797">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000266"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L.S. Ettre, &quot;Nomenclature for Chromatography&quot;, Pure &amp; Appl. Chem. 1993, Vol. 65, No. 4, pp. 819-872</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bypass injector</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling valve</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valve injector</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device in which the sample is first introduced into a chamber (loop), temporarily isolated from the mobile phase system by valves, which can be switched to make an instantaneous diversion of the mobile phase stream through the chamber to carry the sample to the column. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bypass injector</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001798 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001798">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000266"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L.S. Ettre, &quot;Nomenclature for Chromatography&quot;, Pure &amp; Appl. Chem. 1993, Vol. 65, No. 4, pp. 819-872</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct injector</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device which directly introduces the sample into the mobile-phase stream. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direct injector</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001799 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001799">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000266"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">L.S. Ettre, &quot;Nomenclature for Chromatography&quot;, Pure &amp; Appl. Chem. 1993, Vol. 65, No. 4, pp. 819-872</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">on-column injector</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device which directly introduces the sample into the mobile-phase stream. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">on-column injector</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001860 -->

