        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat capacity (dsc)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat capacity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A heat capacity (dsc) is a quantity facet that quantifies the difference in heat capacity of a material before and after its glass transition. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat capacity (dsc)</core:prefLabel>
    </owl:Class>
    


