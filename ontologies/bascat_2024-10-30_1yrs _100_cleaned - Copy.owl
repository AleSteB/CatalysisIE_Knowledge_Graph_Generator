        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A log is a list of related log entries. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">log</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000901 -->

