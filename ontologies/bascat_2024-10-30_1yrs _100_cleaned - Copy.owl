        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">observation</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An observation is a description of a portion of reality that has been observed during an observing process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">observation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000956 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000956">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000936"/>
        <prop:AFX_0002811 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000663"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
