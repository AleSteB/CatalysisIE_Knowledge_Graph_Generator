        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A density of theoretical plates (chromatography) is a chromatography peak facet that measures the amount of band broadening normalized per length unit that occurs during the separation and thus the efficiency of the chromatographic system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">density of theoretical plates (chromatography)</core:prefLabel>
    </owl:Class>
    


