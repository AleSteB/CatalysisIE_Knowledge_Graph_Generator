        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The maximum value is a statistical datum role of a datum that is the largest value of a collection of numbers. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum value role</core:prefLabel>
    </owl:Class>
    


