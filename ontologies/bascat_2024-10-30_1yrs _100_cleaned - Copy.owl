        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quarks comprise one of two classes of the fundamental particles. Quarks possess fractional electric charges and are not observed in free state. The word &quot;quark&quot; first appears in James Joyce&apos;s Finnegans Wake and has been chosen by Murray Gell-Mann as a name for fundamental building blocks of particles.</obo:IAO_0000115>
        <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboI:hasOBONamespace>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quarks</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:36346</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quark</rdfs:label>
    </owl:Class>
