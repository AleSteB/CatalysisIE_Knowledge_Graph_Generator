        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communication function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To communicate is the function to transferring information from one material entity to another. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to communicate</core:prefLabel>
    </owl:Class>
    


