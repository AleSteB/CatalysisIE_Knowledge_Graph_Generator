        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peel with elongation</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peel with elongation is a break code that denotes an elongation of one or both of the arms with peel along the seal contact line. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peel with elongation</core:prefLabel>
    </owl:NamedIndividual>
    


