    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002808 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002808">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has close match</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has close match establishes a connection between two resources that have a high degree of agreement in meaning such that they can be used interchangeably. [Allotrope]</core:definition>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property is related to skos:closeMatch. skos:closeMatch is an object property whereas this property is an annotation property to allow for weak semantic coupling. [Allotrope]</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has close match</core:prefLabel>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#note"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002809 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002809">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has exact match</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has exact match establishes a connection between two resources that have completely same meaning such that they can be used interchangeably. [Allotrope]</core:definition>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property is related to skos:exactMatch. skos:exactMatch is an object property whereas this property is an annotation property to allow for weak semantic coupling. [Allotrope]</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has exact match</core:prefLabel>
        <rdfs:subPropertyOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002808"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002811 -->

