        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An out port is a port in a device where material is flowing out of the system boundary. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">out port</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002192 -->

