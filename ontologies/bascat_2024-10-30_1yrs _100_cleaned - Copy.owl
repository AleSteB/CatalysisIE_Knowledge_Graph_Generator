        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection needle washing</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003664 -->

