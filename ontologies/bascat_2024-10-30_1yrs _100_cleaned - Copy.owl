        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scan position configuration (plate reader)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scan position</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scan position (quality)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scan position configuration</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scan position configuration is a system configuration of a the detector in a plate reader that is the position of the detector above or below the well plate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scan position configuration (plate reader)</core:prefLabel>
    </owl:Class>
    


