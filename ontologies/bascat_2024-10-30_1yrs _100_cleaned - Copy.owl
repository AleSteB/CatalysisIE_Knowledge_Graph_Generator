        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1984, 56, 231. (Nomenclature, symbols, units and their usage in spectrochemical analysis-Part VI: molecular luminescence spectroscopy)</term:source>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1994, 66, 2513. (Nomenclature for radioanalytical chemistry (IUPAC Recommendations 1994))</term:source>
