        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading material role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abrading material role is an abrading role of a material whose surface is being applied to another material to cause abrasion. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading material role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000559 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000559">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000560"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abraded material role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abraded material is an abrading role of a material whose surface is being abraded in an abrading process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abraded material role</core:prefLabel>
    </owl:Class>
    


