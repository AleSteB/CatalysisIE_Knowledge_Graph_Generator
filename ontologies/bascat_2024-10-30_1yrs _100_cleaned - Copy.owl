        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A data processing setting is a setting that controls how a data processing process is executed by some system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data processing setting</core:prefLabel>
    </owl:Class>
    


