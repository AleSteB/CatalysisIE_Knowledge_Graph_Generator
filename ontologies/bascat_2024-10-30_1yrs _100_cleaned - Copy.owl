        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An electronic absorbance wavelength setting that is an electronic absorbance detector setting parameter that specifies the nominal wavelength of a particular signal to be measured by the device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electronic absorbance wavelength setting</core:prefLabel>
    </owl:Class>
    


