        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample passage</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample passage is the compartment of a device that handles the conveying of samples. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample passage</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000023 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002145"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calorimeter</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A piece of apparatus that is used to measure the heat of chemical reactions or physical changes. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calorimeter</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000024 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000392"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0000310"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002809 rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002478"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas chromatograph</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GC device</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas chromatography device</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-03 Changed alt labels from system to device [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-20 Added restriction. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A piece of apparatus, consisting of a gas supply system, an injection or sampling system, a column, detector and a data acquisition/processing system, that is used to carry out chromatographic separations. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas chromatograph</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000029 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000029">
