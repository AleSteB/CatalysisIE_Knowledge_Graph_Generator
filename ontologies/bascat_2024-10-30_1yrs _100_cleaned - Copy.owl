        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exothermic peak is a differential scanning calorimetry peak resulting from energy transfer from the sample heating cell to the surrounding. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exothermic peak</core:prefLabel>
    </owl:Class>
    


