        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To cause a flow (material, energy or signal) to no longer be joined or mixed. [NIST]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to branch</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000105 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000105">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000104"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
