        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The nick name is a written name of person that is a substitute for the proper name of a familiar person, place, or thing - commonly used for affection. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nick name</core:prefLabel>
    </owl:Class>
    


