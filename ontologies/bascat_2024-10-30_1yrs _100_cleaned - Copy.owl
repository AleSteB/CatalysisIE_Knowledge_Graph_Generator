        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to track</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tracking function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To observe and record data from a flow. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">By tracking the performance of batteries, the low efficiency point can be determined. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to track</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000142 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000028"/>
