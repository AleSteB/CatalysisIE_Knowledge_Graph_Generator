        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device that introduces objects into the inside of another object. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000277 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000277">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000550"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002268"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strong anion-exchange column</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SAX column</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatography column where the stationary phase is a strong anion exchanger. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strong anion-exchange column</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000299 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000299">
