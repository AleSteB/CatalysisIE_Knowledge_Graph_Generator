        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An addition rate process profile is a rate process profile that is an occurrent part of an material addition process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">addition rate process profile</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003742 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003742">
