        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying additive</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A drying additive role is the role of a material in a drying process that supports the drying process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying additive role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000511 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000511">
        <owl:equivalentClass>
