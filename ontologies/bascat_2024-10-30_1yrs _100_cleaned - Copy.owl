    <!-- http://purl.obolibrary.org/obo/BFO_0000180 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000180">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an entity in the ontology to the term that is used to represent it in the the CLIF specification of BFO2</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person:Alan Ruttenberg</obo:IAO_0000119>
        <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Really of interest to developers only</obo:IAO_0000232>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BFO CLIF specification label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000112 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000112">
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">example of usage</rdfs:label>
