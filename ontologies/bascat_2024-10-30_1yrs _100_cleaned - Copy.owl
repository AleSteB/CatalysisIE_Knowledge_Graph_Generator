        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that ratios the peak height value with background level of noise.  It is an indication of the sensitivity of a particular method toward the analyte that the peak represents. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001196 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001196">
