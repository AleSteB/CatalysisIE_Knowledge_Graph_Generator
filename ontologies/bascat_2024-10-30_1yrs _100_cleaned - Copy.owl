        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl Fischer titrator</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Karl-Fischer titrator is a titrator designed for Karl-Fischer titrations. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl-Fischer titrator</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002221 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002221">
