        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 2007, 79, 1801 (Definitions of terms relating to the structure and processing of sols, gels, networks, and inorganic-organic hybrid materials (IUPAC Recommendations 2007)) on page 1805</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid aerosol</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid aerosol is an colloid where the continuous phase is a gas and the dispersed phase is a liquid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid aerosol</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001037 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001037">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001044"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular colloid</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A molecular colloid is a type of colloid that consists of many molecules that combine to structures of colloidal size. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sulphur S8 colloid</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular colloid</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001038 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixed material</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blend</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixture</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixture</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An portion of mixed material is a material entity that consists of different kinds of grains if you inspect it at a higher level of granularity. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of milk</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sand</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sea water</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sea water with sand</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixed material</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001039 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <prop:AFX_0002796 rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001223"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of pure substance</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An portion of pure substance is a material entity that consists of one kind of grains if you inspect it at a higher level of granularity. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solution of distilled water</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of pure substance</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001041 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001041">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001031"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000113"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 2007, 79, 1801 (Definitions of terms relating to the structure and processing of sols, gels, networks, and inorganic-organic hybrid materials (IUPAC Recommendations 2007)) on page 1805</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sol</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sol is a fluid colloidal system of two or more components. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sol</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001042 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001042">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000386"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid heterogeneous mixture</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid heterogeneous mixture is a heterogeneous mixture in solid state. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid heterogeneous mixture</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001044 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001044">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001035"/>
        <term:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <term:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 605</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloid</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloidal system</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A colloid is a homogeneous mixture in which one substance of microscopically dispersed insoluble particles is suspended throughout another substance. A colloid has a dispersed phase (the suspended particles) and a continuous phase (the medium of suspension). The molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between 1 nanometer and 1 micrometer, or in a system discontinuities are found at distances of that order. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloid</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001054 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001054">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/X-ray"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray radiation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A form of electromagnetic radiation with a wavelength ranging from 0.01 to 10 nanometers. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray radiation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001055 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001055">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Light"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible light</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">light</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation which is visible to the human eye and is responsible for the sense of sight. Visible light is usually defined as having wavelengths in the range of 400-700 nanometers. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible light</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001056 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001056">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Ultraviolet"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet radiation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UV</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet light</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An electromagnetic radiation with a wavelength from 10 nm to 400 nm. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet radiation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001057 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001057">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Infrared"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared radiation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IR</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared light</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation with longer wavelengths than those of visible light. It extends from the nominal red edge of the visible spectrum at 700 nanometer, to 1  micrometers. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared radiation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001058 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001058">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Gamma_ray"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma radiation</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma ray</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">γ-ray</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation of a kind arising from the radioactive decay of atomic nuclei and having wavelengths less than 10 picometers. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma radiation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001059 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural system</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system that can be discovered in nature. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural system</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001060 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001060">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <owl:disjointWith rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001061"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of compound</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compound</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain only the same kind of molecules, ignoring minor impurities. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of tablesugar</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of water</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of compound</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001061 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001061">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of element</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">element</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain only the same kind of atoms, ignoring minor impurities. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of gold</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of helium</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of element</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001064 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001064">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <owl:disjointWith rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of bulk stuff</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain some multi-molecular objects or particles. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bag of nuts</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">packet of rice</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of bulk stuff</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001065 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001065">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000012"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000114"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000114"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas mixture</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A gas mixture is a solution where the continuous phase is a gas and the dispersed phase is a gas. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">air</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas mixture</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001066 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001066">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000012"/>
        <rdfs:subClassOf>
            <owl:Class>
