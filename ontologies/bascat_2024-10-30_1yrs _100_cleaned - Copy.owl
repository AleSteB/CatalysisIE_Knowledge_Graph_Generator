        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dead cell count is the cell count of the partition of dead cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dead cell count (quality)</core:prefLabel>
    </owl:Class>
    


