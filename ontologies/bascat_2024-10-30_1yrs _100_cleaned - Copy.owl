        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroism spectrum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CD spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CD spectrum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroic spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroic spectrum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroism (CD) spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroism spectra</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of ellipticity vs. wavelength obtained by measuring the differential absorption of left- and right-handed circularly polarized photon radiation as a function of wavelength. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">circular dichroism spectrum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000057 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
