        <prop:AFX_0002865 rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:comment xml:lang="en">The range of skos:altLabel is the class of RDF plain literals.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The range of skos:altLabel is the class of RDF plain literals.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/skos/REC/2018/10/skos"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alternative label</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alternative lexical label for a resource.</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel).</core:example>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    </owl:AnnotationProperty>
    


