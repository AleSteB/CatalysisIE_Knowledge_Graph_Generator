        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fraction role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fraction</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fraction role is the role of a member of the collection of material that is collected in a fraction collection process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fraction role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000565 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000565">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
