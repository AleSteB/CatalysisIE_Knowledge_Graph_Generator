        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communication facet</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A facet that is about communication channels. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communication facet</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001083 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001083">
