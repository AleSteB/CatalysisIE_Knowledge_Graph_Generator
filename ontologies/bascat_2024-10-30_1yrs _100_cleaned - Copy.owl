        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stored object role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stored object</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A stored object is the storage role of an material entity that is being stored in a storage medium. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stored object role</core:prefLabel>
    </owl:Class>
    


