        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000973"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wall-coated open-tubular column</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WCOT column</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An open-tubular column in which the liquid stationary phase is coated on the unmodified smooth inner wall of the tube. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wall-coated open-tubular column</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000785 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000785">
