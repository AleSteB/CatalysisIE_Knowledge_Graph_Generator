        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A personal name is a name that is composed of a set of names by which an individual is known. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">personal name</core:prefLabel>
