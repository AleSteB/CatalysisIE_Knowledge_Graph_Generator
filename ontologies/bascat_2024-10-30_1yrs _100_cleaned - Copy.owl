        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A changing role is a role realized in some cooling process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cooling role</core:prefLabel>
    </owl:Class>
    


