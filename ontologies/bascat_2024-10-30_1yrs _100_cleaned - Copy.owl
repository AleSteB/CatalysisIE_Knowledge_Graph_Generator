        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002456"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electronic absorbance wavelength setting</rdfs:label>
