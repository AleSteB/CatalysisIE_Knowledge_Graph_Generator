                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specification</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">directive information entity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specification is a proposition about the intended purpose or design of an entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specification</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000958 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000958">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001054"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:allValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000961"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Tensor"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor value</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In mathematics, tensors are geometric objects that describe linear relations between geometric vectors, scalars, and other tensors. Elementary examples of such relations include the dot product, the cross product, and linear maps. The tensor datum is a facet that uses a tensor as an abstract mathematical description. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000959 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000959">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000958"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">higher-order tensor datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">higher-order tensor</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">higher-order tensor value</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tensor with order greater than 2. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">higher-order tensor datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000960 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000960">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000958"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002705"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
