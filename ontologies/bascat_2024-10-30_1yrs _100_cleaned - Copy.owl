        <term:source rdf:resource="https://en.wikipedia.org/wiki/Interpolation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interpolation is the constructing new data points within the range of a discrete set of known data points. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003570 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003570">
