        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric resistance is the quality quantification facet that quantifies the electric potential difference divided by the electric current when there is no electromotive force in a conductor. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric resistance</core:prefLabel>
    </owl:Class>
    


