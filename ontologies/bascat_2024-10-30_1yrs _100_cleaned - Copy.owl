        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measure of the magnitude of change of some participating entity per amount of time relative to other processes having similar changes. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rate</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000955 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000955">
