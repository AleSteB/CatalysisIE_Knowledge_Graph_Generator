        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Result of a spectroscopical measurement. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spectroscopy result</core:prefLabel>
    </owl:Class>
    


