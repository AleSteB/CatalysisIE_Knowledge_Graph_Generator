    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2023/11/new_onto.owl#DC_9804">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2023/11/new_onto.owl#DC_9801"/>
        <merg:catalytic_component_of rdf:resource="http://www.semanticweb.org/ontologies/2023/11/new_onto.owl#DC_12502"/>
