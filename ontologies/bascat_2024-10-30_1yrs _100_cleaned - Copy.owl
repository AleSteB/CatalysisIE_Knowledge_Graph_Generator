        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is condition for</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A condition that restricts an entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is condition for</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000365 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000365">
        <rdfs:subPropertyOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002793"/>
        <owl:inverseOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002845"/>
        <rdfs:domain rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001038"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <prop:AFX_0002811 rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000249"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has ingredient</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">component</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has component</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ingredient</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ingredient is a material that enters into a compound or is part of any combination or mixture. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has ingredient</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000386 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000386">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has shape</rdfs:label>
