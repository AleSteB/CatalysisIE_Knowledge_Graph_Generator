    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001651 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001651">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001556"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002704"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003674"/>
            </owl:Restriction>
        </rdfs:subClassOf>
