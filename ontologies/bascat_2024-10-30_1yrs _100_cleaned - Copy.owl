        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">viable cell count (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">viable cell count</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Viable cell count is the cell count of the partition of viable cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">viable cell count (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000186 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000186">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000184"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000608"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total cell count (quality)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total cell count</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total cell count is the cell count over a mereological sum of a partitioned aggregate of cells. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">total cell count (quality)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000187 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000184"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000606"/>
