    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000036 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000036">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001059"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codelist</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of codes in a controlled vocabulary. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codelist</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000050 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-12-01 Changed parent to symbol. [Allotrope]</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">code</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">categorical value</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enumeration value</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An entry in a list of controlled symbols denoting a classification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">code</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000090 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000991"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">condition</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A condition is an information content entity that is about the portion of reality under which something occurs or is valid. The condition is limited by its scope and may have preconditions. It restricts the possible realizations. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">condition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000091 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000091">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">and condition</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">and</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-01-07 Changed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An and condition is a collection of conditions that is valid if all condition items of it are valid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">and condition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000092 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000092">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">or condition</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">or</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-01-07 Changed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An or condition is a collection of conditions that is valid if at least one of its condition items is valid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">or condition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000093 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one of condition</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exclusive or condition</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one of</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xor</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xor condition</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-01-07 Changed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A one of condition is a collection of conditions that is valid if exactly one of its condition items is valid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one of condition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/common#AFC_0000160 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000160">
