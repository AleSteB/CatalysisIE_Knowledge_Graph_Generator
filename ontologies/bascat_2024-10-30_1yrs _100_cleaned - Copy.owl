        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carrying</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carrying is a state where a material entity, the carrier, supports the state of moving or keeping in place of another material or information. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carrying state</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003816 -->

