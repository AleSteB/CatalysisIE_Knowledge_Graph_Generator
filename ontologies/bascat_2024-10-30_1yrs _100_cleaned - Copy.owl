    <!-- http://purl.obolibrary.org/obo/CHEBI_35243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35238"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_tautomer_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17822"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An amino acid zwitterion obtained by transfer of a proton from the carboxy to the amnio group of serine.</obo:IAO_0000115>
        <cheb:charge rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0</cheb:charge>
