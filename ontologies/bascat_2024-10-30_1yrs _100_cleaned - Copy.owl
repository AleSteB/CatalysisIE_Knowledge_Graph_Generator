        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseline determination</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Baseline determination is a data transformation that calculates or assigns a baseline to a curve. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseline determination</core:prefLabel>
    </owl:Class>
    


