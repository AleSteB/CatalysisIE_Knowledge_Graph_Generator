        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to change</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adjusting function</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">changing function</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to adjust</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To adjust the flow of energy, signal, or material in a predetermined and fixed manner. [NIST]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to change</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000128 -->

