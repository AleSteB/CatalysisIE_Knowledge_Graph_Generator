        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading source</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abrading source role is an abrading role of a device or human that abrades material using abrading material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abrading source role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000563 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000563">
