        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetry</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Volumetry is a type of quantitative analysis that measures the quantity of a compound by quantifying its volume. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">volumetry</core:prefLabel>
    </owl:Class>
    


