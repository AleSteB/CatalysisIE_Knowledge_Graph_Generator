        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A project is a planned process that is undertaken or attempted to meet some requirement. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">project</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003735 -->

