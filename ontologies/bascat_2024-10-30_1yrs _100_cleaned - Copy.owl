        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard deviation role is a statistical datum role of a datum that is  a measure of the amount of variation or dispersion of a set of values. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard deviation role</core:prefLabel>
    </owl:Class>
    


