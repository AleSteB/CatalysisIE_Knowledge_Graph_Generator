        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Xenobiotic</oboI:hasDbXref>
        <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Xenobiotic</oboI:hasExactSynonym>
        <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">xenobiotic</oboI:hasExactSynonym>
