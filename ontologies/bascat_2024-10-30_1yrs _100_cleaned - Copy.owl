    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002850 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002850">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has design pattern</rdfs:label>
