        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pump system method is a device method that specifies how pumping should be executed in a pump system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pump system method</core:prefLabel>
