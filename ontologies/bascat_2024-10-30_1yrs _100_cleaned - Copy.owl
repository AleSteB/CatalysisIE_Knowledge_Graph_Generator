    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002228 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:subClassOf>
