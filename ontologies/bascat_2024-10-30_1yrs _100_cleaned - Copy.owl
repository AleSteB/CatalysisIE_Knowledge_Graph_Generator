        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disconnecting is a branching process that removes the connection between parts of a flow so that they become topologically separate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">disconnecting</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003809 -->

