        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To stir is a mixing function involving the agitation of a solution through circular motion. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to stir</core:prefLabel>
    </owl:Class>
    


