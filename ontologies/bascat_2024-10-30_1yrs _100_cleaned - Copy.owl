        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loading medium role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000552 -->

