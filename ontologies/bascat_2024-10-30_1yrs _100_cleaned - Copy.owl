        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backpressure regulator</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A backpressure regulator is a pressure regulator that regulates a defined pressure upstream of itself (at its own inlet). [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backpressure regulator</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002222 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002222">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002168"/>
