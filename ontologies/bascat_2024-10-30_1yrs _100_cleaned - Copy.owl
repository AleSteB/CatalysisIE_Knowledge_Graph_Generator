                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
