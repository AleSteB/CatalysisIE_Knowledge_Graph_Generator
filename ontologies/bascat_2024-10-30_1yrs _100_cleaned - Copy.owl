        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coating process role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coating role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coating process role is a role of a material that participates in a coating activity or the state of being coated. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coating process role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000485 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000485">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000212"/>
