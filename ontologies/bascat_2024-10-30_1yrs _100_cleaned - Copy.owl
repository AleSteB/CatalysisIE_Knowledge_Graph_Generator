        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal molecules</oboI:hasRelatedSynonym>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signaling molecule</oboI:hasRelatedSynonym>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signaling molecules</oboI:hasRelatedSynonym>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signalling molecules</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:62488</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signalling molecule</rdfs:label>
    </owl:Class>
    <owl:Axiom>
