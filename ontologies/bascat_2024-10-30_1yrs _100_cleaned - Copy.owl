        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone number</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A number for calling a telephone. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone number</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001080 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001080">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001682"/>
        <prop:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/title"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Title_(disambiguation)</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">title</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A title is a prefix or suffix added to a personal name. A title can be a title of honor, that is a title bestowed as an award,  a honorary title (academic), that is a recognition of contributions by a non-employee or employee, a hereditary title, that is a title that remains in a family or a job title, that is a designation of a person&apos;s position in an organization. [Wikipedia]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mr, Mrs, Ms, Dr.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">title</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001081 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001081">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001682"/>
        <prop:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#honorific-prefix"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">honorific prefix</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An honorific prefix is a facet that is part of a prefix to a person&apos;s name. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">honorific prefix</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001082 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001082">
