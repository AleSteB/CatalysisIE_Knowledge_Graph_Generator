        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">covering function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To cover is a joining function realized when something is joined to a surface in such way that it is preventing some kind of material or energy flow through that surface. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to cover</core:prefLabel>
    </owl:Class>
    


