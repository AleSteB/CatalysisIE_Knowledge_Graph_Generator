        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supercritical-fluid chromatography system</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A SFC system is a device system that has a supercritical fluid chromatograph component. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SFC system</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002224 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002224">
