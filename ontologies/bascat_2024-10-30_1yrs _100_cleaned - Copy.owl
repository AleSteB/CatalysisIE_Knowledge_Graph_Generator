    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/voc/afo/merged/REC/2023/09/merged-without-qudt-and-inferred#has_title -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/voc/afo/merged/REC/2023/09/merged-without-qudt-and-inferred#has_title">
