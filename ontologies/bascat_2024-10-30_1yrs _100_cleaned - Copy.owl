        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">image document</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002226 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002226">
