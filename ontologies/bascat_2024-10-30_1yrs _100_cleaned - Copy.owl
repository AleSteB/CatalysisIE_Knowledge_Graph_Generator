        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sequential procedure specification</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000947 -->

