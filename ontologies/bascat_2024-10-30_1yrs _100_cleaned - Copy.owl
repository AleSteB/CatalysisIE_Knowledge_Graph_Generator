        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KEGG:C00377</oboI:hasDbXref>
        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MetaCyc:Steroids</oboI:hasDbXref>
