        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any minor or unwanted substance introduced into the environment that can have undesired effects.</obo:IAO_0000115>
