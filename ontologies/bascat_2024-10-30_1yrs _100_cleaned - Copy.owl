        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reactor jacket is a jacket that controls the temperature of a reactor. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reactor jacket</core:prefLabel>
    </owl:Class>
    


