        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In electronics, a diode is a two-terminal electronic component that conducts primarily in one direction (asymmetric conductance). [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diode</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001875 -->

