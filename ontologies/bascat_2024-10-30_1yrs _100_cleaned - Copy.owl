        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">running state</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">executing</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">executing state</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is executing</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is running</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">running</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A running state is a state during which a device or service performs its specified function in normal operation. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">running state</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003666 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003666">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0000708"/>
