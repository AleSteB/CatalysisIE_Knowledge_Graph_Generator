        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to measure</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measuring function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To determine the magnitude of a flow. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An analog thermostat measures temperature through a bimetallic strip. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to measure</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000043 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000043">
