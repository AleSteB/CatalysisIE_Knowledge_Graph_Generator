        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid dosage form</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid dose form</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A substance having definite shape and volume manufactured for the administration of active and/or inert ingredient(s). Solids include tablets, capsules, powders, granules and certain suppositories. [NCI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid dosage form</core:prefLabel>
    </owl:Class>
    


