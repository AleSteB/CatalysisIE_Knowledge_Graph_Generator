    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000902 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000902">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000941"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
