        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A precipitation titration is a titration in which the analyte is precipitated by the titrant. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">precipitation titration</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003739 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003739">
