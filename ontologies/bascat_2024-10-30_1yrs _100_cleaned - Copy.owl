        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area scanning is scanning at positions defined by a two-dimensional pattern over an area. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">area scanning</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003805 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0002294"/>
            </owl:Restriction>
