        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ion formed as the product of a reaction involving a particular precursor ion. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product ion role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000497 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000497">
