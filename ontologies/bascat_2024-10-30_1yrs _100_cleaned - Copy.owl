        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-09-14 Moved from deprecated term AFR_0002500 to replacement AFR_0002507</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fluorescence is a quality quantification facet that quantifies the luminescence which occurs essentially only during the irradiation of a substance by electromagnetic radiation. [IUPAC]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence</core:prefLabel>
    </owl:Class>
    


