        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ion source inlet is an inlet into an ion source of a mass spectrometer. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ion source inlet</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000775 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000775">
