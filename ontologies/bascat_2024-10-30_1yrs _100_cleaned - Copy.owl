    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000388 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000388">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has scope</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in context</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in scope</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in situation</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scope</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A scope defines a situation or context in which a dependent entity such as a condition or contextual role occurs or is valid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has scope</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000395 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000395">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002230"/>
            <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000395"/>
        </owl:propertyChainAxiom>
