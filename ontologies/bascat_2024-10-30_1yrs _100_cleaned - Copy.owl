                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000107"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
