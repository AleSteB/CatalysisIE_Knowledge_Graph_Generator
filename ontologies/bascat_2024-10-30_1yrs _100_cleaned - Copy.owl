        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inlet gas role (DVS)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inlet gas</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inlet gas role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inlet gas role is the role of the gas led into the system in the dynamic vapor sorption process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inlet gas role (DVS)</core:prefLabel>
    </owl:Class>
    


