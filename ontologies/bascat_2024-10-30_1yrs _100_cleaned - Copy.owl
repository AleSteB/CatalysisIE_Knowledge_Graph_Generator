        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A saturated gas role is the role of the gas saturated with the vapor in a dynamic vapor sorption process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturated gas role (DVS)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000532 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000532">
