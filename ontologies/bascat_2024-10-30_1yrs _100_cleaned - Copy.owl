        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-23 Changed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endothermic peak is a differential scanning calorimetry peak peak resulting from energy transfer to the sample heating cell. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endothermic peak</core:prefLabel>
    </owl:Class>
    


