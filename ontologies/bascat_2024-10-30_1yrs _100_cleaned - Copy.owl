        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The electronic absorbance detection wavelength is the detection wavelength setting of an electronic absorbance detector. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electronic absorbance detection wavelength</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000198 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000198">
