        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of theoretical plates calculated based on the peak width measured at the baseline. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of theoretical plates by tangent method</core:prefLabel>
    </owl:Class>
    


