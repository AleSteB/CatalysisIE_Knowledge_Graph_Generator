        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification specific to the column compartment in the chromatography system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">column compartment setting (chromatography)</core:prefLabel>
    </owl:Class>
    


