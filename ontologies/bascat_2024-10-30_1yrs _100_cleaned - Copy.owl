        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data input role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data input</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data input role is a type of contextual role of an information artifact that is the input of a process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data input role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000047 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
