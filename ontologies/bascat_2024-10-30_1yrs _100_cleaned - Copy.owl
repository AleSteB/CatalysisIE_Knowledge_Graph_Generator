        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter specification</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A participant specification which specifies an information object that has the contextual role of a parameter in the realized process. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification can include a formal name, a datatype, a shape or range of values if the parameter is a datum.</core:example>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification is about a parameter. It is a parameter itself only in the context of a specification process.</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter specification</core:prefLabel>
    </owl:Class>
    


