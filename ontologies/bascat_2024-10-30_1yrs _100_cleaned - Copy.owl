        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lower operating limit</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An operating minimum is the contextual role of a description or specification of a lower bound of quality of a system or environment during the operation of the system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">operating minimum</core:prefLabel>
    </owl:Class>
    


