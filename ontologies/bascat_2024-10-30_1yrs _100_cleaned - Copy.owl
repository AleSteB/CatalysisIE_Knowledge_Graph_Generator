        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha-particle spectrum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha particle spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha particle spectrum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha-particle spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">α-particle spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">α-particle spectrum</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of alpha-particle count vs. energy obtained by measuring the number and kinetic energies of alpha-particles emitted by a sample. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alpha-particle spectrum</core:prefLabel>
    </owl:Class>
    


