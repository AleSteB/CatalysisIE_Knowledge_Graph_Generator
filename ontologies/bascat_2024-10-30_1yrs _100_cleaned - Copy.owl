        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assay result</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assay output</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">experimental result</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">result</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-20 Changed equivalent class to subclass. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The final outcome reported for a measured or computed quantity, after performing a measuring procedure including all sub procedures and evaluations. [IUPAC, Allotrope]</core:definition>
