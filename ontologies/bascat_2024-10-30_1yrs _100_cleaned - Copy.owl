        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum pressure of the fluid for a plumbing system</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum environment temperature for operation</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alert setting</core:prefLabel>
    </owl:Class>
    


