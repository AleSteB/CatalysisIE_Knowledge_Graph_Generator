        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An experiment is a planned process that has the goal of verifying, falsifying, or establishing the validity of a hypothesis. [SIO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">experiment</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003736 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003736">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003737"/>
