        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data output role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data output</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">result</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Data output role is a type of contextual role of an information artifact that is the output of a process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data output role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000044 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000008"/>
