        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An in/out port is a port where a flow is going in both directions. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in/out port</core:prefLabel>
    </owl:Class>
    


