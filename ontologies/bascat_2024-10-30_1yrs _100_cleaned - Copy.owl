        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/bet-analysis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adsorbed volume at STP</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An adsorbed volume is a quality quantification facet that denotes the quantity of absorbant calculated to be adsorbed at STP. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adsorbed volume at STP</core:prefLabel>
    </owl:Class>
    


