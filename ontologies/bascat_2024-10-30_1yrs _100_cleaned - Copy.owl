        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">luminescence profile</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A luminescence process profile is a profile that quantifies the luminescence of a material entity over time. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">luminescence process profile</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003804 -->

