        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carrying role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000555 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000555">
