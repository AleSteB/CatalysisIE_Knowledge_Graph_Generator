        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Charge deconvolution is a data transformation of a spectrum representing multiply charged ions to singly charged or neutral masses. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">charge deconvolution</core:prefLabel>
    </owl:Class>
    


