        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A polarized light enabled setting is a setting that specifies whether polarized light is used in an image capture process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polarized light enabled setting</core:prefLabel>
