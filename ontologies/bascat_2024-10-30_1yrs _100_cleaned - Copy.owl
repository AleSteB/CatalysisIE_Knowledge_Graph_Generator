        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to support</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supporting function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To firmly fix a material into a defined location, or secure an energy or signal into a specific course. [NIST]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to support</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000029 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000029">
