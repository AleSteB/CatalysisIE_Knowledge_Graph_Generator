        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature control device</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermostat</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device used to control the temperature in a compartment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temperature controller</core:prefLabel>
    </owl:Class>
    


