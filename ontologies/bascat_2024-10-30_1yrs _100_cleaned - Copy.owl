        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number density measurement</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measuring that targets the number density. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number density measurement</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003628 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003628">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003627"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002750"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000181"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
