    <!-- http://purl.obolibrary.org/obo/CHEBI_3489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_3489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23066"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_52439"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A second-generation cephalosporin antibiotic having N(1)-methyltetrazol-5-ylthiomethyl, {[(cyanomethyl)sulfanyl]acetyl}amino and methoxy side-groups at positions 3, 7beta and 7alpha respectively of the parent cephem bicyclic structure.</obo:IAO_0000115>
