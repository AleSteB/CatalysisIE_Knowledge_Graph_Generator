        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detection bandwidth</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Detection bandwidth is a device setting of a detector controlling the bandwidth of the detection wavelength. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detection bandwidth</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000199 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000199">
