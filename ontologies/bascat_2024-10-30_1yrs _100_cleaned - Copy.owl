        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difference datum role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difference datum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difference value</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-16 Changed pref label and definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A difference datum role is a relative datum role that expresses the relative magnitude as a difference or interval of the magnitude of the subject to that of the reference entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difference datum role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000314 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000314">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation role is a contextual role of an information content entity that is about a relation of the subject of the information content entity to another entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relation role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000316 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000316">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000170"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">first member</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">first</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A first member is an ordered member that has no predecessor in the aggregate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">first member</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000317 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000317">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000170"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">last member</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">last</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A last member is an ordered member that has no successor in the aggregate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">last member</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000319 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000319">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000277"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002734"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003634"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statistical role is a contextual role of data in statistics. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000320 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000320">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Arithmetic_mean"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arithmetic mean role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arithmetic mean</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">average</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">average role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mean role</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-18 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The arithmetic mean is a statistical datum role of a datum that is the sum of a collection of numbers divided by the number of numbers in the collection. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arithmetic mean role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000321 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000321">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Median"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">median role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">median</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-18 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The median role is a statistical datum role that denotes the value separating the higher half of a data sample, a population, or a probability distribution, from the lower half. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">median role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000322 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000322">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Skewness"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skewness role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skewness</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-18 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skewness role is a statistical datum role of a datum that is a measure of the asymmetry of the probability distribution of a real-valued random variable about its mean. The skewness value can be positive or negative, or undefined. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skewness role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000323 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000323">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Variance"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">variance role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">variance</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-18 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The variance role is a statistical datum role of a datum that denotes the expectation of the squared deviation of a random variable from its mean. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">variance role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000324 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000324">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Statistical_population"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical sample role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statistical sample role is the contextual role of a subset of a statistical population that is chosen to represent the population in a statistical analysis. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical sample role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000325 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000325">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000166"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Statistical_population"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical population role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical population</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statistical population role is the statistical role of a set of similar items or events which is of interest for some question or experiment (the statistical population). A statistical population can be a group of existing entities or a hypothetical and potentially infinite group of entities conceived as a generalization from experience. [Wikipedia]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the class of living cells is the population role in the &apos;average living cell diameter&apos; result datum of a cell counter result</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical population role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000326 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000326">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000319"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Random_variable"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">random variable</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aleatory variable</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">random quantity</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stochastic variable</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In probability and statistics, a random variable, random quantity, aleatory variable, or stochastic variable is a variable whose possible values are outcomes of a random phenomenon. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">random variable</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000328 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000328">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000319"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000442"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistic datum role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistic</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistic datum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical result</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-18 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statistic datum is the summary output of descriptive statistics on a statistical population. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistic datum role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000330 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000330">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000982"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002704"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trigger datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trigger value</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An trigger datum is the role of a  datum that specifies some situation about a system or environment participating in a process that should trigger the start of another process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trigger datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000332 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000332">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/realizable#AFRE_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <prop:AFX_0002808 rdf:resource="http://purl.oclc.org/NET/ssnx/ssn#SurvivalRange"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">survival range</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An survival range is the contextual role of an description or specification of about an environment in which the operation of a system can or should operate without damaging the system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">survival range</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000333 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000333">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000330"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alert datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alert value</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alert datum is a trigger datum that specifies a trigger that initiates a notification process that warns about an unintended situation. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alert datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000335 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000335">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000159"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference signal</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference signal is the role of a signal that relates to another signal as reference for comparison. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference signal</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000336 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000336">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000277"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Function_(mathematics)"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain (math)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain (mathematics)</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-19 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A domain is the mathematical role of the set a function is applied on. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domain (math)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000337 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000337">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000277"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codomain (math)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codomain</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codomain (mathematics)</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-19 Changed pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A codomain is the mathematical role of the set a function maps to. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">codomain (math)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000339 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000339">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000011"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid mobile phase</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The liquid mobile phase is a role of a liquid material that percolates through the stationary bed in chromatography. [Allotrope, CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid mobile phase</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000340 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000340">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000291"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The detector role is a detection role of a material entity that is detecting some other entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000344 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000344">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0001348"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesis role</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Change to subclasses to equivalent class. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A synthesis role is a role of a material that is participating in a synthesis (material conversion) process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesis role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000345 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000345">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000344"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulation role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A formulation role is a role of a material that is participating in a formulation process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formulation role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000347 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000347">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particulate phase</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Particulate phase role is the role of the particles dispersed in a gel, sol or aerosol. [NIST, Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particulate phase</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000351 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000351">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000345"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active pharmaceutical ingredient role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">API</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active pharmaceutical ingredient</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drug substance</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drug substance role</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-06-22 Add alt labels. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The role of a material in a drug product that is biologically active when interacting with other components of the drug product, other potential drug products, or the chemistry of the body into which the drug will be applied. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active pharmaceutical ingredient role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000352 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000352">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000035"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specimen role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specimen</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specimen role is the sample role of a prepared fraction of a portion of material that is analyzed in a particular experiment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specimen role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000359 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000359">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000344"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000353"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0001348"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">by-product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">by-product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material role of an expected but not desired product of a synthesis. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the leaving group in a de-protection step.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">by-product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000360 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000360">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000344"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000353"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0001348"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical product</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A role of a material that is intended and desired to be  produced in a synthesis. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000361 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000361">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000360"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lot</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lot role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Batch role is a product role of a portion of material that is intended to have uniform character and quality, within specified limits, and is produced according to a single manufacturing order during the same cycle of manufacture. [Allotrope, CFR21]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batch role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000362 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000362">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0001530"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filtration role</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-08-27 Fixed OWL definition, bug #694.  [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Change to subclasses to equivalent class. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A filtration role is a role of a material in a filtration process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filtration role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000363 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000244"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinse solution role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flush</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinse</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinse solution</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinsing agent</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinsing role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinsing solution</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-09-20 Changed definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The rinse solution role is a cleaning agent role of a fluid used to flush something in order to remove contaminants. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rinse solution role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000364 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000364">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000344"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material role for any component of material that is not part of the defined product at the particular stage of manufacture or storage. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For example a starting material is not an impurity at the start of a reaction but it is an impurity after the final purification step.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000365 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000365">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003641"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degradation product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degradation product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degradation product is an impurity resulting from a chemical change in the drug substance brought about during manufacture and/or storage of the new drug product by the effect of, for example, light, temperature, pH, water, or by reaction with an excipient and/or the immediate container closure system. [ICH-Q3B]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degradation product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000366 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000366">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000427"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000427"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified degradation product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified degradation product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degradation product role for which a structural characterization has not been achieved and that is defined solely by qualitative analytical properties (e.g., chromatographic retention time). [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified degradation product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000367 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000367">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000428"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000428"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified degradation product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified degradation product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degradation product role that is limited by a general acceptance criterion, but not individually listed with its own specific acceptance criterion, in the new drug product specification. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified degradation product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000368 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000368">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002806"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classification purpose</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classification role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A contextual role of information that classifies some of some entity into a category, class or schema. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">classification purpose</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000369 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000369">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003634"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling role</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Change to subclasses to equivalent class. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sampling role is a role of an object aggregate or a member of that aggregate that participates in a sampling process on the aggregate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sampling role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000370 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000370">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000369"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The population role is the sampling role of the object aggregate that is object of the sampling. [Allotrope]</core:definition>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The statistical population contextual role is the related contextual role of an information object describing the population.</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000371 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000371">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000369"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample set role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample set</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sample set role is the role of the partition of the population object aggregate that was selected in the sampling process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample set role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000373 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000373">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A spatial role is the contextual role of some information context object that is about spatial location, orientation, or relative positioning. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">left, right, above, below, inside, outside, parallel</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000402 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">head</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Role that a organizational entity plays leader or formal head of the organization. [W3C ORG]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">head</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000403 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <prop:AFX_0002808 rdf:resource="http://www.w3.org/ns/org#Post"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">post</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A post is some position within an organization that exists independently of the person or persons filling it. Posts may be used to represent situations where a person is a member of an organization ex officio. [W3C ORG]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the Secretary of State for Scotland is part of UK Cabinet by virtue of being Secretary of State for Scotland, not as an individual person [W3C ORG]</core:example>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A post can be held by multiple people and hence can be treated as a organization in its own right. [W3C ORG]</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">post</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000404 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000434"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/audit/role#Approver"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">approver</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An approver is the role of an organizational entity that approves something. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">approver</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000405 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000405">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/MS_1001271"/>
        <prop:AFX_0002808 rdf:resource="http://vivoweb.org/ontology/core#ResearcherRole"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">researcher</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A researcher is the role of an organizational entity that researches something. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">researcher</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000406 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000405"/>
        <prop:AFX_0002808 rdf:resource="http://vivoweb.org/ontology/core#InvestigatorRole"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigator</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An investigator is a researcher that is doing an investigation. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">investigator</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000407 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000407">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/audit/role#Reviewer"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewer</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reviewer is the role of an agent that reviews some information. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reviewer</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000409 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000409">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000435"/>
        <prop:AFX_0002808 rdf:resource="http://purl.allotrope.org/ontologies/audit/role#Signer"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Signature"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signer</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signatory</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A signer is the role of the agent in a signing process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signer</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000410 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000410">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0002389"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0002389"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calibration role is role of a material entity that participates in a calibration process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000411 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000411">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000410"/>
        <term:source rdf:resource="https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nbsspecialpublication260-100.pdf"/>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISO Guide 30</term:source>
        <term:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.citac.cc/CITAC_EURACHEM_GUIDE.pdf</term:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference material role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration material</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration material role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference material</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard material</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard material role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reference material role is the role of a material used in a calibration whose qualities are sufficiently homogenous and well established to be used as reference. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference material role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000420 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000420">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000231"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting material role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A role for a material used in the synthesis of a new drug substance that is incorporated as an element into the structure of an intermediate and/or of the new drug substance. [ICH-Q3A]</core:definition>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Starting materials are normally commercially available and of defined chemical and physical properties and structure. [ICH-Q3A]</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">starting material role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000421 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000086"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limiting reagent role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reagent role of the material with the least mole quantity in a chemical process and as such limits the amount of product that can be formed. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">limiting reagent role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000422 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000422">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enantiomeric impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enantiomere</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enantiomeric impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An enantiomeric impurity is the impurity role of a compound with the same molecular formula as the drug substance that differs in the spatial arrangement of atoms within the molecule and is a non-superimposable mirror image. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enantiomeric impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000423 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000423">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extraneous contaminant role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contaminant</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contaminant role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extraneous contaminant</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An extraneous contaminant role is an impurity role arising from any source extraneous to the manufacturing process. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">extraneous contaminant role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000424 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000424">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity for which a structural characterization has been achieved. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000425 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000425">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potential impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potential impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity role for a material that theoretically can arise during manufacture or storage. It may or may not actually appear in the new drug substance. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potential impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000426 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000426">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity that is individually listed and limited with aspecific acceptance criterion in the new drug substance specification. A specified impurity can be either identified or unidentified. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000427 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000427">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity for which a structural characterization has not been achieved and that is defined solely by qualitative analytical properties (e.g., chromatographic retention time). [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unidentified impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000428 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000428">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000364"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified impurity role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified impurity</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impurity role that is limited by a general acceptance criterion, but not individually listed with its own specific acceptance criterion, in the new drug substance specification. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">unspecified impurity role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000429 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000429">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified degradation product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified degradation product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degradation product role for which a structural characterization has been achieved. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">identified degradation product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000430 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000430">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000365"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified degradation product role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified degradation product</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degradation product role that is individually listed and limited with a specific acceptance criterion in the new drug product specification. A specified degradation product can be either identified or unidentified. [ICH-Q3A]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified degradation product role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000432 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000432">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000293"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Internal_standard"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internal standard role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internal standard</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surrogate internal standard</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internal standard role is the analysis role of a chemical substance that is added in a constant amount to samples, the blank and calibration standards in a chemical analysis. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internal standard role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000434 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003643"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">approving role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An approving role is a role that is realized in some approving process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">approving role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000435 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003645"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signing role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A signing role is a role that is realized in some signing activity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signing role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000436 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000167"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000435"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signed object</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The signed object is the bearer of the information content entity that is signed. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The paper where the signature was written on.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signed object</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000437 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000437">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signing contextual role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A signing contextual role is a contextual role of information content entities that are participants in a signing process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signing contextual role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000438 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000060"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000437"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Signature"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signature role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signature</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A signature role is the role of an information object that is associated with some information and provides a proof of identity and intent of the signer. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signature role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000439 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000439">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000437"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signed content role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signed content</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signed content role is the signing contextual role of the information content entity that is being signed. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A contract signed.</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An approval signed.</core:example>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The signed content role is the role of the information. The physical bearer of that information has the role of a signed object.</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signed content role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000441 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000087"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000449"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000087"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000095"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submitter role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submitter</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A submitter role is the role of a material entity that plays the sender of the submitted entity in a submitting process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submitter role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000442 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000442">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000048"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggregated datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">summary datum</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aggregated datum is the role of an information object that is about aggregated or summary information on the aggregate, such as statistics, count or sums of member data. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggregated datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000443 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000264"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000442"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product (math)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product (mathematics)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The product is the contextual role of numerical data that results from the multiplication of two or more numbers, amounts, or items. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product (math)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000444 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000444">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001286"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggregated feature</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggregated feature role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The aggregated feature is the role of a description or classification of a property, characteristic or facet of the members of the aggregate that is common to each member and is used to make aggregated data about the aggregate. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the diameter quality is the aggregated feature in the &apos;average living cell diameter&apos; result datum of a cell counter result</core:example>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If the members of the aggregates are proxies for other information objects, then the aggregated feature is a feature of the information objects the proxies point to.</core:note>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggregated feature</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000446 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000446">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000039"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000448"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">software agent role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">software agent</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A software agent is the contextual role of software in the context of a process where a system executes that software and causally is an agent in the process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">software agent role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000448 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000091"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general agent role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agent</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agent role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agentive role is a general role of a material entity or software that  influences the behavior of a process in an active way. If a material entity it is an agent role, if its is a software that is executed by a computer system, it is a software agent role. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general agent role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000449 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000449">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003646"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submission role</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Change to subclasses to equivalent class. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A submission role is a role that is realized in a submitting process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submission role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000450 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metadata role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metadata role is a contextual role of an information content entity that is not a parameter or result of a process but describes the context of the process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metadata role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000451 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002230"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003348"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination site</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Moved under localization role and adopted definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Destination role is the localization role of a site where the localized object is at the end of the localization process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000452 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002224"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003348"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin site</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Moved under localization role and adopted definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Origin role is the localization role of a site where the localized object is at the start of the localization process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000453 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000453">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000119"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000167"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transferred material</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transferred object</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-06-23 Changed definition and pref label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transferred material is the role of the material that is being transferred from the origin site to the destination site. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transferred material</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000454 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000454">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000453"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002230"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003312"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">received object role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">received object</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sent object is the role of a transferred object at the start of the transferring process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">received object role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000455 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000453"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002224"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003312"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sent object role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sent object</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sent object is the role of a transferred object at the start of the transferring process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sent object role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000457 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000471"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predecessor role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A predecessor role is an ordering role that applies if the information object or the entity it is about is before another one in a sequence. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predecessor role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000458 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000458">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000471"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">successor role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A successor role is an ordering role that applies if the information object or the entity it is about is after another one in a sequence. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">successor role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000461 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000461">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000472"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">triggering event</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A triggered event is a contextual role of an event specification that when realized is the cause of a trigger. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">triggering event</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000462 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000462">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000472"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">triggered event</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A triggered event is a contextual role of an event specification that when realized is the consequence of a trigger. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">triggered event</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000463 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000463">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direction role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A direction role is a contextual role of some information content entity indicating a direction in a relation. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direction role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000464 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000464">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000463"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">destination role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A to role is a direction role indicating that something is going into an target direction. [Allotrope]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an abstraction of direction, for spatio-temporal role use af-rl:destination datum. [Allotrope]</core:editorialNote>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000465 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000465">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000463"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">origin role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A from role is a direction role indicating that something is coming from a source. [Allotrope]</core:definition>
        <core:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is an abstraction of direction, for spatio-temporal role use af-rl:origin datum. [Allotrope]</core:editorialNote>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specification of a material that is a material output of a process has the contextual role of from role in the material flow specification. [Allotrope]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000466 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000466">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">defining purpose</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">defining role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">definition role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defining purpose is the contextual role of some information that has the purpose to define an entity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">defining purpose</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000471 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ordering role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ordering role is a contextual role of an information content entity in the scope of some sequence. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ordering role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000472 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000472">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workflow role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A workflow role is a contextual role of a part of a procedure specification. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">workflow role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000473 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000473">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000458"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default transition</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An default transition is a successor role in the scope of an exclusive gateway that specifies the succeeding activity if no guard conditions on the gateway are met. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">default transition</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000474 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000474">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000053"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expected datum</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An expected datum is a descriptive datum that describes a information that was predicted or assumed to be the outcome of some process . [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expected datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000475 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000475">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000472"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sequential</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sequential role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A workflow role of a single step in a sequentially executed procedure. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A single data acquisition of a data acquisition profile.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sequential</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000476 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000476">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000472"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeatable</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loop</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">recurring</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A single step that can be repeated multiple times during a procedure. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A single data acquisition that is repeated multiple times with the same settings during a data acquisition profile.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeatable</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000477 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000477">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000053"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated datum</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated result</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calibrated datum is the contextual role of a datum that is the output of some process that applies a calibration function to a measured datum. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibrated datum</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000478 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000478">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000277"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter (math)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter (mathematics)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter is the contextual role of a datum that is not explicitly varied in a mathematical function or during data processing. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter (math)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000479 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000479">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000231"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHEBI_63248"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidant role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidant</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidizer</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidizer role</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidizing agent</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An oxidant role is a chemical reactant role whereby the substance removes electrons from another reactant in a redox reaction. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oxidant role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000480 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000480">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000231"/>
        <prop:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33292"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fuel role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fuel</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fuel role is a chemical reactant role whereby an energy-rich substance is transformed with release of usable energy. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fuel role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000481 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000481">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000216"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">make-up role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">make-up</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A make-up role is a the additive role of a fluid to adjust total flow rate into a device in order to maximize its efficiency. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">make-up role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000484 -->

