        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A magnification setting is a setting that specifies the multiplicative optical apparent size manipulation being applied by an imaging device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">magnification setting</core:prefLabel>
    </owl:Class>
    


