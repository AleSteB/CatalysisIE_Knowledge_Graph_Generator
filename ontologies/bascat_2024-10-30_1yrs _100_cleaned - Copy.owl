        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement metadata</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Measurement metadata is a facet that is part of a information content entity about a measurement that is about the context of the measurement, but not directly about the measurement result or a measurement parameter. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement metadata</core:prefLabel>
    </owl:Class>
    


