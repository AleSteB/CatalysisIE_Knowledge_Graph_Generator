        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance scan slope</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impedance scan slope is an impedance scan result that quantitates the slope (α) of the beta-dispersion at the characteristic frequency fc and is indicative of the cell diameter distribution. The steeper the slope , the more homogeneous the distribution. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance scan slope</core:prefLabel>
    </owl:Class>
    


