    <!-- http://purl.obolibrary.org/obo/CHEBI_78433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33232"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A substance used in a thermodynamic heat pump cycle or refrigeration cycle that undergoes a phase change from a gas to a liquid and back. Refrigerants are used in air-conditioning systems and freezers or refrigerators and are assigned a &quot;R&quot; number (by ASHRAE - formerly the American Society of Heating, Refrigerating and Air Conditioning Engineers), which is determined systematically according to their molecular structure.</obo:IAO_0000115>
        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Refrigerant</oboI:hasDbXref>
        <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboI:hasOBONamespace>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refrigerants</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:78433</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refrigerant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refrigerants</owl:annotatedTarget>
        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ChEBI</oboI:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_78608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_78608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35238"/>
