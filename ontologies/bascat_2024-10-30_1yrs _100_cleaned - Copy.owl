        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of SHACL targets e.g. sh:targetClass or sh:targetNode. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has shape</core:prefLabel>
