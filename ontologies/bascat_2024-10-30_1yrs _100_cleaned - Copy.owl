    <!-- http://purl.allotrope.org/ontologies/process#AFP_0000021 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0000225"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrophilic interaction chromatography</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HILIC</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrophilic interaction liquid chromatography</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-02-03 Added altLabel [OSTHUS]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Liquid chromatography where the stationary phase is hydrophilic, the mobile phase is organic and separation is achieved based on polarity. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrophilic interaction chromatography</core:prefLabel>
    </owl:Class>
    


