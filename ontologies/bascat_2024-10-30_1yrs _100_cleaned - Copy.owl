        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LINCS:LSM-5546</oboI:hasDbXref>
        <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboI:hasOBONamespace>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:94613</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#2_STAR"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DMO</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5,5-dimethyloxazolidine-2,4-dione</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000993 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000275"/>
