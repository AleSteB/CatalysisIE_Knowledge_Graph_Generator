        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flowing is the state of moving along a steady continuous stream. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flow of ions in a TOF detector</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flow of water through pipes</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flowing</core:prefLabel>
    </owl:Class>
    


