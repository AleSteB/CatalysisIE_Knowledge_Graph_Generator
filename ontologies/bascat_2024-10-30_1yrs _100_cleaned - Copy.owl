    <!-- http://purl.obolibrary.org/obo/CHEBI_50268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_50268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38632"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51374"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A substance that does not act as agonist or antagonist but does affect the gamma-aminobutyric acid receptor-ionophore complex. GABA-A receptors appear to have at least three allosteric sites at which modulators act: a site at which benzodiazepines act by increasing the opening frequency of gamma-aminobutyric acid-activated chloride channels; a site at which barbiturates act to prolong the duration of channel opening; and a site at which some steroids may act.</obo:IAO_0000115>
        <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chebi_ontology</oboI:hasOBONamespace>
        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GABA modulators</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:50268</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GABA modulator</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50268"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GABA modulators</owl:annotatedTarget>
        <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ChEBI</oboI:hasDbXref>
    </owl:Axiom>
    


