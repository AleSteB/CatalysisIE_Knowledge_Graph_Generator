        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To make something known to the user about a flow. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small window in the water container of a coffee maker indicates the level of water in the machine. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to indicate</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000014 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000014">
