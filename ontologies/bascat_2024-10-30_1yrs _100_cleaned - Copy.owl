        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lowest value of a range or a set of values. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000331 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000331">
