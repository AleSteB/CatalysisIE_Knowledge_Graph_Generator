        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To provide a flow from storage. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In a flashlight, the battery supplies energy to the bulb. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to supply</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000141 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000141">
