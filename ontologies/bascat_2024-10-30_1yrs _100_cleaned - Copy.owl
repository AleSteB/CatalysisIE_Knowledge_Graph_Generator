        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">device process</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">instrument process</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device process is a planned process that realizes a function by a device or device system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">device process</core:prefLabel>
        <core:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device process focuses on an implementation perspective.</core:scopeNote>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003727 -->

