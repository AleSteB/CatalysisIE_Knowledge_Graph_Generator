        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capability</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capability (proposition)</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-12-01 Changed label and definition. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A capability is a proposition that is about a function, role or quality realized under given conditions. [Allotrope]</core:definition>
        <core:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A capability can be in a description or specification role.</core:note>
