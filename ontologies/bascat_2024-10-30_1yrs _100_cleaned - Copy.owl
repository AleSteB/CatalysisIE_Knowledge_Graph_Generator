        <oboI:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skin-peeling agent</oboI:hasRelatedSynonym>
        <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:50176</oboI:id>
        <oboI:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
