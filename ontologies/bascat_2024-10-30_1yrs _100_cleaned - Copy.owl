        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative peak height</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000950 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000950">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000923"/>
        <prop:AFX_0002811 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000180"/>
        <prop:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">step size</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">increment</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The difference between two discrete points next to each other in a range of discrete values. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device property can be set between a minimum and maximum value but only in steps of the increment value. [Allotrope]</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Step size of sweeping over 2Theta, unit ° [Allotrope]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">step size</core:prefLabel>
    </owl:Class>
    


