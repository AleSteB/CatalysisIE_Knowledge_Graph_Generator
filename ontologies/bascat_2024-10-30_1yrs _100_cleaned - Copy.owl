        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Averaging is the calculation of a mean statistic or a temporal average value. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">averaging</core:prefLabel>
    </owl:Class>
    


