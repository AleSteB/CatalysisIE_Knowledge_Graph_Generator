        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">corrected peak area (relative)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative corrected peak area is a relative peak area that denotes the corrected area of the peak relative to some other peak or summation of peaks. . [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative corrected peak area</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002776 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002776">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001236"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 % height</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 percent height</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4% height</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Changed pref label, added alt label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor equivalent to the ratio of the time or volume from the center point of a peak to its trailing edge to that of its fronting edge at 4.4 % of the peak height. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 % height</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002777 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002777">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001236"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 4.4 % height</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 4.4 percent height</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 4.4% height</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Added alt label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor equivalent to the square of ratio of the time or volume from the center point of a peak to its trailing edge to that of its fronting edge at 4.4 % of the peak height. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 4.4 % height</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002778 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002778">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001236"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 10 % height</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 10 percent height</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor squared measured at 10% height</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Added alt label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor equivalent to the square of ratio of the time or volume from the center point of a peak to its trailing edge to that of its fronting edge at 10 % of the peak height. [Allotrope]</core:definition>
