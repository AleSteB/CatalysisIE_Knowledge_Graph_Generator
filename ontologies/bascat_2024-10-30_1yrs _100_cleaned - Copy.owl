        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A monolayer quantity is a volume of a monolayer based on the cross-sectional area of the adsorbent gas. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monolayer quantity</core:prefLabel>
    </owl:Class>
    


