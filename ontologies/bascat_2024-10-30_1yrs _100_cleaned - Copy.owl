            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell counter assay</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell counter analysis</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell counting analysis</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell counter assay is a cellular assay that uses various methods to quantify cells in a culture. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell counter assay</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0000039 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0000039">
