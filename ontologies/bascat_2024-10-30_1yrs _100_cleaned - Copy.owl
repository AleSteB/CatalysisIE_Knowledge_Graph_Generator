        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preventative maintenance</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preventative maintenance is a proactive maintenance of a device involving inspection, testing and preemptive replacement of parts likely to fail before the preventative maintenance activity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">preventative maintenance</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003740 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003740">
