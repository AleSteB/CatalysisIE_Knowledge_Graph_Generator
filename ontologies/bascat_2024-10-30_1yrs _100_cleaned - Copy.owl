        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample introduction is a loading of some sample into a system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample introduction</core:prefLabel>
    </owl:Class>
    


