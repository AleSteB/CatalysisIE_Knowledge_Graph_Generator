        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">local system account identifier</rdfs:label>
