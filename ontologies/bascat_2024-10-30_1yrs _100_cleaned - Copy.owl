        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weighing device</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weighing instrument</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weighing device is a measurement device for measuring mass by the gravitational force on earth. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weighing device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000266 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000266">
