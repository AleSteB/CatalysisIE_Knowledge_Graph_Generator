        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electronic absorbance bandwidth setting</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector bandwidth setting</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An electronic absorbance bandwidth setting is an electronic absorbance detector setting parameter that specifies the bandwidth of a particular signal to be measured by the device. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electronic absorbance bandwidth setting</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001254 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001254">
