        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A split inlet is a gas chromatograph inlet followed by a splitter enabling the carrier gas to sweep a part of volatilized sample onto the GC column, with that remaining split/swept to waste. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">split inlet</core:prefLabel>
    </owl:Class>
    


