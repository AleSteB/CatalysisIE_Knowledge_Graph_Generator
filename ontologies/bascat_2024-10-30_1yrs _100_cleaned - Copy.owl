        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LC detector</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A liquid chromatography detector is a detector that is used in liquid chromatography as component of a LC system. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid chromatography detector</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002201 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002201">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000161"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001799"/>
