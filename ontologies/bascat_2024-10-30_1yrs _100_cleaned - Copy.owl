                                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000266"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002186"/>
                            </owl:Restriction>
