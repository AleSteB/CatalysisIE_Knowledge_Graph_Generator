    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000222 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000222">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000068"/>
        <prop:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</prop:AFX_0002798>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Absorption_spectroscopy"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">absorption spectrum</rdfs:label>
