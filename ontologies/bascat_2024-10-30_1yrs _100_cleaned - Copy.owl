        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A specification that specifies a participant in a process by the function it bears in it. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">function specification</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000945 -->

