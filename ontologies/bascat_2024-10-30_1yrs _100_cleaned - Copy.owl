        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">loaded material</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000558 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000558">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000560"/>
