        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An electron capture detector is a measurement component that measures an analyte in a gas stream through the attachment of electrons via electron capture ionization. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electron capture detector</core:prefLabel>
