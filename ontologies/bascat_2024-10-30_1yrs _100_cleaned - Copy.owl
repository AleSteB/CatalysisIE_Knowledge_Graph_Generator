        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nozzle is a transferring device consisting of jet port with an opening for regulating and/or directing the flow of fluid. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nozzle</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002223 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002223">
