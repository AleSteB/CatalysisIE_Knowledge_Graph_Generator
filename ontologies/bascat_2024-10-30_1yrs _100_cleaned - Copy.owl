        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to separate material</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material separation function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material separation function is a function that increases the resolution between two or more material entities. The  to distinction between the entities is usually based on some associated physical quality. [OBI]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to separate material</core:prefLabel>
    </owl:Class>
    


