        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">autosampler injection trigger temperature setting</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autosampler injection trigger temperature setting is a setting that specifies the temperature range for triggering injection. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">autosampler injection trigger temperature setting</core:prefLabel>
    </owl:Class>
    


