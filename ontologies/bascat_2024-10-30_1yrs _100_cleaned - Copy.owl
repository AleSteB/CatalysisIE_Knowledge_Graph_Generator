        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Code scanning is the transformation of data in the representation form of visual machine-readable codes to another form. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">code scanning</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003815 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003815">
