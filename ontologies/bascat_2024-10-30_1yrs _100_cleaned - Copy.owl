        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence detector</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FLD</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-08-09 Moved under measuring device, detection is only secondary. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fluorescence detector is a detector that detects material by way of the measurement of the emitted fluorescence light after excitation with light. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence detector</core:prefLabel>
    </owl:Class>
    


