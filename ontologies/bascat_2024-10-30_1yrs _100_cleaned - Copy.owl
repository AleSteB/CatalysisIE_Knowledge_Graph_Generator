        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measure of the magnitude of the time region in which the process occurs. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">duration</core:prefLabel>
    </owl:Class>
    


