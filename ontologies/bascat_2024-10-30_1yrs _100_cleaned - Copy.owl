        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample (preparation)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample role (preparation) is a role of a portion of material that is prepared for bearing the sample role in an experiment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample role (preparation)</core:prefLabel>
    </owl:Class>
    


