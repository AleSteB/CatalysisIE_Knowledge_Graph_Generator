        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 5 % height</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor by EP</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor by JP-27</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 5 percent height</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 5% height</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tailing factor by USP &lt;621&gt; method</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor using 5% peak height. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 5 % height</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001238 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001238">
