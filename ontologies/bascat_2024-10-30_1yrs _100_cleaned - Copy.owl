        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converting device</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A conversion device is a device that has the function to convert something. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conversion device</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002231 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002231">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000407"/>
