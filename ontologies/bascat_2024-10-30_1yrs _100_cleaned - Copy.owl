        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to store</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">storing function</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To accumulate a flow. [NIST]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A DC electrical battery stores the energy in a flashlight. [NIST]</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to store</core:prefLabel>
    </owl:Class>
    


