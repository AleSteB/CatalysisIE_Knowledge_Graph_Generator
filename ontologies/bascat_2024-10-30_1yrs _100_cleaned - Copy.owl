        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A piece of apparatus, consisting of an eluent supply system, an injection or sampling system, a column containing a swollen gel, a detector and a data acquisition/processing system, that is used to carry out chromatographic separations. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel filtration chromatograph</core:prefLabel>
    </owl:Class>
    


