        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microplate reader measurement result</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The readout from a microplate reader measurement. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microplate reader measurement result</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000632 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000633"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">melting peak</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A melting peak results from energy transfer due to the transition from the solid to the liquid phase. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">melting peak</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000633 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000633">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000647"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transition peak</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transition peak is a peak in the differential scanning calorimetry curve that results from a structural transition of the sample. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transition peak</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000634 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000634">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trend</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trending result</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A trend is the result of a process of trending. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Raman spectroscopy a trend a result based on a collection of spectra. [Allotrope]</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In infrared spectroscopy the intensities of peaks over time can be used to monitor compound concentration increase/decrease of a chemical reaction over time.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trend</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000639 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000639">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000992"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">file</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-05-11 Moved from taxonomy to AFO, different perspective than iao:Document</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A file is a resource for storing information, which is available to a computer program and is usually based on some kind of durable storage. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">file</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000647 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000647">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002013"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry peak</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  differential scanning calorimetry peak is a peak that is the result of a differential scanning calorimetry (DSC) and part of a DSC curve. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry peak</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000682 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000682">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry result</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC result</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The differential scanning calorimetry result is the result of a DSC measurement. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry result</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000694 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000694">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000991"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Prediction"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prediction</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forecast</core:altLabel>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-10 Generalized term. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prediction or forecast is a proposition about a future event. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prediction</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000700 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000700">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fingerprint</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fingerprinting</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fingerprint is a type of or portion of spectrum that has a characteristic structure.  It can be used as a fingerprint for comparison to reference spectra. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infrared spectra are fingerprints. The fingerprint region of an IR spectrum lies between 1500 and 500 cm-1 while a complete IR spectrum normally has a range from 4000 to 500 cm-1. Note that the overlay is synonym for the same activity (fingerprinting).</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fingerprint</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000733 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000733">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000207"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distribution</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A distribution is a collection of frequencies of results of a sample. Each frequency is number of occurrences within a given interval. The distribution can be expressed relatively to the width of the interval. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">distribution</core:prefLabel>
    </owl:Class>
    


