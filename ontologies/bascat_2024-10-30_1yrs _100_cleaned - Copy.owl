        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">linear interpolation algorithm</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Linear interpolation is a method of curve fitting using linear polynomials to construct new data points within the range of a discrete set of known data points. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">linear interpolation algorithm</core:prefLabel>
    </owl:Class>
    


