        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal reference</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The role of some data piece of information that acts as reference for stating relative time. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal reference role</core:prefLabel>
    </owl:Class>
    


