        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A information processing function that generates integrals on numerical data item. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to integrate (math)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000027 -->

