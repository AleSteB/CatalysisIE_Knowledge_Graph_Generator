        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualified transition role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualified transition</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualified transition role is the contextual role of an ion transition that asserts that the transition meets some qualification requirements. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualified transition role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000504 -->

