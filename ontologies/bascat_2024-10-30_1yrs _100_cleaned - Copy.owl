        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared (IR) spectra</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared (IR) spectrum</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared spectra</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of absorbance or transmittance vs. wavelength/wavenumber/frequency obtained by measuring the absorption or transmission of infrared radiation by a sample. [CHMO]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared spectrum</core:prefLabel>
    </owl:Class>
    


