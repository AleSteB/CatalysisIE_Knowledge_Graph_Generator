        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A repeated process is a composite process that has occurrent parts of subprocesses following the same plan. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeated process</core:prefLabel>
    </owl:Class>
    


