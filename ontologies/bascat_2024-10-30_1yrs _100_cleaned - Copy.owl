        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pCO2 is the partial pressure of carbon dioxide dissolved in a solution. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pCO2</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000197 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000197">
