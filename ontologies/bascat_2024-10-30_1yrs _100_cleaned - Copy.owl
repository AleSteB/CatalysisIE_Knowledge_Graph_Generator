        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000353 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000353">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
        <owl:inverseOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000395"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">output of</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is output of</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an output entity such as a material or information object with a process that exists at the end of the process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">output of</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000354 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000354">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
        <owl:inverseOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000399"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">input of</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is input of</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relates an input entity such a material entity or information object with a process that exists at the start of the process. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">input of</core:prefLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000355 -->

    <owl:ObjectProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000355">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <owl:inverseOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000408"/>
        <rdfs:domain rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000090"/>
