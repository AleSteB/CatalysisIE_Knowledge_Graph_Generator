        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-23 Changed pref label. [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-12-208 Changed parent class. [Allotrope]</core:changeNote>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-12-208 Changed pref label, added alt label. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An account to a local computer. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">local system account identifier</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001071 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001071">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
        <prop:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#locality"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locality</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A written name denoting a locality (e.g. city) as part a postal address. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locality</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001072 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001072">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular structure</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A molecular structure is a description of the type and arrangement of the atoms and the direction of bonds linking atoms that constitute a molecule. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular structure</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001073 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001073">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak area</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-07-19 Definition changed. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that quantitates the area enclosed by a peak and the selected baseline. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak area</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001074 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001074">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000278"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000388"/>
                                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001202"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak position</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that denotes the abscissa value of the extrema (maxima or minima) attributed to the peak in a data description function.  The extrema is often determined through a mathematical fitting of measurement signals to eliminate spurious extrema due to noise. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak position</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001075 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001075">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <prop:AFX_0002811 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000276"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width</rdfs:label>
        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-08-01 Changed definition [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet denoting its width at a specified peak height or variance. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001078 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001078">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
        <prop:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#hasStreetAddress"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">street address</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The street address is a location facet of a postal address, that denotes a street. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">street address</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001079 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001079">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000917"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001082"/>
        <prop:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#tel"/>
