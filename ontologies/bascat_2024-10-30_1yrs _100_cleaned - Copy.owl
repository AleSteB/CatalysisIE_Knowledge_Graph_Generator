        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A thermal event is an event where a significant change of some material quality occurs at a temperature of that material or that of its environment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermal event</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003737 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003737">
