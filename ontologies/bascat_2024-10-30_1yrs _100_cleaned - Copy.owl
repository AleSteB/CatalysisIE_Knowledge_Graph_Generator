        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of sampled points</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of points is the total number of points sampled during a measurement. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In a spectrum, the number of points is the total number of peak positions.</core:example>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of quick slope points in UV/VIS</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of sampled points</core:prefLabel>
    </owl:Class>
    


