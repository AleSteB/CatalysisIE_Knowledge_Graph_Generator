    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001209 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001209">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000168"/>
