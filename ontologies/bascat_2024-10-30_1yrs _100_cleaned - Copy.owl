        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dyeing</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coloring</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyeing is the changing of the color of some material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dyeing</core:prefLabel>
    </owl:Class>
    


