        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative response</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative response is a ratio quantification facet that quantifies the ratio of an analytes device response signal to the device response signal of some reference material. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative response</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002761 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002761">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001075"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width at inflection</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak width at inflection is the peak width calculated by the length between its two inflection points. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width at inflection</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002762 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002762">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000941"/>
