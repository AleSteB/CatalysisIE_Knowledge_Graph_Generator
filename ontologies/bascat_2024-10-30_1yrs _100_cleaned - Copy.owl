        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bottom scan</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bottom scan position is a scan position of a plate reader where the detector is below the well plate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bottom scan position (plate reader)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000333 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0000140"/>
