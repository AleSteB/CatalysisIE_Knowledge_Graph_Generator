        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">top scan position (plate reader)</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">top scan</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A top scan position is a scan position of a plate reader where the detector is above the well plate. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">top scan position (plate reader)</core:prefLabel>
    </owl:Class>
    


