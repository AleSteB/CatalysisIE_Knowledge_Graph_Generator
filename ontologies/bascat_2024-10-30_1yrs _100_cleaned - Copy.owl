        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction mixture role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction mixture</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reaction mixture role is a role of a chemical mixture undergoing some chemical reaction. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction mixture role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000535 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003769"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qPCR role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantitative polymerase chain reaction role</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A qPCR role is a role of a material used in a qPCR experiment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qPCR role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000536 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000536">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reporter dye role is the role of a dye in a qPCR experiment that binds to target DNA molecules and is detected via fluorescence when it is cleaved free. The fluorescence signal is proportional to DNA concentration. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000537 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000537">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000022"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Passive reference dye role of a dye in a qPCR experiment to provide a baseline for normalization of the fluorescence signal. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000538 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000538">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quencher dye role is the role of a dye in a qPCR experiment that acts to suppress the fluorescence of a reporter dye in proximity. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000539 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000539">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <term:source rdf:resource="https://en.wikipedia.org/wiki/Coefficient_of_variation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative standard deviation role</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coefficient of variation</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relative standard deviation role is a statistical datum role of a datum that is a standardized measure of dispersion of a probability distribution or frequency distribution. [Wikipedia]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative standard deviation role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000542 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000244"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">purge gas role</rdfs:label>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A purge gas role is a cleaning agent role of a gas used to remove or replace an existing gas. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">purge gas role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000543 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000543">
