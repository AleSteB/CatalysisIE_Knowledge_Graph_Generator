        <core:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-12-04 Fixed flag parent. [Allotrope]</core:changeNote>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shoulder detection enabled setting is a  data processing setting that allows the integration process to interpolate a baseline for the smaller peak of overlapping peaks for the time period specified. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shoulder detection enabled setting (chromatography)</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001695 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001695">
