        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multiple reaction monitoring transition report</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MRM transition report</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A multiple reaction monitoring (MRM) transition report is a report that is summarizing the analysis of a MRM experiment. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multiple reaction monitoring transition report</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001856 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001856">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001583"/>
