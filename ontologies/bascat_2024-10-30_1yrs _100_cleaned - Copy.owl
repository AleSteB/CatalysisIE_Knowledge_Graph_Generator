        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tolerance range</rdfs:label>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accepted deviation</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">allowed deviation</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tolerance</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Range of values of allowed deviation for a given value. [Allotrope]</core:definition>
        <core:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tolerance range of +/- 1 °C of a temperature value.</core:example>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tolerance range</core:prefLabel>
    </owl:Class>
    


