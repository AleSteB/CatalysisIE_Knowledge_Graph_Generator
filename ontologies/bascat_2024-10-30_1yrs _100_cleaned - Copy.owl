        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mass spectrometry role is a role that is realized in mass spectrometry. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mass spectrometry role</core:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000496 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000496">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000100"/>
