        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A column void volume time is the time required for an unretained compound to traverse the column and exit. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">column void volume time</core:prefLabel>
    </owl:Class>
    


