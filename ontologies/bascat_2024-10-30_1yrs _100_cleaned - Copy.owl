        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retention volume is a chromatography peak facet that indicates the acquisition volume at the maximum detector response attributed to the peak (analyte band). [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">retention volume</core:prefLabel>
    </owl:Class>
    


