        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise (EP2.2.46)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise (JP-G20)</core:altLabel>
        <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio (JP-G20)</core:altLabel>
        <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signal-to-noise ratio (EP2.2.46) is a signal-to-noise ratio (peak-to-peak) where the noise is calculated over a period that is a minimum of 20 times the peak width. [Allotrope]</core:definition>
        <core:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">signal-to-noise ratio (EP2.2.46)</core:prefLabel>
    </owl:Class>
    


