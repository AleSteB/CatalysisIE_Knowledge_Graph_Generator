        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The acquisition time is the time when a signal is captured. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquisition time</skos:prefLabel>
    </owl:Class>
    


