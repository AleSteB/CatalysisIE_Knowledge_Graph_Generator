        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatography peak is a peak that results from a detector&apos;s response to the presence of an analyte in the mobile phase eluting from a column in chromatography. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatography peak</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000020 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000020">
