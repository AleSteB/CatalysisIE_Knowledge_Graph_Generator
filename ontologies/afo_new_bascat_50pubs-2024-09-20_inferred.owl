        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl-Fischer titrator</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl Fischer titrator</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Karl-Fischer titrator is a titrator designed for Karl-Fischer titrations. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Karl-Fischer titrator</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002221 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002221">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001703"/>
