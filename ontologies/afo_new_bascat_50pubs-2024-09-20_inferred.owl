        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A packed injector is a GC injector device in which the entire sample aliquot is vaporized and directly introduced onto the column. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">packed injector</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002202 -->

