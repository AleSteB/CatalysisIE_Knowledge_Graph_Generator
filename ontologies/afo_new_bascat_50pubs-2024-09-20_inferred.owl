        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A separate enclosed physical section of a device that can contain other devices. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compartment</skos:prefLabel>
    </owl:Class>
    


