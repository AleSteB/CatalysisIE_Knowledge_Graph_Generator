        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical input role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical input</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;Physical input&quot; is a role of a material or energy that is input in a process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical input role</skos:prefLabel>
    </owl:Class>
    


