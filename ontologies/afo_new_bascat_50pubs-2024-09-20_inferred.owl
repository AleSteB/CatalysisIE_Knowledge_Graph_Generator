        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A degassed sample weight is the sample weight of a sample after it has gone through a degassing process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degassed sample weight</skos:prefLabel>
    </owl:Class>
    


