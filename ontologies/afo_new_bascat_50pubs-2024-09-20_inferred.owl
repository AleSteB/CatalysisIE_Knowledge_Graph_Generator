        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A deviation is a quantification facet that quantifies the absolute or relative difference of an observed value from another value. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deviation</skos:prefLabel>
