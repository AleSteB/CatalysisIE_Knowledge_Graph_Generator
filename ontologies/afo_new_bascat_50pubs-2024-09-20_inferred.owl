        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inlet gas role is the role of the gas led into the system in the dynamic vapor sorption process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inlet gas role (DVS)</skos:prefLabel>
    </owl:Class>
    


