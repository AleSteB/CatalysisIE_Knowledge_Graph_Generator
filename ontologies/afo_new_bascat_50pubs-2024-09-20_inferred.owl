        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement chamber free space volume</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free space</skos:altLabel>
