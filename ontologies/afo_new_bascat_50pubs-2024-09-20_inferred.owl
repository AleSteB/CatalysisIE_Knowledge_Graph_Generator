        <property:AFX_0002796 rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001492"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993.</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proton</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrogen nucleus</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A proton is a nuclear particle of charge number +1, spin quantum number of 1/2 and rest mass of 1.00727647012 u. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proton</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001027 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33253"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36347"/>
        <property:AFX_0002796 rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001222"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC Green Book, 2nd ed., p. 93</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neutron</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neutron is a nuclear particle of zero charge, spin quantum number 1/2 and a mass of 1.00866490414 u. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neutron</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001028 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001028">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
