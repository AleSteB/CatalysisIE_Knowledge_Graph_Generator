        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A drying additive role is the role of a material in a drying process that supports the drying process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">drying additive role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000511 -->

