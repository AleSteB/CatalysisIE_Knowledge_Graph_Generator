        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converting</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Converting is a process that changes from one form of a flow (material, energy, signal) to another. [NIST]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">converting</skos:prefLabel>
    </owl:Class>
    


