        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to produce</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The function to bring something into existence. [Allotrope]</skos:definition>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Only information can be produced in the strict sense, because of physical conservation laws of energy and material, but this is function is a perspective on a system boundaries in the context. [Allotrope]</skos:editorialNote>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to produce</skos:prefLabel>
    </owl:Class>
    


