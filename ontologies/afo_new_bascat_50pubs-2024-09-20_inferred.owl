        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(iff (ProcessBoundary a) (exists (p) (and (Process p) (temporalPartOf a p) (not (exists (b) (properTemporalPartOf b a)))))) // axiom label in BFO2 CLIF: [084-001] </owl:annotatedTarget>
