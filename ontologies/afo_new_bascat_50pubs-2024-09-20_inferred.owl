    <!-- http://purl.obolibrary.org/obo/CHEBI_30212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_30212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36341"/>
        <property:AFX_0002796 rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001492"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Green Book, 2nd ed., p. 93</terms:source>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1996, 68, 2223. &apos;Glossary of terms used in photochemistry (IUPAC Recommendations 1996)&apos; on page 2262</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photon</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A photon is a particle of zero charge, zero rest mass, spin quantum number 1, energy hν and momentum hν/c (h is the Planck constant, ν the frequency of radiation and c the speed of light), carrier of electromagnetic force. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">photon</skos:prefLabel>
    </owl:Class>
    


