        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communication facet</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A facet that is about communication channels. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">communication facet</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001083 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001083">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#Location"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location name</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A location name is a location facet that denotes a geographical place. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location name</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001087 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001087">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000917"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001082"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#hasPostalCode"/>
