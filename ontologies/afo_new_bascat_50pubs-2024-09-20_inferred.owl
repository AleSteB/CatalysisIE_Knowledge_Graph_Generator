        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric conductance is the quality quantification facet that quantifies the reciprocal of a the resistance in a conductor. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric conductance</skos:prefLabel>
    </owl:Class>
    


