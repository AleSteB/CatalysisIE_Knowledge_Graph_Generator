        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material dried</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Material dried role is the drying role of the material being dried. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material dried role</skos:prefLabel>
    </owl:Class>
    


