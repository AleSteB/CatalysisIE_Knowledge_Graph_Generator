        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell path length</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell path length (datum)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">path length</skos:altLabel>
