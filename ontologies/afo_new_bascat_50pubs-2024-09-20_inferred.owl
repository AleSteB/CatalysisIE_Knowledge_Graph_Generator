        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak resolution</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that measures the degree of separation between the peak and another specified peak. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak resolution</skos:prefLabel>
    </owl:Class>
    


