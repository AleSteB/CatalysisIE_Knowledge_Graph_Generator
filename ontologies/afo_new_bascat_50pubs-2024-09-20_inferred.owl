        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A flame photometric detector is a measurement component that measures an analyte in a gas stream through the detection of chemiluminescence as a result of ignition. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flame photometric detector</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002277 -->

