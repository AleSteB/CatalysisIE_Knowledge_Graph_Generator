        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spectroscopy where the sample absorbs radiation in the range ultraviolet to visible (190-800 nm) resulting in electronic transitions within the sample. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet-visible spectrophotometry</skos:prefLabel>
    </owl:Class>
    


