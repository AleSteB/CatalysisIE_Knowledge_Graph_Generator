                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000114"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid foam</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid foam is a colloid where the continuous phase is a solid and the dispersed phase is a gas. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid foam</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001078 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001078">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001031"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid sol</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid sol is a colloid where the continuous phase is a solid and the dispersed phase is a solid. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid sol</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001079 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001079">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003640"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <property:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002798>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Dispersion_(chemistry)"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;Terminology of polymers and polymerization processes in dispersed systems (IUPAC Recommendations 2011)&quot; . Pure and Applied Chemistry. 83 (12): 2229–2259. 2011.</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dispersion</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-07-03 Changed definition to IUPAC recommendation. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dispersions is a heterogeneous mixture that is comprising more than one phase where at least one of the phases consists of finely divided phase domains, often in the colloidal size range, dispersed throughout a continuous phase. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dispersion</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001083 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001083">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001084"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person is a human that is member of a group or organization. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001084 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001084">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24433"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalence with http://purl.obolibrary.org/obo/CHEBI_24433 added automatically</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A group is a an aggregate of people. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001085 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001085">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001090"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <property:AFX_0002808 rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organization</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an agent. [W3C ORG]</skos:definition>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">By this hierarchy organizations are built of physical people, so no pure legal persons can be members of an organization.</skos:editorialNote>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organization</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001086 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001086">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001085"/>
        <owl:disjointWith rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001087"/>
        <property:AFX_0002808 rdf:resource="http://www.w3.org/ns/org#FormalOrganization"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formal organization</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A formal organization is an organization which is recognized in the world at large, in particular in legal jurisdictions, with associated rights and responsibilities. [W3C ORG]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">formal organization</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001087 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001087">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001085"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001086"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <property:AFX_0002808 rdf:resource="http://www.w3.org/ns/org#OrganizationalUnit"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organizational unit</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An organization such as a department or support unit which is part of some larger organization and only has full recognition within the context of that organization. In particular the unit would not be regarded as a legal entity in its own right. [W3C ORG]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organizational unit</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001090 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001090">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001083"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001084"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001085"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organizational entity</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An organizational entity is a person, group or organization that is defined by some social contract between humans. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organizational entity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001095 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001095">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002099"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000154"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002735"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0000812"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000696"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002005"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/gc"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zero grade air</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Zero grade air is air that is purified to contain less than 0.1 ppm of hydrocarbons. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zero grade air</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001096 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001096">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001042"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatographic packing</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatographic packing is a solid heterogeneous mixture consisting of a substrate and stationary phase used in a chromatographic separation. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatographic packing</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001097 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001097">
        <owl:equivalentClass rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC. Compendium of Chemical Terminology, 2nd ed. (the &quot;Gold Book&quot;). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997).</terms:source>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Equivalence with http://purl.obolibrary.org/obo/CHEBI_59999 added automatically</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical substance</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chemical substance is a portion of material that is matter of constant composition best characterized by the entities (molecules, formula units, atoms) it is composed of. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical substance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001099 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001099">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001038"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000365"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Chemical_substance"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical mixture</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixed chemical substances</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixed chemical substances</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of chemical mixture is a chemical substance that is composed of chemical substances. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chemical mixture</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001101 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001101">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000880"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry"/>
