        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transition peak is a peak in the differential scanning calorimetry curve that results from a structural transition of the sample. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transition peak</skos:prefLabel>
    </owl:Class>
    


