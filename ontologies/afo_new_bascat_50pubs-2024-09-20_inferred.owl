        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spectroscopy result</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Result of a spectroscopical measurement. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spectroscopy result</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000761 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000761">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000633"/>
