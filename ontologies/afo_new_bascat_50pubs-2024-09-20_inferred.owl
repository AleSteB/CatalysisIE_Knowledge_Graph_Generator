        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The peak width calculated at 10 % of its peak height. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width at 10 % of height</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002512 -->

