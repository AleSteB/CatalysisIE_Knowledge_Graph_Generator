        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A column brand name is a brand name of a chromatography column that can be based on the brand name of the substrate and its chemistry modification. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">column brand name</skos:prefLabel>
    </owl:Class>
    


