        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sulfur chemiluminescence detector is a measurement component that measures an analyte in a gas stream through the detection of sulfur chemiluminescence when reacting with ozone. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sulfur chemiluminescence detector</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002276 -->

