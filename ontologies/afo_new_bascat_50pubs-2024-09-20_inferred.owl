        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity range</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A range that describes a range of quantity values using the same unit. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity range</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000921 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000921">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000928"/>
