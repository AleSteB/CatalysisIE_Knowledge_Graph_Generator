        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents a collection of observations, possibly organized into various slices, conforming to some common dimensional structure. [QB]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data cube</skos:prefLabel>
    </owl:Class>
    


