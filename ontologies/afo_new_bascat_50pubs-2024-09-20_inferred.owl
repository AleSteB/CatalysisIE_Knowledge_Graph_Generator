        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solvolysis reaction where the solvent material is water.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
