    <!-- http://purl.obolibrary.org/obo/MOP_0000569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000543"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The complete transfer of one or more electrons to a molecular entity.</obo:IAO_0000115>
