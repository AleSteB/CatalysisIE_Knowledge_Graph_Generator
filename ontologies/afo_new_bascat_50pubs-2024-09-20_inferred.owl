        <property:AFX_0002865 rdf:resource="http://purl.allotrope.org/voc/qb/REC/2018/10/cube"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data cube</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DataSet</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data set</skos:altLabel>
