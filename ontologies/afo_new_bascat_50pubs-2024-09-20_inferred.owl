        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002734"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003603"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An assignment is a proposition that is an assertion of some relation between entities. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assignment</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001095 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001095">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">timebase</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A timebase is a description that is about a point in time (process boundary or zero dimensional temporal region) that has the role of a temporal reference. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">timebase</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001100 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001100">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000923"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mathematical facet</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A facet that is part of a mathematical expression, formula or equation. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mathematical facet</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001101 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001101">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000923"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0002849"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantification facet</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity facet</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-04 Changed pref label to be more precise. [Allotrope]</skos:changeNote>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-12-01 Changed definition. [Allotrope]</skos:changeNote>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-03-16 Fixed quantifies some mass. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A facet that is part of a quantification of a quality, aggregate or process. [Allotrope]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantification facet is usually a quantity value or a categorization into some group.  It is described by a numeric value together with a unit or a categorical value. [Allotrope]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantification facet</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001103 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001103">
