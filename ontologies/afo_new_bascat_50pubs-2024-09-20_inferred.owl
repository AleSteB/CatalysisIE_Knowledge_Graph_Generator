        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A information processing function that generates integrals on numerical data item. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to integrate (math)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000027 -->

