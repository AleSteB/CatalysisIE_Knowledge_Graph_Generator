        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant</skos:altLabel>
