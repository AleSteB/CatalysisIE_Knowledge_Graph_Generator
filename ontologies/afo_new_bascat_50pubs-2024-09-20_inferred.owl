        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dynamic vapor sorption role is a role that is realized in some dynamic vapor sorption process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dynamic vapor sorption role</skos:prefLabel>
    </owl:Class>
    


