        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation setting</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation enabled</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation enabled setting</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation flag</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation switch</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An automation flag is a flag that controls whether a process involves an automation system (true) participant alone or involves a human participant (false). [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">manual vs. automatic baseline determination [Allotrope]</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">automation setting</skos:prefLabel>
        <skos:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The automation can refer to subprocesses such as consuming of input, or the production of output or full automation. [Allotrope]</skos:scopeNote>
    </owl:Class>
    


