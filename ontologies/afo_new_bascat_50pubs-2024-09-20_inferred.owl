        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exothermic peak is a differential scanning calorimetry peak resulting from energy transfer from the sample heating cell to the surrounding. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exothermic peak</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000780 -->

