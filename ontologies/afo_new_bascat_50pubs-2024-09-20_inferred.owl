                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003349"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <property:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002798>
