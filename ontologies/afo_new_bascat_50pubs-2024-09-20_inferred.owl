        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample (preparation)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample role (preparation) is a role of a portion of material that is prepared for bearing the sample role in an experiment. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample role (preparation)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000509 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000509">
