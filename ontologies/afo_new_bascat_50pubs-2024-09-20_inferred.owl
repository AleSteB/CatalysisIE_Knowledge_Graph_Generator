        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A monolithic columns is a chromatography column where the stationary phase synthesized in place as a single lattice structure in the column. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monolithic column</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002204 -->

