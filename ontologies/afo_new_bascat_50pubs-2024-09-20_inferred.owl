        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quarks</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ChEBI</oboInOwl:hasDbXref>
