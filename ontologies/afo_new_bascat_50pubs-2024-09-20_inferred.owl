                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002726"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000941"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeated action role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeated action</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repetition role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A repeated action role is a contextual role of an action specification that specifies the repeated action in a repeated action specification. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">repeated action role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000524 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000524">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000022"/>
