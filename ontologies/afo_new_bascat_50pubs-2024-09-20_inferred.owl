        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A gripping device is a device that takes holds of something firmly or tightly. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gripping device</skos:prefLabel>
    </owl:Class>
    


