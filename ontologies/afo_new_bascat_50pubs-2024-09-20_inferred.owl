        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An experiment data identifier is an identifier that identifies some experiment data. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a filename of a file containing the experiment data</skos:example>
