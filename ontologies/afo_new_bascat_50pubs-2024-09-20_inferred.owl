        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative weight loss on drying is a mass fraction that quantifies the relative value of moisture content lost from a material after a drying process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative weight loss on drying</skos:prefLabel>
    </owl:Class>
    


