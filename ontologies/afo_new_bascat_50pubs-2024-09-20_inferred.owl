        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 10 % height</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 10 percent of height</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 10% height</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Added alt label. [Allotrope]</skos:changeNote>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Changed pref label and definition. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor calculated at 10 percent of its peak height. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 10 % height</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002513 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002513">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001177"/>
