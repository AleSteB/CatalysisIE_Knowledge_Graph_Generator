        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A BET point document is a document that encompasses the information associated with a single BET measurement point. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BET point document</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002117 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002117">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001583"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/bet-analysis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative pressure (BET)</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative pressure</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative pressure is a quality quantification facet that quantifies the pressure of a pure substance in a chamber relative to its saturation pressure. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative pressure (BET)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002118 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002118">
