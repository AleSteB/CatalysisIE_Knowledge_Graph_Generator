        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enthalpy of fusion</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enthalpy of fusion (datum)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enthalpy of melting</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enthalpy of melting (datum)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat of fusion</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The enthalpy of fusion datum is quantification of the amount of energy (enthalpy) that must be added to a solid substance, to transform a quantity of that substance into a liquid. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enthalpy of fusion</skos:prefLabel>
    </owl:Class>
    


