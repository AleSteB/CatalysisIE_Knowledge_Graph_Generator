        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas-phase electrophoretic mobility molecular analysis spectrum</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GEMMA spectra</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GEMMA spectrum</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of electrophoretic mobility diameter vs. particle count generated by separating singly-charged complexes in air under the influence of an electric field. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas-phase electrophoretic mobility molecular analysis spectrum</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000304 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000304">
