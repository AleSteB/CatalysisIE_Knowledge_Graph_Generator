        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Luminescence is a quality quantification datum that quantifies the spontaneous emission of radiation from an electronically or vibrationally excited species not in thermal equilibrium with its environment. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">luminescence</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002508 -->

