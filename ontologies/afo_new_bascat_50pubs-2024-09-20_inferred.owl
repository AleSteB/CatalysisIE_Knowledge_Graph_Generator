        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter specification</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A participant specification which specifies an information object that has the contextual role of a parameter in the realized process. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification can include a formal name, a datatype, a shape or range of values if the parameter is a datum.</skos:example>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification is about a parameter. It is a parameter itself only in the context of a specification process.</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter specification</skos:prefLabel>
    </owl:Class>
    


