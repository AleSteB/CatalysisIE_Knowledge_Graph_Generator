        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collecting device</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collecting device is a device that has the function to collect things. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collecting device</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002177 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002177">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000074"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000972"/>
