        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A damper is an inhibition device that deadens, restrains, or depresses. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">damper</skos:prefLabel>
    </owl:Class>
    


