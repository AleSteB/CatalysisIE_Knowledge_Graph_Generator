        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reaction mixture role is a role of a chemical mixture undergoing some chemical reaction. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reaction mixture role</skos:prefLabel>
