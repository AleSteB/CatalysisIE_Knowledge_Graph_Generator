        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evacuation time setting</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An evacuation time setting is a control setting that controls the time when a chamber is to be evacuated. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evacuation time setting</skos:prefLabel>
    </owl:Class>
    


