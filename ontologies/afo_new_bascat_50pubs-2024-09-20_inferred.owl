        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A concentration (datum) is a quantification facet that quantifies a quality inhering in a substance by virtue of the amount of the bearer&apos;s there is mixed with another substance. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">concentration</skos:prefLabel>
    </owl:Class>
    


