        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 2007, 79, 1801 (Definitions of terms relating to the structure and processing of sols, gels, networks, and inorganic-organic hybrid materials (IUPAC Recommendations 2007)) on page 1805</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid aerosol</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid aerosol is an colloid where the continuous phase is a gas and the dispersed phase is a liquid. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">liquid aerosol</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001037 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001037">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001044"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular colloid</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A molecular colloid is a type of colloid that consists of many molecules that combine to structures of colloidal size. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sulphur S8 colloid</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular colloid</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001038 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixed material</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blend</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mixture</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixture</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An portion of mixed material is a material entity that consists of different kinds of grains if you inspect it at a higher level of granularity. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of milk</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sand</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sea water</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sea water with sand</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of mixed material</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001039 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000993"/>
        <property:AFX_0002796 rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001223"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of pure substance</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An portion of pure substance is a material entity that consists of one kind of grains if you inspect it at a higher level of granularity. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solution of distilled water</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of pure substance</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001041 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001041">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001031"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000113"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 2007, 79, 1801 (Definitions of terms relating to the structure and processing of sols, gels, networks, and inorganic-organic hybrid materials (IUPAC Recommendations 2007)) on page 1805</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sol</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sol is a fluid colloidal system of two or more components. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sol</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001042 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001042">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000112"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000386"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001034"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid heterogeneous mixture</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solid heterogeneous mixture is a heterogeneous mixture in solid state. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">solid heterogeneous mixture</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001044 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001044">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001035"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 605</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloid</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloidal system</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A colloid is a homogeneous mixture in which one substance of microscopically dispersed insoluble particles is suspended throughout another substance. A colloid has a dispersed phase (the suspended particles) and a continuous phase (the medium of suspension). The molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between 1 nanometer and 1 micrometer, or in a system discontinuities are found at distances of that order. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">colloid</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001054 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001054">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/X-ray"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray radiation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A form of electromagnetic radiation with a wavelength ranging from 0.01 to 10 nanometers. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">X-ray radiation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001055 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001055">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Light"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible light</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">light</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation which is visible to the human eye and is responsible for the sense of sight. Visible light is usually defined as having wavelengths in the range of 400-700 nanometers. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">visible light</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001056 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001056">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Ultraviolet"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet radiation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UV</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet light</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An electromagnetic radiation with a wavelength from 10 nm to 400 nm. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet radiation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001057 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001057">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Infrared"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared radiation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IR</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared light</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation with longer wavelengths than those of visible light. It extends from the nominal red edge of the visible spectrum at 700 nanometer, to 1  micrometers. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">infrared radiation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001058 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001058">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000888"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Gamma_ray"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma radiation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma ray</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">γ-ray</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation of a kind arising from the radioactive decay of atomic nuclei and having wavelengths less than 10 picometers. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gamma radiation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001059 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002577"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural system</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system that can be discovered in nature. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural system</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001060 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001060">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <owl:disjointWith rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001061"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of compound</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compound</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain only the same kind of molecules, ignoring minor impurities. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of tablesugar</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of water</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of compound</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001061 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001061">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of element</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">element</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain only the same kind of atoms, ignoring minor impurities. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of gold</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of helium</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of element</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001064 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001064">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001039"/>
        <owl:disjointWith rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001097"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of bulk stuff</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A portion of material that has grain some multi-molecular objects or particles. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bag of nuts</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">packet of rice</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of bulk stuff</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/material#AFM_0001065 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/material#AFM_0001065">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0000012"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000114"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000271"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHMO_0000993"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000114"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000272"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas mixture</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A gas mixture is a solution where the continuous phase is a gas and the dispersed phase is a gas. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">air</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gas mixture</skos:prefLabel>
