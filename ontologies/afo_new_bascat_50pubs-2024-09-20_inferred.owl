        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle sizing result</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A particle sizing result is the outcome of a process of particle sizing. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particle sizing result</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000754 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000754">
