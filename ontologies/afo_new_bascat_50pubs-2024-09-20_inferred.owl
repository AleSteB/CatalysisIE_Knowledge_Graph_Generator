        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To sample is the function of to take parts or partitions of an object aggregate or data set for the interest for studying it. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to sample</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000203 -->

