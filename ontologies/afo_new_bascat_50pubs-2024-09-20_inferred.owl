        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">separation column</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A separation column is a separation device of columnar shape where the separation occurs inside the column. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">separation column</skos:prefLabel>
