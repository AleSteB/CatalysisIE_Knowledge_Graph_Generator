        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pressure is a quality quantification facet that quantifies the mount of force exerted per unit area. [PATO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure</skos:prefLabel>
    </owl:Class>
    


