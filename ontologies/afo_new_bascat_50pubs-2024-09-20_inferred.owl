        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat transfer fluid</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A role of a material that acts as a heat sink as it undergoes a phase change. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coolant role</skos:prefLabel>
    </owl:Class>
    


