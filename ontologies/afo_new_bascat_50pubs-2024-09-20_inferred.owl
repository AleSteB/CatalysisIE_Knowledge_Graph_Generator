        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tuple is a finite ordered list (sequence) of elements. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tuple</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001054 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Mathematical_object"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mathematical object</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abstract object</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mathematical object is an information content entity that is an abstraction in the area of mathematics. It has a formal definition that allows for deductive reasoning and mathematical proofs. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mathematical object</skos:prefLabel>
    </owl:Class>
    


