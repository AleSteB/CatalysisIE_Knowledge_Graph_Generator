        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To count cells is the function to count cells. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to count cells</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000201 -->

