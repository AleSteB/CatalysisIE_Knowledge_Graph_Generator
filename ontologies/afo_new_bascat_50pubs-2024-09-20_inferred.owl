        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum value exclusive</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000672 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000672">
