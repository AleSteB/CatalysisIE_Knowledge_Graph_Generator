        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A changing role is a role realized in some cooling process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cooling role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000506 -->

