        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to maintain</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000195 -->

