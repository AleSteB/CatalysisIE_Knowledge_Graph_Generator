        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A strain is a quality quantification facet that quantifies the magnitude of deformation representing the displacement between particles in the body relative to a reference length. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">strain</skos:prefLabel>
    </owl:Class>
    


