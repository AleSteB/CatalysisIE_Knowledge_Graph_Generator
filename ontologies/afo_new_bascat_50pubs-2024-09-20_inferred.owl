    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002806 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002806">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001177"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak symmetry factor measured at 5 % peak height</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak symmetry factor measured at 5% peak height</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatography peak facet equivalent to the ratio of the time or volume from the center point of a peak to its fronting edge divided by the entire width of the peak at 5% of the peak height. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak symmetry factor measured at 5 % peak height</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002807 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002807">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001239"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of theoretical plates by peak width at half height (JP14)</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of theoretical plates by JP14 method</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The number of theoretical plates calculated based on the peak width measured at half height, adjusted to use 5.55 as the square of the standard deviation in accordance with JP14. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number of theoretical plates by peak width at half height (JP14)</skos:prefLabel>
        <skos:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Japanese Pharmacopeia previously required use of a different constant value to the one currently used in alignment with European Pharmacopeia for the square of the standard deviation in this method. This term represents results calculated using that alternate constant value.</skos:scopeNote>
    </owl:Class>
    


