        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">person name</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-10 Moved under written name [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A personal name is a name that is composed of a set of names by which an individual is known. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">personal name</skos:prefLabel>
