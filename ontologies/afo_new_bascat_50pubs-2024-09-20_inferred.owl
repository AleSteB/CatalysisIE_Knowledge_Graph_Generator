        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000072"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prescription</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">directive</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rule</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prescription is a proposition that is about some social rules that are imposed on the use of some entity, that a member of the social community has to follow. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prescription</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002520 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002520">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001177"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">density of theoretical plates (chromatography)</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plate density</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A density of theoretical plates (chromatography) is a chromatography peak facet that measures the amount of band broadening normalized per length unit that occurs during the separation and thus the efficiency of the chromatographic system. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">density of theoretical plates (chromatography)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002521 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002521">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001101"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001177"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001583"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002816"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
