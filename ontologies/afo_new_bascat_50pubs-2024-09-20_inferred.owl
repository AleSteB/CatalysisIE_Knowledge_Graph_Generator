        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A minimum peak detection slope setting is a data processing setting that defines the minimum slope of the signal (rate of change of the signal per acquisition time) at or above which the start of a peak is detected. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum peak detection slope setting (chromatography)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002812 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002812">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001843"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">void volume</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">V0</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interparticle volume of the column</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interstitial volume</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A void volume is the volume occupied by the mobile phase between the particles in the packed section of a column. [IUPAC]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In gas chromatography, the symbol V_G may be used for the interparticle volume of the column. In the ideal case, neglecting any extra-column volume, V_G is equal to the corrected gas hold-up volume (V0_M).
V_G = V0_M = V_M
[IUPAC]</skos:note>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In liquid chromatography, the interparticle volume is equal to the mobile-phase hold-up volume (V_M) in the ideal case, neglecting any extra-column volume. [IUPAC]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">void volume</skos:prefLabel>
    </owl:Class>
    


