        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A presence/absence qPCR experiment is an experiment using qPCR that identifies if DNA targets are present in samples. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presence/absence qPCR experiment</skos:prefLabel>
    </owl:Class>
    


