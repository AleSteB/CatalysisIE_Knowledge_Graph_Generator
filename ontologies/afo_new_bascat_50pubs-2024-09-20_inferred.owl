        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interpolation is the constructing new data points within the range of a discrete set of known data points. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interpolation</skos:prefLabel>
    </owl:Class>
    


