        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1984, 56, 231. (Nomenclature, symbols, units and their usage in spectrochemical analysis-Part VI: molecular luminescence spectroscopy)</terms:source>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1994, 66, 2513. (Nomenclature for radioanalytical chemistry (IUPAC Recommendations 1994))</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence (datum)</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-09-14 Moved from deprecated term AFR_0002500 to replacement AFR_0002507</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fluorescence is a quality quantification facet that quantifies the luminescence which occurs essentially only during the irradiation of a substance by electromagnetic radiation. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescence</skos:prefLabel>
    </owl:Class>
    


