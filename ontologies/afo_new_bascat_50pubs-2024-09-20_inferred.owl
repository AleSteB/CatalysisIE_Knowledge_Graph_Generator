        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An overlay of scans is a graphic overlay of generated spectra for comparison. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overlay of scans</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000776 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000776">
