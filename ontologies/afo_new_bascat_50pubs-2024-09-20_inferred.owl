        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The nick name is a written name of person that is a substitute for the proper name of a familiar person, place, or thing - commonly used for affection. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nick name</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001508 -->

