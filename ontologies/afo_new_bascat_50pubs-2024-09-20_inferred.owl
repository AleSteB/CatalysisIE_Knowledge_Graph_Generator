    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000536 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000536">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reporter dye role is the role of a dye in a qPCR experiment that binds to target DNA molecules and is detected via fluorescence when it is cleaved free. The fluorescence signal is proportional to DNA concentration. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reporter dye role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000537 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000537">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000022"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Passive reference dye role of a dye in a qPCR experiment to provide a baseline for normalization of the fluorescence signal. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive reference dye role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000538 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000538">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000535"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/qpcr"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quencher dye role is the role of a dye in a qPCR experiment that acts to suppress the fluorescence of a reporter dye in proximity. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quencher dye role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000539 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000539">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Coefficient_of_variation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative standard deviation role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coefficient of variation</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relative standard deviation role is a statistical datum role of a datum that is a standardized measure of dispersion of a probability distribution or frequency distribution. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative standard deviation role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000542 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000244"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">purge gas role</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A purge gas role is a cleaning agent role of a gas used to remove or replace an existing gas. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">purge gas role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000543 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000543">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000544"/>
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000545"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000091"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000091"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <property:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product role (economic)</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A product role (economic) is a general role of some continuant that is produced for the purpose of sale. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">product role (economic)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000544 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000544">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000166"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000543"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">information product role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">data product</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">information product</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An information product role is a contextual role of some information content entity that is produced for the purpose of sale. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">information product role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000545 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000545">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000543"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50906"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical product role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material product</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material product role</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical product</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A physical product role is a role of some artifact that is produced for the purpose of sale. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical product role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000546 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000546">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000281"/>
        <property:AFX_0002818 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002818>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">z-coordinate role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">applicate</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-17 Changed pref label. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The z-coordinate role is the Cartesian coordinate in the third dimension of a 3-dimensional Cartesian coordinate system. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">z-coordinate role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000547 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000547">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000293"/>
        <property:AFX_0002808 rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002743"/>
        <terms:license rdf:resource="http://purl.allotrope.org/voc/iupac-license"/>
        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PAC, 1989, 61, 1657 (Nomenclature for automated and mechanised analysis (Recommendations 1989))</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrix role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrix</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medium role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The matrix are the components of a sample other than the analyte. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">matrix role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000549 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000549">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000551"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003813"/>
            </owl:Restriction>
        </rdfs:subClassOf>
