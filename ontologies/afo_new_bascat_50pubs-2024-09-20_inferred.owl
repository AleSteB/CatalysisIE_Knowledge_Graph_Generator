        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To make something known to the user about a flow. [NIST]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small window in the water container of a coffee maker indicates the level of water in the machine. [NIST]</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to indicate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000014 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000014">
