        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified action</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified action is the role of information object that specifies an activity. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified action</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000067 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000067">
