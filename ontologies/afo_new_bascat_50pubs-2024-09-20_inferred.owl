    <!-- http://purl.obolibrary.org/obo/CHEBI_13193 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_13193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_17654"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A molecular entity that can undergo reduction by the gain of hydrogen atom(s).</obo:IAO_0000115>
        <chebi:formula rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R</chebi:formula>
        <chebi:smiles rdf:datatype="http://www.w3.org/2001/XMLSchema#string">*</chebi:smiles>
