        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor using the third statistical moment calculated from the peak. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical skew (chromatography)</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001239 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001239">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001177"/>
