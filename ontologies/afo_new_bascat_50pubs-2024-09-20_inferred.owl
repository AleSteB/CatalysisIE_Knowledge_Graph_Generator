        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A piece of apparatus used to measure a spectrum by illumination with light. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optical spectrometer</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000471 -->

