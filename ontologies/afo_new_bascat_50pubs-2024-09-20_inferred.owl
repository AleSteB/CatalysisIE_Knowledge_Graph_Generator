        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance scan result</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An impedance scan result is an assay result that is the output of processing an impedance spectrum. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impedance scan result</skos:prefLabel>
