        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection function</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The function of a device realized when administering a substance applied particularly to the forcible insertion of a liquid or gas by means of a syringe, pump, etc. [OBI]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to inject</skos:prefLabel>
    </owl:Class>
    


