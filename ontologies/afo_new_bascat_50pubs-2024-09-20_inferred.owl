                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001622"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample pan role</rdfs:label>
