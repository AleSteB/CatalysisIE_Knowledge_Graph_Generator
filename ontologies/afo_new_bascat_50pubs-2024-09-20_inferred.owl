    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001993 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001993">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0002023"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">container state description</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Container state description is a state facet that describes the state of the container used in the measurement run. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A container state can be opened or closed. [Allotrope]</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">container state description</skos:prefLabel>
        <skos:scopeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The container&apos;s material is not a container state. [Allotrope]</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001995 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001995">
