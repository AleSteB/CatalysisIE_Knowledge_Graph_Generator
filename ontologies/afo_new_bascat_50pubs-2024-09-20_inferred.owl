        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel filtration chromatograph</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GPC</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel permeation chromatograph</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A piece of apparatus, consisting of an eluent supply system, an injection or sampling system, a column containing a swollen gel, a detector and a data acquisition/processing system, that is used to carry out chromatographic separations. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gel filtration chromatograph</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000462 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000462">
