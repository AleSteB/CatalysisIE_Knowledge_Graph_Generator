        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Condition role is a contextual role of an information object that specifies a prerequisite. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">condition role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000005 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000005">
