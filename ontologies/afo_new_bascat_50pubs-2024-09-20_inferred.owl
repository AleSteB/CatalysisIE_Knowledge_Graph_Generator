        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An equilibration time is an elapsed time required to reach an equilibrium state after a perturbation. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">equilibration time</skos:prefLabel>
