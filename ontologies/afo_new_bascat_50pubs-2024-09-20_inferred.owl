    <!-- http://purl.allotrope.org/ontologies/property#AFX_0001166 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0001166">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/relation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has class</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relation to a class of individuals. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has class</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002796 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002796">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has granularity</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property specifies level of granularity the term mainly belongs to. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has granularity</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002798 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002798">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is defined class</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is defined class flags a resource as being a class that can be defined by necessary and sufficient conditions. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is defined class</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002808 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002808">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has close match</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has close match establishes a connection between two resources that have a high degree of agreement in meaning such that they can be used interchangeably. [Allotrope]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property is related to skos:closeMatch. skos:closeMatch is an object property whereas this property is an annotation property to allow for weak semantic coupling. [Allotrope]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has close match</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002809 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002809">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has exact match</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has exact match establishes a connection between two resources that have completely same meaning such that they can be used interchangeably. [Allotrope]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property is related to skos:exactMatch. skos:exactMatch is an object property whereas this property is an annotation property to allow for weak semantic coupling. [Allotrope]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has exact match</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002811 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002811">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has related</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has related establishes a connection between two resources that have an associative relationship. [Allotrope]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Property is related to skos:related. Skos:related is an object property whereas this property is an annotation property to allow for weak semantic coupling. [Allotrope]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has related</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002815 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002815">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has perspective</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reference that maps a class to a perspective. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has perspective</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002818 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002818">
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is universal class</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is universal class flags a resource as being a primitive class that stands on its own. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is universal class</skos:prefLabel>
    </owl:AnnotationProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0002865 -->

    <owl:AnnotationProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0002865">
        <property:AFX_0002808 rdf:resource="http://purl.org/pav/importedFrom"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/curation"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imported from</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-12-15 Property has been added in order to replace pav:importedFrom. The difference between af-x:AFX_0002865 and pav:importedFrom is that the former is an annotation property whereas the latter is an object property. We added a new property in order to avoid issues of redeclaration of pav:importedFrom as annotation property. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The original source of imported information. [PAV]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">imported from</skos:prefLabel>
    </owl:AnnotationProperty>
    


