        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak group</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-07-19 Changed definition, relaxed restriction. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak group is a user defined set of peaks for which summed peak facet data is expected. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A common example is for alkanes such as heptanes.  Often all of the isomers (C7H16, CH3CH2(CH3)C4H10, C2H5CH2(CH3)C3H8, CH3CH2(CH2CH3)C3H8, etc) are reported as a single value.</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sum of all peak areas in the group.</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak group</skos:prefLabel>
    </owl:Class>
    


