        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mass spectrometry system is a measuring system that is designed and assembled to realize the measurement function by way of mass spectrometry. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mass spectrometry system</skos:prefLabel>
    </owl:Class>
    


