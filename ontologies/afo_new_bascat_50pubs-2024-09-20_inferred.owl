        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to clean</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cleaning function</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The material processing function to get rid of dirt, impurities, or extraneous unwanted matter. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to clean</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000030 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000030">
