        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material separation function which is realized by chromatography. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to separate material by chromatography</skos:prefLabel>
