        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorting</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sorting is distributing flows based on some associated physical quality or entity into distinct fractions according to a defined order. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sorting</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003574 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003574">
