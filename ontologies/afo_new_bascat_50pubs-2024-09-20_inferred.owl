        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromatogram is a distribution function of a detector signal (such as ion count or absorbance) versus time of acquisition or versus volume of analyte. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatogram</skos:prefLabel>
    </owl:Class>
    


