        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An evacuation rate setting is a control setting that controls the evacuation rate. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evacuation rate setting</skos:prefLabel>
    </owl:Class>
    


