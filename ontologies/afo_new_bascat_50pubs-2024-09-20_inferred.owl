        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To discover information about the presence of a flow. [NIST]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A gauge on the top of a gas cylinder detects proper pressure ranges. [NIST]</skos:example>
