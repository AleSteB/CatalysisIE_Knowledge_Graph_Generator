    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001280">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001277"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002801"/>
