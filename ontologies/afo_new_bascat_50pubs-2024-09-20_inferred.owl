        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shifting function</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to convey</skos:altLabel>
