        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A read is a process boundary within a measuring where a data about the measured object is captured. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A read at regular time intervals during the measurement of a process profile. [Allotrope]</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multiple reads for statistics and error corrections. [Allotrope]</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read</skos:prefLabel>
    </owl:Class>
    


