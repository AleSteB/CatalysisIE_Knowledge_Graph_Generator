        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass transition peak</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A glass transition peak is a peak of the differential scanning calorimetry curve that results from the glass transition of a sample. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glass transition peak</skos:prefLabel>
    </owl:Class>
    


