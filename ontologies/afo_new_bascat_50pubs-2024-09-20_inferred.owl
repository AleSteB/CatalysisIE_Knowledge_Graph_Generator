        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of absorbance vs. wavelength obtained by measuring the amount of radiation absorbed by a sample as a function of the wavelength of incident radiation from the ultraviolet region (190-400 nm) range. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ultraviolet spectrum</skos:prefLabel>
    </owl:Class>
    


