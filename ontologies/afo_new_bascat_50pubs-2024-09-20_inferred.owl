        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A plot of emission vs. wavelength obtained through a Fourier transform of the time series of the radiation emitted by a sample of gas phase molecules that have been excited by a microwave-frequency pulse. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">microwave spectrum</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000023 -->

