        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peak separation is a data transformation that allows to distinguish between two peaks. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak separation</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0000983 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0000983">
