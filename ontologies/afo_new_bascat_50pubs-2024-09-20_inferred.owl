    <!-- http://purl.allotrope.org/ontologies/result#AFR_0000937 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0000937">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
