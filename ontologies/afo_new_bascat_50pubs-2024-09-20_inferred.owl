        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nitrogen chemiluminescence detector is a measurement component that measures an analyte in a gas stream through the detection of nitrogen chemiluminescence. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nitrogen chemiluminescence detector</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002275 -->

