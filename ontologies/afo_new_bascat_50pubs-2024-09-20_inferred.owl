        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An expected qualifier transition ratio is a qualifier transition ratio that has the contextual role of an expected datum. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">expected qualifier transition ratio</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001876 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001876">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001873"/>
