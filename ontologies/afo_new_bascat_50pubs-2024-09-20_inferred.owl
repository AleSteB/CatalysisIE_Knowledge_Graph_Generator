        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A column void volume time is the time required for an unretained compound to traverse the column and exit. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">column void volume time</skos:prefLabel>
    </owl:Class>
    


