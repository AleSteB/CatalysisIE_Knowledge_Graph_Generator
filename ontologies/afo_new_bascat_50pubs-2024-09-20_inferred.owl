        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An evaporative light scattering detector is a detector that detects material by way of the measurement of the scattering of light after nebulization with an inert carrier gas and evaporation of the solvent. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evaporative light scattering detector</skos:prefLabel>
    </owl:Class>
    


