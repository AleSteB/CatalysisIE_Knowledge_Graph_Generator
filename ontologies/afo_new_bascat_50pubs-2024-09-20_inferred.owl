        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nozzle is a transferring device consisting of jet port with an opening for regulating and/or directing the flow of fluid. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nozzle</skos:prefLabel>
    </owl:Class>
    


