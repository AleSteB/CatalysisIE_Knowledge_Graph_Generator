        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relative permittivity result is a quality quantification facet that quantifies the the ability of a medium composed of molecules of a given type to transmit an electric field. [CHEMINF]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Relative permittivity is a chemical substance quality that reflects the ability of a medium composed of molecules of a given type to transmit an electric field.</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relative permittivity</skos:prefLabel>
    </owl:Class>
    


