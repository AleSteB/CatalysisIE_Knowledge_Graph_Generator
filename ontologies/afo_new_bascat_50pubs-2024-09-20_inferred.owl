        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To stir is a mixing function involving the agitation of a solution through circular motion. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to stir</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000206 -->

