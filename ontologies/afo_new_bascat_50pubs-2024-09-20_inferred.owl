        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000675 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000675">
