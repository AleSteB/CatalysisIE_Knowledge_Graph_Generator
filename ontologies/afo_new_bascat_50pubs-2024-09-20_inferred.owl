        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">homo sapiens</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human being</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">man</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A member of the the species Homo sapiens. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">human</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_C142533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C142533">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001963"/>
        <property:AFX_0002865 rdf:resource="http://purl.obolibrary.org/obo/ncit.owl"/>
