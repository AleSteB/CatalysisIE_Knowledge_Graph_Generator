        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">power (datum)</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power is a quality quantification facet that quantifies the rate of doing work. [PATO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">power</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001918 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001918">
