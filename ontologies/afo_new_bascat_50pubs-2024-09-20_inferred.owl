    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0000979 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0000979">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0000307"/>
