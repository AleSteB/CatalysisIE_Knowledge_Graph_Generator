        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing support</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizing support role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nebulizer support role is a support role in converting liquid into aerosol mist. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nebulizer support role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000510 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000510">
