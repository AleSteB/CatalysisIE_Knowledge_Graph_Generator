        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to decompose</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decomposition function</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To decompose is the function to breakdown a single phase into two or more phases by heating or treatment with acid, alkali or enzymes. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to decompose</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000186 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000186">
