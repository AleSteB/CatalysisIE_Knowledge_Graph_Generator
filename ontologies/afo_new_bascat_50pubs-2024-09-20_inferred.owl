        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration certificate identifier</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002065 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002065">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001844"/>
