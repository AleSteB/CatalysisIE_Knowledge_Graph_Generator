        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measuring system is a device system which has the designed function of measurement. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measuring system</skos:prefLabel>
    </owl:Class>
    


