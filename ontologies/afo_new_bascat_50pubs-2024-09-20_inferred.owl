            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/pumping"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pump system</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-03-24 Add restrictions. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system intended for pumping. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pump system</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002184 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002184">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://jcgm.bipm.org/vim/en/3.8.html</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor is a component of a measuring system that is directly affected by a phenomenon, body, or substance carrying a quantity to be measured. [Allotrope]</skos:definition>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensor can be a measuring device on its own, but is typically a part of it.</skos:editorialNote>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensor</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002185 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002185">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002145"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement component</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement module</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement component is a component of a measuring system, that does measuring. [Allotrope]</skos:definition>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The criteria is compromise. Some measurement components can be fully standalone measurement devices used in a component role, but are not typically used as such. A UV spectrometer is an electromagnetic absorbance measuring instrument and an elecctromagnetic absorbance detector has the same function, but it is used as part of a larger system, such as a HPLC-UV system.</skos:editorialNote>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement component</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0002186 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0002186">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000939"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000266"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0000354"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/injection"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device component</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An injection device  component is a component of an injection device. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">injection device component</skos:prefLabel>
    </owl:Class>
    


