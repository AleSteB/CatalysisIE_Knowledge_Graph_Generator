        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reference pan role is the role of the measurement pan realized in a DSC measurement that is without sample content. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference pan role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000525 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000525">
