        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A spatial process of removing a material from a site. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">removing material</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/process#AFP_0003575 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/process#AFP_0003575">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003275"/>
