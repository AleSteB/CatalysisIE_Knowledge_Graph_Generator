        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To remove material is the function to remove material. [NIST]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to remove material</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000185 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000009"/>
