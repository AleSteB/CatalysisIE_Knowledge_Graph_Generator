        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum value</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lowest value of a range of literals. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum value</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000671 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000671">
        <rdfs:subPropertyOf rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000670"/>
