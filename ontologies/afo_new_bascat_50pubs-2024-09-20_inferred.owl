        <merged-without-qudt-and-inferred:mentions rdf:resource="http://www.semanticweb.org/ontologies/2023/11/new_onto.owl#DC_1111"/>
        <merged-without-qudt-and-inferred:mentions rdf:resource="http://www.semanticweb.org/ontologies/2023/11/new_onto.owl#DC_1112"/>
