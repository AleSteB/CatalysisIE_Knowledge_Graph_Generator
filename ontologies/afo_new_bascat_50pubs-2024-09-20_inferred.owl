        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/material#AFM_0001083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/familyName"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#family-name"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Surname</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">family name</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">last name</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">surname</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-10 Moved under written name [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A family name is a name that is the portion (in some cultures) of a personal name that indicates a person&apos;s family (or tribe or community, depending on the culture). [Wikipedia]</skos:definition>
        <skos:editorialNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The family name is provided (alongside given name) for use when describing parts of people&apos;s names. Although these concepts do not capture the full range of personal naming styles found world-wide, they are commonly used and have some value. [FoaF]</skos:editorialNote>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">family name</skos:prefLabel>
    </owl:Class>
    


