        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">voltage (datum)</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Voltage is a quality quantification facet which quantifies the difference in electric potential energy between two points per unit electric charge. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">voltage</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001917 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001917">
