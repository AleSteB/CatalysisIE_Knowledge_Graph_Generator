        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A heat transfer coefficient is a quality quantification facet that quantifies the proportionality constant between the heat flux and the thermodynamic driving force for the flow of heat. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat transfer coefficient</skos:prefLabel>
    </owl:Class>
    


