        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement chamber free space (datum)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement chamber free space volume (datum)</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement chamber free space result is a quality quantification facet that quantifies the volume of a sample chamber not occupied by the sample. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement chamber free space volume</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002128 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002128">
