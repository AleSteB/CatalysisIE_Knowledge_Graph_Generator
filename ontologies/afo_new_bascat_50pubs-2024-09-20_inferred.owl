        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A needle is a device consisting of a very thin, hollow tube with a sharp tip which contains a small opening at the pointed end. It is commonly used with a syringe. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">needle</skos:prefLabel>
    </owl:Class>
    


