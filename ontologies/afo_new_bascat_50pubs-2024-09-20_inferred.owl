                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000273"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996)&quot;, Lehmann, H.P.;Fuentes-arderiu, X.;Bertello, L.F., Pure and Applied Chemistry 1996, 68(4), 957</terms:source>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC. Compendium of Chemical Terminology, 2nd ed. (the &quot;Gold Book&quot;). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997)</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric charge</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">charge</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric charge is the quality quantification facet that quantifies the integral of electric current over time. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric charge</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002112 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002112">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001982"/>
