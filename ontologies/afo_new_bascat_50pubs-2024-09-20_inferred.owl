    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000196 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000196">
        <owl:equivalentClass>
