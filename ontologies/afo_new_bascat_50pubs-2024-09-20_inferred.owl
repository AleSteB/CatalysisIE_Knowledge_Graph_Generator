        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 % height</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 percent height</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4% height</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-11-28 Changed pref label, added alt label. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quantitative asymmetry factor equivalent to the ratio of the time or volume from the center point of a peak to its trailing edge to that of its fronting edge at 4.4 % of the peak height. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">asymmetry factor measured at 4.4 % height</skos:prefLabel>
    </owl:Class>
    


