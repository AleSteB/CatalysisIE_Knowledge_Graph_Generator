        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum value exclusive</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The highest value of a range excluding the boundary value. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum value exclusive</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.allotrope.org/ontologies/property#AFX_0000676 -->

    <owl:DatatypeProperty rdf:about="http://purl.allotrope.org/ontologies/property#AFX_0000676">
