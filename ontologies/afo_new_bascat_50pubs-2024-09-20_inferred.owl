        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A minimum qualifier transition ratio is a qualifier transition ratio that species a minimum allowed qualified transition ratio. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">minimum qualifier transition ratio</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001877 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001877">
