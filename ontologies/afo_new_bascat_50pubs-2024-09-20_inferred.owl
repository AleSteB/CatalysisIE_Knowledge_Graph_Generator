        <chebi:smiles rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[NH3+]C([*])C([O-])=O</chebi:smiles>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:83409</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MetaCyc:Alpha-Amino-Acids</oboInOwl:hasDbXref>
