        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chord selection setting</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chord selection setting is a control setting for a FBRM run that optimizes the analysis for small primary particles or larger agglomerates. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chord selection setting</skos:prefLabel>
    </owl:Class>
    


