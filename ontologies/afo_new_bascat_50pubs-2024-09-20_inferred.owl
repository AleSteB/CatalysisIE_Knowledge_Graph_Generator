        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak extremum point</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001209 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001209">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000168"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001852"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/common#AFC_0000168"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                        <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000325"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Statistical_population"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical population</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population (statistics)</skos:altLabel>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-08-19 Moved under statistical facet. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In statistics, a population is a set of similar items or events which is of interest for some question or experiment. A statistical population can be a group of existing objects or a hypothetical and potentially infinite group of objects conceived as a generalization from experience. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statistical population</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001210 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001210">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000168"/>
