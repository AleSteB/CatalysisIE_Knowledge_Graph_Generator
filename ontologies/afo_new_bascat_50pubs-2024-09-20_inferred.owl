        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dry gas role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dry gas role is the role of the gas devoid of the vapor in the dynamic vapor sorption process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dry gas role (DVS)</skos:prefLabel>
    </owl:Class>
    


