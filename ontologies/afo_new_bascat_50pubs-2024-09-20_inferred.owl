        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any piece of apparatus used to detect an analyte. [CHMO]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0000322 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0000322">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0001028"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/spatial#AFSP_0000005"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/spatial#AFSP_0000007"/>
