    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002286 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002286">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001060"/>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/BET_theory"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/bet-analysis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BET plot</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brunauer–Emmett–Teller plot</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A BET plot is a data distribution function of an adsorption isotherm with 1/v[(p0/p)-1] on the y-axis and p/p0 on the x-axis, where p is equilibrium pressure and p0 saturation pressure of adsorbates at the temperature of adsorption, and v is the adsorbed gas quantity. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BET plot</skos:prefLabel>
    </owl:Class>
    


