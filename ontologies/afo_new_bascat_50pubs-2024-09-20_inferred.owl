        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">maximum qualifier transition ratio</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001878 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001878">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001871"/>
