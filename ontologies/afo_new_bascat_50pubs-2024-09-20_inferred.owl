        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type specification</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type specification is a specification of a collection of things by the members of that collection being classified as instance of a class or concept, often with additional constraints. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a SHACL node shape.</skos:example>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the humans that live in Berlin.</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type specification</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001286 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001286">
