        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">enumerated value</skos:prefLabel>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt#Quantity -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt#Quantity">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001101"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quantity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt#QuantityKind -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt#QuantityKind">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000916"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002806"/>
