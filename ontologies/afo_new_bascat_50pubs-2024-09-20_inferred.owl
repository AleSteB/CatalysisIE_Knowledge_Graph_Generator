        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatography system setting</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A parameter specification specific to a chromatography system. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chromatography system setting</skos:prefLabel>
    </owl:Class>
    


