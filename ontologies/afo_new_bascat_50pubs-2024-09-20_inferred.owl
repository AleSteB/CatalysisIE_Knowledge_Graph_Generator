        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement mode setting is a control setting that specifies the measurement mode of some measurement process. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MS1, MRM, SIM, PIM, or SRM in mass spectrometry, and qf, qsim, qseq, or DQD in NMR.</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement mode setting</skos:prefLabel>
    </owl:Class>
    


