        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal reference</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The role of some data piece of information that acts as reference for stating relative time. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal reference role</skos:prefLabel>
    </owl:Class>
    


