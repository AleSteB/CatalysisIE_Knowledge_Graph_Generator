        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electric resistivity is the is the quality quantification facet that quantifies the electric field strength divided by the current density when there is no electromotive force in a conductor. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electric resistivity</skos:prefLabel>
    </owl:Class>
    


