        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DSC role</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A differential calorimetry role is a role of a material entity realized in a differential scanning calorimetry process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">differential scanning calorimetry role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000527 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000527">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/role#AFRL_0000328"/>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Standard_deviation"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard deviation role</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard deviation</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standard deviation role is a statistical datum role of a datum that is  a measure of the amount of variation or dispersion of a set of values. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">standard deviation role</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000528 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000528">
