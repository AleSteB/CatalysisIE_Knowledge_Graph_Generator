        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ion flow is a material flow where ions transport electric charges in an electromagnetic field. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ion flow</skos:prefLabel>
