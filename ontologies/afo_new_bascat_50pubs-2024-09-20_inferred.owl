                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source rdf:resource="https://en.wikipedia.org/wiki/Refractive_index"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refractive index</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">index of refraction</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refraction index</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refractive index (datum)</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refraction index is a quality quantification facet, that quantifies how fast light travels through a material. It is defined as n = c/v, where c is the speed of light in vacuum and v is the phase velocity of light in the medium. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">refractive index</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002208 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002208">
