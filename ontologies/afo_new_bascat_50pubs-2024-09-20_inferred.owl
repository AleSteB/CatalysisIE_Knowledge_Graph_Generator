        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material specification is a specification that specifies some qualities, roles or dispositions of some material. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material specification</skos:prefLabel>
    </owl:Class>
    


