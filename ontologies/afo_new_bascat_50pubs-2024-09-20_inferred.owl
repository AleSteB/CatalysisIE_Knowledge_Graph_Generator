    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001061 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001061">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001682"/>
