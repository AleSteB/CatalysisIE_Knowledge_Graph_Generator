        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to cover</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">covering function</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To cover is a joining function realized when something is joined to a surface in such way that it is preventing some kind of material or energy flow through that surface. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to cover</skos:prefLabel>
    </owl:Class>
    


