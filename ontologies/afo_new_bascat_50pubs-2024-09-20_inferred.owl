        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified capability</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specified capability is the contextual role of an information object that specifies a capability. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specified capability</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/role#AFRL_0000068 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000068">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000957"/>
