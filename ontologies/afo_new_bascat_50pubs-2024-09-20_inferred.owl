        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transferring function</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To shift, or convey, a flow (material, energy, signal) from one place to another. [NIST]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to transfer</skos:prefLabel>
    </owl:Class>
    


