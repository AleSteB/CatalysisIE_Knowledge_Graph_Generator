        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample pan role is the role of the measurement pan realized in a DSC measurement that contains the sample. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample pan role</skos:prefLabel>
    </owl:Class>
    


