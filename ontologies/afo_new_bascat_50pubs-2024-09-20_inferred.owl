        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endothermic peak is a differential scanning calorimetry peak peak resulting from energy transfer to the sample heating cell. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endothermic peak</skos:prefLabel>
    </owl:Class>
    


