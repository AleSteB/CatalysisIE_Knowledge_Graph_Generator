        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A backpressure regulator is a pressure regulator that regulates a defined pressure upstream of itself (at its own inlet). [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backpressure regulator</skos:prefLabel>
    </owl:Class>
    


