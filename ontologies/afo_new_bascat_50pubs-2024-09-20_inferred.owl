        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-08-19 Changed pref label. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Number concentration is a concentration defined by number of entities of a constituent in a mixture divided by the volume of the mixture. [IUPAC]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number concentration (quality)</skos:prefLabel>
