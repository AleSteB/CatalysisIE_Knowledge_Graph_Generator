        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A property specification is a specification about a feature, property, attribute or characteristic. The specification defines constraints on it, such as being an instance of a specific class. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a SHACL property shape</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">property specification</skos:prefLabel>
    </owl:Class>
    


