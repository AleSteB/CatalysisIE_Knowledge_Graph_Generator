        <terms:rights rdf:resource="http://purl.allotrope.org/voc/iupac-copyright"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IUPAC Quantities, Units and Symbols in Physical Chemistry, 1993</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">angle of optical rotation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">angle of optical rotation (datum)</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">angle of optical rotation result</skos:altLabel>
