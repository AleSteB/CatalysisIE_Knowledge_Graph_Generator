        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chord length distribution data cube is a data cube that represents particle count binned by chord length over time. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chord length distribution data cube</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002352 -->

