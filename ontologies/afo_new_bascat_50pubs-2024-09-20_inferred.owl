        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak analysis that determines the peak height following a specified algorithm. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak height analysis</skos:prefLabel>
    </owl:Class>
    


