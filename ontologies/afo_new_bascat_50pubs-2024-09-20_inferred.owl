        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-12-208 Changed parent class. [Allotrope]</skos:changeNote>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-12-208 Changed pref label, added alt label. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An account to a local computer. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">local system account identifier</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001071 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001071">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#locality"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locality</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A written name denoting a locality (e.g. city) as part a postal address. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">locality</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001072 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001072">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000922"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular structure</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A molecular structure is a description of the type and arrangement of the atoms and the direction of bonds linking atoms that constitute a molecule. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">molecular structure</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001073 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001073">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak area</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-07-19 Definition changed. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that quantitates the area enclosed by a peak and the selected baseline. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak area</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001074 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001074">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0002730"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.allotrope.org/ontologies/role#AFRL_0000278"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000388"/>
                                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001202"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak position</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet that denotes the abscissa value of the extrema (maxima or minima) attributed to the peak in a data description function.  The extrema is often determined through a mathematical fitting of measurement signals to eliminate spurious extrema due to noise. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak position</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001075 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001075">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000947"/>
        <property:AFX_0002811 rdf:resource="http://purl.allotrope.org/ontologies/property#AFX_0000276"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/aft"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width</rdfs:label>
        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-08-01 Changed definition [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A peak facet denoting its width at a specified peak height or variance. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peak width</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001078 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001078">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001065"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000590"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#hasStreetAddress"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">street address</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The street address is a location facet of a postal address, that denotes a street. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">street address</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001079 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001079">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000917"/>
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001082"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#tel"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone number</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A number for calling a telephone. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">telephone number</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001080 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001080">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001682"/>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/title"/>
        <terms:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Title_(disambiguation)</terms:source>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">title</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A title is a prefix or suffix added to a personal name. A title can be a title of honor, that is a title bestowed as an award,  a honorary title (academic), that is a recognition of contributions by a non-employee or employee, a hereditary title, that is a title that remains in a family or a job title, that is a designation of a person&apos;s position in an organization. [Wikipedia]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mr, Mrs, Ms, Dr.</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">title</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001081 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001081">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001682"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#honorific-prefix"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">honorific prefix</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An honorific prefix is a facet that is part of a prefix to a person&apos;s name. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">honorific prefix</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001082 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001082">
