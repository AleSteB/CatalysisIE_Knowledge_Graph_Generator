        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A saturated gas role is the role of the gas saturated with the vapor in a dynamic vapor sorption process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">saturated gas role (DVS)</skos:prefLabel>
    </owl:Class>
    


