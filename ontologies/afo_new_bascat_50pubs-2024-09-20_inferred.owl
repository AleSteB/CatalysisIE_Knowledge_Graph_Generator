        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To firmly fix a material into a defined location, or secure an energy or signal into a specific course. [NIST]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to support</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/function#AFFN_0000029 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/function#AFFN_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/function#AFFN_0000109"/>
