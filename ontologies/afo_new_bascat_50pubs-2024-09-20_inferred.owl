    <!-- http://purl.obolibrary.org/obo/MOP_0000589 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MOP_0000589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MOP_0000569"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reduction process that involves addition of hydrogen atoms across a double bond.</obo:IAO_0000115>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">batchelorc</oboInOwl:created_by>
