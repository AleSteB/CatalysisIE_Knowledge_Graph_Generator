    <!-- http://purl.allotrope.org/ontologies/equipment#AFE_0001515 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/equipment#AFE_0001515">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/equipment#AFE_0002145"/>
