        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height equivalent to a theoretical plate</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HETP</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A height equivalent to a theoretical plate is a chromatography peak facet quantifying the ratio of the absorption bed length divided by the number of theoretical plates in the absorption bed. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">height equivalent to a theoretical plate</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002519 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002519">
