        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">genotyping</skos:altLabel>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">genotyping experiment</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A genotyping qPCR experiment is an experiment using qPCR that identifies known mutations in a DNA Sample. DNA primers are used to target and identify specific alleles in a sample. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">genotyping qPCR experiment</skos:prefLabel>
    </owl:Class>
    


