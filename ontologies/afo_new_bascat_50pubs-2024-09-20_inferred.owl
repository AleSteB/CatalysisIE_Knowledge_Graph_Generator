        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A device that is used to provide data and control signals to an information processing system. [Wikipedia]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">input device</skos:prefLabel>
    </owl:Class>
    


