        <skos:changeNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-17 Moved under measurement time and end time. [Allotrope]</skos:changeNote>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A measurement end time is the date/time of the end of the measurement process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">measurement end time</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002125 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0002125">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001243"/>
