        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal coordination</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A temporal coordination is a class coordination that coordinates a class with a temporal aspect. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal coordination</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001634 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001634">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0001552"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">topological coordination</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A topological coordination is a class coordination that coordinates a class with a topological aspect. [Allotrope]</skos:definition>
        <skos:example rdf:datatype="http://www.w3.org/2001/XMLSchema#string">left, right, top, bottom</skos:example>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">topological coordination</skos:prefLabel>
    </owl:Class>
    


