        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">set command</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A control command is an action specification that specifies a setting to be set by a controlling process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">control command</skos:prefLabel>
    </owl:Class>
    


