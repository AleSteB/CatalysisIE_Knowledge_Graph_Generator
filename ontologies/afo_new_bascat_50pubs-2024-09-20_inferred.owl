    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001486 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001486">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/result#AFR_0000923"/>
        <property:AFX_0002808 rdf:resource="http://xmlns.com/foaf/0.1/gender"/>
        <property:AFX_0002808 rdf:resource="https://www.w3.org/2006/vcard/ns#Gender"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gender</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The gender facet relates a human to a string representing its gender. [Allotrope]</skos:definition>
        <skos:note rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In most cases the value will be the string &apos;female&apos; or &apos;male&apos; (in lowercase without surrounding quotes or spaces). Like all FOAF properties, there is in general no requirement to use gender in any particular document or description. Values other than &apos;male&apos; and &apos;female&apos; may be used, but are not enumerated here. The gender mechanism is not intended to capture the full variety of biological, social and sexual concepts associated with the word &apos;gender&apos;. [FoaF]</skos:note>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gender</skos:prefLabel>
    </owl:Class>
    


