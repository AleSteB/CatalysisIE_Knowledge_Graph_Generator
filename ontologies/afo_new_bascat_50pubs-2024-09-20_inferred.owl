        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sample inlet is an in port of a measurement or separation device where sample material is passing in to the device. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sample inlet</skos:prefLabel>
    </owl:Class>
    


