        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monolayer quantity</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A monolayer quantity is a volume of a monolayer based on the cross-sectional area of the adsorbent gas. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">monolayer quantity</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/result#AFR_0002124 -->

