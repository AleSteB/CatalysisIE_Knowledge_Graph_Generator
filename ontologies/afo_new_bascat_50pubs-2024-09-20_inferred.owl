        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transferring device is a device that is designed to transfer material. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transferring device</skos:prefLabel>
    </owl:Class>
    


