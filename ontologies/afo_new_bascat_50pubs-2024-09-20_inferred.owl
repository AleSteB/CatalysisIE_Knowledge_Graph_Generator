        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A heat seal is a coupling device that is the output of a heat sealing process. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heat seal</skos:prefLabel>
    </owl:Class>
    


