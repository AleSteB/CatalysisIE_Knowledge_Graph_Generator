        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A secant modulus is the slope of a line from the origin of a stress-strain curve intersecting at a given strain value. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">secant modulus</skos:prefLabel>
    </owl:Class>
    


