                <owl:someValuesFrom rdf:resource="http://purl.allotrope.org/ontologies/process#AFP_0003811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <property:AFX_0002798 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</property:AFX_0002798>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/REC/2023/09/afo"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material flow</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flow (material)</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A material flow is a material that is an aggregate of granular objects that steadily and continuously move along a path. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">material flow</skos:prefLabel>
    </owl:Class>
    


