        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A detector relative offset setting is a detector setting that specifies the offset of the signals of two detectors to align them along the x-axis. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">detector relative offset setting</skos:prefLabel>
    </owl:Class>
    


