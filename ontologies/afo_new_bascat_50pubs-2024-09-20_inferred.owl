    <!-- http://purl.allotrope.org/ontologies/result#AFR_0001835 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/result#AFR_0001835">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/common#AFC_0000050"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.allotrope.org/voc/afo/domain/REC/2023/09/calibration"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration assessment code</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A calibration assessment code is a code indicating a calibration assessment about the performance of an instrument. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">calibration assessment code</skos:prefLabel>
    </owl:Class>
    


