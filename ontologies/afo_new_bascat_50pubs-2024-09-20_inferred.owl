        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adsorbed volume at STP</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An adsorbed volume is a quality quantification facet that denotes the quantity of absorbant calculated to be adsorbed at STP. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adsorbed volume at STP</skos:prefLabel>
    </owl:Class>
    


