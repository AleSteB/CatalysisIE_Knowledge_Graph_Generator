        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure configuration</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure setting</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pressure configuration is a device configuration of a pressure controlling or monitoring device, that controls or monitors the target pressure at the site of some system component. [Allotrope]</skos:definition>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pressure configuration</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.allotrope.org/ontologies/quality#AFQ_0000338 -->

    <owl:Class rdf:about="http://purl.allotrope.org/ontologies/quality#AFQ_0000338">
        <rdfs:subClassOf rdf:resource="http://purl.allotrope.org/ontologies/quality#AFQ_0000065"/>
