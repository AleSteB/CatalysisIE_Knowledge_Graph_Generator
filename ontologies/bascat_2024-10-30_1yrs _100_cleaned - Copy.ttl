                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0002849>
                                                                          ] ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "quantification facet"^^xsd:string ;
                                                          core:altLabel "quantity facet"^^xsd:string ;
                                                          core:changeNote "2019-07-04 Changed pref label to be more precise. [Allotrope]"^^xsd:string ,
                                                                          "2020-12-01 Changed definition. [Allotrope]"^^xsd:string ,
                                                                          "2021-03-16 Fixed quantifies some mass. [Allotrope]"^^xsd:string ;
                                                          core:definition "A facet that is part of a quantification of a quality, aggregate or process. [Allotrope]"^^xsd:string ;
                                                          core:note "A quantification facet is usually a quantity value or a categorization into some group.  It is described by a numeric value together with a unit or a categorical value. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "quantification facet"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001103
<http://purl.allotrope.org/ontologies/result#AFR_0001103> rdf:type owl:Class ;
