                                                                                                  owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000147>
                                                                                                ]
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "exporting"^^xsd:string ;
                                                           core:changeNote "2022-06-23 Added assertions. [Allotrope]"^^xsd:string ;
                                                           core:definition "Exporting is a channeling that sends a flow (material, energy, signal) from inside of a boundary to the outside. [Allotrope, NIST]"^^xsd:string ;
                                                           core:prefLabel "exporting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003351
<http://purl.allotrope.org/ontologies/process#AFP_0003351> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003348> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "guiding"^^xsd:string ;
                                                           core:altLabel "directing the course"^^xsd:string ;
                                                           core:definition "Guiding is directing the course of a flow (material, energy, signal) along a specific path. [Allotrope, NIST]"^^xsd:string ;
                                                           core:prefLabel "guiding"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003354
<http://purl.allotrope.org/ontologies/process#AFP_0003354> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003475> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "connecting"^^xsd:string ;
                                                           core:definition "Connecting is bringing two or more topological flows into connection. [Allotrope, NIST]"^^xsd:string ;
                                                           core:editorialNote "n input flows to 1 output flow"^^xsd:string ;
                                                           core:prefLabel "connecting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003356
<http://purl.allotrope.org/ontologies/process#AFP_0003356> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003354> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "coupling"^^xsd:string ;
                                                           core:definition "Coupling is connecting together material such that the members are still distinguishable from each other. [NIST]"^^xsd:string ;
                                                           core:prefLabel "coupling"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003357
<http://purl.allotrope.org/ontologies/process#AFP_0003357> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003356> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "joining"^^xsd:string ;
                                                           core:definition "Joining is the direct coupling of flows without any intermediary flow. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "joining"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003358
<http://purl.allotrope.org/ontologies/process#AFP_0003358> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003356> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "linking"^^xsd:string ;
                                                           core:definition "Linking is coupling flows together by means of an intermediary flow. [NIST]"^^xsd:string ;
                                                           core:prefLabel "linking"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003359
<http://purl.allotrope.org/ontologies/process#AFP_0003359> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003620> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "controlling"^^xsd:string ;
                                                           core:definition "Controlling is changing or regulating a flow in its magnitude. [NIST, Allotrope]"^^xsd:string ;
                                                           core:prefLabel "controlling"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003360
<http://purl.allotrope.org/ontologies/process#AFP_0003360> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003359> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "actuating"^^xsd:string ;
                                                           core:altLabel "activating"^^xsd:string ,
                                                                         "starting"^^xsd:string ,
                                                                         "switching on"^^xsd:string ,
                                                                         "turning on"^^xsd:string ;
                                                           core:definition "Actuating is the process of commencing the flow of energy, signal, or material in response to an imported control signal. [NIST]"^^xsd:string ;
                                                           core:prefLabel "actuating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003361
<http://purl.allotrope.org/ontologies/process#AFP_0003361> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003485> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "regulating material"^^xsd:string ;
                                                           core:definition "Regulating material is adjusting a quality of material in response to a control signal. [Allotrope]"^^xsd:string ;
                                                           core:example "regulating the temperature"^^xsd:string ;
                                                           core:prefLabel "regulating material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003362
<http://purl.allotrope.org/ontologies/process#AFP_0003362> rdf:type owl:Class ;
