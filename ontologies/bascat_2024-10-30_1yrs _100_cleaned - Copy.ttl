                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          prop:AFX_0002798 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "ion transition list"^^xsd:string ;
                                                          core:altLabel "transition list"^^xsd:string ;
                                                          core:definition "A ion transition list is a collection of ion transitions. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "ion transition list"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001865
<http://purl.allotrope.org/ontologies/result#AFR_0001865> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001619> ;
                                                          prop:AFX_0002808 obo:MS_1000011 ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          term:source "G. L. Glish, D. J. Burinsky. J. Am. Soc. Mass Spectrom. 19, 161 (2008)."^^xsd:string ,
                                                                      "IUPAC. Analytical Division. Compendium of Analytical Nomenclature (the Orange Book). Definitive Rules, 1979. Compiled by J. Inczédy, T. Lengyel, A. M. Ure. Blackwell Scientific Publications, Oxford (1997)"^^xsd:string ,
                                                                      "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the Gold Book). Compiled by A. D. McNaught and A.Wilkinson. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ,
                                                                      "J. Laskin, J. H. Futrell. Mass Spectrom. Rev. 24, 135 (2005)."^^xsd:string ,
                                                                      "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "mass resolution"^^xsd:string ;
                                                          core:definition "Mass resolution is a resolution in a mass spectrum, the observed m/z value divided by the smallest difference Δ(m/z) for two ions that can be separated: (m/z)/Δ(m/z). [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "mass resolution"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001866
<http://purl.allotrope.org/ontologies/result#AFR_0001866> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001505> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "mass spectrometry system setting"^^xsd:string ;
                                                          core:definition "A mass spectrometry system setting is a setting that specifies the operation of a mass spectrometry system. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "mass spectrometry system setting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001867
<http://purl.allotrope.org/ontologies/result#AFR_0001867> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001866> ;
                                                          prop:AFX_0002808 obo:MS_1000502 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "dwell time"^^xsd:string ;
                                                          core:definition "The dwell time is a mass spectrometry system setting that specifies the time spent gathering data across a peak. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "dwell time"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001868
<http://purl.allotrope.org/ontologies/result#AFR_0001868> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001583> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty prop:AFX_0002816 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000257>
                                                                          ] ;
                                                          prop:AFX_0002808 obo:MS_1000040 ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "m/z"^^xsd:string ;
                                                          core:altLabel "mass-to-charge ratio"^^xsd:string ;
                                                          core:definition "A quantification facet that quantifies the quantity formed by dividing the mass of an ion in unified atomic mass units by its charge number (regardless of sign). [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "m/z"^^xsd:string ;
                                                          core:scopeNote "Mass-to-charge ratio is deprecated. Mass-to-charge ratio has been used occasionally for the horizontal axis in a plot of a mass spectrum, although the quantity measured is not the ion's mass divided by its electric charge (SI units kg C-1). [IUPAC]"^^xsd:string ,
                                                                         "m/z is recommended as an abbreviation to represent the dimensionless quantity that is used almost universally as the independent variable in a mass spectrum. [IUPAC]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001871
<http://purl.allotrope.org/ontologies/result#AFR_0001871> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "qualification"^^xsd:string ;
                                                          core:definition "A qualification is a proposition that an entity meets the requirements of a specific right or objective. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "qualification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001872
<http://purl.allotrope.org/ontologies/result#AFR_0001872> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "requirement"^^xsd:string ;
                                                          core:definition "A requirement is a proposition that states a set of conditions that have to be fulfilled to achieve some specific objective. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "requirement"^^xsd:string ;
                                                          core:scopeNote "The goal can be stated in a prescriptive (laws) or directive (plans) way. [Allotrope]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001873
<http://purl.allotrope.org/ontologies/result#AFR_0001873> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001101> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty prop:AFX_0002730 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000312>
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "qualifier transition ratio"^^xsd:string ;
                                                          core:definition "A qualifier transition ratio is a ratio of the magnitudes of the qualifier transition signal to the quantifier transition signal. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "qualifier transition ratio"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001874
<http://purl.allotrope.org/ontologies/result#AFR_0001874> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001873> ,
                                                                          <http://purl.allotrope.org/ontologies/role#AFRL_0000157> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "measured qualifier transition ratio"^^xsd:string ;
                                                          core:definition "A measured qualifier transition ratio is a qualifier transition ratio that has the contextual role of a measure. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "measured qualifier transition ratio"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001875
<http://purl.allotrope.org/ontologies/result#AFR_0001875> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001873> ,
                                                                          [ rdf:type owl:Restriction ;
