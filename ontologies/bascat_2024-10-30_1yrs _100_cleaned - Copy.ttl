                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty obo:BFO_0000054 ;
                                                                                                  owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003299>
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "specification target role"^^xsd:string ;
                                                         core:altLabel "specification subject"^^xsd:string ,
                                                                       "specification target"^^xsd:string ;
                                                         core:definition "A specification target is the role of a material entity that participates in a specifying process and is what the resulting specification is about. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "specification target role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000032
<http://purl.allotrope.org/ontologies/role#AFRL_0000032> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000126> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                         rdfs:label "stationary phase"^^xsd:string ;
                                                         core:definition "A stationary phase is the chromatographic phase role of a solid, gel or liquid material that is the stationary component in chromatography. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "stationary phase"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000033
<http://purl.allotrope.org/ontologies/role#AFRL_0000033> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000073> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "temporal mean"^^xsd:string ;
                                                         core:definition "Temporal mean is the contextual role of a quantity (quantity value or count) that describes a arithmetic mean of a quantity over time. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "temporal mean"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000034
<http://purl.allotrope.org/ontologies/role#AFRL_0000034> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000073> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "time segment"^^xsd:string ;
                                                         core:definition "Time segment is a contextual role of some information object that is about a temporal part in the context of representation of a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "time segment"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000035
<http://purl.allotrope.org/ontologies/role#AFRL_0000035> rdf:type owl:Class ;
