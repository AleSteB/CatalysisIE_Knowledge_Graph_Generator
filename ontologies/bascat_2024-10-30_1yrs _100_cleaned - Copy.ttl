                                                          rdfs:label "honorific prefix"^^xsd:string ;
                                                          core:definition "An honorific prefix is a facet that is part of a prefix to a person's name. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "honorific prefix"^^xsd:string .


