###  http://purl.allotrope.org/ontologies/equipment#AFE_0001718
<http://purl.allotrope.org/ontologies/equipment#AFE_0001718> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0002256> ;
