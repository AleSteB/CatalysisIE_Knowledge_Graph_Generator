                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting> ;
                                                           rdfs:label "cell counter configuration"^^xsd:string ;
                                                           core:altLabel "cell counter setting"^^xsd:string ;
                                                           core:definition "A cell counter configuration is a device configuration of a cell counter device. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "cell counter configuration"^^xsd:string .


