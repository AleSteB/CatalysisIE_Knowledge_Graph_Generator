                                                                                                      owl:onProperty obo:RO_0000056 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0001321>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                             prop:AFX_0002798 "true"^^xsd:boolean ;
                                                             prop:AFX_0002808 obo:OBI_0000481 ;
                                                             term:source "PAC, 1993, 65, 819 (Nomenclature for chromatography (IUPAC Recommendations 1993))"^^xsd:string ;
