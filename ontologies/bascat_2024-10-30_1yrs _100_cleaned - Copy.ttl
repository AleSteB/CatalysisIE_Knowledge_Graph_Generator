                                                          rdfs:label "BET C constant"^^xsd:string ;
                                                          core:definition "A BET C constant is a calculated constant from a BET analysis equal to Exp(E1−EL) where E1 is  heat of adsorption for the first layer and EL is the heat of vaporization for layers beyond the first layer. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "BET C constant"^^xsd:string .


