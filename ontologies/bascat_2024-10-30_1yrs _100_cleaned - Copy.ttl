                                                         prop:AFX_0002808 <http://msi-ontology.sourceforge.net/ontology/NMR.owl#MSI_400127> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "experiment sample role"^^xsd:string ;
                                                         core:altLabel "experiment sample"^^xsd:string ;
                                                         core:definition "An experiment sample is a role that is played by a material object of interest in an assay used to obtain generalizable information about the sample source. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "experiment sample role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000211
<http://purl.allotrope.org/ontologies/role#AFRL_0000211> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000484> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "coated material role"^^xsd:string ;
                                                         core:altLabel "coated material"^^xsd:string ,
                                                                       "substrate"^^xsd:string ,
                                                                       "substrate role"^^xsd:string ;
                                                         core:definition "A coated material is a coating role of a material whose surface is being coated by another material which it covers. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "coated material role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000212
<http://purl.allotrope.org/ontologies/role#AFRL_0000212> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000484> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "coating role"^^xsd:string ;
                                                         core:altLabel "coating"^^xsd:string ,
                                                                       "coating medium"^^xsd:string ,
                                                                       "coating medium role"^^xsd:string ;
                                                         core:definition "A coating role is the role of a material that coats another material (the substrate). [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "coating role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000213
<http://purl.allotrope.org/ontologies/role#AFRL_0000213> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000294> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "measurand role"^^xsd:string ;
                                                         core:altLabel "measurand"^^xsd:string ;
                                                         core:definition "A measurand role is a measurement role of a material entity that is being measured. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "measurand role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000216
<http://purl.allotrope.org/ontologies/role#AFRL_0000216> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000085> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000344> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "additive role"^^xsd:string ;
                                                         core:altLabel "additive"^^xsd:string ;
                                                         core:definition "Additive is a role of material that is added to a mixture in order to achieve a supportive purpose. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "additive role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000217
<http://purl.allotrope.org/ontologies/role#AFRL_0000217> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:OBI_0000086 ;
                                                         prop:AFX_0002798 "false"^^xsd:boolean ;
                                                         prop:AFX_0002809 obo:CHEBI_35223 ;
                                                         term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                         term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                         term:source "PAC, 1996, 68, 155 (Glossary of terms used in chemical kinetics, including reaction dynamics.)"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "catalyst role"^^xsd:string ;
                                                         core:altLabel "catalyst"^^xsd:string ;
                                                         core:definition "A catalyst role is a reagent role of a substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction; the process is called catalysis. The catalyst is both a reactant and product of the reaction. [IUPAC]"^^xsd:string ;
                                                         core:prefLabel "catalyst role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000218
<http://purl.allotrope.org/ontologies/role#AFRL_0000218> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                         rdfs:label "effluent"^^xsd:string ;
                                                         core:definition "Effluent is a mobile phase eluting from a column. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "effluent"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000219
<http://purl.allotrope.org/ontologies/role#AFRL_0000219> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                         rdfs:label "eluate"^^xsd:string ;
                                                         core:changeNote "2020-12-16 Rephrased definition [Allotrope]"^^xsd:string ;
                                                         core:definition "A mobile phase that is analyte material coming from the chromatograph. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "eluate"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000220
<http://purl.allotrope.org/ontologies/role#AFRL_0000220> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                         rdfs:label "eluent"^^xsd:string ;
                                                         core:definition "Eluent is a mobile phase entering a column to perform a separation of material. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "eluent"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000221
<http://purl.allotrope.org/ontologies/role#AFRL_0000221> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "debris role"^^xsd:string ;
                                                         core:altLabel "debris"^^xsd:string ;
                                                         core:definition "Debris is a role of material to be waste. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "debris role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000223
<http://purl.allotrope.org/ontologies/role#AFRL_0000223> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000289> ;
                                                         term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                         term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                         term:source "PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 612"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "detergent role"^^xsd:string ;
                                                         core:altLabel "detergent"^^xsd:string ;
                                                         core:definition "A detergent role is a cleaning role of a surface active agent (or a mixture containing one of more surface active agents) having cleaning properties in dilute solution. [IUPAC]"^^xsd:string ;
                                                         core:prefLabel "detergent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000224
<http://purl.allotrope.org/ontologies/role#AFRL_0000224> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000298> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "diluent role"^^xsd:string ;
                                                         core:altLabel "diluent"^^xsd:string ;
                                                         core:definition "Diluent is a role of material used to lessen the strength or flavor of a solution or mixture of another ingredient. [NCI]"^^xsd:string ;
                                                         core:prefLabel "diluent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000225
<http://purl.allotrope.org/ontologies/role#AFRL_0000225> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000273> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "dispersant role"^^xsd:string ;
                                                         core:altLabel "dispersant"^^xsd:string ;
                                                         core:definition "A dispersant is either a non-surface active polymer or a surface-active substance added to a suspension, usually a colloid, to improve the separation of particles and to prevent settling or clumping. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "dispersant role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000226
<http://purl.allotrope.org/ontologies/role#AFRL_0000226> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000345> ;
                                                         prop:AFX_0002809 obo:CHEBI_75324 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "excipient role"^^xsd:string ;
                                                         core:altLabel "excipient"^^xsd:string ;
                                                         core:definition "Excipient is a role of a generally pharmacologically inactive substance that is formulated with the active ingredient of a medication. [ChEBI]"^^xsd:string ;
                                                         core:prefLabel "excipient role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000228
<http://purl.allotrope.org/ontologies/role#AFRL_0000228> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000362> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "filtrate role"^^xsd:string ;
                                                         core:altLabel "filtrate"^^xsd:string ;
                                                         core:definition "Filtrate is a role of liquid outcome of a filtration process that is commonly the mechanical or physical operation which is used for the separation of solids from fluids (liquids or gases) by interposing a medium through which only the fluid can pass. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "filtrate role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000229
