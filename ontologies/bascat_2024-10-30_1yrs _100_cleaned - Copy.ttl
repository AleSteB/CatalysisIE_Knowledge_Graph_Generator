                                                                         "stable quality state"^^xsd:string ,
                                                                         "steady (state)"^^xsd:string ,
                                                                         "steady quality state"^^xsd:string ,
                                                                         "unchanging (state)"^^xsd:string ,
                                                                         "unchanging quality state"^^xsd:string ;
                                                           core:definition "A constant quality state is a quality state where the quality does not change. [Allotrope]"^^xsd:string ;
                                                           core:example "being red"^^xsd:string ,
                                                                        "being solid"^^xsd:string ;
                                                           core:prefLabel "constant quality state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003818
<http://purl.allotrope.org/ontologies/process#AFP_0003818> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003281> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "constant quality process profile"^^xsd:string ;
                                                           core:definition "A constant quality process profile is a quality process profile where the tracked  quality does not change. [Allotrope]"^^xsd:string ;
                                                           core:example "A solid material has a constant state of matter quality profile when it does not melt or sublimate. [Allotrope]"^^xsd:string ;
                                                           core:note "An assertion about a constant quality process profile is done by measuring the process profile and thereby also effected by the observer."^^xsd:string ,
                                                                     "Whether a quality changes is determined by the granularity of the quality."^^xsd:string ;
                                                           core:prefLabel "constant quality process profile"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003819
<http://purl.allotrope.org/ontologies/process#AFP_0003819> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003822> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "increasing quality process profile"^^xsd:string ;
                                                           core:definition "An increasing quality process profile is a quality process profile where the tracked determinate quality is continuously increasing in magnitude. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "increasing quality process profile"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003820
