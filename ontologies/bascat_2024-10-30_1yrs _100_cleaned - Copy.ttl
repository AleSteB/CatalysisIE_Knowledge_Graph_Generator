                obo:BFO_0000180 "ThreeDimensionalSpatialRegion"^^xsd:string ;
                obo:IAO_0000112 "a cube-shaped region of space"@en ,
                                "a sphere-shaped region of space,"^^xsd:string ;
                obo:IAO_0000600 "A three-dimensional spatial region is a spatial region that is of three dimensions. (axiom label in BFO2 Reference: [040-001])"^^xsd:string ;
                obo:IAO_0000602 "(forall (x) (if (ThreeDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [040-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "three-dimensional spatial region"^^xsd:string ;
                core:altLabel "3D spatial region"^^xsd:string ;
                core:definition "A three-dimensional spatial region is a spatial region that is of three dimensions. [BFO]"^^xsd:string ;
                core:prefLabel "three-dimensional spatial region"^^xsd:string .

