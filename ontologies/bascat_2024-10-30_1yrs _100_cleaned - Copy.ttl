                                                         rdfs:label "x-coordinate role"^^xsd:string ;
                                                         core:altLabel "abscissa"^^xsd:string ,
                                                                       "x-coordinate"^^xsd:string ;
                                                         core:changeNote "2021-06-17 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "The x-coordinate is the Cartesian coordinate in the first dimension of a 2- or 3-dimensional Cartesian coordinate system. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "x-coordinate role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000279
