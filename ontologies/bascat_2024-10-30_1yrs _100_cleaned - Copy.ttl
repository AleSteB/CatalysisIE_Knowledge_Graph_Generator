                                                             rdfs:label "ultraviolet-visible-near infrared spectrometer"^^xsd:string ;
                                                             core:altLabel "UV-VIS-NIR spectrometer"^^xsd:string ,
                                                                           "UV-Vis-NIR absorption spectrometer"^^xsd:string ,
                                                                           "UV-Vis-NIR spectrometer"^^xsd:string ,
                                                                           "UV-Vis-NIR spectrophotometer"^^xsd:string ,
