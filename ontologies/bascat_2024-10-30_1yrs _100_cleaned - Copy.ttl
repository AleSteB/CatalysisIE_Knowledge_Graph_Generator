                                                           rdfs:label "consuming"^^xsd:string ;
                                                           core:altLabel "consumption"^^xsd:string ;
                                                           core:definition "A process where a essential material entity participant ceases to exist at the end and  it was existing at the start. [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "needs FOL for full axiomization"^^xsd:string ;
                                                           core:prefLabel "consuming"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003318
<http://purl.allotrope.org/ontologies/process#AFP_0003318> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003316> ;
