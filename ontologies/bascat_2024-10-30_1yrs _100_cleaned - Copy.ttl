                                                          rdfs:label "non-hygroscopic"^^xsd:string ;
                                                          core:changeNote "2021-09-29 Moved under hygroscopicity code. [Allotrope]"^^xsd:string ;
                                                          core:definition "Non-hygroscopic is a hygroscopicity type that denotes the increase in mass as no greater than 0.2%. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "non-hygroscopic"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002200
<http://purl.allotrope.org/ontologies/result#AFR_0002200> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/dynamic-vapor-sorption> ;
                                                          rdfs:label "deliquescent"^^xsd:string ;
                                                          core:changeNote "2021-09-29 Moved under hygroscopicity code. [Allotrope]"^^xsd:string ;
                                                          core:definition "Deliquescent is a hygroscopicity type that denotes the substance as sufficiently absorbant to form a liquid. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "deliquescent"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002201
<http://purl.allotrope.org/ontologies/result#AFR_0002201> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002552> ;
