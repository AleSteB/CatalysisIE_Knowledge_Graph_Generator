                                                                         obo:BFO_0000023 ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "physical input role"^^xsd:string ;
                                                         core:altLabel "physical input"^^xsd:string ;
                                                         core:definition "\"Physical input\" is a role of a material or energy that is input in a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "physical input role"^^xsd:string .


