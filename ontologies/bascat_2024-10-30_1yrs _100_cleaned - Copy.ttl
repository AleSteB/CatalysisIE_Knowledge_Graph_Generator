                                                                         "paused"^^xsd:string ;
                                                           core:definition "A paused state is a state during which a device or service waits for being resumed to continue a planned process. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "paused state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003670
