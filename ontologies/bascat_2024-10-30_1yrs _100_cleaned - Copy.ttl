###  http://purl.allotrope.org/ontologies/result#AFR_0001501
<http://purl.allotrope.org/ontologies/result#AFR_0001501> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000957> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "plan specification"^^xsd:string ;
                                                          core:altLabel "method"^^xsd:string ,
                                                                        "plan"^^xsd:string ,
                                                                        "procedure"^^xsd:string ,
                                                                        "recipe"^^xsd:string ;
                                                          core:changeNote "2020-05-11 Added alt labels method and procedure. [Allotrope]"^^xsd:string ;
                                                          core:definition "A directive information entity with action specifications and objective specifications as parts that, when concretized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified. [IAO]"^^xsd:string ;
                                                          core:example "To lose weight, go running daily for at least 30 minutes. To isolate plasma  from blood, centrifuge tubes at 1100-1300 rpm for 15 minutes. [IAO]"^^xsd:string ;
                                                          core:prefLabel "plan specification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001503
