                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak group"^^xsd:string ;
                                                          core:changeNote "2018-07-19 Changed definition, relaxed restriction. [Allotrope]"^^xsd:string ;
                                                          core:definition "A peak group is a user defined set of peaks for which summed peak facet data is expected. [Allotrope]"^^xsd:string ;
                                                          core:example "A common example is for alkanes such as heptanes.  Often all of the isomers (C7H16, CH3CH2(CH3)C4H10, C2H5CH2(CH3)C3H8, CH3CH2(CH2CH3)C3H8, etc) are reported as a single value."^^xsd:string ,
                                                                       "Sum of all peak areas in the group."^^xsd:string ;
                                                          core:prefLabel "peak group"^^xsd:string .


