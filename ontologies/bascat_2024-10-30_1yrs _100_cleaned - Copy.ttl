                                                           rdfs:label "pCO2"^^xsd:string ;
                                                           core:altLabel "partial pressure of carbon dioxide"^^xsd:string ;
                                                           core:definition "pCO2 is the partial pressure of carbon dioxide dissolved in a solution. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "pCO2"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000197
<http://purl.allotrope.org/ontologies/quality#AFQ_0000197> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000029> ;
