                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "PAC, 2007, 79, 1801 (Definitions of terms relating to the structure and processing of sols, gels, networks, and inorganic-organic hybrid materials (IUPAC Recommendations 2007)) on page 1806"^^xsd:string ;
