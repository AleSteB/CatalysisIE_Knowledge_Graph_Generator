                                                           rdfs:label "nebulizing"^^xsd:string ;
                                                           core:definition "Nebulizing is converting by of breaking up solutions and suspensions into small aerosol droplets. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "nebulizing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003721
<http://purl.allotrope.org/ontologies/process#AFP_0003721> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003598> ;
                                                           term:source <http://bioassayontology.org> ;
