                                                          core:definition "Negative polarity is the code that indicates a negative direction of polarity. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "negative polarity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001832
<http://purl.allotrope.org/ontologies/result#AFR_0001832> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0001835> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/calibration> ;
