###  http://www.w3.org/2004/02/skos/core#altLabel
core:altLabel rdf:type owl:AnnotationProperty ;
              prop:AFX_0002865 <http://www.w3.org/2004/02/skos/core> ;
              rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en ,
                           "The range of skos:altLabel is the class of RDF plain literals."^^xsd:string ,
                           "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."^^xsd:string ;
              rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ,
                               <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                               <http://www.w3.org/2004/02/skos/core> ;
              rdfs:label "alternative label"^^xsd:string ;
              core:definition "An alternative lexical label for a resource."^^xsd:string ;
              core:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."^^xsd:string ;
              rdfs:subPropertyOf rdfs:label .


###  http://www.w3.org/2004/02/skos/core#changeNote
