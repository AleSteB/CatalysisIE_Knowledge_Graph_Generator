                                                          core:prefLabel "impedance scan permittivity range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002305
<http://purl.allotrope.org/ontologies/result#AFR_0002305> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0002307> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/electrochemistry> ;
                                                          rdfs:label "impedance scan slope"^^xsd:string ;
                                                          core:definition "An impedance scan slope is an impedance scan result that quantitates the slope (α) of the beta-dispersion at the characteristic frequency fc and is indicative of the cell diameter distribution. The steeper the slope , the more homogeneous the distribution. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "impedance scan slope"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002306
<http://purl.allotrope.org/ontologies/result#AFR_0002306> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001732> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0002307> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/electrochemistry> ;
                                                          rdfs:label "impedance scan characteristic frequency"^^xsd:string ;
                                                          core:definition "An impedance scan characteristic frequency is an impedance scan result datum obtained from the infliction point of the impedance spectrum that provides an indication of the average cell diameter. The larger the cell diameter, the smaller the fc and vice-versa. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "impedance scan characteristic frequency"^^xsd:string .


