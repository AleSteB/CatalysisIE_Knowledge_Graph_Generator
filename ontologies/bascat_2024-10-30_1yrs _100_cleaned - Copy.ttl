                                                          core:definition "The differential scanning calorimetry result is the result of a DSC measurement. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "differential scanning calorimetry result"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000694
<http://purl.allotrope.org/ontologies/result#AFR_0000694> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                                                          term:source <https://en.wikipedia.org/wiki/Prediction> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "prediction"^^xsd:string ;
                                                          core:altLabel "forecast"^^xsd:string ;
                                                          core:changeNote "2019-05-10 Generalized term. [Allotrope]"^^xsd:string ;
                                                          core:definition "A prediction or forecast is a proposition about a future event. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "prediction"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000700
<http://purl.allotrope.org/ontologies/result#AFR_0000700> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000207> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "fingerprint"^^xsd:string ;
                                                          core:altLabel "fingerprinting"^^xsd:string ;
                                                          core:definition "A fingerprint is a type of or portion of spectrum that has a characteristic structure.  It can be used as a fingerprint for comparison to reference spectra. [Allotrope]"^^xsd:string ;
                                                          core:example "Infrared spectra are fingerprints. The fingerprint region of an IR spectrum lies between 1500 and 500 cm-1 while a complete IR spectrum normally has a range from 4000 to 500 cm-1. Note that the overlay is synonym for the same activity (fingerprinting)."^^xsd:string ;
                                                          core:prefLabel "fingerprint"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000733
<http://purl.allotrope.org/ontologies/result#AFR_0000733> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000207> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "distribution"^^xsd:string ;
                                                          core:definition "A distribution is a collection of frequencies of results of a sample. Each frequency is number of occurrences within a given interval. The distribution can be expressed relatively to the width of the interval. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "distribution"^^xsd:string .


