###  http://purl.allotrope.org/ontologies/result#AFR_0000639
<http://purl.allotrope.org/ontologies/result#AFR_0000639> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000992> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "file"^^xsd:string ;
                                                          core:changeNote "2020-05-11 Moved from taxonomy to AFO, different perspective than iao:Document"^^xsd:string ;
                                                          core:definition "A file is a resource for storing information, which is available to a computer program and is usually based on some kind of durable storage. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "file"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000647
<http://purl.allotrope.org/ontologies/result#AFR_0000647> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0002013> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty obo:BFO_0000050 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/result#AFR_0000007>
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/differential-scanning-calorimetry> ;
                                                          rdfs:label "differential scanning calorimetry peak"^^xsd:string ;
                                                          core:definition "A  differential scanning calorimetry peak is a peak that is the result of a differential scanning calorimetry (DSC) and part of a DSC curve. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "differential scanning calorimetry peak"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000682
<http://purl.allotrope.org/ontologies/result#AFR_0000682> rdf:type owl:Class ;
