                                                                         "high pressure liquid chromatography"^^xsd:string ,
                                                                         "high-pressure liquid chromatography"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles and the inlet pressure is relatively high. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000759
<http://purl.allotrope.org/ontologies/process#AFP_0000759> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002211> ;
