                                                           rdfs:label "dilution"^^xsd:string ;
                                                           core:definition "Dilution is the process of adding a solvent to a solution to lower its concentration. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dilution"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000792
<http://purl.allotrope.org/ontologies/process#AFP_0000792> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003566> ;
