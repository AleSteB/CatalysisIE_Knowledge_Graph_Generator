                                                           core:altLabel "separation"^^xsd:string ;
                                                           core:definition "A branching process that isolates flows into distinct component flows. The separated components are distinct from the flow before separation, as well as each other. [NIST]"^^xsd:string ;
                                                           core:prefLabel "separating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000441
<http://purl.allotrope.org/ontologies/process#AFP_0000441> rdf:type owl:Class ;
