                                                           core:altLabel "nuclear magnetic resonance method"^^xsd:string ;
                                                           core:definition "A nuclear magnetic resonance assay is magnetic resonance assay that applies a technique which detects the response of nuclear spins to a perturbing magnetic field. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "nuclear magnetic resonance assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000780
<http://purl.allotrope.org/ontologies/process#AFP_0000780> rdf:type owl:Class ;
