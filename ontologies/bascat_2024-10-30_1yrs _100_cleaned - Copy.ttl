                                                           core:altLabel "completed"^^xsd:string ,
                                                                         "is completed"^^xsd:string ;
                                                           core:definition "A completed state is a state during which a planned process has run to completion and the device or service is waiting for a reset that cause the state to change to an idle state. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "completed state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003669
