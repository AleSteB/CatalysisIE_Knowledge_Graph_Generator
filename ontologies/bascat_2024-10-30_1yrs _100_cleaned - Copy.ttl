                                                            oboI:is_cyclic "true"^^xsd:boolean ;
                                                            oboI:is_transitive "false"^^xsd:boolean ;
                                                            rdfs:label "is conjugate acid of"^^xsd:string .


###  http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of
<http://purl.obolibrary.org/obo/chebi#is_conjugate_base_of> rdf:type owl:ObjectProperty ;
                                                            oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                            oboI:id "is_conjugate_base_of"^^xsd:string ;
                                                            oboI:is_cyclic "true"^^xsd:boolean ;
                                                            oboI:is_transitive "false"^^xsd:boolean ;
                                                            rdfs:label "is conjugate base of"^^xsd:string .


###  http://purl.obolibrary.org/obo/chebi#is_enantiomer_of
<http://purl.obolibrary.org/obo/chebi#is_enantiomer_of> rdf:type owl:ObjectProperty ;
                                                        oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                        oboI:id "is_enantiomer_of"^^xsd:string ;
                                                        oboI:is_cyclic "true"^^xsd:boolean ;
                                                        oboI:is_transitive "false"^^xsd:boolean ;
                                                        rdfs:label "is enantiomer of"^^xsd:string .


###  http://purl.obolibrary.org/obo/chebi#is_substituent_group_from
<http://purl.obolibrary.org/obo/chebi#is_substituent_group_from> rdf:type owl:ObjectProperty ;
                                                                 oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                                 oboI:id "is_substituent_group_from"^^xsd:string ;
                                                                 oboI:is_cyclic "false"^^xsd:boolean ;
                                                                 oboI:is_transitive "false"^^xsd:boolean ;
                                                                 rdfs:label "is substituent group from"^^xsd:string .


