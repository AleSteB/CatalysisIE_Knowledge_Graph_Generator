                                                            rdfs:label "sol"^^xsd:string ;
                                                            core:definition "A sol is a fluid colloidal system of two or more components. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "sol"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001042
<http://purl.allotrope.org/ontologies/material#AFM_0001042> rdf:type owl:Class ;
                                                            owl:equivalentClass [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0001034>
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty obo:RO_0000086 ;
                                                                                                         owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000112>
                                                                                                       ]
                                                                                                     ) ;
                                                                                  rdf:type owl:Class
                                                                                ] ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000386> ,
                                                                            <http://purl.allotrope.org/ontologies/material#AFM_0001034> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "solid heterogeneous mixture"^^xsd:string ;
                                                            core:definition "A solid heterogeneous mixture is a heterogeneous mixture in solid state. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "solid heterogeneous mixture"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001044
<http://purl.allotrope.org/ontologies/material#AFM_0001044> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001035> ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 605"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "colloid"^^xsd:string ;
                                                            core:altLabel "colloidal system"^^xsd:string ;
                                                            core:definition "A colloid is a homogeneous mixture in which one substance of microscopically dispersed insoluble particles is suspended throughout another substance. A colloid has a dispersed phase (the suspended particles) and a continuous phase (the medium of suspension). The molecules or polymolecular particles dispersed in a medium have at least in one direction a dimension roughly between 1 nanometer and 1 micrometer, or in a system discontinuities are found at distances of that order. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "colloid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001054
<http://purl.allotrope.org/ontologies/material#AFM_0001054> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000888> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            term:source <https://en.wikipedia.org/wiki/X-ray> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "X-ray radiation"^^xsd:string ;
                                                            core:altLabel "X-ray"^^xsd:string ;
                                                            core:definition "A form of electromagnetic radiation with a wavelength ranging from 0.01 to 10 nanometers. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "X-ray radiation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001055
<http://purl.allotrope.org/ontologies/material#AFM_0001055> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000888> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            term:source <https://en.wikipedia.org/wiki/Light> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "visible light"^^xsd:string ;
                                                            core:altLabel "light"^^xsd:string ;
                                                            core:definition "Electromagnetic radiation which is visible to the human eye and is responsible for the sense of sight. Visible light is usually defined as having wavelengths in the range of 400-700 nanometers. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "visible light"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001056
<http://purl.allotrope.org/ontologies/material#AFM_0001056> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000888> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            term:source <https://en.wikipedia.org/wiki/Ultraviolet> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "ultraviolet radiation"^^xsd:string ;
                                                            core:altLabel "UV"^^xsd:string ,
                                                                          "ultraviolet light"^^xsd:string ;
                                                            core:definition "An electromagnetic radiation with a wavelength from 10 nm to 400 nm. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "ultraviolet radiation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001057
<http://purl.allotrope.org/ontologies/material#AFM_0001057> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000888> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            term:source <https://en.wikipedia.org/wiki/Infrared> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "infrared radiation"^^xsd:string ;
                                                            core:altLabel "IR"^^xsd:string ,
                                                                          "infrared"^^xsd:string ,
                                                                          "infrared light"^^xsd:string ;
                                                            core:definition "Electromagnetic radiation with longer wavelengths than those of visible light. It extends from the nominal red edge of the visible spectrum at 700 nanometer, to 1  micrometers. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "infrared radiation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001058
<http://purl.allotrope.org/ontologies/material#AFM_0001058> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000888> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            term:source <https://en.wikipedia.org/wiki/Gamma_ray> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "gamma radiation"^^xsd:string ;
                                                            core:altLabel "gamma ray"^^xsd:string ,
                                                                          "γ-ray"^^xsd:string ;
                                                            core:definition "Electromagnetic radiation of a kind arising from the radioactive decay of atomic nuclei and having wavelengths less than 10 picometers. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "gamma radiation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001059
<http://purl.allotrope.org/ontologies/material#AFM_0001059> rdf:type owl:Class ;
