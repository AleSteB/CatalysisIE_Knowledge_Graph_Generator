                                                           core:prefLabel "electric impedance (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000340
<http://purl.allotrope.org/ontologies/quality#AFQ_0000340> rdf:type owl:Class ;
