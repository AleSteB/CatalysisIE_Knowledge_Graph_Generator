###  http://purl.obolibrary.org/obo/BFO_0000038
obo:BFO_0000038 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000008 ;
                owl:disjointWith obo:BFO_0000148 ;
                obo:BFO_0000179 "1d-t-region"^^xsd:string ;
                obo:BFO_0000180 "OneDimensionalTemporalRegion"^^xsd:string ;
                obo:IAO_0000112 "the temporal region during which a process occurs."^^xsd:string ;
                obo:IAO_0000116 "BFO 2 Reference: A temporal interval is a special kind of one-dimensional temporal region, namely one that is self-connected (is without gaps or breaks)."^^xsd:string ;
                obo:IAO_0000600 "A one-dimensional temporal region is a temporal region that is extended. (axiom label in BFO2 Reference: [103-001])"^^xsd:string ;
                obo:IAO_0000602 "(forall (x) (if (OneDimensionalTemporalRegion x) (TemporalRegion x))) // axiom label in BFO2 CLIF: [103-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "one-dimensional temporal region"^^xsd:string ;
                core:altLabel "1D-temporal region"^^xsd:string ;
                core:definition "A one-dimensional temporal region is a temporal region that is extended. [BFO]"^^xsd:string ;
                core:prefLabel "one-dimensional temporal region"^^xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:BFO_0000038 ;
   owl:annotatedProperty obo:IAO_0000600 ;
   owl:annotatedTarget "A one-dimensional temporal region is a temporal region that is extended. (axiom label in BFO2 Reference: [103-001])"^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/103-001>
 ] .

