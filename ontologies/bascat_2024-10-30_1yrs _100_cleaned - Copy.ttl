                                                         core:definition "A sample role is a type of role whose bearer is a material entity that is the output of a sampling. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "sample role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000039
<http://purl.allotrope.org/ontologies/role#AFRL_0000039> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "processing role"^^xsd:string ;
                                                         core:definition "A contextual role that describes the way information is participating in some process from a causal dependency perspective. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "processing role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000040
<http://purl.allotrope.org/ontologies/role#AFRL_0000040> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "bound role"^^xsd:string ;
                                                         core:definition "The role of some datum forming the maximum or minimum value in a range or collection of values. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "bound role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000041
<http://purl.allotrope.org/ontologies/role#AFRL_0000041> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000040> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "lower bound"^^xsd:string ;
                                                         core:definition "The role of a datum that is smaller than all data in an ordered range or collection. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "lower bound"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000042
<http://purl.allotrope.org/ontologies/role#AFRL_0000042> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000040> ;
