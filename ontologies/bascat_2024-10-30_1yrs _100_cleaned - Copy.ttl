                                                      oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                      oboI:id "is_tautomer_of"^^xsd:string ;
                                                      oboI:is_cyclic "true"^^xsd:boolean ;
                                                      rdfs:label "is tautomer of"^^xsd:string .


###  http://qudt.org/schema/qudt#quantityKind
<http://qudt.org/schema/qudt#quantityKind> rdf:type owl:ObjectProperty ;
                                           rdfs:range <http://qudt.org/schema/qudt#QuantityKind> ;
                                           prop:AFX_0002865 <http://qudt.org/1.1/schema/qudt> ;
                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                           rdfs:label "has quantity kind"^^xsd:string ;
                                           core:altLabel "quantity kind"^^xsd:string ;
                                           core:prefLabel "has quantity kind"^^xsd:string .


