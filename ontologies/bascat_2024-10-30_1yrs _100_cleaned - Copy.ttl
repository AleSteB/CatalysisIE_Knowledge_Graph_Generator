                                                             rdfs:label "chromatographic detector"^^xsd:string ;
                                                             core:definition "A chromatography detector is a detector that is used in chromatography as component of a chromatography system. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "chromatographic detector"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000252
<http://purl.allotrope.org/ontologies/equipment#AFE_0000252> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0002145> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty obo:RO_0000056 ;
                                                                               owl:someValuesFrom [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0002294>
                                                                                                                         [ rdf:type owl:Restriction ;
