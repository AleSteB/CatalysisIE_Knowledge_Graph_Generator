                                                           rdfs:label "magnetic stirring"^^xsd:string ;
                                                           core:definition "Magnetic stirring is stirring that is achieved by rotating a magnetic stir bar in a solution. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "magnetic stirring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000044
<http://purl.allotrope.org/ontologies/process#AFP_0000044> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001801> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003305> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003774> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "microscopy"^^xsd:string ;
                                                           core:definition "Microscopy is a imaging assay where a microscope is used to view a small object (or specimen) by producing a magnified image. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "microscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000047
<http://purl.allotrope.org/ontologies/process#AFP_0000047> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001462> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "Raman spectroscopy"^^xsd:string ;
                                                           core:altLabel "Raman scattering spectrometry"^^xsd:string ,
                                                                         "Raman scattering spectroscopy"^^xsd:string ,
                                                                         "Raman spectrometry"^^xsd:string ,
                                                                         "laser Raman spectroscopy"^^xsd:string ;
                                                           core:definition "Any type of vibrational spectroscopy where the Raman scattering of monochromatic light, usually from a laser in the visible, near infrared, or near ultraviolet range by a sample is detected. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "Raman spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000057
<http://purl.allotrope.org/ontologies/process#AFP_0000057> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "granulometry"^^xsd:string ;
                                                           core:altLabel "particle size analysis"^^xsd:string ,
                                                                         "particle size measurement"^^xsd:string ,
                                                                         "particle sizing"^^xsd:string ;
                                                           core:definition "The measurement of the size distribution in a collection of grains. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "granulometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000078
<http://purl.allotrope.org/ontologies/process#AFP_0000078> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "argentometric titration"^^xsd:string ;
                                                           core:altLabel "argentimetric titration"^^xsd:string ;
                                                           core:definition "Argentometric titration is a process of determining the quantity of a sample by adding measured increments of a titrant until the end-point, at which essentially all of the sample has reacted, is reached. The titration is followed by the observing the precipitation of silver compounds following the addition of silver nitrate. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "argentometric titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000080
<http://purl.allotrope.org/ontologies/process#AFP_0000080> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "optical density measurement"^^xsd:string ;
                                                           core:altLabel "O.D. measurement"^^xsd:string ,
                                                                         "OD measurement"^^xsd:string ,
                                                                         "optical densiometry"^^xsd:string ,
                                                                         "optical densitometry"^^xsd:string ;
                                                           core:definition "The measurement of the light transmitted through a sample for a given wavelength. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "optical density measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000109
<http://purl.allotrope.org/ontologies/process#AFP_0000109> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "zeta-potential measurement"^^xsd:string ;
                                                           core:altLabel "zeta potential analysis"^^xsd:string ,
                                                                         "zeta potential measurement"^^xsd:string ,
                                                                         "zeta-potential analysis"^^xsd:string ,
                                                                         "zeta-potential measurements"^^xsd:string ,
                                                                         "zeta-potential studies"^^xsd:string ,
                                                                         "ζ-potential analysis"^^xsd:string ,
                                                                         "ζ-potential measurement"^^xsd:string ;
                                                           core:definition "The measurement of the overall charge a particle acquires in a specific medium. A number of different experimental methods can be used including electrophoretic light scattering and laser Doppler velocimetry. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "zeta-potential measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000112
<http://purl.allotrope.org/ontologies/process#AFP_0000112> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dissolving"^^xsd:string ;
                                                           core:definition "A mixing step where a soluble component is mixed with a liquid component. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "dissolving"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000119
<http://purl.allotrope.org/ontologies/process#AFP_0000119> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000441> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0000634> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "Karl-Fischer volumetric titration"^^xsd:string ;
                                                           core:altLabel "Karl Fischer volumetric titration"^^xsd:string ,
                                                                         "volumetric Karl Fischer titration"^^xsd:string ,
                                                                         "volumetric Karl-Fischer titration"^^xsd:string ;
                                                           core:definition "Karl-Fischer volumetric titration is a process of determining trace amounts of water in a sample by the titration of sulfur dioxide in water using iodine. In this method the titrant is added directly to the sample using a burette. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "Karl-Fischer volumetric titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000131
<http://purl.allotrope.org/ontologies/process#AFP_0000131> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "partition chromatography"^^xsd:string ;
                                                           core:definition "Chromatography in which separation is based mainly on differences between the solubility of the sample components in the stationary phase (gas chromatography), or on differences between the solubilities of the components in the mobile and stationary phases (liquid chromatography). [CHMO]"^^xsd:string ;
                                                           core:prefLabel "partition chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000142
<http://purl.allotrope.org/ontologies/process#AFP_0000142> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "flame ionization measurement"^^xsd:string ;
                                                           core:altLabel "FID"^^xsd:string ,
                                                                         "flame ionization detection"^^xsd:string ,
                                                                         "flame ionization process"^^xsd:string ;
                                                           core:definition "A flame ionization measurement is a measurement which is sensitive to compounds containing C-H bonds. A flow of carrier gas containing the sample is mixed with H2 and air and ignited. Any positively-charged radicals resulting from this process are collected at a cathode, allowing the current to be measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "flame ionization measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000161
<http://purl.allotrope.org/ontologies/process#AFP_0000161> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003336> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "cleaning"^^xsd:string ;
                                                           core:altLabel "cleansing"^^xsd:string ,
                                                                         "cleanup"^^xsd:string ;
                                                           core:definition "Cleaning is the process of getting rid of dirt, impurities, or extraneous unwanted matter. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "cleaning"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000225
<http://purl.allotrope.org/ontologies/process#AFP_0000225> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
