                                                         rdfs:label "liquid mobile phase"^^xsd:string ;
                                                         core:definition "The liquid mobile phase is a role of a liquid material that percolates through the stationary bed in chromatography. [Allotrope, CHMO]"^^xsd:string ;
                                                         core:prefLabel "liquid mobile phase"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000340
<http://purl.allotrope.org/ontologies/role#AFRL_0000340> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000291> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "detector role"^^xsd:string ;
                                                         core:altLabel "detector"^^xsd:string ;
                                                         core:definition "The detector role is a detection role of a material entity that is detecting some other entity. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "detector role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000344
<http://purl.allotrope.org/ontologies/role#AFRL_0000344> rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:BFO_0000054 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0001348>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "synthesis role"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Change to subclasses to equivalent class. [Allotrope]"^^xsd:string ;
                                                         core:definition "A synthesis role is a role of a material that is participating in a synthesis (material conversion) process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "synthesis role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000345
<http://purl.allotrope.org/ontologies/role#AFRL_0000345> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000344> ;
