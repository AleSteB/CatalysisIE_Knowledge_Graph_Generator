###  http://purl.obolibrary.org/obo/IAO_0000136
obo:IAO_0000136 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain obo:IAO_0000030 ;
                rdfs:label "is about"^^xsd:string ;
                core:example "This document is about information artifacts and their representations. [IAO]"^^xsd:string ;
                core:prefLabel "is about"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000219
obo:IAO_0000219 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:IAO_0000136 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "denotes"^^xsd:string ;
                core:definition "Denotes is a primitive, instance-level, relation obtaining between an information content entity and some portion of reality. Denotation is what happens when someone creates an information content entity E in order to specifically refer to something. The only relation between E and the thing is that E can be used to 'pick out' the thing. This relation connects those two together. Freedictionary.com sense 3: To signify directly; refer to specifically [IAO]"^^xsd:string ;
                core:example "A person's name denotes the person. [IAO]"^^xsd:string ,
                             "A variable name in a computer program denotes some piece of memory. [IAO]"^^xsd:string ,
                             "Lexically equivalent strings can denote different things, for instance \"Alan\" can denote different people. In each case of use, there is a case of the denotation relation obtaining, between \"Alan\" and the person that is being named. [IAO]"^^xsd:string ;
                core:prefLabel "denotes"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000314
obo:OBI_0000314 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prop:AFX_0002821 ;
                rdfs:domain obo:BFO_0000002 ;
                rdfs:range obo:BFO_0000002 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "proxy for"^^xsd:string ;
                core:altLabel "is proxy for"^^xsd:string ;
                core:definition "A relation between continuant instances c1 and c2 where within a protocol application, measurement of c1 is related to a what would be the measurement of c2. [OBI]"^^xsd:string ;
                core:example "Florescent intensity is proxy for amount of protein labeled with GFP [OBI]"^^xsd:string ,
                             "position on a gel is proxy for mass and charge of molecule in an western blot [OBI]"^^xsd:string ;
                core:prefLabel "proxy for"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000643
obo:OBI_0000643 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prop:AFX_0002793 ;
                owl:inverseOf obo:OBI_0000645 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "has grain"^^xsd:string ;
                core:definition "The relation of the cells in the finger of the skin to the finger, in which an indeterminate number of grains are parts of the whole by virtue of being grains in a collective that is part of the whole, and in which removing one granular part does not nec- essarily damage or diminish the whole. Ontological Whether there is a fixed, or nearly fixed number of parts - e.g. fingers of the hand, chambers of the heart, or wheels of a car - such that there can be a notion of a single one being missing, or whether, by contrast, the number of parts is indeterminate - e.g., cells in the skin of the hand, red cells in blood, or rubber molecules in the tread of the tire of the wheel of the car. [OBI]"^^xsd:string ;
                core:prefLabel "has grain"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000645
obo:OBI_0000645 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prop:AFX_0002846 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "is grain of"^^xsd:string ;
                core:definition "A relation between granular parts and the whole of which they are a part. Granular parts have indeterminate number such that removing one granular part does not necessarily damage or diminish the whole. [OBI]"^^xsd:string ;
                core:prefLabel "is grain of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000052
obo:RO_0000052 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002314 ;
               owl:inverseOf obo:RO_0000053 ;
               rdfs:label "inheres in"^^xsd:string ;
               core:prefLabel "inheres in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000053
obo:RO_0000053 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:range obo:BFO_0000020 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "bearer of"^^xsd:string ;
               core:altLabel "is bearer of"^^xsd:string ;
               core:definition "A relation between an independent continuant (the bearer) and a specifically dependent continuant (the dependent), in which the dependent specifically depends on the bearer for its existence. [RO]"^^xsd:string ;
               core:editorialNote "A bearer can have many dependents, and its dependents can exist for different periods of time, but none of its dependents can exist when the bearer does not exist. [RO]"^^xsd:string ;
               core:example "this apple is bearer of this red color"^^xsd:string ,
                            "this vase is bearer of this fragility"^^xsd:string ;
               core:prefLabel "bearer of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000056
obo:RO_0000056 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf obo:RO_0000057 ;
               rdfs:domain obo:BFO_0000002 ;
               rdfs:range obo:BFO_0000003 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "participates in"^^xsd:string ;
               core:altLabel "is participant of"^^xsd:string ;
               core:definition "A relation between a continuant and a process, in which the continuant is somehow involved in the process [RO]"^^xsd:string ;
               core:prefLabel "participates in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000057
obo:RO_0000057 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain obo:BFO_0000003 ;
               rdfs:range obo:BFO_0000002 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has participant"^^xsd:string ;
               core:definition "A relation between a process and a continuant, in which the continuant is somehow involved in the process [RO]"^^xsd:string ;
               core:example "this blood coagulation has participant this blood clot"^^xsd:string ,
                            "this investigation has participant this investigator"^^xsd:string ,
                            "this process has participant this input material (or this output material)"^^xsd:string ;
               core:prefLabel "has participant"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000058
obo:RO_0000058 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf obo:RO_0000059 ;
               rdfs:domain obo:BFO_0000031 ;
               rdfs:range obo:BFO_0000020 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "concretized by"^^xsd:string ;
               core:altLabel "is concretized as"^^xsd:string ;
               core:definition "A relationship between a generically dependent continuant and a specifically dependent continuant, in which the generically dependent continuant depends on some independent continuant in virtue of the fact that the specifically dependent continuant also depends on that same independent continuant. A generically dependent continuant may be concretized as multiple specifically dependent continuants. [RO]"^^xsd:string ;
               core:example "A journal article is an information artifact that inheres in some number of printed journals. For each copy of the printed journal there is some quality that carries the journal article, such as a pattern of ink. The journal article (a generically dependent continuant) is concretized as the quality (a specifically dependent continuant), and both depend on that copy of the printed journal (an independent continuant). [RO]"^^xsd:string ,
                            "An investigator reads a protocol and forms a plan to carry out an assay. The plan is a realizable entity (a specifically dependent continuant) that concretizes the protocol (a generically dependent continuant), and both depend on the investigator (an independent continuant). The plan is then realized by the assay (a process). [RO]"^^xsd:string ;
               core:prefLabel "concretized by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000059
obo:RO_0000059 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain obo:BFO_0000020 ;
               rdfs:range obo:BFO_0000031 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "concretizes"^^xsd:string ;
               core:definition "A relationship between a specifically dependent continuant and a generically dependent continuant, in which the generically dependent continuant depends on some independent continuant in virtue of the fact that the specifically dependent continuant also depends on that same independent continuant. Multiple specifically dependent continuants can concretize the same generically dependent continuant. [RO]"^^xsd:string ;
               core:example "A journal article is an information artifact that inheres in some number of printed journals. For each copy of the printed journal there is some quality that carries the journal article, such as a pattern of ink. The quality (a specifically dependent continuant) concretizes the journal article (a generically dependent continuant), and both depend on that copy of the printed journal (an independent continuant)."^^xsd:string ,
                            "An investigator reads a protocol and forms a plan to carry out an assay. The plan is a realizable entity (a specifically dependent continuant) that concretizes the protocol (a generically dependent continuant), and both depend on the investigator (an independent continuant). The plan is then realized by the assay (a process)."^^xsd:string ;
               core:prefLabel "concretizes"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000079
obo:RO_0000079 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000085 ;
               rdfs:domain obo:BFO_0000034 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "function of"^^xsd:string ;
               core:altLabel "is function of"^^xsd:string ;
               core:definition "A relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence. [RO]"^^xsd:string ;
               core:prefLabel "function of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000080
obo:RO_0000080 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000086 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "quality of"^^xsd:string ;
               core:definition "Inverse of has quality [RO]"^^xsd:string ;
               core:prefLabel "quality of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000081
obo:RO_0000081 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               owl:inverseOf obo:RO_0000087 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "role of"^^xsd:string ;
               core:altLabel "is role of"^^xsd:string ;
               core:definition "A relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence. [RO]"^^xsd:string ;
               core:prefLabel "role of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000085
obo:RO_0000085 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000034 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has function"^^xsd:string ;
               core:definition "A relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence. [RO]"^^xsd:string ;
               core:editorialNote "A bearer can have many functions, and its functions can exist for different periods of time, but none of its functions can exist when the bearer does not exist. A function need not be realized at all the times that the function exists. [RO]"^^xsd:string ;
               core:example "this enzyme has function this catalysis function (more colloquially: this enzyme has this catalysis function)"^^xsd:string ;
               core:prefLabel "has function"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000086
obo:RO_0000086 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:range obo:BFO_0000019 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has quality"^^xsd:string ;
               core:definition "A relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence. [RO]"^^xsd:string ;
               core:editorialNote "A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist. [RO]"^^xsd:string ;
               core:example "this apple has quality this red color"^^xsd:string ;
               core:prefLabel "has quality"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000087
obo:RO_0000087 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000023 ;
               oboI:hasDbXref "RO:0000087"^^xsd:string ;
               oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
               oboI:id "has_role"^^xsd:string ;
               oboI:is_cyclic "false"^^xsd:boolean ;
               oboI:is_transitive "false"^^xsd:boolean ;
               oboI:shorthand "has_role"^^xsd:string ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has role"^^xsd:string ;
               core:definition "A relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence [RO]"^^xsd:string ;
               core:editorialNote "A bearer can have many roles, and its roles can exist for different periods of time, but none of its roles can exist when the bearer does not exist. A role need not be realized at all the times that the role exists.  [RO]"^^xsd:string ;
               core:example "this person has role this investigator role (more colloquially: this person has this role of investigator) [RO]"^^xsd:string ;
               core:prefLabel "has role"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000091
obo:RO_0000091 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000053 ;
               owl:inverseOf obo:RO_0000092 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000016 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has disposition"^^xsd:string ;
               core:definition "A relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence, [RO]"^^xsd:string ;
               core:prefLabel "has disposition"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0000092
obo:RO_0000092 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000052 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "disposition of"^^xsd:string ;
               core:definition "Inverse of has disposition [RO]"^^xsd:string ;
               core:prefLabel "disposition of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0001000
obo:RO_0001000 rdf:type owl:ObjectProperty ;
               owl:inverseOf obo:RO_0001001 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "derives from"^^xsd:string ;
               core:definition "A relation between two distinct material entities, the new entity and the old entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity. [RO]"^^xsd:string ;
               core:example "this cell derives from this parent cell (cell division)"^^xsd:string ,
                            "this nucleus derives from this parent nucleus (nuclear division)"^^xsd:string ;
               core:prefLabel "derives from"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0001001
obo:RO_0001001 rdf:type owl:ObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "derives into"^^xsd:string ;
               core:definition "A relation between two distinct material entities, the old entity and the new entity, in which the new entity begins to exist when the old entity ceases to exist, and the new entity inherits the significant portion of the matter of the old entity. [RO]"^^xsd:string ;
               core:editorialNote "This is a very general relation. More specific relations are preferred when applicable, such as 'directly develops into'. To avoid making statements about a future that may not come to pass, it is often better to use the backward-looking 'derives from' rather than the forward-looking 'derives into'. [RO]"^^xsd:string ;
               core:prefLabel "derives into"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0001015
obo:RO_0001015 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000004 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "location of"^^xsd:string ;
               core:altLabel "is location of"^^xsd:string ;
               core:definition "a relation between two independent continuants, the location and the target, in which the target is entirely within the location [RO]"^^xsd:string ;
               core:example "this cage is the location of this rat"^^xsd:string ;
               core:prefLabel "location of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0001025
obo:RO_0001025 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000004 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "located in"^^xsd:string ;
               core:definition "A relation between two independent continuants, the target and the location, in which the target is entirely within the location. [RO]"^^xsd:string ;
               core:prefLabel "located in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002000
obo:RO_0002000 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               owl:inverseOf obo:RO_0002002 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "2D boundary of"^^xsd:string ;
               core:altLabel "boundary of"^^xsd:string ,
                             "is 2D boundary of"^^xsd:string ,
                             "is boundary of"^^xsd:string ;
               core:definition "a relation between a 2D immaterial entity (the boundary) and a material entity, in which the boundary delimits the material entity [RO]"^^xsd:string ;
               core:editorialNote "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts. [RO]"^^xsd:string ,
                                  "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape. [RO]"^^xsd:string ;
               core:example "the surface of my skin is a 2D boundary of my body"^^xsd:string ;
               core:prefLabel "2D boundary of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002002
obo:RO_0002002 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has 2D boundary"^^xsd:string ;
               core:definition "a relation between a material entity and a 2D immaterial entity (the boundary), in which the boundary delimits the material entity [RO]"^^xsd:string ;
               core:editorialNote "A 2D boundary may have holes and gaps, but it must be a single connected entity, not an aggregate of several disconnected parts. [RO]"^^xsd:string ,
                                  "Although the boundary is two-dimensional, it exists in three-dimensional space and thus has a 3D shape. [RO]"^^xsd:string ;
               core:prefLabel "has 2D boundary"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002012
obo:RO_0002012 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000050 ,
                                  obo:RO_0002418 ;
               rdfs:domain obo:BFO_0000003 ;
               rdfs:range obo:BFO_0000003 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "occurrent part of"^^xsd:string ;
               core:definition "A part of relation that applies only between occurrents. [RO]"^^xsd:string ;
               core:prefLabel "occurrent part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002081
obo:RO_0002081 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "before or simultaneous with"^^xsd:string ;
               core:definition "Primitive instance level timing relation between events [RO]"^^xsd:string ;
               core:prefLabel "before or simultaneous with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002082
obo:RO_0002082 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002081 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "simultaneous with"^^xsd:string ;
               core:definition "t1 simultaneous_with t2 iff:= t1 before_or_simultaneous_with t2 and not (t1 before t2) [RO]"^^xsd:string ;
               core:prefLabel "simultaneous with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002083
obo:RO_0002083 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002081 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "before"^^xsd:string ;
               core:definition "t1 before t2 iff:= t1 before_or_simulataneous_with t2 and not (t1 simultaneous_with t2) [RO]"^^xsd:string ;
               core:prefLabel "before"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002084
obo:RO_0002084 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               owl:inverseOf obo:RO_0002093 ;
               rdfs:label "during which ends"^^xsd:string ;
               core:prefLabel "during which ends"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002085
obo:RO_0002085 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002088 ;
               owl:inverseOf obo:RO_0002092 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:label "encompasses"^^xsd:string ;
               core:prefLabel "encompasses"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002086
obo:RO_0002086 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               rdf:type owl:TransitiveProperty ;
               owl:propertyChainAxiom ( obo:RO_0002093
                                        obo:BFO_0000062
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "ends after"^^xsd:string ;
               core:definition "X ends_after Y iff: end(Y) before_or_simultaneous_with end(X) [RO]"^^xsd:string ;
               core:prefLabel "ends after"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002087
obo:RO_0002087 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000062 ;
               owl:inverseOf obo:RO_0002090 ;
               owl:propertyChainAxiom ( obo:RO_0002224
                                        obo:RO_0002230
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "immediately preceded by"^^xsd:string ;
               core:altLabel "starts at end of"^^xsd:string ;
               core:definition "X immediately_preceded_by Y iff: end(X) simultaneous_with start(Y) [RO]"^^xsd:string ;
               core:prefLabel "immediately preceded by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002088
obo:RO_0002088 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               owl:inverseOf obo:RO_0002091 ;
               rdfs:label "during which starts"^^xsd:string ;
               core:prefLabel "during which starts"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002089
obo:RO_0002089 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               rdf:type owl:TransitiveProperty ;
               owl:propertyChainAxiom ( obo:RO_0002091
                                        obo:BFO_0000062
                                      ) ;
               rdfs:label "starts before"^^xsd:string ;
               core:prefLabel "starts before"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002090
obo:RO_0002090 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000063 ;
               owl:propertyChainAxiom ( obo:RO_0002230
                                        obo:RO_0002224
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "immediately precedes"^^xsd:string ;
               core:altLabel "ends at start of"^^xsd:string ,
                             "meets"^^xsd:string ;
               core:definition "X immediately_precedes_Y iff: end(X) simultaneous_with start(Y) [RO]"^^xsd:string ;
               core:prefLabel "immediately precedes"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002091
obo:RO_0002091 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "starts during"^^xsd:string ;
               core:definition "X starts_during Y iff: (start(Y) before_or_simultaneous_with start(X)) AND (start(X) before_or_simultaneous_with end(Y)) [RO]"^^xsd:string ;
               core:prefLabel "starts during"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002092
obo:RO_0002092 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002093 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "happens during"^^xsd:string ;
               core:altLabel "during"^^xsd:string ;
               core:definition "X happens_during Y iff: (start(Y) before_or_simultaneous_with start(X)) AND (end(X) before_or_simultaneous_with end(Y)) [RO]"^^xsd:string ;
               core:prefLabel "happens during"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002093
obo:RO_0002093 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002222 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "ends during"^^xsd:string ;
               core:definition "X ends_during Y iff: ((start(Y) before_or_simultaneous_with end(X)) AND end(X) before_or_simultaneous_with end(Y). [RO]"^^xsd:string ;
               core:prefLabel "ends during"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002131
obo:RO_0002131 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               owl:propertyChainAxiom ( obo:BFO_0000050
                                        obo:BFO_0000050
                                      ) ,
                                      ( obo:BFO_0000051
                                        obo:BFO_0000050
                                      ) ,
                                      ( obo:BFO_0000051
                                        obo:RO_0002131
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "overlaps"^^xsd:string ;
               core:definition "x overlaps y if and only if there exists some z such that x has part z and z part of y [RO]"^^xsd:string ;
               core:prefLabel "overlaps"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002150
obo:RO_0002150 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:range obo:BFO_0000004 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "continuous with"^^xsd:string ;
               core:definition "X continuous_with Y if and only if X and Y share a fiat boundary. [RO]"^^xsd:string ;
               core:prefLabel "continuous with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002163
obo:RO_0002163 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "spatially disjoint from"^^xsd:string ;
               core:definition "A is spatially_disjoint_from B if and only if they have no parts in common [RO]"^^xsd:string ;
               core:editorialNote "Note that it would be possible to use the relation to label the relationship between a near infinite number of structures - between the rings of saturn and my left earlobe. The intent is that this is used for parsiomoniously for disambiguation purposes - for example, between siblings in a jointly exhaustive pairwise disjointness hierarchy [RO]"^^xsd:string ;
               core:prefLabel "spatially disjoint from"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002170
obo:RO_0002170 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               owl:propertyChainAxiom ( [ owl:inverseOf obo:RO_0002176
                                        ]
                                        obo:RO_0002176
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "connected to"^^xsd:string ;
               core:definition "a is connected to b if and only if a and b are discrete structure, and there exists some connecting structure c, such that c connects a and b [RO]"^^xsd:string ;
               core:prefLabel "connected to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002176
obo:RO_0002176 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               rdfs:domain obo:BFO_0000004 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "connects"^^xsd:string ;
               core:definition "C connects a if and only if there exist some b such that a and b are similar parts of the same system, and c connects b, specifically, c connects a with b. When one structure connects two others it unites some aspect of the function or role they play within the system. [IAO]"^^xsd:string ;
               core:prefLabel "connects"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002177
obo:RO_0002177 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002323 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               owl:propertyChainAxiom ( obo:RO_0002371
                                        obo:BFO_0000050
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "attached to part of"^^xsd:string ;
               core:definition "A is attached to part of b if a is attached to b, or a is attached to some p, where p is part of b. [IAO]"^^xsd:string ;
               core:prefLabel "attached to part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002180
obo:RO_0002180 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has component"^^xsd:string ;
               core:definition "W 'has component' p if w 'has part' p and w is such that it can be directly disassembled into into n parts p, p2, p3, ..., pn, where these parts are of similar type. [RO]"^^xsd:string ;
               core:editorialNote "For use in recording has_part with a cardinality constraint, because OWL does not permit cardinality constraints to be used in combination with transitive object properties. In situations where you would want to say something like 'has part exactly 5 digit, you would instead use has_component exactly 5 digit. [RO]"^^xsd:string ;
               core:prefLabel "has component"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002211
obo:RO_0002211 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002418 ;
               owl:inverseOf obo:RO_0002334 ;
               rdfs:domain obo:BFO_0000015 ;
               rdfs:range obo:BFO_0000015 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "regulates"^^xsd:string ;
               core:definition "Process(P1) regulates process(P2) iff: P1 results in the initiation or termination of P2 OR affects the frequency of its initiation or termination OR affects the magnitude or rate of output of P2. [RO]"^^xsd:string ;
               core:prefLabel "regulates"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002212
obo:RO_0002212 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002211 ,
                                  obo:RO_0002305 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "negatively regulates (process to process)"^^xsd:string ;
               core:definition "Process(P1) negatively regulates process(P2) iff: P1 terminates P2, or P1 descreases the the frequency of initiation of P2 or the magnitude or rate of output of P2. [RO]"^^xsd:string ;
               core:prefLabel "negatively regulates (process to process)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002213
obo:RO_0002213 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002211 ,
                                  obo:RO_0002304 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "positively regulates (process to process)"^^xsd:string ;
               core:definition "Process(P1) positively regulates process(P2) iff: P1 initiates P2, or P1 increases the the frequency of initiation of P2 or the magnitude or rate of output of P2. [RO]"^^xsd:string ;
               core:prefLabel "positively regulates (process to process)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002215
obo:RO_0002215 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002216 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "capable of"^^xsd:string ;
               core:altLabel "has function realized in"^^xsd:string ;
               core:definition "A relation between a material entity (such as a cell) and a process, in which the material entity has the ability to carry out the process. [RO]"^^xsd:string ;
               core:editorialNote "this relation has a shortcut definition in which the expression \"capable of some P\" expands to \"bearer_of (some realized_by only P)"^^xsd:string ;
               core:example "mechanosensory neuron capable of detection of mechanical stimulus involved in sensory perception [RO]"^^xsd:string ;
               core:prefLabel "capable of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002216
obo:RO_0002216 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002328 ,
                                  obo:RO_0002500 ;
               owl:propertyChainAxiom ( obo:RO_0002215
                                        obo:BFO_0000050
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "capable of part of"^^xsd:string ;
               core:altLabel "has function in"^^xsd:string ;
               core:definition "C stands in this relationship to p if and only if there exists some p' such that c is capable_of p', and p' is part_of p. [RO]"^^xsd:string ;
               core:prefLabel "capable of part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002217
obo:RO_0002217 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000056 ;
               owl:inverseOf obo:RO_0002218 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "actively participates in"^^xsd:string ;
               core:altLabel "agent in"^^xsd:string ;
               core:definition "X actively participates in y if and only if x participates in y and x realizes some active role [RO]"^^xsd:string ;
               core:prefLabel "actively participates in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002218
obo:RO_0002218 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000057 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has active participant"^^xsd:string ;
               core:altLabel "has agent"^^xsd:string ;
               core:definition "X has participant y if and only if x realizes some active role that inheres in y [RO]"^^xsd:string ;
               core:prefLabel "has active participant"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002219
obo:RO_0002219 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002220 ;
               owl:inverseOf obo:RO_0002221 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "surrounded by"^^xsd:string ;
               core:definition "X surrounded_by y if and only if (1) x is adjacent to y and for every region r that is adjacent to x, r overlaps y (2) the shared boundary between x and y occupies the majority of the outermost boundary of x [RO]"^^xsd:string ;
               core:prefLabel "surrounded by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002220
obo:RO_0002220 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002163 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "adjacent to"^^xsd:string ;
               core:definition "X adjacent to y if and only if x and y share a boundary. [RO]"^^xsd:string ;
               core:example "A caterpillar walking on the surface of a leaf is adjacent_to the leaf, if one of the caterpillar appendages is touching the leaf. In contrast, a butterfly flying close to a flower is not considered adjacent, unless there are any touching parts."^^xsd:string ,
                            "The epidermis layer of a vertebrate is adjacent to the dermis."^^xsd:string ,
                            "The plasma membrane of a cell is adjacent to the cytoplasm, and also to the cell lumen which the cytoplasm occupies."^^xsd:string ,
                            "The skin of the forelimb is adjacent to the skin of the torso if these are considered anatomical subdivisions with a defined border. Otherwise a relation such as continuous_with would be used."^^xsd:string ;
               core:prefLabel "adjacent to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002221
obo:RO_0002221 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002220 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "surrounds"^^xsd:string ;
               core:definition "Inverse of surrounded by [RO]"^^xsd:string ;
               core:prefLabel "surrounds"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002222
obo:RO_0002222 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain obo:BFO_0000003 ;
               rdfs:range obo:BFO_0000003 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "temporally related to"^^xsd:string ;
               core:definition "A relation that holds between two occurrents. This is a grouping relation that collects together all the Allen relations. [RO]"^^xsd:string ;
               core:prefLabel "temporally related to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002223
obo:RO_0002223 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000050 ,
                                  obo:RO_0002222 ;
               owl:inverseOf obo:RO_0002224 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "starts"^^xsd:string ;
               core:definition "Inverse of starts with [RO]"^^xsd:string ;
               core:prefLabel "starts"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002224
obo:RO_0002224 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ,
                                  obo:RO_0002222 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "starts with"^^xsd:string ;
               core:definition "X starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) and ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point. [RO]"^^xsd:string ;
               core:prefLabel "starts with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002229
obo:RO_0002229 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000050 ,
                                  obo:RO_0002222 ;
               owl:inverseOf obo:RO_0002230 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "ends"^^xsd:string ;
               core:definition "Inverse of ends with [RO]"^^xsd:string ;
               core:prefLabel "ends"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002230
obo:RO_0002230 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ,
                                  obo:RO_0002222 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "ends with"^^xsd:string ;
               core:definition "X ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) > α(x) and ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point. [RO]"^^xsd:string ;
               core:prefLabel "ends with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002263
obo:RO_0002263 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002264 ;
               owl:propertyChainAxiom ( obo:RO_0002327
                                        obo:RO_0002411
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "acts upstream of"^^xsd:string ;
               core:definition "C involved in regulation of p if c enables 'p' and p' causally upstream of p [RO]"^^xsd:string ;
               core:prefLabel "acts upstream of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002264
obo:RO_0002264 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002500 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "acts upstream of or within"^^xsd:string ;
               core:definition "C acts upstream of or within p if c is enables 'p' and p' causally upstream of or within p [RO]"^^xsd:string ;
               core:prefLabel "acts upstream of or within"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002304
obo:RO_0002304 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002411 ;
               rdfs:label "causally upstream of, positive effect"^^xsd:string ;
               core:prefLabel "causally upstream of, positive effect"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002305
obo:RO_0002305 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002411 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causally upstream of, negative effect"^^xsd:string ;
               core:definition "holds between x and y if and only if x is causally upstream of y and the progression of x decreases the frequency, rate or extent of y [RO]"^^xsd:string ;
               core:prefLabel "causally upstream of, negative effect"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002314
obo:RO_0002314 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002502 ;
               owl:propertyChainAxiom ( obo:RO_0000052
                                        obo:BFO_0000050
                                      ) ,
                                      ( obo:RO_0002314
                                        obo:BFO_0000050
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "inheres in part of"^^xsd:string ;
               core:definition "Q inheres in part of w if and only if there exists some p such that q inheres in p and p part of w. [RO]"^^xsd:string ;
               core:prefLabel "inheres in part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002323
obo:RO_0002323 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "mereotopologically related to"^^xsd:string ;
               core:definition "A mereological relationship or a topological relationship [RO]"^^xsd:string ;
               core:editorialNote "Do not use this relation directly. It is ended as a grouping for a diverse set of relations, all involving parthood or connectivity relationships [RO]"^^xsd:string ;
               core:prefLabel "mereotopologically related to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002326
obo:RO_0002326 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002216 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "contributes to"^^xsd:string ;
               core:definition "if and only if exists c', p' c part_of c' and c' capable_of p and c capable_of p' and p' part_of p then c contributes_to p [RO]"^^xsd:string ;
               core:prefLabel "contributes to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002327
obo:RO_0002327 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002215 ;
               owl:inverseOf obo:RO_0002333 ;
               rdfs:label "enables"^^xsd:string ;
               core:altLabel "catalyzes"^^xsd:string ,
                             "executes"^^xsd:string ;
               core:editorialNote "This relation differs from the parent relation 'capable of' in that the parent is weaker and only expresses a capability that may not be actually realized, whereas this relation is always realized. [RO]"^^xsd:string ;
               core:example "a particular instances of akt-2 enables some instance of protein kinase activity [RO]"^^xsd:string ;
               core:prefLabel "enables"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002328
obo:RO_0002328 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "functionally related to"^^xsd:string ;
               core:definition "This is a grouping relation that collects relations used for the purpose of connecting structure and function. [RO]"^^xsd:string ;
               core:prefLabel "functionally related to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002331
obo:RO_0002331 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002431 ;
               owl:propertyChainAxiom ( obo:RO_0002327
                                        obo:BFO_0000050
                                      ) ,
                                      ( obo:RO_0002331
                                        obo:BFO_0000050
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "involved in"^^xsd:string ;
               core:altLabel "actively involved in"^^xsd:string ,
                             "enables part of"^^xsd:string ;
               core:definition "C involved_in p if and only if c enables some process p', and p' is part of p [RO]"^^xsd:string ;
               core:prefLabel "involved in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002332
obo:RO_0002332 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000057 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "regulates levels of (process to entity)"^^xsd:string ;
               core:altLabel "regulates levels of"^^xsd:string ;
               core:definition "P regulates levels of c if p regulates some amount (PATO:0000070) of c [RO]"^^xsd:string ;
               core:example "every cellular sphingolipid homeostasis process regulates_level_of some sphingolipid"^^xsd:string ;
               core:prefLabel "regulates levels of (process to entity)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002333
obo:RO_0002333 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002328 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "enabled by"^^xsd:string ;
               core:definition "inverse of enables [RO]"^^xsd:string ;
               core:prefLabel "enabled by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002334
obo:RO_0002334 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002427 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain obo:BFO_0000015 ;
               rdfs:range obo:BFO_0000015 ;
               rdfs:label "regulated by"^^xsd:string ;
               core:prefLabel "regulated by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002335
obo:RO_0002335 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002334 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "negatively regulated by"^^xsd:string ;
               core:definition "Inverse of negatively regulates [RO]"^^xsd:string ;
               core:prefLabel "negatively regulated by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002336
obo:RO_0002336 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002334 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "positively regulated by"^^xsd:string ;
               core:definition "Inverse of positively regulates [RO]"^^xsd:string ;
               core:prefLabel "positively regulated by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002337
obo:RO_0002337 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "related via localization to"^^xsd:string ;
               core:definition "A relationship that holds via some process of localization. [RO]"^^xsd:string ;
               core:prefLabel "related via localization to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002338
obo:RO_0002338 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002344 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has target start location"^^xsd:string ;
               core:definition "This relationship holds between p and l when p is a transport or localization process in which the outcome is to move some cargo c from some initial location l to some destination. [RO]"^^xsd:string ;
               core:prefLabel "has target start location"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002339
obo:RO_0002339 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002344 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has target end location"^^xsd:string ;
               core:definition "This relationship holds between p and l when p is a transport or localization process in which the outcome is to move some cargo c from a an initial location to some destination l. [RO]"^^xsd:string ;
               core:prefLabel "has target end location"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002341
obo:RO_0002341 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002337 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "results in transport along"^^xsd:string ;
               core:definition "Holds between p and l when p is a transportation or localization process and the outcome of this process is to move c from one location to another, and the route taken by c follows a path that is aligned_with l. [RO]"^^xsd:string ;
               core:prefLabel "results in transport along"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002342
obo:RO_0002342 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002344 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "results in transport across"^^xsd:string ;
               core:definition "Holds between p and m when p is a transportation or localization process and the outcome of this process is to move c from one location to another, and the route taken by c follows a path that crosses m. [RO]"^^xsd:string ;
               core:prefLabel "results in transport across"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002344
obo:RO_0002344 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002337 ;
               rdfs:label "results in transport to from or in"^^xsd:string ;
               core:example "'mitochondrial transport' results_in_transport_to_from_or_in some  mitochondrion (GO:0005739)"^^xsd:string ;
               core:prefLabel "results in transport to from or in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002350
obo:RO_0002350 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf prop:AFX_0002846 ;
               owl:inverseOf obo:RO_0002351 ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "member of"^^xsd:string ;
               core:altLabel "member part of"^^xsd:string ;
               core:definition "Inverse of has member"^^xsd:string ;
               core:example "An organism that is a member of a population of organisms. [RO]"^^xsd:string ;
               core:prefLabel "member of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002351
obo:RO_0002351 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf prop:AFX_0002793 ;
               rdf:type owl:AsymmetricProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has member"^^xsd:string ;
               core:definition "Has member is a mereological relation between a collection and an item. [RO]"^^xsd:string ;
               core:prefLabel "has member"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002371
obo:RO_0002371 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002170 ,
                                  obo:RO_0002177 ;
               rdf:type owl:SymmetricProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "attached to"^^xsd:string ;
               core:definition "A is attached to b if and only if a and b are discrete objects or object parts, and there are physical connections between a and b such that a force pulling a will move b, or a force pulling b will move a. [IAO]"^^xsd:string ;
               core:prefLabel "attached to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002379
obo:RO_0002379 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002131 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "spatially coextensive with"^^xsd:string ;
               core:definition "X spatially_coextensive_with y if and only if x and y have the same location [RO]"^^xsd:string ;
               core:example "A lump of clay and a statue"^^xsd:string ;
               core:prefLabel "spatially coextensive with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002404
obo:RO_0002404 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000062 ,
                                  obo:RO_0002427 ;
               owl:inverseOf obo:RO_0002411 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causally downstream of"^^xsd:string ;
               core:definition "inverse of upstream of [RO]"^^xsd:string ;
               core:prefLabel "causally downstream of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002405
obo:RO_0002405 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002087 ,
                                  obo:RO_0002404 ;
               owl:inverseOf obo:RO_0002412 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "immediately causally downstream of"^^xsd:string ;
               core:definition "inverse of immediately causally upstream of"^^xsd:string ;
               core:prefLabel "immediately causally downstream of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002410
obo:RO_0002410 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002609 ;
               rdfs:label "causally related to"^^xsd:string ;
               core:editorialNote "Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect. [IAO]"^^xsd:string ;
               core:note "This relation groups causal relations between material entities and causal relations between processes. [IAO]"^^xsd:string ;
               core:prefLabel "causally related to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002411
obo:RO_0002411 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000063 ,
                                  obo:RO_0002418 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causally upstream of"^^xsd:string ;
               core:definition "P is causally upstream of q if and only if p precedes q and p and q are linked in a causal chain [RO]"^^xsd:string ;
               core:prefLabel "causally upstream of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002412
obo:RO_0002412 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002090 ,
                                  obo:RO_0002411 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "immediately causally upstream of"^^xsd:string ;
               core:definition "P is immediately causally upstream of q if and only if both (a) p immediately precedes q and (b) p is causally upstream of q. In addition, the output of p must be an input of q. [RO]"^^xsd:string ;
               core:prefLabel "immediately causally upstream of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002418
obo:RO_0002418 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002501 ;
               owl:inverseOf obo:RO_0002427 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causally upstream of or within"^^xsd:string ;
               core:altLabel "affects"^^xsd:string ;
               core:definition "P 'causally upstream or within' q if and only if (1) the end of p is before the end of q and (2) the execution of p exerts some causal influence over the outputs of q; i.e. if p was abolished or the outputs of p were to be modified, this would necessarily affect q. [RO]"^^xsd:string ;
               core:prefLabel "causally upstream of or within"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002427
obo:RO_0002427 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002501 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:label "causally downstream of or within"^^xsd:string ;
               core:prefLabel "causally downstream of or within"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002428
obo:RO_0002428 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002263 ,
                                  obo:RO_0002431 ;
               owl:propertyChainAxiom ( obo:RO_0002327
                                        obo:RO_0002211
                                      ) ,
                                      ( obo:RO_0002331
                                        obo:RO_0002211
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "involved in regulation of"^^xsd:string ;
               core:definition "C involved in regulation of p if c is involved in some 'p' and p' regulates some p [RO]"^^xsd:string ;
               core:prefLabel "involved in regulation of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002429
obo:RO_0002429 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002428 ;
               owl:propertyChainAxiom ( obo:RO_0002327
                                        obo:RO_0002213
                                      ) ,
                                      ( obo:RO_0002331
                                        obo:RO_0002213
                                      ) ;
               rdfs:label "involved in positive regulation of"^^xsd:string ;
               core:prefLabel "involved in positive regulation of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002430
obo:RO_0002430 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002428 ;
               owl:propertyChainAxiom ( obo:RO_0002327
                                        obo:RO_0002212
                                      ) ,
                                      ( obo:RO_0002331
                                        obo:RO_0002212
                                      ) ;
               rdfs:label "involved in negative regulation of"^^xsd:string ;
               core:prefLabel "involved in negative regulation of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002431
obo:RO_0002431 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002264 ,
                                  obo:RO_0002328 ,
                                  obo:RO_0002500 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "involved in or involved in regulation of"^^xsd:string ;
               core:altLabel "involved in or regulates"^^xsd:string ;
               core:definition "C involved in or regulates p if and only if either (i) c is involved in p or (ii) c is involved in regulation of p [RO]"^^xsd:string ;
               core:prefLabel "involved in or involved in regulation of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002434
obo:RO_0002434 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "interacts with"^^xsd:string ;
               core:altLabel "pairwise interacts with"^^xsd:string ;
               core:definition "A relationship that holds between two entities in which the processes executed by the two entities are causally connected. [RO]"^^xsd:string ;
               core:editorialNote "This relation and all sub-relations can be applied to either (1) pairs of entities that are interacting at any moment of time (2) populations or species of entity whose members have the disposition to interact (3) classes whose members have the disposition to interact. [RO]"^^xsd:string ;
               core:prefLabel "interacts with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002461
obo:RO_0002461 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000056 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "partner in"^^xsd:string ;
               core:definition "relation used for defining interaction relations. An interaction relation holds when there is an interaction event with two partners. In a directional interaction, one partner is deemed the subject, the other the target [RO]"^^xsd:string ;
               core:prefLabel "partner in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002462
obo:RO_0002462 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002461 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "subject participant in"^^xsd:string ;
               core:altLabel "subject in"^^xsd:string ;
               core:definition "relation used for defining interaction relations; the meaning of s 'subject participant in' p is determined by the type of p, where p must be a directional interaction process. [RO]"^^xsd:string ;
               core:example "in a predator-prey interaction process the subject is the predator"^^xsd:string ;
               core:prefLabel "subject participant in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002463
obo:RO_0002463 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002461 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "target participant in"^^xsd:string ;
               core:altLabel "target in"^^xsd:string ;
               core:definition "Relation used for defining interaction relations; the meaning of s 'target participant in' p is determined by the type of p, where p must be a directional interaction process [RO]"^^xsd:string ;
               core:example "in a predator-prey interaction process the target is the prey"^^xsd:string ;
               core:prefLabel "target participant in"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002500
obo:RO_0002500 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002595 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causal agent in process"^^xsd:string ;
               core:altLabel "causal agent in"^^xsd:string ;
               core:definition "A relationship between a material entity and a process where the material entity has some causal role that influences the process. [RO]"^^xsd:string ;
               core:prefLabel "causal agent in process"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002501
obo:RO_0002501 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002410 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain obo:BFO_0000003 ;
               rdfs:range obo:BFO_0000003 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causal relation between processes"^^xsd:string ;
               core:definition "P is causally related to q if and only if p or any part of p and q or any part of q are linked by a chain of events where each event pair is one of direct activation or direct inhibition. p may be upstream, downstream, part of or a container of q. [RO]"^^xsd:string ;
               core:prefLabel "causal relation between processes"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002502
obo:RO_0002502 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "depends on"^^xsd:string ;
               core:definition "Being determined, based or contingent on something. [Allotrope]"^^xsd:string ;
               core:prefLabel "depends on"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002503
obo:RO_0002503 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002502 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "towards"^^xsd:string ;
               core:definition "Q towards e2 if and only if q is a relational quality such that q inheres-in some e, and e != e2 and q is dependent on e2 [RO]"^^xsd:string ;
               core:editorialNote "This relation is provided in order to support the use of relational qualities such as 'concentration of'; for example, the concentration of C in V is a quality that inheres in V, but pertains to C. [RO]"^^xsd:string ;
               core:prefLabel "towards"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002505
obo:RO_0002505 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000057 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has intermediate"^^xsd:string ;
               core:altLabel "has intermediate product"^^xsd:string ;
               core:definition "P has intermediate c if and only if p has parts p1, p2 and p1 has output c, and p2 has input c [RO]"^^xsd:string ;
               core:prefLabel "has intermediate"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002506
obo:RO_0002506 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002410 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:label "causal relation between material entities"^^xsd:string ;
               core:editorialNote "Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect. [RO]"^^xsd:string ;
               core:prefLabel "causal relation between material entities"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002507
obo:RO_0002507 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000050 ,
                                  obo:RO_0002509 ,
                                  obo:RO_0002559 ;
               owl:inverseOf obo:RO_0002508 ;
               rdfs:domain obo:RO_0002577 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "determined by (system to material entity)"^^xsd:string ;
               core:altLabel "determined by"^^xsd:string ;
               core:definition "S determined by f if and only if s is a type of system, and f is a material entity that is part of s, such that f exerts a strong causal influence on the functioning of s, and the removal of f would cause the collapse of s. [RO]"^^xsd:string ;
               core:prefLabel "determined by (system to material entity)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002508
obo:RO_0002508 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002566 ;
               rdfs:label "determines (material entity to system)"^^xsd:string ;
               core:altLabel "determines"^^xsd:string ;
               core:prefLabel "determines (material entity to system)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002509
obo:RO_0002509 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002131 ,
                                  obo:RO_0002506 ;
               rdfs:domain obo:RO_0002577 ;
               rdfs:range obo:BFO_0000040 ;
               owl:propertyChainAxiom ( obo:RO_0002507
                                        obo:BFO_0000050
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "determined by part of"^^xsd:string ;
               core:definition "S 'determined by part of' w if and only if there exists some f such that (1) s 'determined by' f and (2) f part_of w, or f=w. [RO]"^^xsd:string ;
               core:prefLabel "determined by part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002514
obo:RO_0002514 rdf:type owl:ObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "sequentially related to"^^xsd:string ;
               core:definition "A relation that holds between two entities that have the property of being sequences or having sequences. [RO]"^^xsd:string ;
               core:prefLabel "sequentially related to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002515
obo:RO_0002515 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002527 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "sequentially adjacent to"^^xsd:string ;
               core:definition "x is sequentially adjacent to y if and only if x and y do not overlap and if there are no base units intervening between x and y [RO]"^^xsd:string ;
               core:prefLabel "sequentially adjacent to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002516
obo:RO_0002516 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002524 ;
               owl:inverseOf obo:RO_0002517 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has start sequence"^^xsd:string ;
               core:altLabel "started by"^^xsd:string ;
               core:definition "x has start sequence y if the start of x is identical to the start of y, and x has y as a subsequence [RO]"^^xsd:string ;
               core:prefLabel "has start sequence"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002517
obo:RO_0002517 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002524 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is start sequence of"^^xsd:string ;
               core:altLabel "starts"^^xsd:string ;
               core:definition "inverse of has start sequence [RO]"^^xsd:string ;
               core:prefLabel "is start sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002518
obo:RO_0002518 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002524 ;
               owl:inverseOf obo:RO_0002519 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has end sequence"^^xsd:string ;
               core:altLabel "ended by"^^xsd:string ;
               core:definition "x has end sequence y if the end of x is identical to the end of y, and x has y as a subsequence [RO]"^^xsd:string ;
               core:prefLabel "has end sequence"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002519
obo:RO_0002519 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002525 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is end sequence of"^^xsd:string ;
               core:altLabel "ends"^^xsd:string ;
               core:definition "inverse of has end sequence [RO]"^^xsd:string ;
               core:prefLabel "is end sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002522
obo:RO_0002522 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002514 ;
               owl:inverseOf obo:RO_0002523 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "bounds sequence of"^^xsd:string ;
               core:definition "x bounds the sequence of y if and only if the upstream-most part of x is upstream of or coincident with the upstream-most part of y, and the downstream-most part of x is downstream of or coincident with the downstream-most part of y [RO]"^^xsd:string ;
               core:prefLabel "bounds sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002523
obo:RO_0002523 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002514 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is bound by sequence of"^^xsd:string ;
               core:definition "inverse of bounds sequence of [RO]"^^xsd:string ;
               core:prefLabel "is bound by sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002524
obo:RO_0002524 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ,
                                  obo:RO_0002522 ,
                                  obo:RO_0002526 ;
               owl:inverseOf obo:RO_0002525 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has subsequence"^^xsd:string ;
               core:altLabel "contains"^^xsd:string ;
               core:definition "x has subsequence y if and only if all of the sequence parts of x are sequence parts of y [RO]"^^xsd:string ;
               core:prefLabel "has subsequence"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002525
obo:RO_0002525 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000050 ,
                                  obo:RO_0002523 ,
                                  obo:RO_0002526 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is subsequence of"^^xsd:string ;
               core:altLabel "contained by"^^xsd:string ;
               core:definition "inverse of has subsequence [RO]"^^xsd:string ;
               core:prefLabel "is subsequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002526
obo:RO_0002526 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002131 ,
                                  obo:RO_0002514 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "overlaps sequence of"^^xsd:string ;
               core:definition "x overlaps the sequence of x if and only if x has a subsequence z and z is a subsequence of y. [RO]"^^xsd:string ;
               core:prefLabel "overlaps sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002527
obo:RO_0002527 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002514 ;
               rdf:type owl:SymmetricProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "does not overlap sequence of"^^xsd:string ;
               core:altLabel "disconnected from"^^xsd:string ;
               core:definition "x does not overlaps the sequence of x if and only if there is no z such that x has a subsequence z and z is a subsequence of y. [RO]"^^xsd:string ;
               core:prefLabel "does not overlap sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002528
obo:RO_0002528 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002527 ;
               owl:inverseOf obo:RO_0002529 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is upstream sequence of"^^xsd:string ;
               core:definition "inverse of downstream sequence of [RO]"^^xsd:string ;
               core:prefLabel "is upstream sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002529
obo:RO_0002529 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002527 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is downstream of sequence of"^^xsd:string ;
               core:definition "x is downstream of the sequence of y if and only if either (1) x and y have sequence units, and all units of x are downstream of all units of y, or (2) x and y are sequence units, and x is either immediately downstream of y, or transitively downstream of y. [RO]"^^xsd:string ;
               core:prefLabel "is downstream of sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002530
obo:RO_0002530 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002515 ,
                                  obo:RO_0002529 ;
               owl:inverseOf obo:RO_0002531 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is immediately downstream of sequence of"^^xsd:string ;
               core:definition "x is immediately downstream of the sequence of y if and only if either (1) x and y have sequence units, and all units of x are downstream of all units of y, and x is sequentially adjacent to y, or (2) x and y are sequence units, in which case the immediately downstream relation is primitive and defined by context: for DNA bases, y would be adjacent and 5' to y [RO]"^^xsd:string ;
               core:prefLabel "is immediately downstream of sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002531
obo:RO_0002531 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002515 ,
                                  obo:RO_0002528 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is immediately upstream sequence of"^^xsd:string ;
               core:definition "inverse of immediately downstream of [RO]"^^xsd:string ;
               core:prefLabel "is immediately upstream sequence of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002559
obo:RO_0002559 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002506 ;
               owl:inverseOf obo:RO_0002566 ;
               rdfs:label "causally influenced by (material entity to material entity)"^^xsd:string ;
               core:altLabel "causally influenced by"^^xsd:string ;
               core:prefLabel "causally influenced by (material entity to material entity)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002566
obo:RO_0002566 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002506 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causally influences (material entity to material entity)"^^xsd:string ;
               core:altLabel "causally influences"^^xsd:string ;
               core:definition "Holds between materal entities a and b if the activity of a is causally upstream of the activity of b, or causally upstream of a an activity that modifies b [RO]"^^xsd:string ;
               core:prefLabel "causally influences (material entity to material entity)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002570
obo:RO_0002570 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002131 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "conduit for"^^xsd:string ;
               core:definition "X is a conduit for y if and only if y overlaps through the lumen_of of x, and y has parts on either side of the lumen of x. [RO]"^^xsd:string ;
               core:editorialNote "This relation holds between a thing with a 'conduit' (e.g. a bone foramen) and a 'conduee' (for example, a nerve) such that at the time the relationship holds, the conduee has two ends sticking out either end of the conduit. It should therefore note be used for objects that move through the conduit but whose spatial extent does not span the passage. For example, it would not be used for a mountain that contains a long tunnel through which trains pass. Nor would we use it for a digestive tract and objects such as food that pass through. [RO]"^^xsd:string ;
               core:prefLabel "conduit for"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002584
obo:RO_0002584 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002328 ,
                                  obo:RO_0002595 ;
               owl:propertyChainAxiom ( obo:BFO_0000051
                                        obo:RO_0002215
                                      ) ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "has part structure that is capable of"^^xsd:string ;
               core:definition "S 'has part structure that is capable of' p if and only if there exists some part x such that s 'has part' x and x 'capable of' p [RO]"^^xsd:string ;
               core:prefLabel "has part structure that is capable of"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002595
obo:RO_0002595 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002410 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000015 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causal relation between material entity and a process"^^xsd:string ;
               core:definition "A relationship that holds between a material entity and a process in which causality is involved, with either the material entity or some part of the material entity exerting some influence over the process, or the process influencing some aspect of the material entity. [RO]"^^xsd:string ;
               core:prefLabel "causal relation between material entity and a process"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002607
obo:RO_0002607 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002610 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "is marker for"^^xsd:string ;
               core:definition "C is marker for d if and only if the presence or occurrence of d is correlated with the presence of occurrence of c, and the observation of c is used to infer the presence or occurrence of d. Note that this does not imply that c and d are in a direct causal relationship, as it may be the case that there is a third entity e that stands in a direct causal relationship with c and d. [RO]"^^xsd:string ;
               core:prefLabel "is marker for"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002609
obo:RO_0002609 rdf:type owl:ObjectProperty ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "related via dependence to"^^xsd:string ;
               core:definition "A relationship that holds between two entities, where the relationship holds based on the presence or absence of statistical dependence relationship. The entities may be statistical variables, or they may be other kinds of entities such as diseases, chemical entities or processes. [RO]"^^xsd:string ;
               core:editorialNote "Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect. [IAO]"^^xsd:string ;
               core:prefLabel "related via dependence to"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002610
obo:RO_0002610 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002609 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "correlated with"^^xsd:string ;
               core:definition "A relationship that holds between two entities, where the entities exhibit a statistical dependence relationship. The entities may be statistical variables, or they may be other kinds of entities such as diseases, chemical entities or processes. [RO]"^^xsd:string ;
               core:editorialNote "Groups both positive and negative correlation"^^xsd:string ;
               core:prefLabel "correlated with"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0003000
obo:RO_0003000 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf obo:RO_0003001 ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "produces"^^xsd:string ;
               core:definition "a produces b if some process that occurs_in a has_output b, where a and b are material entities. [RO]"^^xsd:string ;
               core:editorialNote "Note that this definition doesn't quite distinguish the output of a transformation process from a production process, which is related to the identity/granularity issue [RO]"^^xsd:string ;
               core:example "chondroblast produces avascular GAG-rich matrix"^^xsd:string ,
                            "hybridoma cell line produces monoclonal antibody reagent"^^xsd:string ;
               core:prefLabel "produces"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0003001
obo:RO_0003001 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain obo:BFO_0000040 ;
               rdfs:range obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "produced by"^^xsd:string ;
               core:definition "inverse of produces"^^xsd:string ;
               core:prefLabel "produced by"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0003302
obo:RO_0003302 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0002410 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causes or contributes to condition"^^xsd:string ;
               core:definition "A relationship between an entity (e.g. a genotype, genetic variation, chemical, or environmental exposure) and a condition (a phenotype or disease), where the entity has some causal or contributing role that influences the condition. [RO]"^^xsd:string ;
               core:prefLabel "causes or contributes to condition"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0003303
obo:RO_0003303 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0003302 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "causes condition"^^xsd:string ;
               core:definition "A relationship between an entity (e.g. a genotype, genetic variation, chemical, or environmental exposure) and a condition (a phenotype or disease), where the entity has some causal role for the condition. [RO]"^^xsd:string ;
               core:prefLabel "causes condition"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0003304
obo:RO_0003304 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0003302 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
               rdfs:label "contributes to condition"^^xsd:string ;
               core:definition "A relationship between an entity (e.g. a genotype, genetic variation, chemical, or environmental exposure) and a condition (a phenotype or disease), where the entity has some contributing role that influences the condition. [RO]"^^xsd:string ;
               core:prefLabel "contributes to condition"^^xsd:string .


###  http://purl.obolibrary.org/obo/chebi#has_functional_parent
<http://purl.obolibrary.org/obo/chebi#has_functional_parent> rdf:type owl:ObjectProperty ;
                                                             oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                             oboI:id "has_functional_parent"^^xsd:string ;
                                                             oboI:is_cyclic "false"^^xsd:boolean ;
                                                             oboI:is_transitive "false"^^xsd:boolean ;
                                                             rdfs:label "has functional parent"^^xsd:string .


