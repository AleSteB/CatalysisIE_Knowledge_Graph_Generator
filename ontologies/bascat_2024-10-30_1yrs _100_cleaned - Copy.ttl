                                                          core:prefLabel "peak asymmetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001089
<http://purl.allotrope.org/ontologies/result#AFR_0001089> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001101> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001177> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
