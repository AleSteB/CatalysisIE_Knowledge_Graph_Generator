                                                           core:example "opening of the soller slit"^^xsd:string ;
                                                           core:prefLabel "inner diameter (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000019
<http://purl.allotrope.org/ontologies/quality#AFQ_0000019> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ;
                                                           prop:AFX_0002811 prop:AFX_0001180 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "Orange Book: IUPAC Compendium of Analytical Nomenclature. Second Edition, Blackwell Scientific Publications, Oxford, 1987."^^xsd:string ,
                                                                       "PAC, 1993, 65, 819. Nomenclature for chromatography (IUPAC Recommendations 1993)"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "relative retention time (quality)"^^xsd:string ;
                                                           core:altLabel "relative retention"^^xsd:string ,
                                                                         "relative retention time"^^xsd:string ;
                                                           core:definition "Relative retention time is a ratio quality of the adjusted or net retention time of a component relative to that of a standard, obtained under identical conditions. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "relative retention time (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000020
<http://purl.allotrope.org/ontologies/quality#AFQ_0000020> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000122 ;
                                                           prop:AFX_0002811 prop:AFX_0002676 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "cylinder length (quality)"^^xsd:string ;
                                                           core:altLabel "cylinder length"^^xsd:string ;
                                                           core:changeNote "2020-06-22 Changed labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "Quality of a material entity of cylindrical or tubular shape which describes its length along its main (non-circular) dimension. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "cylinder length (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000026
<http://purl.allotrope.org/ontologies/quality#AFQ_0000026> rdf:type owl:Class ;
