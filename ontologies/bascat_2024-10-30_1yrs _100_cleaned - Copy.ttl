                                                           core:definition "Fluorescent tag positive cell density is the cell density of the partition of fluorescent tag positive cells. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "fluorescent tag positive cell density (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000001
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000001> rdf:type owl:Class ;
                                                               rdfs:subClassOf obo:OBI_0000260 ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "action"^^xsd:string ;
                                                               core:altLabel "task"^^xsd:string ;
                                                               core:definition "An action is a unit element in a procedure and is a concretization of an action specification. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "action"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000002
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000002> rdf:type owl:Class ;
                                                               rdfs:subClassOf obo:OBI_0000260 ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "procedure"^^xsd:string ;
                                                               core:definition "A procedure is plan containing multiple activities that are intended to be executed in an order following a procedure specification. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "procedure"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000003
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> rdf:type owl:Class ;
                                                               rdfs:subClassOf obo:BFO_0000017 ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
