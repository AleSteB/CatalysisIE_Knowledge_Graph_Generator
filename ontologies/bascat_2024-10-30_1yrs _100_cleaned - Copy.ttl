                                                           rdfs:label "liquid chromatography"^^xsd:string ;
                                                           core:altLabel "LC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000229
<http://purl.allotrope.org/ontologies/process#AFP_0000229> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "reflectometry"^^xsd:string ;
                                                           core:altLabel "reflectivity measurement"^^xsd:string ;
                                                           core:definition "Any method for determining structure by directing a beam of particles or X-rays onto an extremely flat surface and measuring the intensity of the reflected radiation as a function of angle. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "reflectometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000246
<http://purl.allotrope.org/ontologies/process#AFP_0000246> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002188> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
                                                           rdfs:label "ultraviolet absorbance measurement"^^xsd:string ;
                                                           core:altLabel "UV detection"^^xsd:string ,
                                                                         "UV measurement"^^xsd:string ,
                                                                         "ultra-violet detection"^^xsd:string ,
                                                                         "ultra-violet measurement"^^xsd:string ,
                                                                         "ultraviolet detection"^^xsd:string ,
                                                                         "ultraviolet measurement"^^xsd:string ;
                                                           core:changeNote "2019-08-14 Changed definition and preferred label. [Allotrope]"^^xsd:string ;
                                                           core:definition "Ultraviolet absorbance measurement is electronic absorbance measurement of light in the wavelength region of 190-350 nm. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ultraviolet absorbance measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000253
<http://purl.allotrope.org/ontologies/process#AFP_0000253> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "supercritical-fluid chromatography"^^xsd:string ;
                                                           core:altLabel "SFC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a fluid above and relatively close to its critical temperature and pressure. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "supercritical-fluid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000254
<http://purl.allotrope.org/ontologies/process#AFP_0000254> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
