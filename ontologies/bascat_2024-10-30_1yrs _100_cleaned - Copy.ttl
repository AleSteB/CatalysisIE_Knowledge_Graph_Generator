                                                         rdfs:label "quantifier transition role"^^xsd:string ;
                                                         core:altLabel "quantifier transition"^^xsd:string ;
                                                         core:definition "A quantifier transition is the contextual of an ion transition, that is used to calculate the measured result. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "quantifier transition role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000502
<http://purl.allotrope.org/ontologies/role#AFRL_0000502> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
