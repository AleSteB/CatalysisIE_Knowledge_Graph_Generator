###  http://purl.allotrope.org/ontologies/equipment#AFE_0000145
<http://purl.allotrope.org/ontologies/equipment#AFE_0000145> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0002235> ;
