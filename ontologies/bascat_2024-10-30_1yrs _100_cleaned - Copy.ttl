                 rdfs:label "data input of"^^xsd:string ;
                 core:altLabel "is data input of"^^xsd:string ;
                 core:definition "Inverse of 'has data input'. [Allotrope]"^^xsd:string ;
                 core:prefLabel "data input of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000554
prop:AFX_0000554 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000354 ;
                 owl:inverseOf prop:AFX_0000696 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/material#AFM_0000275> ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "material input of"^^xsd:string ;
                 core:altLabel "is material input of"^^xsd:string ;
                 core:definition "Inverse of 'has material input'. [Allotrope]"^^xsd:string ;
                 core:prefLabel "material input of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000557
prop:AFX_0000557 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000331 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum exclusive"^^xsd:string ;
                 core:definition "The highest value of a range excluding the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum exclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000558
prop:AFX_0000558 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000331 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum inclusive"^^xsd:string ;
                 core:definition "The highest value of a range including the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum inclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000560
prop:AFX_0000560 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000314 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum exclusive"^^xsd:string ;
                 core:definition "The lowest value of a range or set of values excluding the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum exclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000561
prop:AFX_0000561 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000314 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum inclusive"^^xsd:string ;
                 core:definition "The lowest value of a range or set of values including the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum inclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000696
prop:AFX_0000696 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000399 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/material#AFM_0000275> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has material input"^^xsd:string ;
                 core:definition "Refers to the material entity that is an input of a process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has material input"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000834
prop:AFX_0000834 rdf:type owl:ObjectProperty ;
                 owl:inverseOf prop:AFX_0002855 ;
                 rdfs:domain obo:BFO_0000015 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000900> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has log"^^xsd:string ;
                 core:altLabel "has protocol"^^xsd:string ,
                               "log"^^xsd:string ,
                               "protocol"^^xsd:string ;
                 core:definition "The relation between a process and its log. A log is a steadily updated information object containing data of events in time such as process executions. [Allotrope]"^^xsd:string ;
                 core:example "log files, auto export file of cell counter devices"^^xsd:string ;
                 core:prefLabel "has log"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000939
prop:AFX_0000939 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002846 ;
                 owl:inverseOf prop:AFX_0000972 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain obo:BFO_0000040 ;
                 rdfs:range obo:BFO_0000040 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "component of"^^xsd:string ;
                 core:altLabel "is component of"^^xsd:string ;
                 core:definition "A physical object that is a component that is a physical part of another physical object that is a system. [Allotrope]"^^xsd:string ;
                 core:editorialNote "part of relation in the system perspective"^^xsd:string ;
                 core:prefLabel "component of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000940
prop:AFX_0000940 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:BFO_0000051 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "composed of"^^xsd:string ;
                 core:altLabel "consists of"^^xsd:string ,
                               "has material"^^xsd:string ;
                 core:definition "The property specifies of which kind of general portion of material something is built of. [Allotrope]"^^xsd:string ;
                 core:example "a weighing pan that is composed of platinum [Allotrope]"^^xsd:string ;
                 core:prefLabel "composed of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000972
prop:AFX_0000972 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002793 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain obo:RO_0002577 ;
                 rdfs:range obo:BFO_0000040 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has component"^^xsd:string ;
                 core:altLabel "has physical part"^^xsd:string ;
                 core:definition "A physical object that forms a system that has as part a physical entity that is one of its components. [Allotrope]"^^xsd:string ;
                 core:editorialNote "has part relation in the system perspective"^^xsd:string ;
                 core:prefLabel "has component"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000974
prop:AFX_0000974 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000972 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:range <http://purl.allotrope.org/ontologies/equipment#AFE_0000847> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has port"^^xsd:string ;
                 core:definition "Relation between a system and a component of it that has the role of a port in the system though which material, energy or information flows in or out of the system. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has port"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000976
prop:AFX_0000976 rdf:type owl:ObjectProperty ;
                 owl:inverseOf prop:AFX_0002856 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0001103> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has capability"^^xsd:string ;
                 core:altLabel "capability"^^xsd:string ;
                 core:definition "The relation of an entity to a description of it which refers to the qualification of an entity to perform a certain function. [Allotrope]"^^xsd:string ;
                 core:example "a part of a data sheet"^^xsd:string ;
                 core:prefLabel "has capability"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001048
prop:AFX_0001048 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0001015 ;
                 owl:inverseOf prop:AFX_0001049 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/equipment#AFE_0000407> ;
                 rdfs:range obo:BFO_0000040 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "contains"^^xsd:string ;
                 core:definition "The relation between a container and its physical content. A material entity a contains a material entity b if b is located in some cavity of a. [Allotrope]"^^xsd:string ;
                 core:prefLabel "contains"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001049
prop:AFX_0001049 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0001025 ;
                 rdfs:domain obo:BFO_0000040 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/equipment#AFE_0000407> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "contained in"^^xsd:string ;
                 core:definition "Inverse of contains. [Allotrope]"^^xsd:string ;
                 core:prefLabel "contained in"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001154
prop:AFX_0001154 rdf:type owl:ObjectProperty ;
                 owl:inverseOf prop:AFX_0002806 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000916> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has classification"^^xsd:string ;
                 core:altLabel "classification"^^xsd:string ,
                               "classified by"^^xsd:string ;
                 core:definition "A classification is a kind of categorization in order to differentiate between different classes of objects. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has classification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001178
prop:AFX_0001178 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002170 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "connected to source"^^xsd:string ;
                 core:altLabel "attached to source"^^xsd:string ,
                               "has source"^^xsd:string ;
                 core:definition "A system that is attached to another system by an ingoing port. [Allotrope]"^^xsd:string ;
                 core:prefLabel "connected to source"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001179
prop:AFX_0001179 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002170 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "connected to destination"^^xsd:string ;
                 core:altLabel "attached to destination"^^xsd:string ,
                               "has destination"^^xsd:string ;
                 core:definition "A system that is attached to another system by an outgoing port. [Allotrope]"^^xsd:string ;
                 core:prefLabel "connected to destination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001550
prop:AFX_0001550 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has reference"^^xsd:string ;
                 core:altLabel "reference"^^xsd:string ,
                               "reference object"^^xsd:string ;
                 core:definition "Reference object relates an entity A to some entity B that is taken as a reference for A in a certain context. [Allotrope]"^^xsd:string ;
                 core:example "reference for comparison"^^xsd:string ,
                              "reference object"^^xsd:string ,
                              "reference process"^^xsd:string ;
                 core:prefLabel "has reference"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002674
prop:AFX_0002674 rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( obo:BFO_0000015
                                            obo:BFO_0000035
                                          )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "satisfies"^^xsd:string ;
                 core:definition "The relation between a proposition about of a portion of reality and a process asserting that the process is described truthfully by the description. [Allotrope]"^^xsd:string ;
                 core:prefLabel "satisfies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002677
prop:AFX_0002677 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:BFO_0000034 ;
                 rdfs:range obo:BFO_0000034 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "by way of"^^xsd:string ;
                 core:definition "The relation between a function with an objective and another function that when realized acts as a proxy to achieve the objective of the first. [Allotrope]"^^xsd:string ;
                 core:prefLabel "by way of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002682
prop:AFX_0002682 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf prop:AFX_0002685 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/process#AFP_0003281> ;
                 rdfs:range obo:BFO_0000019 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "tracks quality"^^xsd:string ;
                 core:definition "A relation between a process profile and a changing determinable quality of some participant of the process of the profile. [Allotrope]"^^xsd:string ;
                 core:example "An profile of the absorption in a chromatography is quality process profile of the quality absorption of some participating material. [Allotrope]"^^xsd:string ;
                 core:note "The relation is usually used with punning of the quality."^^xsd:string ;
                 core:prefLabel "tracks quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002684
prop:AFX_0002684 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002802 ;
                 owl:inverseOf prop:AFX_0002816 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quantified by"^^xsd:string ;
                 core:altLabel "has quantity value"^^xsd:string ;
                 core:definition "Relation of something that is quantified by some quantity value which expresses it relative to some other thing. [Allotrope]"^^xsd:string ;
                 core:example "The duration of a process expressed as 60 sec expresses it in quantitative relation to the duration of some second defining process specified in the SI systems of units."^^xsd:string ;
                 core:prefLabel "quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002685
prop:AFX_0002685 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain obo:BFO_0000019 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/process#AFP_0003281> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality tracked by"^^xsd:string ;
                 core:definition "The relation between a quality and a process profile in which the quality is changing. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quality tracked by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002686
prop:AFX_0002686 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002718 ;
                 rdfs:domain obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "process quantified by"^^xsd:string ;
                 core:definition "Relation of some process that is quantified by some quantity value which expresses its duration relative to other process or a temporal aggregation function on the quantification of a quality of some participant over this duration. [Allotrope]"^^xsd:string ;
                 core:example "The process of injection has a material flow profile of the injected material that is quantified by the volume of 1 mL/sec."^^xsd:string ;
                 core:prefLabel "process quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002687
prop:AFX_0002687 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002686 ;
                 rdfs:domain obo:BFO_0000144 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "profile mean quantified by"^^xsd:string ;
                 core:definition "The quantity value that is the result of averaging a quality of some participant of the process over the duration of the process or the quantification of the participant's quality at the temporal granularity of the duration of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "profile mean quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002688
prop:AFX_0002688 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002686 ;
                 rdfs:domain obo:BFO_0000144 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "profile maximum quantified by"^^xsd:string ;
                 core:definition "The temporal maximum quantified by is the maximum of the quantification of some quality of a participant that occurred during the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "profile maximum quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002689
prop:AFX_0002689 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002686 ;
                 rdfs:domain obo:BFO_0000144 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "profile minimum quantified by"^^xsd:string ;
                 core:definition "The temporal minimum quantified by is the minimum of the quantification of some quality of a participant that occurred during the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "profile minimum quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002690
prop:AFX_0002690 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002684 ;
                 rdfs:domain obo:BFO_0000019 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality quantified by"^^xsd:string ;
                 core:definition "Quantification of some determinate quality which expresses it relative to some other (known) determinate quality. [Allotrope]"^^xsd:string ;
                 core:example "A portion of water has some determinate temperature quality that is quantified by the quantity value of 15° C."^^xsd:string ;
                 core:prefLabel "quality quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002696
prop:AFX_0002696 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002803 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/common#AFC_0000021> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has range"^^xsd:string ;
                 core:definition "Relation to a data item that describes the boundaries of possible or existing qualities, process profiles or process durations that can be ordered. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002699
prop:AFX_0002699 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 owl:inverseOf prop:AFX_0002802 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000922> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "describes"^^xsd:string ;
                 core:altLabel "description of"^^xsd:string ;
                 core:definition "Describes is a property of an entity which has the ability to indicate or denote certain characteristics in another entity. [Allotrope]"^^xsd:string ;
                 core:prefLabel "describes"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002703
prop:AFX_0002703 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:BFO_0000133 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/process#AFP_0003281> ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality profile of"^^xsd:string ;
                 core:definition "The relation of a process profile of some changing quality to a process. [Allotrope]"^^xsd:string ;
                 core:example "A pressure profile in chromatography. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quality profile of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002704
prop:AFX_0002704 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 owl:inverseOf prop:AFX_0002805 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000957> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "specifies"^^xsd:string ;
                 core:definition "Specifies is a relation between a specification and the object specified. [Allotrope]"^^xsd:string ;
                 core:prefLabel "specifies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002716
prop:AFX_0002716 rdf:type owl:ObjectProperty ;
                 owl:inverseOf prop:AFX_0002717 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has identifier"^^xsd:string ;
                 core:altLabel "identified by"^^xsd:string ,
                               "identifier"^^xsd:string ,
                               "is identified by"^^xsd:string ;
                 core:definition "The relation of an entity to an identifier that denotes it. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has identifier"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002717
prop:AFX_0002717 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000219 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000917> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "identifies"^^xsd:string ;
                 core:definition "The relation of an identifier to the entity it denotes. [Allotrope]"^^xsd:string ;
                 core:prefLabel "identifies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002718
prop:AFX_0002718 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002684 ;
                 rdfs:domain obo:BFO_0000003 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "occurrent quantified by"^^xsd:string ;
                 core:definition "Occurrent quantified by relates an occurrent entity with an information content entity that is a quantification of the occurrent (duration, rate). [Allotrope]"^^xsd:string ;
                 core:prefLabel "occurrent quantified by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002720
prop:AFX_0002720 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002350 ;
                 rdf:type owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:range <http://purl.allotrope.org/ontologies/common#AFC_0000166> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "item of"^^xsd:string ;
                 core:altLabel "in collection"^^xsd:string ,
                               "is item in"^^xsd:string ,
                               "member of"^^xsd:string ;
                 core:changeNote "2017-11-16 Changed pref label [OSTHUS]"^^xsd:string ,
                                 "2018-07-23 Change hierarchy, subproperty of member of [Allotrope]"^^xsd:string ;
                 core:definition "In collection relates an item to a collection entity. [Allotrope]"^^xsd:string ;
                 core:prefLabel "item of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002722
prop:AFX_0002722 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002502 ;
                 owl:inverseOf prop:AFX_0002723 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality influenced by"^^xsd:string ;
                 core:altLabel "influenced by"^^xsd:string ;
                 core:definition "Inverse of quality influences. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quality influenced by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002723
prop:AFX_0002723 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002609 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain obo:BFO_0000019 ;
                 rdfs:range obo:BFO_0000019 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality influences"^^xsd:string ;
                 core:altLabel "influences"^^xsd:string ;
                 core:definition "Holds between qualities a and b  such that if a process changes the quality to some other instance a' then for some a' it is necessary that b changes to another instance b'. [Allotrope]"^^xsd:string ;
                 core:example "volume influences density"^^xsd:string ;
                 core:prefLabel "quality influences"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002724
prop:AFX_0002724 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002723 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality strongly influences"^^xsd:string ;
                 core:definition "Holds between qualities a and b  such that if a process changes the quality to some other instance a' != a then for all a' it is necessary that b changes to another instance b' != b. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quality strongly influences"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002725
prop:AFX_0002725 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002722 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quality strongly influenced by"^^xsd:string ;
                 core:altLabel "strongly influenced by"^^xsd:string ;
                 core:definition "Inverse of quality strongly influences. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quality strongly influenced by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002726
prop:AFX_0002726 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf prop:AFX_0002730 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "contextual role of"^^xsd:string ;
                 core:altLabel "is contextual role of"^^xsd:string ;
                 core:definition "Inverse of has contextual role. [Allotrope]"^^xsd:string ;
                 core:prefLabel "contextual role of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002727
prop:AFX_0002727 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 term:source "W. Ceusters, P. Elkin, B. Smith Referent Tracking: The Problem of Negative Findings 2006"^^xsd:string ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "lacks"^^xsd:string ;
                 core:definition "Property describing the absence of a particular in relation to another particular depending on its spatio-temporal existence. [Allotrope]"^^xsd:string ;
                 core:editorialNote "if punning to a universal class: A particular is not the instance of a given class at some given time. A particular is not related in a specific way to any instance of a universal at some given time."^^xsd:string ;
                 core:prefLabel "lacks"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002729
prop:AFX_0002729 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 owl:inverseOf prop:AFX_0002807 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                 rdfs:range obo:IAO_0000030 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "facet implemented as"^^xsd:string ;
                 core:altLabel "concretized as"^^xsd:string ,
                               "facet concretized as"^^xsd:string ,
                               "facet represented as"^^xsd:string ,
                               "implemented as"^^xsd:string ,
                               "represented as"^^xsd:string ;
                 core:definition "The relation between the abstract facet and a specific information that represents the facet. [Allotrope]"^^xsd:string ;
                 core:example "a label facet can be implemented as a barcode or written text"^^xsd:string ;
                 core:note "This relation is intended to bridge between different perspectives on the taxonomy of information content entities."^^xsd:string ;
                 core:prefLabel "facet implemented as"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002730
prop:AFX_0002730 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has contextual role"^^xsd:string ;
                 core:definition "The relation between an information object and its contextual role. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has contextual role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002731
prop:AFX_0002731 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000388 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "in process"^^xsd:string ;
                 core:altLabel "has contextual role in process"^^xsd:string ;
                 core:definition "The relation between a conceptual role and the process where the contextual role is realized. [Allotrope]"^^xsd:string ;
                 core:prefLabel "in process"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002734
prop:AFX_0002734 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000353 ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "data output of"^^xsd:string ;
                 core:altLabel "is data output of"^^xsd:string ;
                 core:definition "Inverse of 'has data output'. [Allotrope]"^^xsd:string ;
                 core:prefLabel "data output of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002735
prop:AFX_0002735 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000353 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/material#AFM_0000275> ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "material output of"^^xsd:string ;
                 core:altLabel "is material output of"^^xsd:string ;
                 core:definition "Inverse of 'has material output'. [Allotrope]"^^xsd:string ;
                 core:prefLabel "material output of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002736
prop:AFX_0002736 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has proposition"^^xsd:string ;
                 core:altLabel "has content"^^xsd:string ;
                 core:definition "The relation between a representation and its content independent of form. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has proposition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002737
prop:AFX_0002737 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000992> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has representation form"^^xsd:string ;
                 core:definition "The relation between the information and the way it is represented. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has representation form"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002740
prop:AFX_0002740 rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                 rdfs:range obo:BFO_0000019 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has effort component"^^xsd:string ;
                 core:definition "Has effort component relates an energy with its quality of effort. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has effort component"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002741
prop:AFX_0002741 rdf:type owl:ObjectProperty ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                 rdfs:range obo:BFO_0000019 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has flow component"^^xsd:string ;
                 core:definition "Has flow component relates an energy with its quality of flow. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has flow component"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002744
prop:AFX_0002744 rdf:type owl:ObjectProperty ,
                          owl:TransitiveProperty ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range obo:IAO_0000030 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has information derived from"^^xsd:string ;
                 core:definition "An information content entity has information derived from some other information content entity, if there is a data processing that transforms the other into it, either transforming the representational form or the content. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has information derived from"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002745
prop:AFX_0002745 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:propertyChainAxiom ( obo:RO_0002224
                                          prop:AFX_0002745
                                        ) ,
                                        ( obo:RO_0002230
                                          prop:AFX_0002745
                                        ) ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "affects"^^xsd:string ;
                 core:changeNote "2018-10-24 Moved to relation ontology. [Allotrope]"^^xsd:string ;
                 core:definition "P has direct input c if and only if c is a participant in p, c is present at the start of p, and the state of c is modified during p, c is present at the end of p. [Allotrope]"^^xsd:string ;
                 core:prefLabel "affects"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002748
prop:AFX_0002748 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000399 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "consumes"^^xsd:string ;
                 core:definition "P has output c if and only if c is a participant in p, c is present at the start of p, and c is not present at the end of p. [Allotrope]"^^xsd:string ;
                 core:example "An experimental step consumes a sample. [Allotrope]"^^xsd:string ;
                 core:prefLabel "consumes"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002750
prop:AFX_0002750 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:inverseOf prop:AFX_0002863 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "targets"^^xsd:string ;
                 core:altLabel "has focus"^^xsd:string ;
                 core:changeNote "2020-11-12 Changed definition. [Allotrope]"^^xsd:string ;
                 core:definition "A planned process targets a continuant if the continuant is a participant in the process and it in important part of towards the main objective of the process' plan. [Allotrope]"^^xsd:string ;
                 core:example "A hardness test targets the hardness quality. [Allotrope]"^^xsd:string ;
                 core:prefLabel "targets"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002793
prop:AFX_0002793 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:BFO_0000051 ;
                 owl:inverseOf prop:AFX_0002846 ;
                 rdf:type owl:TransitiveProperty ;
                 prop:AFX_0002809 <http://semanticscience.org/resource/SIO_000053> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has proper part"^^xsd:string ;
                 core:definition "Has proper part is an antisymmetric, irreflexive (normally transitive) relation between a whole and a distinct part. [SIO]"^^xsd:string ;
                 core:example "An atom has subatomic particles as its proper parts."^^xsd:string ;
                 core:prefLabel "has proper part"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002800
prop:AFX_0002800 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002846 ;
                 owl:inverseOf prop:AFX_0002803 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "facet of"^^xsd:string ;
                 core:altLabel "is facet of"^^xsd:string ;
                 core:definition "Facet of relates two information content entities where one information content entity is an aspect of the other one. [Allotrope]"^^xsd:string ;
                 core:prefLabel "facet of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002801
prop:AFX_0002801 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002803 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/common#AFC_0000050> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has categorical value"^^xsd:string ;
                 core:altLabel "has code"^^xsd:string ;
                 core:changeNote "2020-12-01 Add alt label. [Allotrope]"^^xsd:string ;
                 core:definition "Has categorical value is a facet that relates an information content entity to a code that describes a category for classification. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has categorical value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002802
prop:AFX_0002802 rdf:type owl:ObjectProperty ;
                 prop:AFX_0002808 dc:description ,
                                  term:description ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has description"^^xsd:string ;
                 core:altLabel "described by"^^xsd:string ,
                               "description"^^xsd:string ,
                               "is described by"^^xsd:string ;
                 core:definition "Has description relates an entity to an information content entity that is its description. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has description"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002803
prop:AFX_0002803 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002793 ;
                 rdf:type owl:TransitiveProperty ;
                 rdfs:domain obo:IAO_0000030 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has facet"^^xsd:string ;
                 core:definition "Relation between an information content entity and some part of it called a facet that is covers some general aspect of information context. [Allotrope]"^^xsd:string ;
                 core:example "a timestamp"^^xsd:string ,
                              "a title"^^xsd:string ,
                              "an ordering"^^xsd:string ;
                 core:prefLabel "has facet"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002805
prop:AFX_0002805 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has specification"^^xsd:string ;
                 core:altLabel "specification"^^xsd:string ,
                               "specified by"^^xsd:string ;
                 core:definition "Has specification relates an entity to an information content entity that is its specification. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has specification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002806
prop:AFX_0002806 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000916> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "classifies"^^xsd:string ;
                 core:definition "The relation between a classification and something that is grouped by the classification. [Allotrope]"^^xsd:string ;
                 core:prefLabel "classifies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002807
prop:AFX_0002807 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "implements facet"^^xsd:string ;
                 core:altLabel "concretizes"^^xsd:string ,
                               "concretizes facet"^^xsd:string ,
                               "implements"^^xsd:string ,
                               "represents"^^xsd:string ,
                               "represents facet"^^xsd:string ;
                 core:changeNote "2018-08-29 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "Inverse of facet concretized as. [Allotrope]"^^xsd:string ;
                 core:prefLabel "implements facet"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002816
prop:AFX_0002816 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002699 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "quantifies"^^xsd:string ;
                 core:definition "The relation of an information object to an entity that gives some indication of magnitude of a quality, information facet or process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "quantifies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002819
prop:AFX_0002819 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000219 ;
                 owl:inverseOf prop:AFX_0002820 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000928> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "index of"^^xsd:string ;
                 core:altLabel "is index of"^^xsd:string ;
                 core:definition "The relation between an index and the entity in an aggregate or list it denotes. [Allotrope]"^^xsd:string ;
                 core:prefLabel "index of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002820
prop:AFX_0002820 rdf:type owl:ObjectProperty ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0000928> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has index"^^xsd:string ;
                 core:definition "The relation between an object and an index that denotes the object within an aggregate the object is member of. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has index"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002821
prop:AFX_0002821 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "proxy for"^^xsd:string ;
                 core:definition "The relation between a proxy entity and a target entity where the target entity is a real participant in some process or the subject of an information content entity but is not referenced directly, but instead the proxy is used as a surrogate or representation for it. [Allotrope]"^^xsd:string ;
                 core:example "A measurement of a quality to indirectly measure another quality."^^xsd:string ,
                              "An object aggregate as a proxy for a collection."^^xsd:string ;
                 core:prefLabel "proxy for"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002822
prop:AFX_0002822 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:range core:Concept ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has concept"^^xsd:string ;
                 core:definition "The relation an entity and an associated SKOS concept. [Allotrope]"^^xsd:string ;
                 core:note "The relation is intended to relate a classifying datum with a SKOS concept, but there might be other uses. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has concept"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002832
prop:AFX_0002832 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002793 ;
                 owl:inverseOf prop:AFX_0002847 ;
                 prop:AFX_0002809 <http://semanticscience.org/resource/SIO_000273> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has direct part"^^xsd:string ;
                 core:definition "A core relation that holds between a whole and a proper part without an intermediate part at a level of granularity. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has direct part"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002833
prop:AFX_0002833 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002858 ;
                 owl:inverseOf prop:AFX_0002834 ;
                 rdf:type owl:TransitiveProperty ;
                 prop:AFX_0002808 obo:NCIT_C25629 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "is followed by"^^xsd:string ;
                 core:altLabel "before"^^xsd:string ,
                               "has follower"^^xsd:string ,
                               "has successor"^^xsd:string ,
                               "leading"^^xsd:string ,
                               "preceeds"^^xsd:string ,
                               "prior"^^xsd:string ;
                 core:changeNote "2020-06-22 Added alt labels, subclassed under 'related by order'. [Allotrope]"^^xsd:string ;
                 core:definition "Is followed by is a relation between entities that are items in an ordered sequence. For each pair of entities P, S being a member of the sequence, there exists an ordering function o so that o(P) < o(S). Iff o(P) < o(S) then P is followed by S. [Allotrope]"^^xsd:string ;
                 core:prefLabel "is followed by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002834
prop:AFX_0002834 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002858 ;
                 rdf:type owl:TransitiveProperty ;
                 prop:AFX_0002808 obo:NCIT_C38008 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "follows"^^xsd:string ;
                 core:altLabel "after"^^xsd:string ,
                               "has predecessor"^^xsd:string ,
                               "post"^^xsd:string ,
                               "succeeds"^^xsd:string ,
                               "trailing"^^xsd:string ;
                 core:changeNote "2020-06-22 Added alt labels, subclassed under 'related by order'. [Allotrope]"^^xsd:string ;
                 core:definition "Follows is a relation between entities that are items in an ordered sequence. For each pair of entities P, S being a member of the sequence, there exists an ordering function o so that o(P) < o(S).  Iff o(S) > o(P) the S follows P. [Allotrope]"^^xsd:string ;
                 core:prefLabel "follows"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002835
prop:AFX_0002835 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002833 ;
                 owl:inverseOf prop:AFX_0002836 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "is immediately followed by"^^xsd:string ;
                 core:altLabel "has next"^^xsd:string ,
                               "next"^^xsd:string ;
                 core:definition "Is immediately followed by is a relation between entities that are items in an ordered sequence. For each pair of entities P, S being a member of the sequence, there exists an ordering function o so that o(P) < o(S).  Iff for members P, S of the sequence, there is no member I that o(P) < o(I) < o(S), then P is immediately followed by S. [Allotrope]"^^xsd:string ;
                 core:prefLabel "is immediately followed by"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002836
prop:AFX_0002836 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002834 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "immediately follows"^^xsd:string ;
                 core:altLabel "has previous"^^xsd:string ,
                               "previous"^^xsd:string ;
                 core:definition "Immediately follows is a relation between entities that are items in an ordered sequence. For each pair of entities P, S being a member of the sequence, there exists an ordering function o so that o(P) < o(S).  Iff for members P, S of the sequence, there is no member I that o(S) > o(I) > o(P), then S follows P. [Allotrope]"^^xsd:string ;
                 core:prefLabel "immediately follows"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002837
prop:AFX_0002837 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "relation of"^^xsd:string ;
                 core:definition "Relation of is a relation of a relational entity to the referred entities. [Allotrope]"^^xsd:string ;
                 core:example "A ratio quality is relation of two qualities of the same kind, whose magnitude is a ratio value."^^xsd:string ,
                              "A sum datum is relation of its summands."^^xsd:string ;
                 core:note """This predicate is often used with punning, to avoid pre-coordination of ratios or differences.
A af-q:ratio 'af-x:relation of' pato:mass is a mass ratio quality."""^^xsd:string ;
                 core:prefLabel "relation of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002838
prop:AFX_0002838 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002837 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "relates to"^^xsd:string ;
                 core:definition "Relates to is a relation between a directed relational entity to the target of the relation. [Allotrope]"^^xsd:string ;
                 core:example "A ratio relates to the denominator."^^xsd:string ;
                 core:prefLabel "relates to"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002839
prop:AFX_0002839 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002837 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "relates from"^^xsd:string ;
                 core:definition "Relates from is a relation between a directed relational entity to the source of the relation. [Allotrope]"^^xsd:string ;
                 core:example "A ratio relates from the numerator."^^xsd:string ;
                 core:prefLabel "relates from"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002842
prop:AFX_0002842 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 owl:inverseOf prop:AFX_0002843 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0001561> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "defines"^^xsd:string ;
                 core:definition "The relation between a definition and the entity that is defined by it. [Allotrope]"^^xsd:string ;
                 core:prefLabel "defines"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002843
prop:AFX_0002843 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has definition"^^xsd:string ;
                 core:altLabel "defined by"^^xsd:string ,
                               "is defined by"^^xsd:string ;
                 core:definition "Has definition relates an entity to an information content entity that is its definition. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has definition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002845
prop:AFX_0002845 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002846 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "ingredient of"^^xsd:string ;
                 core:altLabel "is ingredient of"^^xsd:string ;
                 core:definition "Inverse of has ingredient. [Allotrope]"^^xsd:string ;
                 core:prefLabel "ingredient of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002846
prop:AFX_0002846 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:BFO_0000050 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "proper part of"^^xsd:string ;
                 core:altLabel "is proper part of"^^xsd:string ;
                 core:definition "Inverse of has proper part. [Allotrope]"^^xsd:string ;
                 core:prefLabel "proper part of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002847
prop:AFX_0002847 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002846 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "direct part of"^^xsd:string ;
                 core:altLabel "is direct part of"^^xsd:string ;
                 core:definition "Inverse of has direct part. [Allotrope]"^^xsd:string ;
                 core:prefLabel "direct part of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002848
prop:AFX_0002848 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:BFO_0000015 ;
                 rdfs:range obo:BFO_0000015 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "observes"^^xsd:string ;
                 core:definition "A process observing process p observes a process q if p produces information about the process q, such as the duration, or about some independent continuant participating in q in an important active or passive role. [Allotrope]"^^xsd:string ;
                 core:prefLabel "observes"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002849
prop:AFX_0002849 rdf:type owl:ObjectProperty ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( <http://purl.allotrope.org/ontologies/result#AFR_0000957>
                                            <http://purl.allotrope.org/ontologies/result#AFR_0001257>
                                          )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "applies"^^xsd:string ;
                 core:altLabel "conforms to"^^xsd:string ,
                               "follows"^^xsd:string ;
                 core:definition "An entity applies a specification or mathematical function, if the specification specifies the entity and the entity conforms or follows the specification. [Allotrope]"^^xsd:string ;
                 core:prefLabel "applies"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002853
prop:AFX_0002853 rdf:type owl:ObjectProperty ;
                 rdfs:domain obo:BFO_0000017 ;
                 rdfs:range <http://purl.allotrope.org/ontologies/result#AFR_0001872> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "fulfills"^^xsd:string ;
                 core:altLabel "meets"^^xsd:string ;
                 core:definition "A relation between a realizable entity and a requirement, that states that the process or process boundary that realizes it, satisfies all conditions of the requirement. [Allotrope]"^^xsd:string ;
                 core:prefLabel "fulfills"^^xsd:string .


