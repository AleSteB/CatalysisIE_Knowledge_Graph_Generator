                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A length quality which is equal to the length of any straight line segment that passes through the center of a circle and whose endpoints are on the circular boundary. [PATO]"^^xsd:string ;
                 core:prefLabel "diameter (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001413
obo:PATO_0001413 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0002242 ;
                 prop:AFX_0002865 obo:pato-owl ;
