                                                           rdfs:label "deflecting"^^xsd:string ;
                                                           core:altLabel "deflection"^^xsd:string ;
                                                           core:definition "A deflection, in physics, refers to the change in an objects' acceleration as a consequence of contact (collision) with a surface or the influence of a field. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "deflecting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003596
<http://purl.allotrope.org/ontologies/process#AFP_0003596> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003424> ;
