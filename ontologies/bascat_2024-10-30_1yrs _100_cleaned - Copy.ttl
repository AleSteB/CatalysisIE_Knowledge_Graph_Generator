                                                           core:altLabel "ABG"^^xsd:string ,
                                                                         "BGA"^^xsd:string ,
                                                                         "arterial blood gas"^^xsd:string ,
                                                                         "blood gas measurement"^^xsd:string ;
                                                           core:definition "Blood gas analysis is the process of analyzing amount of dissolved gases in a blood sample. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "blood gas analysis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001062
<http://purl.allotrope.org/ontologies/process#AFP_0001062> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000047> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ,
                                                                            <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/raman> ;
                                                           rdfs:label "Fourier transform Raman spectroscopy"^^xsd:string ;
                                                           core:altLabel "FT Raman spectrometry"^^xsd:string ,
                                                                         "FT Raman spectroscopy"^^xsd:string ,
                                                                         "FT-Raman"^^xsd:string ,
                                                                         "Fourier transform Raman spectrometry"^^xsd:string ,
                                                                         "Fourier-transform Raman spectrometry"^^xsd:string ,
                                                                         "Fourier-transform Raman spectroscopy"^^xsd:string ;
                                                           core:definition "A type of vibrational spectroscopy where the Raman scattering of light by a sample is detected and the spectrum is subject to a Fourier transform. [CHMO]"^^xsd:string ,
                                                                           "Fourier transform Raman spectroscopy is a type of vibrational spectroscopy where the Raman scattering of light by a sample is detected and the spectrum is subject to a Fourier transform. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "Fourier transform Raman spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001106
<http://purl.allotrope.org/ontologies/process#AFP_0001106> rdf:type owl:Class ;
