                                                           rdfs:label "quantification"^^xsd:string ;
                                                           core:altLabel "quantitation"^^xsd:string ;
                                                           core:definition "In mathematics and empirical science, quantification (or quantitation) is the act of counting and measuring that maps human sense observations and experiences into members of some set of numbers. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "quantification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003095
<http://purl.allotrope.org/ontologies/process#AFP_0003095> rdf:type owl:Class ;
