                                                               rdfs:label "transition"^^xsd:string ;
                                                               core:definition "A transition is a situation that is realized when one or more preceding processes end and the one or more succeeding processes begin. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "transition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000008
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000008> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "trigger"^^xsd:string ;
                                                               core:definition "A realizable entity that when realized coincides with the start of some intended or causally dependent process. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "trigger"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000011
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000011> rdf:type owl:Class ;
                                                               rdfs:subClassOf obo:BFO_0000016 ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "chemical disposition"^^xsd:string ;
                                                               core:altLabel "chemical agent"^^xsd:string ;
                                                               core:definition "A disposition of a portion of material to react with other materials in a specific way by nature of its chemical composition. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "chemical disposition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000012
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000012> rdf:type owl:Class ;
                                                               owl:equivalentClass obo:CHEBI_27780 ;
