###  http://purl.obolibrary.org/obo/BFO_0000018
obo:BFO_0000018 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000006 ;
                owl:disjointWith obo:BFO_0000028 ;
                obo:BFO_0000179 "0d-s-region"^^xsd:string ;
                obo:BFO_0000180 "ZeroDimensionalSpatialRegion"^^xsd:string ;
                obo:IAO_0000600 "A zero-dimensional spatial region is a point in space. (axiom label in BFO2 Reference: [037-001])"^^xsd:string ;
                obo:IAO_0000602 "(forall (x) (if (ZeroDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [037-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "zero-dimensional spatial region"^^xsd:string ;
                core:altLabel "0D spatial region"^^xsd:string ;
                core:definition "A zero-dimensional spatial region is a point in space. [BFO]"^^xsd:string ;
                core:prefLabel "zero-dimensional spatial region"^^xsd:string .

[ rdf:type owl:Axiom ;
