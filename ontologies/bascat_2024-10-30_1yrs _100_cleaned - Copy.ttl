                                                         core:prefLabel "matrix sample role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000571
<http://purl.allotrope.org/ontologies/role#AFRL_0000571> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000255> ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/sec> ;
                                                         rdfs:label "narrow standard role (size-exclusion chromatography)"^^xsd:string ;
                                                         core:definition "A narrow standard role is a standard sample role used in size-exclusion chromatography that has a narrow molecular-weight distribution and are typically chemically different than the sample. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "narrow standard role (size-exclusion chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000572
