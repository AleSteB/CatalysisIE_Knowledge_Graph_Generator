                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000058>
                                                                          ] ;
                                                          term:source <https://en.wikipedia.org/wiki/Heat_capacity> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "heat capacity"^^xsd:string ;
                                                          core:altLabel "heat capacity (datum)"^^xsd:string ;
                                                          core:definition "Heat capacity is a quantification facet that quantifies the amount of heat to be supplied to a given mass of a material to produce a unit change in its temperature. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "heat capacity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002023
<http://purl.allotrope.org/ontologies/result#AFR_0002023> rdf:type owl:Class ;
