                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "room"^^xsd:string ;
                                                            core:definition "A room is a site that is a part or division of a building enclosed by walls, floor, and ceiling. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "room"^^xsd:string .


###  http://purl.allotrope.org/ontologies/spatial#AFSP_0000005
<http://purl.allotrope.org/ontologies/spatial#AFSP_0000005> rdf:type owl:Class ;
                                                            rdfs:subClassOf obo:BFO_0000029 ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "space"^^xsd:string ;
                                                            core:altLabel "free space"^^xsd:string ,
                                                                          "room"^^xsd:string ;
                                                            core:definition "A space is a site that can be occupied or where something can be done. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "space"^^xsd:string ;
                                                            core:scopeNote "Space is especially viewed in terms of whether there is enough. [Allotrope]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/spatial#AFSP_0000006
<http://purl.allotrope.org/ontologies/spatial#AFSP_0000006> rdf:type owl:Class ;
                                                            rdfs:subClassOf obo:BFO_0000029 ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "campus"^^xsd:string ;
