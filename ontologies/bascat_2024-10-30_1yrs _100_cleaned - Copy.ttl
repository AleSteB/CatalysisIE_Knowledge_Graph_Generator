   owl:annotatedSource obo:BFO_0000002 ;
   owl:annotatedProperty obo:IAO_0000602 ;
   owl:annotatedTarget "(forall (x y) (if (and (Continuant x) (exists (t) (continuantPartOfAt y x t))) (Continuant y))) // axiom label in BFO2 CLIF: [009-002] "^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/009-002>
 ] .

