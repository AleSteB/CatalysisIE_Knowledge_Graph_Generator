                                                               rdfs:label "situation"^^xsd:string ;
                                                               core:definition "Portion of reality that is realized in some process. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "situation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000004
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000004> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "configuration"^^xsd:string ;
                                                               core:altLabel "constitution"^^xsd:string ,
                                                                             "physique"^^xsd:string ,
                                                                             "structure"^^xsd:string ;
                                                               core:definition "A specific combination of qualities that the bearer realizes at some time. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000005
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000005> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "environmental situation"^^xsd:string ;
                                                               core:altLabel "environment"^^xsd:string ;
                                                               core:definition "A situation that is realized in a processes outside the system boundary of an operation situation of a device. [Allotrope]"^^xsd:string ;
                                                               core:example "example: humid conditions"^^xsd:string ;
                                                               core:prefLabel "environmental situation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000006
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000006> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "operational situation"^^xsd:string ;
                                                               core:altLabel "operation"^^xsd:string ;
                                                               core:changeNote "2019-09-20 Moved, an operational situation is not necessarily an environmental situation. [Allotrope]"^^xsd:string ;
                                                               core:definition "The situation when a device is performing its intended function. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "operational situation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000007
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000007> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000003> ;
                                                               prop:AFX_0002818 "true"^^xsd:boolean ;
