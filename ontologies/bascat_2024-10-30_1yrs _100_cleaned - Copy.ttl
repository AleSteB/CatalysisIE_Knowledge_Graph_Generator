                                                           core:altLabel "UV-vis-DRS"^^xsd:string ,
                                                                         "UV-vis-diffuse reflectance spectroscopy"^^xsd:string ,
                                                                         "diffuse reflectance UV-vis spectroscopy"^^xsd:string ,
                                                                         "diffuse reflectance UV-visible"^^xsd:string ;
                                                           core:definition "A type of spectroscopy where the diffuse reflection of radiation in the range ultraviolet to visible (190-800 nm) by a sample is measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "diffuse reflectance ultraviolet-visible spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000422
<http://purl.allotrope.org/ontologies/process#AFP_0000422> rdf:type owl:Class ;
