                                                           rdfs:label "specific enthalpy of vaporization (quality)"^^xsd:string ;
                                                           core:altLabel "specific heat of evaporation"^^xsd:string ,
                                                                         "specific heat of vaporization"^^xsd:string ,
                                                                         "specific latent heat of vaporization"^^xsd:string ;
                                                           core:definition "The specific enthalpy of vaporization is the enthalpy of vaporization referenced to a unit mass of substance. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "specific enthalpy of vaporization (quality)"^^xsd:string .


