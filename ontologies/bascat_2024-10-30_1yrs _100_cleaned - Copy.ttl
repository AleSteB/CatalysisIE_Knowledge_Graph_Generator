###  http://purl.allotrope.org/ontologies/property#AFX_0002808
prop:AFX_0002808 rdf:type owl:AnnotationProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ;
                 rdfs:label "has close match"^^xsd:string ;
                 core:definition "Has close match establishes a connection between two resources that have a high degree of agreement in meaning such that they can be used interchangeably. [Allotrope]"^^xsd:string ;
