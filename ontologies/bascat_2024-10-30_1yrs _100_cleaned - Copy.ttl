                                                           rdfs:label "electronic absorbance detection wavelength"^^xsd:string ;
                                                           core:definition "The electronic absorbance detection wavelength is the detection wavelength setting of an electronic absorbance detector. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "electronic absorbance detection wavelength"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000198
<http://purl.allotrope.org/ontologies/quality#AFQ_0000198> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000199> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection> ;
                                                           rdfs:label "detection bandwidth"^^xsd:string ;
                                                           core:definition "Detection bandwidth is a device setting of a detector controlling the bandwidth of the detection wavelength. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "detection bandwidth"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000199
<http://purl.allotrope.org/ontologies/quality#AFQ_0000199> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/equipment#AFE_0000317>
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection> ;
                                                           rdfs:label "detector configuration"^^xsd:string ;
                                                           core:altLabel "detector setting"^^xsd:string ;
                                                           core:definition "A detector configuration is a device configuration of a detector. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "detector configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000200
<http://purl.allotrope.org/ontologies/quality#AFQ_0000200> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000204> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "signal configuration"^^xsd:string ;
                                                           core:altLabel "signal setting"^^xsd:string ;
                                                           core:definition "A signal configuration is a device configuration of a device producing or consuming signals, that controls the processing of a signal. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "signal configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000201
<http://purl.allotrope.org/ontologies/quality#AFQ_0000201> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000200> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "signal gain configuration"^^xsd:string ;
                                                           core:altLabel "amplification"^^xsd:string ,
                                                                         "amplification configuration"^^xsd:string ,
                                                                         "amplification setting"^^xsd:string ,
                                                                         "gain"^^xsd:string ,
                                                                         "gain configuration"^^xsd:string ,
                                                                         "gain setting"^^xsd:string ,
                                                                         "signal amplification setting"^^xsd:string ,
                                                                         "signal gain setting"^^xsd:string ;
                                                           core:definition "A gain setting is a signal configuration, that controls the amplification of an incoming or outgoing signal. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "signal gain configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000202
<http://purl.allotrope.org/ontologies/quality#AFQ_0000202> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000200> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "signal offset configuration"^^xsd:string ;
                                                           core:altLabel "signal offset setting"^^xsd:string ;
                                                           core:definition "A signal offset configuration is a signal processing configuration, that adds/subtracts a fixed amount of magnitude to the signal strength or amplitude to move the zero reference. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "signal offset configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000203
<http://purl.allotrope.org/ontologies/quality#AFQ_0000203> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Class ;
                                                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002722 ;
                                                                                             owl:someValuesFrom obo:PATO_0000146
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002723 ;
                                                                                             owl:someValuesFrom obo:PATO_0000146
                                                                                           ]
                                                                                         )
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "temperature configuration"^^xsd:string ;
                                                           core:altLabel "temperature setting"^^xsd:string ;
                                                           core:changeNote "2018-12-10 Changed alt label to temperature setting. [Allotrope]"^^xsd:string ,
                                                                           "2018-12-10 Changed definition to include alerting [Allotrope]"^^xsd:string ,
                                                                           "2018-12-10 Moved to AFO. [Allotrope]"^^xsd:string ,
                                                                           "2019-07-01 Added relation to the temperature being controlled or observed. [Allotrope]"^^xsd:string ;
                                                           core:definition "A temperature configuration is a device configuration of a temperature controlling or monitoring device, that controls or monitors the target temperature at the site of some system component. [Allotrope]"^^xsd:string ;
                                                           core:example "An oven thermostat has a temperature configuration that controls the heating."^^xsd:string ;
                                                           core:prefLabel "temperature configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000204
<http://purl.allotrope.org/ontologies/quality#AFQ_0000204> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002723 ;
                                                                             owl:someValuesFrom obo:BFO_0000019
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "controller configuration"^^xsd:string ;
                                                           core:altLabel "control setting"^^xsd:string ,
                                                                         "controller setting"^^xsd:string ;
                                                           core:definition "A controller configuration is a device configuration of a controller, that directly influences the controlling process done by the controller towards a goal. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "controller configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000205
<http://purl.allotrope.org/ontologies/quality#AFQ_0000205> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002722 ;
                                                                             owl:someValuesFrom obo:BFO_0000019
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "trigger configuration"^^xsd:string ;
                                                           core:altLabel "trigger setting"^^xsd:string ;
                                                           core:definition "A trigger configuration is a device configuration for a system with a sensor and an actor component, that directly influences when the sensor sends an activating signal to the actor based on an observation. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "trigger configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000206
<http://purl.allotrope.org/ontologies/quality#AFQ_0000206> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000205> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "notification configuration"^^xsd:string ;
                                                           core:altLabel "alert configuration"^^xsd:string ,
                                                                         "alert setting"^^xsd:string ,
                                                                         "notification setting"^^xsd:string ,
                                                                         "signaling configuration"^^xsd:string ,
                                                                         "signaling setting"^^xsd:string ;
                                                           core:definition "A notification setting is a trigger setting in a system that has a notification component, that controls when the component send out a notification signal. [Allotrope]"^^xsd:string ;
                                                           core:example "A pressure sensor measures the pressure of the liquid in the plumbing an if the notification setting on the pressure is above a maximum, it triggers the notification of a signaling device, such as a warning lamp."^^xsd:string ;
                                                           core:prefLabel "notification configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000208
<http://purl.allotrope.org/ontologies/quality#AFQ_0000208> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001025 ;
                                                           term:source <https://en.wikipedia.org/wiki/Partial_pressure> ,
                                                                       "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ,
                                                                       "PAC, 1994, 66, 533 (Standard quantities in chemical thermodynamics. Fugacities, activities and equilibrium constants for pure and mixed phases (IUPAC Recommendations 1994))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "partial pressure (quality)"^^xsd:string ;
                                                           core:altLabel "partial pressure"^^xsd:string ;
                                                           core:definition "Partial pressure is the notional pressure of a gas in a mixture of gases, if it alone occupied the entire volume of the original mixture at the same temperature. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "partial pressure (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000209
<http://purl.allotrope.org/ontologies/quality#AFQ_0000209> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000025 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "purity (quality)"^^xsd:string ;
                                                           core:altLabel "purity"^^xsd:string ;
                                                           core:definition "Purity is a composition quality inhering in an bearer by virtue of the bearer lacking undesired components. [Allotrope]"^^xsd:string ;
                                                           core:note "It is generally quantified by the sum of the mass fractions of the impurities subtracted from a theoretically pure value of 100%."^^xsd:string ;
                                                           core:prefLabel "purity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000210
<http://purl.allotrope.org/ontologies/quality#AFQ_0000210> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mechanical quality"^^xsd:string ;
                                                           core:altLabel "mechanics quality"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in an bearer by virtue of how that bearer behaves when subjected to forces or displacements and the effect of their bodies on their environment. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "mechanical quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000211
<http://purl.allotrope.org/ontologies/quality#AFQ_0000211> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000210> ;
                                                           term:subject <https://en.wikipedia.org/wiki/Deformation_(mechanics)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "strain (quality)"^^xsd:string ;
                                                           core:altLabel "deformation"^^xsd:string ,
                                                                         "strain"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed prefLabel. [Allotrope]"^^xsd:string ;
                                                           core:definition "Strain is a quality of deformation representing the displacement between particles in the body relative to a reference length. [Wikipedia]"^^xsd:string ;
                                                           core:note "A general deformation of a body can be expressed in the form x = F(X) where X is the reference position of material points in the body."^^xsd:string ;
                                                           core:prefLabel "strain (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000212
<http://purl.allotrope.org/ontologies/quality#AFQ_0000212> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000210> ;
                                                           term:subject <https://en.wikipedia.org/wiki/Shear_stress> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "shear stress (quality)"^^xsd:string ;
                                                           core:altLabel "shear stress"^^xsd:string ,
                                                                         "τ"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "A shearing force is applied to the top of the rectangle while the bottom is held in place. The resulting shear stress deforms the rectangle into a parallelogram. The area involved would be the top of the parallelogram. A shear stress is the component of stress coplanar with a material cross section. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "shear stress (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000213
<http://purl.allotrope.org/ontologies/quality#AFQ_0000213> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000211> ;
                                                           term:subject <https://en.wikipedia.org/wiki/Deformation_(mechanics)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "normal strain"^^xsd:string ;
                                                           core:definition "A normal strain is strain perpendicular to the face of an element. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "normal strain"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000214
<http://purl.allotrope.org/ontologies/quality#AFQ_0000214> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000211> ;
                                                           term:subject <https://en.wikipedia.org/wiki/Deformation_(mechanics)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "shear strain"^^xsd:string ;
                                                           core:definition "A shear strain is parallel to the face of an element. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "shear strain"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000215
<http://purl.allotrope.org/ontologies/quality#AFQ_0000215> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000222> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "total impurities"^^xsd:string ;
                                                           core:altLabel "total mass of impurities"^^xsd:string ;
                                                           core:definition "Total impurities is a composition quality that is the sum of the mass of all impurities in a material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "total impurities"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000216
<http://purl.allotrope.org/ontologies/quality#AFQ_0000216> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000209> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "stereochemical purity"^^xsd:string ;
                                                           core:definition "A purity quality of a material with respect to its stereoisomers. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "stereochemical purity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000217
<http://purl.allotrope.org/ontologies/quality#AFQ_0000217> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000221> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000223> ;
                                                           prop:AFX_0002808 obo:CHMO_0002860 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "diastereomeric excess"^^xsd:string ;
                                                           core:definition "The absolute value of the mole fraction for one diastereomer in a mixture minus the mole fraction for the other. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "diastereomeric excess"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000218
<http://purl.allotrope.org/ontologies/quality#AFQ_0000218> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000223> ;
                                                           prop:AFX_0002808 obo:CHMO_0002858 ;
                                                           term:source "doi:10.1359/goldbook.D01681"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "diastereomeric ratio"^^xsd:string ;
                                                           core:definition "The ratio of the percentage of one diastereomer in a mixture to that of the other. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "diastereomeric ratio"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000219
<http://purl.allotrope.org/ontologies/quality#AFQ_0000219> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000223> ;
                                                           prop:AFX_0002808 obo:CHMO_0002859 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "enantiomeric ratio"^^xsd:string ;
                                                           core:definition "The ratio of the percentage of one enantiomer in a mixture to that of the other. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "enantiomeric ratio"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000220
<http://purl.allotrope.org/ontologies/quality#AFQ_0000220> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000221> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000223> ;
                                                           prop:AFX_0002808 obo:CHMO_0002856 ;
                                                           term:source "doi:10.1359/goldbook.E02070"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "enantiomeric excess"^^xsd:string ;
                                                           core:definition "The absolute value of the mole fraction for one enantiomer in a mixture minus the mole fraction for the other enantiomer. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "enantiomeric excess"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000221
<http://purl.allotrope.org/ontologies/quality#AFQ_0000221> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000145 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "excess"^^xsd:string ;
                                                           core:altLabel "difference"^^xsd:string ;
                                                           core:definition "An excess  is a relational quality that is the difference in magnitude of two qualities of the same kind. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "excess"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000222
<http://purl.allotrope.org/ontologies/quality#AFQ_0000222> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000025 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "impurity (quality)"^^xsd:string ;
                                                           core:altLabel "impurity"^^xsd:string ;
                                                           core:definition "Impurity is a composition quality inhering in an bearer by virtue of the bearer having undesired components. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "impurity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000223
<http://purl.allotrope.org/ontologies/quality#AFQ_0000223> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000025 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "stereochemical composition"^^xsd:string ;
                                                           core:definition "Stereochemical composition is a composition quality based on the stereochemistry of its components. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "stereochemical composition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000224
<http://purl.allotrope.org/ontologies/quality#AFQ_0000224> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000025 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dilution composition"^^xsd:string ;
                                                           core:definition "A dilution composition is a composition quality of a dilution. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dilution composition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000225
