                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "thermal energy"^^xsd:string ;
                                                            core:definition "A form of energy that is transferred between bodies as a result of a temperature difference. [NIST]"^^xsd:string ;
                                                            core:prefLabel "thermal energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000882
<http://purl.allotrope.org/ontologies/material#AFM_0000882> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "mechanic translational energy"^^xsd:string ;
                                                            core:definition "Energy flow generated or required by a translation or virtual translation. [NIST]"^^xsd:string ;
                                                            core:prefLabel "mechanic translational energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000883
<http://purl.allotrope.org/ontologies/material#AFM_0000883> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "chemical energy"^^xsd:string ;
                                                            core:definition "Work resulting from the reactions by which substances are produced from or converted into other substances. [NIST]"^^xsd:string ;
                                                            core:example "A battery converts the flow of chemical energy into electical energy."^^xsd:string ;
                                                            core:prefLabel "chemical energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000884
<http://purl.allotrope.org/ontologies/material#AFM_0000884> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
