###  http://purl.allotrope.org/ontologies/material#AFM_0001079
<http://purl.allotrope.org/ontologies/material#AFM_0001079> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001034> ,
                                                                            [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0001034>
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty obo:RO_0000056 ;
                                                                                                     owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003640>
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ] ;
                                                            prop:AFX_0002798 "true"^^xsd:boolean ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source <https://en.wikipedia.org/wiki/Dispersion_(chemistry)> ,
                                                                        "\"Terminology of polymers and polymerization processes in dispersed systems (IUPAC Recommendations 2011)\" . Pure and Applied Chemistry. 83 (12): 2229–2259. 2011."^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "dispersion"^^xsd:string ;
                                                            core:changeNote "2017-07-03 Changed definition to IUPAC recommendation. [Allotrope]"^^xsd:string ;
                                                            core:definition "A dispersions is a heterogeneous mixture that is comprising more than one phase where at least one of the phases consists of finely divided phase domains, often in the colloidal size range, dispersed throughout a continuous phase. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "dispersion"^^xsd:string .


