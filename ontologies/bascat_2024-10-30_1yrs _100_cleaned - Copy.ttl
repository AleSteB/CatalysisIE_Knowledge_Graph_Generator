                                                         rdfs:label "result role"^^xsd:string ;
                                                         core:altLabel "result"^^xsd:string ;
                                                         core:definition "Result role is a data output role that applies to new information produced by a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "result role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000312
<http://purl.allotrope.org/ontologies/role#AFRL_0000312> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000248> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "ratio datum role"^^xsd:string ;
                                                         core:altLabel "ratio datum"^^xsd:string ,
                                                                       "ratio value"^^xsd:string ;
                                                         core:changeNote "2020-03-16 Changed pref label and definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "A ratio datum role is a relative datum role that expresses the relative magnitude as a ratio of the magnitude of the subject to that of the reference entity. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "ratio datum role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000313
<http://purl.allotrope.org/ontologies/role#AFRL_0000313> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000248> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "difference datum role"^^xsd:string ;
                                                         core:altLabel "difference datum"^^xsd:string ,
                                                                       "difference value"^^xsd:string ;
                                                         core:changeNote "2020-03-16 Changed pref label and definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "A difference datum role is a relative datum role that expresses the relative magnitude as a difference or interval of the magnitude of the subject to that of the reference entity. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "difference datum role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000314
<http://purl.allotrope.org/ontologies/role#AFRL_0000314> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "relation role"^^xsd:string ;
                                                         core:definition "A relation role is a contextual role of an information content entity that is about a relation of the subject of the information content entity to another entity. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "relation role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000316
<http://purl.allotrope.org/ontologies/role#AFRL_0000316> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000170> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "first member"^^xsd:string ;
                                                         core:altLabel "first"^^xsd:string ;
                                                         core:definition "A first member is an ordered member that has no predecessor in the aggregate. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "first member"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000317
<http://purl.allotrope.org/ontologies/role#AFRL_0000317> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000170> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "last member"^^xsd:string ;
                                                         core:altLabel "last"^^xsd:string ;
                                                         core:definition "A last member is an ordered member that has no successor in the aggregate. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "last member"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000319
<http://purl.allotrope.org/ontologies/role#AFRL_0000319> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000277> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty prop:AFX_0002734 ;
                                                                                                owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003634>
                                                                                              ]
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "statistical role"^^xsd:string ;
                                                         core:definition "A statistical role is a contextual role of data in statistics. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "statistical role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000320
<http://purl.allotrope.org/ontologies/role#AFRL_0000320> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000328> ;
                                                         term:source <https://en.wikipedia.org/wiki/Arithmetic_mean> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "arithmetic mean role"^^xsd:string ;
                                                         core:altLabel "arithmetic mean"^^xsd:string ,
                                                                       "average"^^xsd:string ,
                                                                       "average role"^^xsd:string ,
                                                                       "mean"^^xsd:string ,
                                                                       "mean role"^^xsd:string ;
                                                         core:changeNote "2020-09-18 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "The arithmetic mean is a statistical datum role of a datum that is the sum of a collection of numbers divided by the number of numbers in the collection. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "arithmetic mean role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000321
<http://purl.allotrope.org/ontologies/role#AFRL_0000321> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000328> ;
                                                         term:source <https://en.wikipedia.org/wiki/Median> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "median role"^^xsd:string ;
                                                         core:altLabel "median"^^xsd:string ;
                                                         core:changeNote "2020-09-18 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "The median role is a statistical datum role that denotes the value separating the higher half of a data sample, a population, or a probability distribution, from the lower half. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "median role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000322
<http://purl.allotrope.org/ontologies/role#AFRL_0000322> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000328> ;
                                                         term:source <https://en.wikipedia.org/wiki/Skewness> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "skewness role"^^xsd:string ;
                                                         core:altLabel "skewness"^^xsd:string ;
                                                         core:changeNote "2020-09-18 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "Skewness role is a statistical datum role of a datum that is a measure of the asymmetry of the probability distribution of a real-valued random variable about its mean. The skewness value can be positive or negative, or undefined. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "skewness role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000323
<http://purl.allotrope.org/ontologies/role#AFRL_0000323> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000328> ;
                                                         term:source <https://en.wikipedia.org/wiki/Variance> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "variance role"^^xsd:string ;
                                                         core:altLabel "variance"^^xsd:string ;
                                                         core:changeNote "2020-09-18 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "The variance role is a statistical datum role of a datum that denotes the expectation of the squared deviation of a random variable from its mean. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "variance role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000324
<http://purl.allotrope.org/ontologies/role#AFRL_0000324> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000319> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/common#AFC_0000166>
                                                                         ] ;
                                                         term:source <https://en.wikipedia.org/wiki/Statistical_population> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "statistical sample role"^^xsd:string ;
                                                         core:definition "A statistical sample role is the contextual role of a subset of a statistical population that is chosen to represent the population in a statistical analysis. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "statistical sample role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000325
<http://purl.allotrope.org/ontologies/role#AFRL_0000325> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000319> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/common#AFC_0000166>
                                                                         ] ;
                                                         term:source <https://en.wikipedia.org/wiki/Statistical_population> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "statistical population role"^^xsd:string ;
                                                         core:altLabel "population"^^xsd:string ,
                                                                       "population role"^^xsd:string ,
                                                                       "statistical population"^^xsd:string ;
                                                         core:definition "A statistical population role is the statistical role of a set of similar items or events which is of interest for some question or experiment (the statistical population). A statistical population can be a group of existing entities or a hypothetical and potentially infinite group of entities conceived as a generalization from experience. [Wikipedia]"^^xsd:string ;
                                                         core:example "the class of living cells is the population role in the 'average living cell diameter' result datum of a cell counter result"^^xsd:string ;
                                                         core:prefLabel "statistical population role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000326
<http://purl.allotrope.org/ontologies/role#AFRL_0000326> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000319> ;
                                                         term:source <https://en.wikipedia.org/wiki/Random_variable> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "random variable"^^xsd:string ;
                                                         core:altLabel "aleatory variable"^^xsd:string ,
                                                                       "random quantity"^^xsd:string ,
                                                                       "stochastic variable"^^xsd:string ;
                                                         core:definition "In probability and statistics, a random variable, random quantity, aleatory variable, or stochastic variable is a variable whose possible values are outcomes of a random phenomenon. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "random variable"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000328
<http://purl.allotrope.org/ontologies/role#AFRL_0000328> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000319> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000442> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "statistic datum role"^^xsd:string ;
                                                         core:altLabel "statistic"^^xsd:string ,
                                                                       "statistic datum"^^xsd:string ,
                                                                       "statistical result"^^xsd:string ;
                                                         core:changeNote "2020-09-18 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A statistic datum is the summary output of descriptive statistics on a statistical population. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "statistic datum role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000330
<http://purl.allotrope.org/ontologies/role#AFRL_0000330> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000982> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000064> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002704 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/realizable#AFRE_0000008>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "trigger datum"^^xsd:string ;
                                                         core:altLabel "trigger value"^^xsd:string ;
                                                         core:definition "An trigger datum is the role of a  datum that specifies some situation about a system or environment participating in a process that should trigger the start of another process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "trigger datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000332
<http://purl.allotrope.org/ontologies/role#AFRL_0000332> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:IAO_0000136 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/realizable#AFRE_0000005>
                                                                         ] ;
                                                         prop:AFX_0002808 <http://purl.oclc.org/NET/ssnx/ssn#SurvivalRange> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "survival range"^^xsd:string ;
                                                         core:definition "An survival range is the contextual role of an description or specification of about an environment in which the operation of a system can or should operate without damaging the system. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "survival range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000333
<http://purl.allotrope.org/ontologies/role#AFRL_0000333> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000330> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "alert datum"^^xsd:string ;
                                                         core:altLabel "alert value"^^xsd:string ;
                                                         core:definition "An alert datum is a trigger datum that specifies a trigger that initiates a notification process that warns about an unintended situation. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "alert datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000335
<http://purl.allotrope.org/ontologies/role#AFRL_0000335> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000159> ;
