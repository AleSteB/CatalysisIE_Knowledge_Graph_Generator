                                                           core:prefLabel "calorimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000620
<http://purl.allotrope.org/ontologies/process#AFP_0000620> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "osmometry"^^xsd:string ;
                                                           core:altLabel "osometry"^^xsd:string ;
                                                           core:definition "The measurement of the osmotic strength of a substance which often used to determine its molecular weight. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "osmometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000634
<http://purl.allotrope.org/ontologies/process#AFP_0000634> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "volumetric titration"^^xsd:string ;
                                                           core:definition "Volumetric titration is the process of determining the quantity of a sample by adding measured volumes of a titrant (normally via a burette) until the end-point, at which essentially all of the sample has reacted, is reached. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "volumetric titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000669
<http://purl.allotrope.org/ontologies/process#AFP_0000669> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003335> ,
                                                                           obo:OBI_0000011 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electrophoresis"^^xsd:string ;
                                                           core:altLabel "cataphoresis"^^xsd:string ,
                                                                         "electrophoretic analysis"^^xsd:string ;
                                                           core:definition "An electrophoresis is a separation where colloidal particles move at different speeds according to their electrophoretic mobilities in a separation medium, across which an electric field is applied. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "electrophoresis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000698
<http://purl.allotrope.org/ontologies/process#AFP_0000698> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "nanoflow high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "nHPLC"^^xsd:string ,
                                                                         "nano HPLC"^^xsd:string ,
                                                                         "nano flow HPLC"^^xsd:string ,
                                                                         "nano high performance liquid chromatography"^^xsd:string ,
                                                                         "nano high pressure liquid chromatography"^^xsd:string ,
                                                                         "nano high-performance liquid chromatography"^^xsd:string ,
                                                                         "nano high-pressure liquid chromatography"^^xsd:string ,
                                                                         "nano-HPLC"^^xsd:string ,
                                                                         "nanoHPLC"^^xsd:string ,
                                                                         "nanoflow HPLC"^^xsd:string ,
                                                                         "nanoflow high performance liquid chromatography"^^xsd:string ,
                                                                         "nanoflow high pressure liquid chromatography"^^xsd:string ,
                                                                         "nanoflow high-pressure liquid chromatography"^^xsd:string ,
                                                                         "nanoflow-HPLC"^^xsd:string ,
                                                                         "nanoflowHPLC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles, the inlet pressure is relatively high and the flow rate is nL min-1. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "nanoflow high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000708
<http://purl.allotrope.org/ontologies/process#AFP_0000708> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003349> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "loading"^^xsd:string ;
                                                           core:changeNote "2020-06-18 Changed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Loading is the importing of a material into a new location that contains the material. [Allotrope]"^^xsd:string ;
                                                           core:example "The loading step of IEF is the mixing of the sample with the appropriate ampholytes and loading the mixture into the capillary. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "loading"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000733
<http://purl.allotrope.org/ontologies/process#AFP_0000733> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "amperometry"^^xsd:string ;
                                                           core:altLabel "amperometric method"^^xsd:string ;
                                                           core:definition "An electrochemical technique where the cell current is measured whilst the potential difference between the indicator and reference electrodes is controlled. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "amperometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000747
<http://purl.allotrope.org/ontologies/process#AFP_0000747> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "catalymetric titration"^^xsd:string ;
                                                           core:definition "Catalymetric titration is he process of determining the quantity of a sample by adding measured increments of a titrant until the end-point is reached. The titration involves a catalyst, and the end-point is detected by the sudden increase or decrease in the rate of a reaction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "catalymetric titration"^^xsd:string .


