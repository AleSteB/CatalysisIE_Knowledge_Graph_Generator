                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "continuous phase role"^^xsd:string ;
                                                         core:altLabel "continuous medium"^^xsd:string ,
                                                                       "continuous medium role"^^xsd:string ,
                                                                       "continuous phase"^^xsd:string ;
                                                         core:definition """The continuous phase role is the dispersion role of a portion of material constituting the medium, a phase that exhibits continuity throughout the
dispersion. [NIST]"""^^xsd:string ;
                                                         core:prefLabel "continuous phase role"^^xsd:string .


