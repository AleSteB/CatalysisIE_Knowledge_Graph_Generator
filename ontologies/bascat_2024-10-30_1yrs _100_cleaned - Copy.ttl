                                                         rdfs:label "default transition"^^xsd:string ;
                                                         core:definition "An default transition is a successor role in the scope of an exclusive gateway that specifies the succeeding activity if no guard conditions on the gateway are met. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "default transition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000474
<http://purl.allotrope.org/ontologies/role#AFRL_0000474> rdf:type owl:Class ;
