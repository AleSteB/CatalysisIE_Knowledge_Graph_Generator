                 rdfs:label "has state"^^xsd:string ;
                 core:definition "Has state is a relation between an continuant c and a state s where the c participates in s and s is expressed in the same way in terms of c at all times during s. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has state"^^xsd:string .


