                                                          rdfs:label "arithmetic mean"^^xsd:string ;
                                                          core:altLabel "mean"^^xsd:string ;
                                                          core:definition "The arithmetic mean is a descriptive statistic that is the sum of a collection of numbers divided by the number of numbers in the collection. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "arithmetic mean"^^xsd:string .


