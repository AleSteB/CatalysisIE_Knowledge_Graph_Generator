                                                           core:definition "Vibrational spectroscopy is a spectroscopy which probes the vibrational degrees of freedom of a molecule. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "vibrational spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000785
<http://purl.allotrope.org/ontologies/process#AFP_0000785> rdf:type owl:Class ;
