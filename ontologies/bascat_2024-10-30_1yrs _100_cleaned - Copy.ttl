                                                           rdfs:label "ion reaction"^^xsd:string ;
                                                           core:definition "An ion reaction is a chemical reaction that has ion participants. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ion reaction"^^xsd:string .


