                                                           rdfs:label "assay"^^xsd:string ;
                                                           core:altLabel "analysis"^^xsd:string ;
                                                           core:changeNote "2020-03-23 Changed alt labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "A planned process with the objective to produce information about the material entity that is the evaluand, by physically examining it or its proxies. [OBI]"^^xsd:string ;
                                                           core:prefLabel "assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002683
<http://purl.allotrope.org/ontologies/process#AFP_0002683> rdf:type owl:Class ;
