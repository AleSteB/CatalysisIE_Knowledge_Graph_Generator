                                                         rdfs:label "selected device"^^xsd:string ;
                                                         core:changeNote "2018-07-23 Made a defined class and moved to AFO. [Allotrope]"^^xsd:string ;
                                                         core:definition "A device that is selected to perform a specific function in a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "selected device"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000028
<http://purl.allotrope.org/ontologies/role#AFRL_0000028> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000064> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "setting datum"^^xsd:string ;
                                                         core:altLabel "setting role"^^xsd:string ,
                                                                       "setting value"^^xsd:string ;
                                                         core:changeNote "2018-07-31 Changed definition and pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "Setting datum is the contextual role of an information object that specifies some device or process setting. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "setting datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000029
<http://purl.allotrope.org/ontologies/role#AFRL_0000029> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000073> ,
