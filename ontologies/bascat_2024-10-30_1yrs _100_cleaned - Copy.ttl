                                                          core:definition "Above indicates a vertical position that is higher than another. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "above"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002597
<http://purl.allotrope.org/ontologies/result#AFR_0002597> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002596> ;
