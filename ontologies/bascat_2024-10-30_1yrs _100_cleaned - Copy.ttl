###  http://purl.allotrope.org/ontologies/result#AFR_0002764
<http://purl.allotrope.org/ontologies/result#AFR_0002764> rdf:type owl:Class ;
                                                          rdfs:subClassOf obo:IAO_0000310 ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty obo:IAO_0000136 ;
                                                                            owl:someValuesFrom [ owl:intersectionOf ( obo:IAO_0000030
                                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                                        owl:onProperty prop:AFX_0002803 ;
                                                                                                                        owl:someValuesFrom obo:IAO_0000009
                                                                                                                      ]
                                                                                                                    ) ;
                                                                                                 rdf:type owl:Class
                                                                                               ]
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "custom information document"^^xsd:string ;
                                                          core:definition "A custom information document is a document that about some labeled information entity for which limited meaning and/or context is known. [Allotrope]"^^xsd:string ;
                                                          core:example "Information placed by a user in acquisition or processing software in a field that is ambiguously defined by the software ( e.g. ‘SPARE FIELD 1’). This allows the information tag and value to be unambiguously linked and therefore retrieved by those with knowledge into its use for the data being interrogated. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "custom information document"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002765
<http://purl.allotrope.org/ontologies/result#AFR_0002765> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001583> ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          term:source "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\"). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997). Online version (2019-) created by S. J. Chalk. ISBN 0-9678550-9-8. https://doi.org/10.1351/goldbook."^^xsd:string ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "attenuation coefficient"^^xsd:string ;
                                                          core:altLabel "extinction coefficient"^^xsd:string ;
                                                          core:definition "Linear decadic (a,K) and Napierian attenuation coefficients (α) are equal to the corresponding absorbances divided by the optical path length through the sample, but taking into account also the effects due to scattering and luminescence. The molar absorption coefficients (decadic ε, Napierian κ) are the linear absorption coefficients divided by the amount concentration. [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "attenuation coefficient"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002766
<http://purl.allotrope.org/ontologies/result#AFR_0002766> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0002765> ;
                                                          prop:AFX_0002808 <http://edamontology.org/data_1531> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "protein attenuation coefficient"^^xsd:string ;
                                                          core:altLabel "protein extinction coefficient"^^xsd:string ;
                                                          core:definition "A protein attenuation coefficient is a calculated extinction coefficient at 280 nm of a protein calculated from the number of aromatic amino acids, particularly tryptophan. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "protein attenuation coefficient"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002767
<http://purl.allotrope.org/ontologies/result#AFR_0002767> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0002765> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "molar absorptivity"^^xsd:string ;
                                                          core:definition "A molar absorptivity is an attenuation coefficient where the concentration is molarity and the path length is decimeters. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "molar absorptivity"^^xsd:string .


