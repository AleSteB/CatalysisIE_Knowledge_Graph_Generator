                 rdfs:label "viscosity (quality)"^^xsd:string ;
                 core:definition "A physical quality of a fluid inhering in a bearer by virtue of the bearer's disposition to internal resistance to flow. [PATO]"^^xsd:string ;
                 core:prefLabel "viscosity (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001019
