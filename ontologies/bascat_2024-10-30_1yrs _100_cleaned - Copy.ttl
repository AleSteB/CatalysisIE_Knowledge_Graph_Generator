                                                           rdfs:label "specifying"^^xsd:string ;
                                                           core:definition "Specifying is a process that produces an information object which describes constraints or objectives on characteristics like qualities, functions, dispositions, facets of continuants or processes. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "specifying"^^xsd:string .


