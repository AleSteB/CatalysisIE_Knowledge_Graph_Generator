                                                           core:definition "Particle sizing is an experimental method for the investigation of particle sizes in a sample. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "particle sizing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002744
<http://purl.allotrope.org/ontologies/process#AFP_0002744> rdf:type owl:Class ;
