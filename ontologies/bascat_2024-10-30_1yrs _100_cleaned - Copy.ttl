                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty prop:AFX_0000399 ;
                                                                                                    owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000275>
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "changing material"^^xsd:string ;
                                                           core:altLabel "modification"^^xsd:string ,
                                                                         "modifying material"^^xsd:string ;
                                                           core:definition "Changing is controlling a quality of the material in a predetermined and fixed manner. The identity of the material is maintained. [NIST]"^^xsd:string ;
                                                           core:prefLabel "changing material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003364
<http://purl.allotrope.org/ontologies/process#AFP_0003364> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003486> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "shaping"^^xsd:string ;
                                                           core:altLabel "forming"^^xsd:string ,
                                                                         "molding"^^xsd:string ;
                                                           core:definition "Shaping is changing the material in regard to spatial form. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "shaping"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003367
<http://purl.allotrope.org/ontologies/process#AFP_0003367> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003486> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "decrementing"^^xsd:string ;
                                                           core:altLabel "decrementing magnitude"^^xsd:string ;
                                                           core:definition "Decrementing is reducing the magnitude of a quality in a predetermined and fixed manner. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "decrementing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003368
<http://purl.allotrope.org/ontologies/process#AFP_0003368> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003486> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "incrementing"^^xsd:string ;
                                                           core:altLabel "incrementing magnitude"^^xsd:string ;
                                                           core:definition "Incrementing is enlarging the magnitude of a quality in a predetermined and fixed manner. [NIST]"^^xsd:string ;
                                                           core:prefLabel "incrementing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003370
<http://purl.allotrope.org/ontologies/process#AFP_0003370> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003737> ,
                                                                           obo:BFO_0000035 ;
                                                           term:source "http://www.loa.istc.cnr.it/old/Papers/D18.pdf"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "achievement"^^xsd:string ;
                                                           core:definition "A process boundary based on some physical characteristics at the start or end of some process changing these characteristics. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "achievement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003371
<http://purl.allotrope.org/ontologies/process#AFP_0003371> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003737> ,
                                                                           obo:BFO_0000015 ;
                                                           term:source "http://www.loa.istc.cnr.it/old/Papers/D18.pdf"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "accomplishment"^^xsd:string ;
                                                           core:definition "A non-cumulative process (event) that is non-atomic. [DOLCE]"^^xsd:string ;
                                                           core:example "leaving a place"^^xsd:string ;
                                                           core:note "An accomplishment is the process of what is coming out instead of what is going on. (Aristoteles kinesis vs. energeia). [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "accomplishment"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003374
<http://purl.allotrope.org/ontologies/process#AFP_0003374> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000015 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "http://www.loa.istc.cnr.it/old/Papers/D18.pdf"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "state"^^xsd:string ;
                                                           core:definition "A state is a homomeric, cumulative process in which all the temporal parts are described by the same expression used for the whole. [Allotrope]"^^xsd:string ;
                                                           core:example "corroding"^^xsd:string ;
                                                           core:prefLabel "state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003385
<http://purl.allotrope.org/ontologies/process#AFP_0003385> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003475> ;
                                                           term:source obo:NCIT_C25453 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "collecting"^^xsd:string ;
                                                           core:altLabel "collection"^^xsd:string ;
                                                           core:definition "The act of gathering things together; having been brought together in one place. [NCI]"^^xsd:string ;
                                                           core:prefLabel "collecting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003393
<http://purl.allotrope.org/ontologies/process#AFP_0003393> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003370> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "arrival"^^xsd:string ;
                                                           core:definition "Arrival is the achievement of reaching the destination site in a moving process. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "arrival"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003394
<http://purl.allotrope.org/ontologies/process#AFP_0003394> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003464> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "repelling"^^xsd:string ;
                                                           core:altLabel "keeping separated"^^xsd:string ;
                                                           core:definition "A spatial change processing the increases the spatial distance from the start. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "repelling"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003395
<http://purl.allotrope.org/ontologies/process#AFP_0003395> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003826> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "resting state"^^xsd:string ;
                                                           core:altLabel "staying in place"^^xsd:string ;
                                                           core:definition "A state when material object keeps its spatial location and orientation. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "resting state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003396
<http://purl.allotrope.org/ontologies/process#AFP_0003396> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003464> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "attracting"^^xsd:string ;
                                                           core:altLabel "keeping close"^^xsd:string ;
                                                           core:definition "A spatial change state the decreases the spatial distance at the end. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "attracting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003398
<http://purl.allotrope.org/ontologies/process#AFP_0003398> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003575> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "inserting material"^^xsd:string ;
                                                           core:altLabel "insertion"^^xsd:string ;
                                                           core:definition "A spatial processing of transferring material into a site. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "inserting material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003400
<http://purl.allotrope.org/ontologies/process#AFP_0003400> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003620> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mereotopological process"^^xsd:string ;
                                                           core:definition "A process that affects the topological connectedness or parthood of two or more flows. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "mereotopological process"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003403
<http://purl.allotrope.org/ontologies/process#AFP_0003403> rdf:type owl:Class ;
