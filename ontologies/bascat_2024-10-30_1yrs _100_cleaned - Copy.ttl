                                                         core:definition "An expected datum is a descriptive datum that describes a information that was predicted or assumed to be the outcome of some process . [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "expected datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000475
<http://purl.allotrope.org/ontologies/role#AFRL_0000475> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000472> ;
