                                                           rdfs:label "pO2"^^xsd:string ;
                                                           core:altLabel "partial pressure of oxygen"^^xsd:string ;
                                                           core:definition "pO2 is the partial pressure of oxygen gas dissolved in a solution. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "pO2"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000196
<http://purl.allotrope.org/ontologies/quality#AFQ_0000196> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000208> ;
