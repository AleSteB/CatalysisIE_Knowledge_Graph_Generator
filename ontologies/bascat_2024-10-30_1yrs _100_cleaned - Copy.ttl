                                                         rdfs:label "exception role"^^xsd:string ;
                                                         core:altLabel "exception"^^xsd:string ;
                                                         core:definition "A contextual role of information the describes an unexpected, unusual or unintended situation. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "exception role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000075
<http://purl.allotrope.org/ontologies/role#AFRL_0000075> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000277> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "variable"^^xsd:string ;
                                                         core:changeNote "2018-12-19 Changed definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "A variable is the contextual role of some data that is part of some other data that is varied in a  mathematical function or during data processing. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "variable"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000077
<http://purl.allotrope.org/ontologies/role#AFRL_0000077> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000075> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         term:source <https://en.wikipedia.org/wiki/Dependent_and_independent_variables> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "dependent variable"^^xsd:string ;
                                                         core:definition "A dependent variable is a contextual role of an information artifact that represents the outputs or outcomes whose variation is being studied. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "dependent variable"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000078
<http://purl.allotrope.org/ontologies/role#AFRL_0000078> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000075> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         term:source <https://en.wikipedia.org/wiki/Dependent_and_independent_variables> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "independent variable"^^xsd:string ;
                                                         core:definition "An independent variable is a contextual role of an information artifact that represents inputs or causes for variation of a dependent variable. In the experimental setting, the independent variable is controlled by the experimenter. Models and experiments test or determine the effects that the independent variables have on the dependent variables. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "independent variable"^^xsd:string .


