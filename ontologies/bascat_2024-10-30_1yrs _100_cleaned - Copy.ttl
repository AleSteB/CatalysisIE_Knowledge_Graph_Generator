                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "positive polarity"^^xsd:string ;
                                                          core:altLabel "positive"^^xsd:string ;
                                                          core:definition "Positive polarity is the code that indicates a positive direction of polarity. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "positive polarity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001668
<http://purl.allotrope.org/ontologies/result#AFR_0001668> rdf:type owl:NamedIndividual ,
