                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                             rdfs:label "skimmer"^^xsd:string ;
                                                             core:definition "A skimmer is a cone with a central orifice that intercepts the center of a spray or jet expansion to sample the central portion of the expansion, for example, as in a momentum separator. [IUPAC]"^^xsd:string ;
                                                             core:prefLabel "skimmer"^^xsd:string .


