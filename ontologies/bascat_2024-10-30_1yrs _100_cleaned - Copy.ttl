###  http://purl.allotrope.org/ontologies/quality#AFQ_0000166
<http://purl.allotrope.org/ontologies/quality#AFQ_0000166> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000179> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "amount of substance (quality)"^^xsd:string ;
                                                           core:altLabel "amount of substance"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "Amount of substance is a quality inhered in a portion of material that is a size that is proportional to the number of elementary entities present. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "amount of substance (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000167
<http://purl.allotrope.org/ontologies/quality#AFQ_0000167> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000033 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ,
                                                                       "IUPAC, Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\") (1997). Online corrected version:  (2006–) \"mass concentration\". doi:10.1351/goldbook.M03713"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mass concentration (quality)"^^xsd:string ;
                                                           core:altLabel "mass concentration"^^xsd:string ;
                                                           core:changeNote "2018-12-17 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "Mass concentration is a concentration that is defined as the mass of a constituent divided by the volume of the mixture. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "mass concentration (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000168
<http://purl.allotrope.org/ontologies/quality#AFQ_0000168> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000033 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "molar concentration (quality)"^^xsd:string ;
                                                           core:altLabel "amount concentration"^^xsd:string ,
                                                                         "amount concentration (quality)"^^xsd:string ,
                                                                         "amount of substance concentration"^^xsd:string ,
                                                                         "molar concentration"^^xsd:string ,
                                                                         "molarity"^^xsd:string ,
                                                                         "molarity (quality)"^^xsd:string ,
                                                                         "substance concentration"^^xsd:string ,
                                                                         "substance concentration (quality)"^^xsd:string ;
                                                           core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ,
                                                                           "2020-05-11 Changed pref label to molar concentration. [Allotrope]"^^xsd:string ,
                                                                           "2020-06-18 Added alt labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "Molar concentration is the ratio of molar amount of a substance divided by volume of mixture containing the amount of substance. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "molar concentration (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000169
<http://purl.allotrope.org/ontologies/quality#AFQ_0000169> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000172> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ,
                                                                       "PAC, 1996, 68, 957 (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "volume fraction (quality)"^^xsd:string ;
                                                           core:altLabel "volume fraction"^^xsd:string ;
                                                           core:changeNote "2020-06-22 Changed labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "The volume fraction is a fraction pertaining the volume of a constituent divided by the total volume of all constituents in the mixture. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "volume fraction (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000170
<http://purl.allotrope.org/ontologies/quality#AFQ_0000170> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000918 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 1993, 65, 819 (Nomenclature for chromatography (IUPAC Recommendations 1993))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "hold-up volume (quality)"^^xsd:string ;
                                                           core:altLabel "dead volume"^^xsd:string ,
                                                                         "hold-up volume"^^xsd:string ;
                                                           core:definition "The hold-up volume is the volume of the mobile phase required to elute a component the concentration of which in the stationary phase is negligible compared to that in the mobile phase. In other words, this component is not retained at all by the stationary phase. Thus, the hold-up volume is equal to the retention volume of an unretained compound. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "hold-up volume (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000171
<http://purl.allotrope.org/ontologies/quality#AFQ_0000171> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000918 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 1993, 65, 819 (Nomenclature for chromatography (IUPAC Recommendations 1993))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "retention volume (quality)"^^xsd:string ;
                                                           core:altLabel "retention volume"^^xsd:string ;
                                                           core:definition "Retention volume is the volume of the mobile phase required to elute a component the concentration of which in the stationary phase is negligible compared to that in the mobile phase. In other words, this component is not retained at all by the stationary phase. Thus, the hold-up volume is equal to the retention volume of an unretained compound. The hold-up volume includes any volumes contributed by the sample injector, the detector, and connectors.  In gas chromatography this term is also called the gas hold-up volume. The corrected gas hold-up volume is the gas hold-up volume multiplied by the compression (compressibility) correction factor. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "retention volume (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000172
<http://purl.allotrope.org/ontologies/quality#AFQ_0000172> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           obo:PATO_0000025 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "fraction (quality)"^^xsd:string ;
                                                           core:altLabel "fraction"^^xsd:string ;
                                                           core:changeNote "2020-06-22 Changed labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "A fraction is the ratio of one constitutent (part) to all constituents of a mixture. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "fraction (quality)"^^xsd:string .


