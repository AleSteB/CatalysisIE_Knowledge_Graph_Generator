                              "tablet"^^xsd:string ,
                              "tablet dose form"^^xsd:string ;
                core:definition "A table dosage form is a pharmaceutical dosage form that is a solid composed of a mixture of that active and/or inert ingredient(s) are pressed or compacted together, usually in the form of a relatively flat and round, square or oval shape. [NCI]"^^xsd:string ;
                core:prefLabel "tablet dosage form"^^xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_C45235
obo:NCIT_C45235 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000386> ,
                                obo:NCIT_C42636 ;
                pav:importedFrom obo:ncit.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/dosage-form> ;
                rdfs:label "solid dosage form"^^xsd:string ;
                core:altLabel "solid"^^xsd:string ,
                              "solid dose form"^^xsd:string ;
                core:definition "A substance having definite shape and volume manufactured for the administration of active and/or inert ingredient(s). Solids include tablets, capsules, powders, granules and certain suppositories. [NCI]"^^xsd:string ;
                core:prefLabel "solid dosage form"^^xsd:string .


###  http://purl.obolibrary.org/obo/NCIT_C48297
obo:NCIT_C48297 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0001695> ;
                prop:AFX_0002865 obo:ncit.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "server"^^xsd:string ;
                core:definition "A server is a computer which provides some service for other computers connected to it via a network. [NCI]"^^xsd:string ;
                core:prefLabel "server"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000011
obo:OBI_0000011 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000015
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:BFO_0000055 ;
                                                             owl:someValuesFrom obo:OBI_0000260
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:BFO_0000015 ;
                prop:AFX_0002798 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:obi.owl ;
                oboI:hasAlternativeId "CHMO:0001840"^^xsd:string ;
                oboI:id "OBI:0000011"^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "planned process"^^xsd:string ;
                core:definition "A processual entity that realizes a plan which is the concretization of a plan specification. [IAO]"^^xsd:string ;
                core:example "Injecting mice with a vaccine in order to test its efficacy"^^xsd:string ;
                core:prefLabel "planned process"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000047
obo:OBI_0000047 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000040 ;
                prop:AFX_0002798 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "processed material"^^xsd:string ;
                core:definition "Is a material entity that is created or changed during material processing. [OBI]"^^xsd:string ;
                core:example "Examples include gel matrices, filter paper, parafilm and buffer solutions, mass spectrometer, tissue samples"^^xsd:string ;
                core:prefLabel "processed material"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000086
obo:OBI_0000086 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000249> ;
                prop:AFX_0002809 obo:CHEBI_33893 ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "reagent role"^^xsd:string ;
                core:altLabel "reagent"^^xsd:string ;
                core:definition "A role inhering in a biological or chemical entity that is intended to be applied in a scientific technique to participate (or have molecular components that participate) in a chemical reaction that facilitates the generation of data about some entity distinct from the bearer, or the generation of some specified material output distinct from the bearer. [OBI]"^^xsd:string ;
                core:prefLabel "reagent role"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000094
obo:OBI_0000094 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                <http://purl.allotrope.org/ontologies/process#AFP_0003620> ,
                                obo:OBI_0000011 ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0003362>
                                                <http://purl.allotrope.org/ontologies/process#AFP_0003566>
                                                <http://purl.allotrope.org/ontologies/process#AFP_0003716>
                                              )
                                ] ;
                prop:AFX_0002865 obo:obi.owl ;
                obo:IAO_0000115 "A planned process which results in physical changes in a specified input material."^^xsd:string ;
                oboI:hasAlternativeId "CHMO:0001131"^^xsd:string ,
                                      "CHMO:0001267"^^xsd:string ,
                                      "CHMO:0001461"^^xsd:string ,
                                      "FIX:0000258"^^xsd:string ;
                oboI:hasExactSynonym "material transformations"^^xsd:string ,
                                     "preparative method"^^xsd:string ,
                                     "sample preparation"^^xsd:string ,
                                     "sample preparation step"^^xsd:string ,
                                     "sample preparative method"^^xsd:string ;
                oboI:id "OBI:0000094"^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "material processing"^^xsd:string ;
                core:definition "Material processing is a planned material process which results in physical changes in a specified input material. [OBI]"^^xsd:string ;
                core:prefLabel "material processing"^^xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:OBI_0000094 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A planned process which results in physical changes in a specified input material."^^xsd:string ;
   oboI:hasDbXref "obi:bp"^^xsd:string ,
                  "obi:fg"^^xsd:string ,
                  "obi:jf"^^xsd:string ,
                  "obi:mc"^^xsd:string ,
                  "obi:prs"^^xsd:string
 ] .


###  http://purl.obolibrary.org/obo/OBI_0000260
obo:OBI_0000260 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "plan"^^xsd:string ;
                core:definition "A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a planned process. [OBI]"^^xsd:string ;
                core:prefLabel "plan"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000457
obo:OBI_0000457 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                <http://purl.allotrope.org/ontologies/process#AFP_0003315> ,
                                obo:OBI_0000011 ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "manufacturing"^^xsd:string ;
                core:definition "Manufacturing is a producing with the intent to produce a processed material which will have a function for future use. [OBI]"^^xsd:string ;
                core:prefLabel "manufacturing"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000571
obo:OBI_0000571 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000023 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:BFO_0000054 ;
                                  owl:someValuesFrom obo:OBI_0000457
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:RO_0000081 ;
                                  owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001090>
                                ] ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "manufacturer role"^^xsd:string ;
                core:altLabel "manufacturer"^^xsd:string ;
                core:definition "Manufacturer role is a role which inheres in a person or organization and which is realized by a manufacturing process. [OBI]"^^xsd:string ;
                core:example "With respect to The Accuri C6 Flow Cytometer System, the organization Accuri bears the role manufacturer role. [OBI]"^^xsd:string ,
                             "With respect to a specific antibody produced by an individual scientist, the scientist who purifies, characterizes and distributes the anitbody bears the role manufacturer role. [OBI]"^^xsd:string ,
                             "With respect to a transformed line of tissue culture cells derived by a specific lab, the lab whose personnel isolated the cll line bears the role manufacturer role. [OBI]"^^xsd:string ;
                core:prefLabel "manufacturer role"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0000835
obo:OBI_0000835 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0001090>
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:RO_0000087 ;
                                                             owl:someValuesFrom obo:OBI_0000571
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001090> ;
                prop:AFX_0002798 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "manufacturer"^^xsd:string ;
                core:definition "A manufacturer is an organizational entity that has a manufacturer role. [Allotrope]"^^xsd:string ;
                core:prefLabel "manufacturer"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0100026
obo:OBI_0100026 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000877> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "organism"^^xsd:string ;
                core:definition "A material entity that is an individual living system, such as animal, plant, bacteria or virus, that is capable of replicating or reproducing, growth and maintenance in the right environment. An organism may be unicellular or made up, like humans, of many billions of cells divided into specialized tissues and organs. [OBI]"^^xsd:string ;
                core:editorialNote "OBI doesn't take position as to when an organism starts or ends being an organism - e.g. sperm, foetus. This issue is outside the scope of OBI [OBI]"^^xsd:string ,
                                   "subclasses should be imported from the NCBI taxonomy [Allotrope]"^^xsd:string ;
                core:prefLabel "organism"^^xsd:string .


###  http://purl.obolibrary.org/obo/OBI_0200072
obo:OBI_0200072 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003598> ;
                prop:AFX_0002865 obo:obi.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "curve fitting"^^xsd:string ;
                core:definition "Curve fitting is a data transformation that is the process of constructing a curve, or mathematical function, that has the best fit to a series of data points, possibly subject to constraints. [Wikipedia]"^^xsd:string ;
                core:prefLabel "curve fitting"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000008
obo:PATO_0000008 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001906 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "speed"^^xsd:string ;
                 core:altLabel "velocity"^^xsd:string ;
                 core:definition "A physical quality inhering in a bearer by virtue of the bearer's scalar absolute value of the rate of change of the bearer's position. [PATO]"^^xsd:string ;
                 core:prefLabel "speed"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000014
obo:PATO_0000014 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001300 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "color (quality)"^^xsd:string ;
                 core:altLabel "color"^^xsd:string ;
                 core:definition "A color is a composite chromatic quality composed of hue, saturation and intensity parts. [PATO]"^^xsd:string ;
                 core:prefLabel "color (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000018
obo:PATO_0000018 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000325> ;
                 prop:AFX_0002865 obo:pato-owl ;
                 term:license <http://purl.allotrope.org/voc/iupac-license> ;
                 term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                 term:source "PAC, 1984, 56, 231. (Nomenclature, symbols, units and their usage in spectrochemical analysis-Part VI: molecular luminescence spectroscopy)"^^xsd:string ,
                             "PAC, 1994, 66, 2513. (Nomenclature for radioanalytical chemistry (IUPAC Recommendations 1994))"^^xsd:string ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "fluorescence (quality)"^^xsd:string ;
                 core:changeNote "2021-06-21 Changed definition to IUPAC. [Allotrope]"^^xsd:string ;
                 core:definition "Fluorescence is a luminescence which occurs essentially only during the irradiation of a substance by electromagnetic radiation. [IUPAC]"^^xsd:string ;
                 core:prefLabel "fluorescence (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000025
obo:PATO_0000025 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000141 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "composition"^^xsd:string ;
                 core:altLabel "compositionality"^^xsd:string ,
                               "content"^^xsd:string ,
                               "structure"^^xsd:string ;
                 core:definition "A single physical entity inhering in an bearer by virtue of the bearer's quantities or relative ratios of subparts. [PATO]"^^xsd:string ;
                 core:example "calcium composition (which may inhere in bone)"^^xsd:string ,
                              "haemoglobin composition (which may inhere in blood)."^^xsd:string ;
                 core:prefLabel "composition"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000033
obo:PATO_0000033 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000250> ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 term:source "Green Book, 2nd ed.: IUPAC Quantities, Units and Symbols in Physical Chemistry. Second Edition, Blackwell Scientific Publications, Oxford, 1993."^^xsd:string ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "concentration (quality)"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ,
                                 "2019-08-29 Changed definition. [Allotrope]"^^xsd:string ;
                 core:definition "Concentration is a molecular quality inhering in a substance by virtue of the amount of the bearer's there is mixed with another substance. [PATO]"^^xsd:string ;
                 core:prefLabel "concentration (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000048
obo:PATO_0000048 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000210> ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "hardness (quality)"^^xsd:string ;
                 core:definition "A physical quality inhering in a bearer by virtue of the bearer's resistance to pressure, being broken, or pierced."^^xsd:string ;
                 core:prefLabel "hardness (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000051
obo:PATO_0000051 rdf:type owl:Class ;
                 rdfs:subClassOf obo:BFO_0000019 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "morphology"^^xsd:string ;
                 core:definition "A quality of a single physical entity inhering in the bearer by virtue of the bearer's size or shape or structure. [PATO]"^^xsd:string ;
                 core:prefLabel "morphology"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000052
obo:PATO_0000052 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000051 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "shape (quality)"^^xsd:string ;
                 core:altLabel "shape"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A morphological quality inhering in a bearer by virtue of the bearer's ratios of distances between its features (points, edges, surfaces and also holes etc). [PATO]"^^xsd:string ;
                 core:prefLabel "shape (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000117
obo:PATO_0000117 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000051 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "size (quality)"^^xsd:string ;
                 core:altLabel "dimension"^^xsd:string ,
                               "extend"^^xsd:string ,
                               "size"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A morphology quality inhering in a bearer by virtue of the bearer's physical magnitude. [PATO]"^^xsd:string ;
                 core:prefLabel "size (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000119
obo:PATO_0000119 rdf:type owl:Class ;
                 rdfs:subClassOf owl:Thing .


###  http://purl.obolibrary.org/obo/PATO_0000122
obo:PATO_0000122 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001708 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "length (quality)"^^xsd:string ;
                 core:altLabel "length"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A 1-D extent quality which is equal to the distance between two points. [PATO]"^^xsd:string ;
                 core:prefLabel "length (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000125
obo:PATO_0000125 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000210> ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "mass (quality)"^^xsd:string ;
                 core:altLabel "mass"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ,
                                 "2019-09-09 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ;
                 core:definition "A physical quality that inheres in a bearer by virtue of the proportion of the bearer's amount of matter. [PATO]"^^xsd:string ;
                 core:prefLabel "mass (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000140
obo:PATO_0000140 rdf:type owl:Class ;
                 rdfs:subClassOf obo:BFO_0000145 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "position (quality)"^^xsd:string ;
                 core:altLabel "position"^^xsd:string ;
                 core:definition "Position is a  spatial quality inhering in a bearer by virtue of the bearer's spatial location relative to other objects in the vicinity. [PATO]"^^xsd:string ;
                 core:prefLabel "position (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000141
obo:PATO_0000141 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000051 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "structure"^^xsd:string ;
                 core:altLabel "conformation"^^xsd:string ,
                               "relational structural quality"^^xsd:string ;
                 core:changeNote "2018-12-05 Generalized definition [Allotrope]"^^xsd:string ;
                 core:definition "A morphology quality inhering in a bearer by virtue of the bearer's relative position, shape, arrangements and connectivity of an material entity's various parts; the pattern underlying its form. [PATO]"^^xsd:string ;
                 core:prefLabel "structure"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000146
obo:PATO_0000146 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                 prop:AFX_0002865 obo:pato.owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "temperature (quality)"^^xsd:string ;
                 core:altLabel "temperature"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A physical quality of the thermal energy of a system. [PATO]"^^xsd:string ;
                 core:prefLabel "temperature (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000169
obo:PATO_0000169 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001995 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "viability (quality)"^^xsd:string ;
                 core:altLabel "viability"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "An organismal quality inhering in a bearer or a population by virtue of the bearer's disposition to survive and develop normally or the number of surviving individuals in a given population. [PATO]"^^xsd:string ;
                 core:prefLabel "viability (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000719
obo:PATO_0000719 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000169 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "viable"^^xsd:string ;
                 core:definition "A viability quality inhering in a bearer or a population by virtue of the bearer's ability to survive or the long term survival ability of a given population. [PATO]"^^xsd:string ;
                 core:prefLabel "viable"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000915
obo:PATO_0000915 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001708 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "thickness (quality)"^^xsd:string ;
                 core:altLabel "thickness"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A 1-D extent quality which is equal to the dimension through an object as opposed to its length or width. [PATO]"^^xsd:string ;
                 core:prefLabel "thickness (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000918
obo:PATO_0000918 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001710 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "volume (quality)"^^xsd:string ;
                 core:altLabel "volume"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A 3-D extent quality inhering in a bearer by virtue of the bearer's amount of 3-dimensional space it occupies."^^xsd:string ;
                 core:prefLabel "volume (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000921
obo:PATO_0000921 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001708 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "width (quality)"^^xsd:string ;
                 core:altLabel "width"^^xsd:string ;
                 core:definition "A 1-D extent quality which is equal to the distance from one side of an object to another side which is opposite. [PATO]"^^xsd:string ;
                 core:prefLabel "width (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000970
obo:PATO_0000970 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000141 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "permeability"^^xsd:string ;
                 core:definition "A structural quality inhering in a bearer by virtue of the bearer's disposition to being permeated or pervaded by a gas or liquid (as by osmosis or diffusion). [PATO]"^^xsd:string ;
                 core:prefLabel "permeability"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000973
obo:PATO_0000973 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000970 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "porosity"^^xsd:string ;
                 core:definition "A permeability quality inhering in a bearer by virtue of the bearer's disposition to admit the passage of gas or liquid through pores or interstices. [PATO]"^^xsd:string ;
                 core:prefLabel "porosity"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000984
obo:PATO_0000984 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000973 ;
                 prop:AFX_0002865 obo:pato-owl ;
