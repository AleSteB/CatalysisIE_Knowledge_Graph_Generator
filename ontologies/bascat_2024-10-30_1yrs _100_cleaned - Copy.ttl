                                                           core:altLabel "CZE"^^xsd:string ,
                                                                         "capillary zone electrophoresis"^^xsd:string ;
                                                           core:definition "A capillary electrophoresis is an electrophoresis which takes place in a capillary. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "capillary electrophoresis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000498
<http://purl.allotrope.org/ontologies/process#AFP_0000498> rdf:type owl:Class ;
