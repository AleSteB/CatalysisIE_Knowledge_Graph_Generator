                                                           core:definition "Shortening a passage or a write-up without changing its meaning but by using different words and sentences. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "summarizing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003655
<http://purl.allotrope.org/ontologies/process#AFP_0003655> rdf:type owl:Class ;
