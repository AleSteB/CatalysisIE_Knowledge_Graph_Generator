                                                         core:altLabel "data output"^^xsd:string ,
                                                                       "result"^^xsd:string ;
                                                         core:definition "Data output role is a type of contextual role of an information artifact that is the output of a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "data output role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000044
<http://purl.allotrope.org/ontologies/role#AFRL_0000044> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000008> ,
