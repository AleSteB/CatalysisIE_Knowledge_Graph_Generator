                                                           rdfs:label "dead cell density (quality)"^^xsd:string ;
                                                           core:altLabel "dead cell density"^^xsd:string ;
                                                           core:definition "Dead cell density is the cell density of the partition of dead cells. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dead cell density (quality)"^^xsd:string .


