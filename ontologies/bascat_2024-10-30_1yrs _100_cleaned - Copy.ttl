                                                         core:altLabel "selected  object"^^xsd:string ,
                                                                       "selected component"^^xsd:string ;
                                                         core:changeNote "2018-07-23 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A selected object is the selection role of the object that is selected from the selection target. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "selected object role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000027
<http://purl.allotrope.org/ontologies/role#AFRL_0000027> rdf:type owl:Class ;
