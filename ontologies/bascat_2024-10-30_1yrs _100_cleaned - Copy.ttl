   owl:annotatedProperty obo:IAO_0000602 ;
   owl:annotatedTarget "(forall (x) (if (SpatialRegion x) (Continuant x))) // axiom label in BFO2 CLIF: [035-001] "^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/035-001>
 ] .


###  http://purl.obolibrary.org/obo/BFO_0000008
obo:BFO_0000008 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000117 ;
                                                         owl:allValuesFrom obo:BFO_0000008
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000132 ;
                                                         owl:allValuesFrom obo:BFO_0000008
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                owl:disjointWith obo:BFO_0000011 ,
                                 obo:BFO_0000015 ,
                                 obo:BFO_0000035 ;
                obo:BFO_0000179 "t-region"^^xsd:string ;
                obo:BFO_0000180 "TemporalRegion"^^xsd:string ;
                obo:IAO_0000116 "Temporal region doesn't have a closure axiom because the subclasses don't exhaust all possibilites. An example would be the mereological sum of a temporal instant and a temporal interval that doesn't overlap the instant. In this case the resultant temporal region is neither 0-dimensional nor 1-dimensional"^^xsd:string ;
                obo:IAO_0000600 "A temporal region is an occurrent entity that is part of time as defined relative to some reference frame. (axiom label in BFO2 Reference: [100-001])"^^xsd:string ;
                obo:IAO_0000601 "All parts of temporal regions are temporal regions. (axiom label in BFO2 Reference: [101-001])"@en ,
                                "All parts of temporal regions are temporal regions. (axiom label in BFO2 Reference: [101-001])"^^xsd:string ,
                                "Every temporal region t is such that t occupies_temporal_region t. (axiom label in BFO2 Reference: [119-002])"^^xsd:string ;
                obo:IAO_0000602 "(forall (r) (if (TemporalRegion r) (occupiesTemporalRegion r r))) // axiom label in BFO2 CLIF: [119-002] "^^xsd:string ,
                                "(forall (x y) (if (and (TemporalRegion x) (occurrentPartOf y x)) (TemporalRegion y))) // axiom label in BFO2 CLIF: [101-001] "^^xsd:string ,
                                "(forall (x) (if (TemporalRegion x) (Occurrent x))) // axiom label in BFO2 CLIF: [100-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "temporal region"^^xsd:string ;
                core:definition "A temporal region is an occurrent entity that is part of time as defined relative to some reference frame. [BFO]"^^xsd:string ;
                core:prefLabel "temporal region"^^xsd:string .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:BFO_0000008 ;
   owl:annotatedProperty obo:IAO_0000116 ;
   owl:annotatedTarget "Temporal region doesn't have a closure axiom because the subclasses don't exhaust all possibilites. An example would be the mereological sum of a temporal instant and a temporal interval that doesn't overlap the instant. In this case the resultant temporal region is neither 0-dimensional nor 1-dimensional"^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/0000003> ;
