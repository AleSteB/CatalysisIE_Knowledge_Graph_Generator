                                                           rdfs:label "decreasing quality process profile"^^xsd:string ;
                                                           core:definition "An decreasing quality process profile is a quality process profile where the tracked determinate quality is continuously decreasing in magnitude. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "decreasing quality process profile"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003821
<http://purl.allotrope.org/ontologies/process#AFP_0003821> rdf:type owl:Class ;
