                rdfs:label "during which exists"^^xsd:string ;
                core:definition "inverse of exists at [BFO]"^^xsd:string ;
                core:prefLabel "during which exists"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000184
obo:BFO_0000184 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000066 ;
                rdf:type owl:InverseFunctionalProperty ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000040 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "history of"^^xsd:string ;
                core:definition "b history_of c if c is a material entity or site and b is a history that is the unique history of c"^^xsd:string ;
                core:prefLabel "history of"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000185
obo:BFO_0000185 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000067 ;
                rdf:type owl:InverseFunctionalProperty ;
                rdfs:domain obo:BFO_0000040 ;
