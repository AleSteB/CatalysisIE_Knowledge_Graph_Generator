<http://purl.allotrope.org/ontologies/role#AFRL_0000336> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000277> ;
                                                         term:source <https://en.wikipedia.org/wiki/Function_(mathematics)> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "domain (math)"^^xsd:string ;
                                                         core:altLabel "domain"^^xsd:string ,
                                                                       "domain (mathematics)"^^xsd:string ;
                                                         core:changeNote "2018-12-19 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A domain is the mathematical role of the set a function is applied on. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "domain (math)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000337
<http://purl.allotrope.org/ontologies/role#AFRL_0000337> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000277> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "codomain (math)"^^xsd:string ;
                                                         core:altLabel "codomain"^^xsd:string ,
                                                                       "codomain (mathematics)"^^xsd:string ;
                                                         core:changeNote "2018-12-19 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A codomain is the mathematical role of the set a function maps to. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "codomain (math)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000339
<http://purl.allotrope.org/ontologies/role#AFRL_0000339> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ;
