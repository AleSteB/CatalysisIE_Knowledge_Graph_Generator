                                                           rdfs:subClassOf obo:PATO_0000025 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "reaction composition"^^xsd:string ;
                                                           core:definition "Reaction composition is a composition quality of a reaction mixture. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "reaction composition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000226
<http://purl.allotrope.org/ontologies/quality#AFQ_0000226> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000225> ;
                                                           term:source <https://en.wikipedia.org/wiki/Conversion_(chemistry)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "conversion (quality)"^^xsd:string ;
                                                           core:altLabel "conversion"^^xsd:string ;
                                                           core:definition "Conversion is a reaction composition quality dependent on the fraction of reactant remaining. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "conversion (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000227
<http://purl.allotrope.org/ontologies/quality#AFQ_0000227> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000225> ;
                                                           prop:AFX_0002808 obo:CHMO_0002855 ;
                                                           term:source <https://en.wikipedia.org/wiki/Conversion_(chemistry)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "yield (quality)"^^xsd:string ;
                                                           core:altLabel "percentage yield"^^xsd:string ,
                                                                         "yield"^^xsd:string ;
                                                           core:definition "Reaction yield is a reaction composition quality expressed as a percentage of the theoretical maximum mass of the product given the masses of the reactants. [CHMO, Allotrope]"^^xsd:string ;
                                                           core:note "Often there is an assumption that the product and starting materials have the same relative response in the analytical method being used."^^xsd:string ;
                                                           core:prefLabel "yield (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000228
<http://purl.allotrope.org/ontologies/quality#AFQ_0000228> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000225> ;
                                                           term:source <https://en.wikipedia.org/wiki/Conversion_(chemistry)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "reaction selectivity"^^xsd:string ;
                                                           core:altLabel "selectivity"^^xsd:string ;
                                                           core:definition "Reaction selectivity is a reaction composition that is expressed as the number of moles of desired product per the number of moles of undesired product. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "reaction selectivity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000231
<http://purl.allotrope.org/ontologies/quality#AFQ_0000231> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000145 ;
                                                           prop:AFX_0002808 <http://www.w3.org/ns/org#Membership> ;
