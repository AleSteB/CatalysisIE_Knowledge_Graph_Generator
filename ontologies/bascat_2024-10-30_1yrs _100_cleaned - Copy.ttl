                                                           core:prefLabel "purification"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000813
<http://purl.allotrope.org/ontologies/process#AFP_0000813> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000266> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
                                                           rdfs:label "equimolar spectrophotometry"^^xsd:string ;
                                                           core:definition "A method where the absorption of radiation in the ultraviolet to near-infrared (0.1-2.5 µm) is used to calculate stability constants by equimolar dilution. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "equimolar spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000840
<http://purl.allotrope.org/ontologies/process#AFP_0000840> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
