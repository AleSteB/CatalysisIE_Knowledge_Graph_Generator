                                                           core:definition "Gas chromatography injection is the process of loading a sample into a gas chromatography system. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "gas chromatography injection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003684
<http://purl.allotrope.org/ontologies/process#AFP_0003684> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003683> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/gc> ;
                                                           rdfs:label "splitless injection"^^xsd:string ;
                                                           core:definition "Splitless injection is a GC injection whereby the carrier gas sweeps the volatilized sample onto the GC column for a specified period of time before diverting the remaining sample to waste. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "splitless injection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003685
<http://purl.allotrope.org/ontologies/process#AFP_0003685> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003683> ;
