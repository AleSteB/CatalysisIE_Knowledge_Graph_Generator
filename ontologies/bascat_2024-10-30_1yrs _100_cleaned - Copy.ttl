                                                          rdfs:label "topological coordination"^^xsd:string ;
                                                          core:definition "A topological coordination is a class coordination that coordinates a class with a topological aspect. [Allotrope]"^^xsd:string ;
                                                          core:example "left, right, top, bottom"^^xsd:string ;
                                                          core:prefLabel "topological coordination"^^xsd:string .


