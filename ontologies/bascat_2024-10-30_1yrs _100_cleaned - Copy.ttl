                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/equipment#AFE_0000317>
                                                                           ] ;
                                                           prop:AFX_0002808 prop:AFX_0000027 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection> ;
                                                           rdfs:label "detection wavelength"^^xsd:string ;
                                                           core:definition "A detection wavelength quality is a device setting which determines the wavelength range that a detector of electromagnetic radiation detects. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "detection wavelength"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000032
<http://purl.allotrope.org/ontologies/quality#AFQ_0000032> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000145 ;
                                                           prop:AFX_0002808 obo:PATO_0000040 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "distance"^^xsd:string ;
                                                           core:definition "A quality that is the extent of space between two entities. [PATO]"^^xsd:string ;
                                                           core:prefLabel "distance"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000036
<http://purl.allotrope.org/ontologies/quality#AFQ_0000036> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
                                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                  owl:unionOf ( <http://purl.allotrope.org/ontologies/equipment#AFE_0000354>
                                                                                                                obo:RO_0002577
                                                                                                              )
                                                                                                ]
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "system configuration"^^xsd:string ;
                                                           core:altLabel "configuration"^^xsd:string ,
                                                                         "device configuration"^^xsd:string ,
                                                                         "device setting"^^xsd:string ,
                                                                         "setting"^^xsd:string ,
                                                                         "system setting"^^xsd:string ;
                                                           core:changeNote "2018-12-05 Changed pref label [Allotrope]"^^xsd:string ,
                                                                           "2020-03-24 Generalized configuration quality to include systems. [Allotrope]"^^xsd:string ;
                                                           core:definition "A configuration is a range of determinate quality or combination of qualities that are present in some part of a device or system that influence participants in some of the functions of the device or system including the device or system itself. [Allotrope]"^^xsd:string ;
                                                           core:example "detector wavelength is a device configuration of a specific detector assembly, e.g. optical filters or of a controller in the detector to detect certain ranges of wavelength of the electromagnetic spectrum"^^xsd:string ;
                                                           core:prefLabel "system configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000042
<http://purl.allotrope.org/ontologies/quality#AFQ_0000042> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "heat rate"^^xsd:string ;
                                                           core:definition "Quality of a bearer which describes the bearer's efficiency in terms of useful output energy. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "heat rate"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000043
<http://purl.allotrope.org/ontologies/quality#AFQ_0000043> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0002242 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "linear velocity (quality)"^^xsd:string ;
                                                           core:altLabel "linear velocity"^^xsd:string ;
                                                           core:changeNote "2020-06-22 Changed labels. [Allotrope]"^^xsd:string ;
                                                           core:definition "Quality of velocity inhering in a bearer which is traveling in a straight line, meaning its direction is not changing. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "linear velocity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000045
<http://purl.allotrope.org/ontologies/quality#AFQ_0000045> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001035 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "torque (quality)"^^xsd:string ;
                                                           core:altLabel "torque"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of its rotational force. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "torque (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000048
<http://purl.allotrope.org/ontologies/quality#AFQ_0000048> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "voltage (quality)"^^xsd:string ;
                                                           core:altLabel "voltage"^^xsd:string ;
                                                           core:changeNote "2019-09-20 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ;
                                                           core:definition "A quality which inheres in an independent continuant which has a difference in electric potential energy between two points per unit electric charge. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "voltage (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000049
<http://purl.allotrope.org/ontologies/quality#AFQ_0000049> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electric current (quality)"^^xsd:string ;
                                                           core:altLabel "current"^^xsd:string ,
                                                                         "current (quality)"^^xsd:string ,
                                                                         "electric current"^^xsd:string ;
                                                           core:changeNote "2019-09-20 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ,
                                                                           "2020-07-27 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "A quality inhering in a bearer by virtue of the bearer's ability to conduct an electrical charge. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "electric current (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000056
<http://purl.allotrope.org/ontologies/quality#AFQ_0000056> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "thermal quality"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of its material properties pertaining to temperature. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "thermal quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000057
<http://purl.allotrope.org/ontologies/quality#AFQ_0000057> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ,
                                                                           obo:PATO_0001585 ;
                                                           prop:AFX_0002808 obo:OMIT_0014665 ,
                                                                            obo:PATO_0001756 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "thermal conductivity (quality)"^^xsd:string ;
                                                           core:altLabel "thermal conductivity"^^xsd:string ;
                                                           core:definition "A conductivity quality inhering in a bearer by virtue of the bearer's disposition to spontaneous transfer of thermal energy from a region of higher temperature to a region of lower temperature. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "thermal conductivity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000058
<http://purl.allotrope.org/ontologies/quality#AFQ_0000058> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           term:source <https://en.wikipedia.org/wiki/Heat_capacity> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "heat capacity (quality)"^^xsd:string ;
                                                           core:altLabel "heat capacity"^^xsd:string ,
                                                                         "thermal capacity"^^xsd:string ;
                                                           core:changeNote "2020-03-23 Changed pref label and definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Heat capacity is a thermal quality that inheres in a bearer by virtue of its resistance or ability to change its temperature based on a change to the heat added or removed from said object (ratio of head added or removed from an object to the resulting temperature change). [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "heat capacity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000059
<http://purl.allotrope.org/ontologies/quality#AFQ_0000059> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "radiative emissivity"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of its emissivity, which is defined as a material's effectiveness in emitting energy as thermal radiation. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "radiative emissivity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000061
<http://purl.allotrope.org/ontologies/quality#AFQ_0000061> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "PAC, 1990, 62, 2167 (Glossary of atmospheric chemistry terms (Recommendations 1990))"^^xsd:string ,
                                                                       "PAC, 1996, 68, 2223 (Glossary of terms used in photochemistry (IUPAC Recommendations 1996))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "absorbance (quality)"^^xsd:string ;
                                                           core:altLabel "absorbance"^^xsd:string ;
                                                           core:definition "Absorbance is the logarithm of the ratio of intensities of electromagnetic radiation on both sides of a medium that the radiation passes through. Lambert-Beer's law states that absorbance is equal to the product of molar coefficient of absorbance of an absorbing compound in a medium times its concentration in the medium times path length of the electromagnetic radiation passing through the medium. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "absorbance (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000062
<http://purl.allotrope.org/ontologies/quality#AFQ_0000062> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "focal length"^^xsd:string ;
                                                           core:altLabel "focal distance"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of how strongly the bearer converges or diverges light. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "focal length"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000064
<http://purl.allotrope.org/ontologies/quality#AFQ_0000064> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 2007, 79, 293 (Glossary of terms used in photochemistry, 3rd edition (IUPAC Recommendations 2006))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "reflectance (quality)"^^xsd:string ;
                                                           core:altLabel "reflectance factor"^^xsd:string ,
                                                                         "reflectivity"^^xsd:string ;
                                                           core:definition "Reflectance is an optical quality that is the fraction of incident radiation reflected by a surface or discontinuity. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "reflectance (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000065
<http://purl.allotrope.org/ontologies/quality#AFQ_0000065> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           prop:AFX_0002808 obo:PATO_0001291 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electrical and magnetic quality"^^xsd:string ;
                                                           core:altLabel "electromagnetic radiation quality"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in an bearer by virtue of how that bearer interacts with electromagnetic radiation. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "electrical and magnetic quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000067
<http://purl.allotrope.org/ontologies/quality#AFQ_0000067> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source <https://en.wikipedia.org/wiki/Electrical_resistance_and_conductance> ,
                                                                       "PAC, 1996, 68, 957. (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electric resistance (quality)"^^xsd:string ;
                                                           core:altLabel "electric resistance"^^xsd:string ,
                                                                         "resistance"^^xsd:string ,
                                                                         "resistance (quality)"^^xsd:string ;
                                                           core:changeNote "2019-09-20 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ,
                                                                           "2020-01-23 Changed definition to IUPAC. [Allotrope]"^^xsd:string ;
                                                           core:definition "Electric resistance is the quality inhered in a conductor that is the electric potential difference divided by the electric current when there is no electromotive force in the conductor. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "electric resistance (quality)"^^xsd:string ;
                                                           core:scopeNote "Quality of a object or substance with the property of resisting opposing the flow of an electrical current. [NCI]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000111
<http://purl.allotrope.org/ontologies/quality#AFQ_0000111> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000051 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "state of matter"^^xsd:string ;
                                                           core:altLabel "material state"^^xsd:string ;
                                                           core:definition "A state of matter is a quality of material that is one of the distinct forms in which matter can exist. Four states of matter are observable in everyday life: solid, liquid, gas, and plasma. Many other states are known to exist only in extreme situations, such as Bose-Einstein condensates, neutron-degenerate matter, and quark-gluon plasma, which only occur in situations of extreme cold, extreme density, and extremely high-energy color-charged matter respectively. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "state of matter"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000112
<http://purl.allotrope.org/ontologies/quality#AFQ_0000112> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000111> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "solid"^^xsd:string ;
                                                           core:altLabel "solid state of matter"^^xsd:string ;
                                                           core:definition "A state of matter, in which particles are closely packed together. The forces between particles are strong so that the particles cannot move freely but can only vibrate. As a result, a solid has a stable, definite shape, and a definite volume. Solids can only change their shape by force, as when broken or cut. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "solid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000113
<http://purl.allotrope.org/ontologies/quality#AFQ_0000113> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000111> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "liquid"^^xsd:string ;
                                                           core:altLabel "liquid state of matter"^^xsd:string ;
                                                           core:definition "A state of matter that is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "liquid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000114
<http://purl.allotrope.org/ontologies/quality#AFQ_0000114> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000111> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "gas"^^xsd:string ;
                                                           core:altLabel "gaseous"^^xsd:string ,
                                                                         "gaseous state of matter"^^xsd:string ;
                                                           core:definition "A state of matter that is a compressible fluid. Not only will a gas conform to the shape of its container but it will also expand to fill the container. In a gas, the molecules have enough kinetic energy so that the effect of intermolecular forces is small (or zero for an ideal gas), and the typical distance between neighboring molecules is much greater than the molecular size. A gas has no definite shape or volume, but occupies the entire container in which it is confined. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "gas"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000115
<http://purl.allotrope.org/ontologies/quality#AFQ_0000115> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000111> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "plasma"^^xsd:string ;
                                                           core:altLabel "plasma state of matter"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of its plasma is a state of matter, that is, it does not have definite shape or volume. Unlike gases, plasmas are electrically conductive, produce magnetic fields and electric currents, and respond strongly to electromagnetic forces. Positively charged nuclei swim in a \"sea\" of freely-moving disassociated electrons, similar to the way such charges exist in conductive metal. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "plasma"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000116
<http://purl.allotrope.org/ontologies/quality#AFQ_0000116> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000210> ,
                                                                           [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/quality#AFQ_0000005>
                                                                                                  <http://purl.allotrope.org/ontologies/quality#AFQ_0000210>
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source <https://en.wikipedia.org/wiki/Shear_modulus> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "shear modulus (quality)"^^xsd:string ;
                                                           core:altLabel "shear modulus"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "Shear modulus is a ratio of shear stress to the shear strain. It is a quantity for measuring the stiffness of materials. The shear modulus is concerned with the deformation of a material. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "shear modulus (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000118
<http://purl.allotrope.org/ontologies/quality#AFQ_0000118> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000116> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "shear modulus of zero magnitude"^^xsd:string ;
                                                           core:altLabel "zero shear modulus"^^xsd:string ;
                                                           core:definition "A zero shear modulus is a determinate shear modulus with zero magnitude. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "shear modulus of zero magnitude"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000119
<http://purl.allotrope.org/ontologies/quality#AFQ_0000119> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000114> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "supercritical fluid"^^xsd:string ;
                                                           core:altLabel "supercritical fluid state of matter"^^xsd:string ;
                                                           core:definition "A gaseous state of matter in which temperature and pressure are above the critical temperature and critical pressure. In this state, the distinction between liquid and gas disappears. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "supercritical fluid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000120
<http://purl.allotrope.org/ontologies/quality#AFQ_0000120> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000112> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "gel (quality)"^^xsd:string ;
                                                           core:altLabel "gel"^^xsd:string ,
                                                                         "gel state of matter"^^xsd:string ;
                                                           core:definition "A gel is a solid state of matter of jelly-like material that can have properties ranging from soft and weak to hard and tough. Gels are defined as a substantially dilute cross-linked system, which exhibits no flow when in the steady-state. By weight, gels are mostly liquid, yet they behave like solids due to a three-dimensional cross-linked network within the liquid. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "gel (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000121
<http://purl.allotrope.org/ontologies/quality#AFQ_0000121> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000026> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "particle size above one micrometer"^^xsd:string ;
                                                           core:changeNote "2020-12-07 Moved to AFO. [Allotrope]"^^xsd:string ;
                                                           core:definition "A particle size above one micrometer is a determinate quality of particle size that has a determinate magnitude of greater that one micrometer. Magnitude of particle size can be measured in different ways such as based on diameter of spherical objects. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "particle size above one micrometer"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000123
<http://purl.allotrope.org/ontologies/quality#AFQ_0000123> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000125 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "exact mass"^^xsd:string ;
                                                           core:definition "Exact mass is a quality of mass of an isotopic species that is obtained by summing the masses of the individual isotopes of the molecule. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "exact mass"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000129
<http://purl.allotrope.org/ontologies/quality#AFQ_0000129> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "fugacity"^^xsd:string ;
                                                           core:definition "Thermodynamic property of a real gas that, if substituted for the pressure or partial pressure in the equations for an ideal gas, gives equations applicable to the real gas. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "fugacity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000138
<http://purl.allotrope.org/ontologies/quality#AFQ_0000138> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           prop:AFX_0002808 obo:NCIT_C16256 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "acoustic quality"^^xsd:string ;
                                                           core:definition "Property that inheres in an independent continuant having to do with sound or hearing. [NCI]"^^xsd:string ;
                                                           core:prefLabel "acoustic quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000139
<http://purl.allotrope.org/ontologies/quality#AFQ_0000139> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000138> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "frequency response"^^xsd:string ;
                                                           core:definition "Frequency response is the quantitative measure of the output spectrum of a system or device in response to a stimulus, and is used to characterize the dynamics of the system. It is a measure of magnitude and phase of the output as a function of frequency, in comparison to the input. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "frequency response"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000141
<http://purl.allotrope.org/ontologies/quality#AFQ_0000141> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000138> ;
                                                           prop:AFX_0002809 obo:NCIT_C99179 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "audible device noise"^^xsd:string ;
                                                           core:definition "An unintended or unpleasant sound that emanates from a device. [NCI]"^^xsd:string ;
                                                           core:prefLabel "audible device noise"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000142
<http://purl.allotrope.org/ontologies/quality#AFQ_0000142> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "polarization"^^xsd:string ;
                                                           core:definition "A physical quality that inheres in a bearer by virtue of the geometrical orientation of the oscillations of a transverse wave. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "polarization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000144
<http://purl.allotrope.org/ontologies/quality#AFQ_0000144> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001906 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source "D. Schulze: Powders and Bulk Solids, Springer-Verlag, Heidelberg (2008)."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "flowability"^^xsd:string ;
                                                           core:definition "Flowability is the quality of material to move by flow. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "flowability"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000145
<http://purl.allotrope.org/ontologies/quality#AFQ_0000145> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001035 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "friction (quality)"^^xsd:string ;
                                                           core:altLabel "friction"^^xsd:string ;
                                                           core:changeNote "2021-12-01 Changed pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "Friction is a quality of an object which is resisting the force the relative motion of solid surfaces, fluid layers, and material elements produce when sliding against each other. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "friction (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000149
<http://purl.allotrope.org/ontologies/quality#AFQ_0000149> rdf:type owl:Class ;
                                                           owl:equivalentClass [ rdf:type owl:Class ;
                                                                                 owl:unionOf ( <http://purl.allotrope.org/ontologies/quality#AFQ_0000150>
                                                                                               <http://purl.allotrope.org/ontologies/quality#AFQ_0000151>
                                                                                               <http://purl.allotrope.org/ontologies/quality#AFQ_0000152>
                                                                                             )
                                                                               ] ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/equipment#AFE_0000004>
                                                                           ] ;
                                                           prop:AFX_0002811 <http://purl.allotrope.org/ontologies/process#AFP_0001138> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "ionization polarity"^^xsd:string ;
                                                           core:definition "Ionization polarity is a device configuration of a ionization source whether the ions charge is negative or positive. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ionization polarity"^^xsd:string .


