                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "start command"^^xsd:string ;
                                                          core:altLabel "begin"^^xsd:string ,
                                                                        "begin command"^^xsd:string ,
                                                                        "start"^^xsd:string ;
                                                          core:definition "A start command is a process command that orders the procedural element to begin executing the normal RUNNING logic. This command is only valid when the procedural element is in the IDLE state. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "start command"^^xsd:string .


