                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "particle size (quality)"^^xsd:string ;
                                                           core:altLabel "granularity (material)"^^xsd:string ,
                                                                         "particle size"^^xsd:string ;
                                                           core:changeNote "2020-06-22 Changed labels. [Allotrope]"^^xsd:string ,
                                                                           "2020-12-07 Moved to AFO. [Allotrope]"^^xsd:string ;
                                                           core:definition "Quality of an independent continuant which describes the dimensions of an individual particle. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "particle size (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000029
<http://purl.allotrope.org/ontologies/quality#AFQ_0000029> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000199> ,
