                                                         rdfs:label "qualified transition role"^^xsd:string ;
                                                         core:altLabel "qualified transition"^^xsd:string ;
                                                         core:definition "Qualified transition role is the contextual role of an ion transition that asserts that the transition meets some qualification requirements. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "qualified transition role"^^xsd:string .


