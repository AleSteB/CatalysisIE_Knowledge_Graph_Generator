                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/result#AFR_0000788>
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "analyte calibration"^^xsd:string ;
                                                           core:altLabel "calibration"^^xsd:string ;
                                                           core:definition "Analyte calibration is producing a calibration curve from measurements of known amounts of analyte that will be used as measurement function for the measurement of unknown amounts of analytes. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "analyte calibration"^^xsd:string ;
                                                           core:scopeNote "This is not to be confused with calibration [AFP_0002389], which is the calibration of a measurement device. [Allotrope]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003710
<http://purl.allotrope.org/ontologies/process#AFP_0003710> rdf:type owl:Class ;
