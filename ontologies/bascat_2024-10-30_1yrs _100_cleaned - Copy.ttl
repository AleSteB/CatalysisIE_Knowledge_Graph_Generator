###  http://purl.allotrope.org/ontologies/role#AFRL_0000072
<http://purl.allotrope.org/ontologies/role#AFRL_0000072> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
