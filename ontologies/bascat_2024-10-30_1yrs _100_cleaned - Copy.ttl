                 core:prefLabel "dead"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001574
obo:PATO_0001574 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001906 ;
                 prop:AFX_0002865 obo:pato-owl ;
