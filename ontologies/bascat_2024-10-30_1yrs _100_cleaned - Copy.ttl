                                                           core:prefLabel "spectra combination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000812
<http://purl.allotrope.org/ontologies/process#AFP_0000812> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003473> ;
