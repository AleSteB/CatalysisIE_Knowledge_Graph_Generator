                                                          rdfs:label "cross direction"^^xsd:string ;
                                                          core:definition "Cross direction is a sampling orientation code that denotes a sample cut perpendicular to the direction of extrusion of the material being sampled. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "cross direction"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002733
<http://purl.allotrope.org/ontologies/result#AFR_0002733> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "adhesive peel"^^xsd:string ;
                                                          core:definition "An adhesive peel is a break code that denotes a peel along the seal contact line. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "adhesive peel"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002734
<http://purl.allotrope.org/ontologies/result#AFR_0002734> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "cohesive peel"^^xsd:string ;
                                                          core:definition "A cohesive peel is a break code that denotes a peel within one of the sealant layers. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "cohesive peel"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002735
<http://purl.allotrope.org/ontologies/result#AFR_0002735> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "delamination"^^xsd:string ;
                                                          core:definition "A delamination is a break code that denotes a separation between two layers somewhere other than the seal contact line. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "delamination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002736
<http://purl.allotrope.org/ontologies/result#AFR_0002736> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "material break"^^xsd:string ;
                                                          core:definition "A material break is a break code that denotes a catastrophic failure of one of the arms at the seal. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "material break"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002737
<http://purl.allotrope.org/ontologies/result#AFR_0002737> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "material break (remote)"^^xsd:string ;
                                                          core:definition "A material break (remote) is a break code that denotes a catastrophic failure of one of the arms at a distance from the seal. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "material break (remote)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002738
<http://purl.allotrope.org/ontologies/result#AFR_0002738> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "material elongation"^^xsd:string ;
                                                          core:definition "A material elongation is a break code that denotes an elongation of one or both of the arms. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "material elongation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002739
<http://purl.allotrope.org/ontologies/result#AFR_0002739> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "peel with elongation"^^xsd:string ;
                                                          core:definition "A peel with elongation is a break code that denotes an elongation of one or both of the arms with peel along the seal contact line. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peel with elongation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002817
<http://purl.allotrope.org/ontologies/result#AFR_0002817> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002732> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                          rdfs:label "no seal"^^xsd:string ;
                                                          core:definition "A no seal is a break code that denotes a failure to achieve a seal. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "no seal"^^xsd:string .


