###  http://purl.allotrope.org/ontologies/role#AFRL_0000269
<http://purl.allotrope.org/ontologies/role#AFRL_0000269> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000274> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "solvent role"^^xsd:string ;
                                                         core:altLabel "solvent"^^xsd:string ;
                                                         core:definition "Solvent is the role of a potion of liquid material when it dissolves a solute in order to produce a solution. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "solvent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000270
<http://purl.allotrope.org/ontologies/role#AFRL_0000270> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000274> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "solute role"^^xsd:string ;
                                                         core:altLabel "dissolved compound"^^xsd:string ,
                                                                       "dissolved substance"^^xsd:string ,
                                                                       "solute"^^xsd:string ,
                                                                       "solvated compound"^^xsd:string ;
                                                         core:definition "Solute is the role a portion of material when it is dissolved within a solution. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "solute role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000271
<http://purl.allotrope.org/ontologies/role#AFRL_0000271> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000273> ;
                                                         term:source <https://ws680.nist.gov/publication/get_pdf.cfm?pub_id=850489> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "dispersed phase role"^^xsd:string ;
                                                         core:altLabel "discontinuous phase"^^xsd:string ,
                                                                       "dispersed phase"^^xsd:string ;
                                                         core:definition """The dispersed phase role is the dispersion role of a portion of material in a dispersion, that is distributed in the form of discrete discontinuities
(particles, droplets or bubbles), in a second immiscible phase that is
continuous. [NIST]"""^^xsd:string ;
                                                         core:prefLabel "dispersed phase role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000272
<http://purl.allotrope.org/ontologies/role#AFRL_0000272> rdf:type owl:Class ;
