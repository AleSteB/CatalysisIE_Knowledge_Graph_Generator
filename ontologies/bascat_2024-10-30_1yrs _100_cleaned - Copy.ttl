                                                            rdfs:label "supercritical fluid"^^xsd:string ;
                                                            core:definition "A supercritical fluid is a gas whose temperature and pressure are above the critical temperature and critical pressure. In this state, the distinction between liquid and gas disappears. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "supercritical fluid"^^xsd:string .


