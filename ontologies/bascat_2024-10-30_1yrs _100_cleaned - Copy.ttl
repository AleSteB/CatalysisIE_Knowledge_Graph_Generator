                                                           rdfs:label "vortexing"^^xsd:string ;
                                                           core:definition "Vortexing is a process of mixing that creates a vortex in the solution usually using a vortexer. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "vortexing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000260
<http://purl.allotrope.org/ontologies/process#AFP_0000260> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
