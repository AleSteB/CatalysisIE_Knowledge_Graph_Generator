                                                         rdfs:label "reference signal"^^xsd:string ;
                                                         core:definition "Reference signal is the role of a signal that relates to another signal as reference for comparison. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "reference signal"^^xsd:string .


