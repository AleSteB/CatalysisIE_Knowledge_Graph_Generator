                                                          core:definition "A parameter specification specific to the sampler device in the chromatography system. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "autosampler setting (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001243
<http://purl.allotrope.org/ontologies/result#AFR_0001243> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001505> ;
