                                                          prop:AFX_0002808 <https://www.w3.org/2006/vcard/ns#tel> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                          rdfs:label "telephone number"^^xsd:string ;
