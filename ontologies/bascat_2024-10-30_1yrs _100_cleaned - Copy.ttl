                                                           core:prefLabel "specific enthalpy of sublimation (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000288
<http://purl.allotrope.org/ontologies/quality#AFQ_0000288> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000286> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "molar enthalpy of sublimation (quality)"^^xsd:string ;
                                                           core:altLabel "molar enthalpy of sublimation"^^xsd:string ,
                                                                         "molar heat of sublimation"^^xsd:string ;
                                                           core:definition "The specific enthalpy of sublimation is the enthalpy of sublimation referenced to a unit amount of substance. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "molar enthalpy of sublimation (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000290
<http://purl.allotrope.org/ontologies/quality#AFQ_0000290> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC, Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\"). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997). Online version (2019-) created by S. J. Chalk."^^xsd:string ,
                                                                       "IUPAC, Compendium of Macromolecular Nomenclature, The Purple Book, 1st ed., p. 66"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/turbidity> ;
                                                           rdfs:label "turbidity (quality)"^^xsd:string ;
                                                           core:altLabel "turbidity"^^xsd:string ;
                                                           core:definition "Turbidity is an optical quality that is the apparent absorbance of the incident radiation due to scattering. For small particles, direct proportionality exists between turbidity and the Rayleigh ratio. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "turbidity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000291
<http://purl.allotrope.org/ontologies/quality#AFQ_0000291> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000172> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "count fraction (quality)"^^xsd:string ;
                                                           core:definition "The count fraction is a quality pertaining the number of particles of a constituent divided by the total number of particles of all constituents in the mixture. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "count fraction (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000292
<http://purl.allotrope.org/ontologies/quality#AFQ_0000292> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "refractive index (quality)"^^xsd:string ;
                                                           core:definition "The refractive index is an optical quality inhered in a material by virtue of how fast light travels through the material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "refractive index (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000293
<http://purl.allotrope.org/ontologies/quality#AFQ_0000293> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000199> ,
                                                                           <http://purl.allotrope.org/ontologies/quality#AFQ_0000297> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/detection> ;
                                                           rdfs:label "detector gain"^^xsd:string ;
                                                           core:definition "The detector gain is a (relative) amount by which a detector to increases the magnitude of a signal from the input to the output port by adding energy to the signal. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "detector gain"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000295
<http://purl.allotrope.org/ontologies/quality#AFQ_0000295> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001300 ;
                                                           prop:AFX_0002808 obo:OMIT_0003079 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "birefringence (quality)"^^xsd:string ;
                                                           core:altLabel "birefringence"^^xsd:string ;
                                                           core:definition "An optical quality of anisotropic material that has a refractive index which depends on the properties of light. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "birefringence (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000297
<http://purl.allotrope.org/ontologies/quality#AFQ_0000297> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000005> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "gain"^^xsd:string ;
                                                           core:definition "Signal gain is the ratio of magnitude of a quality between a flow of energy incoming to a system (input signal) and the outgoing flow of energy (output signal) used for signaling. [Allotrope]"^^xsd:string ;
                                                           core:example "detector gain"^^xsd:string ;
                                                           core:prefLabel "gain"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000298
<http://purl.allotrope.org/ontologies/quality#AFQ_0000298> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "acicular particle shape"^^xsd:string ;
                                                           core:altLabel "acicular"^^xsd:string ,
                                                                         "needle"^^xsd:string ,
                                                                         "needle particle shape"^^xsd:string ;
                                                           core:definition "An acicular particle shape is a shape of particle with similar small height and width and large length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "acicular particle shape"^^xsd:string ;
                                                           core:scopeNote "Acicular particles are needle-like."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000299
<http://purl.allotrope.org/ontologies/quality#AFQ_0000299> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "columnar particle shape"^^xsd:string ;
                                                           core:altLabel "columnar"^^xsd:string ;
                                                           core:definition "A columnar particle shape is a shape of particle with similar moderate height and width and large length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "columnar particle shape"^^xsd:string ;
                                                           core:scopeNote "Columnar particles are similar in shape to poster tubes or wood joists."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000300
<http://purl.allotrope.org/ontologies/quality#AFQ_0000300> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "flake particle shape"^^xsd:string ;
                                                           core:altLabel "flake"^^xsd:string ;
                                                           core:definition "A flake particle shape is a shape of particle with small width and similar height and length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "flake particle shape"^^xsd:string ;
                                                           core:scopeNote "Flake particles are similar in shape to beer mats."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000301
<http://purl.allotrope.org/ontologies/quality#AFQ_0000301> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "plate particle shape"^^xsd:string ;
                                                           core:altLabel "plate"^^xsd:string ;
                                                           core:definition "A plate particle shape is a shape of particle with moderate width and similar height and length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "plate particle shape"^^xsd:string ;
                                                           core:scopeNote "Plate particles are similar in shape to dinner plates."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000302
<http://purl.allotrope.org/ontologies/quality#AFQ_0000302> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "lath particle shape"^^xsd:string ;
                                                           core:altLabel "lath"^^xsd:string ;
                                                           core:definition "A lath particle shape is a shape of particle with small width, moderate height, and large length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "lath particle shape"^^xsd:string ;
                                                           core:scopeNote "Lath particles are similar in shape to A4 paper sheets."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000303
<http://purl.allotrope.org/ontologies/quality#AFQ_0000303> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000311> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "equant particle shape"^^xsd:string ;
                                                           core:altLabel "equant"^^xsd:string ;
                                                           core:definition "An equant particle shape is a shape of particle with similar height, width, and length. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "equant particle shape"^^xsd:string ;
                                                           core:scopeNote "Equant particles may be spherical or cuboid."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000304
<http://purl.allotrope.org/ontologies/quality#AFQ_0000304> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000141 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "association state (quality)"^^xsd:string ;
                                                           core:altLabel "association state"^^xsd:string ;
                                                           core:definition "An association state is a structure of an association of primary particles in a material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "association state (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000305
<http://purl.allotrope.org/ontologies/quality#AFQ_0000305> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "lamellar association state"^^xsd:string ;
                                                           core:altLabel "lamellar"^^xsd:string ;
                                                           core:definition "A lamellar association state is an association state where the primary particles associate as a collection of plate particles in a stack. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "lamellar association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000306
<http://purl.allotrope.org/ontologies/quality#AFQ_0000306> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "aggregate association state"^^xsd:string ;
                                                           core:altLabel "aggregate"^^xsd:string ;
                                                           core:definition "An aggregate association state is an association state where the primary particles associate as a collection of particles loosely coupled together. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "aggregate association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000307
<http://purl.allotrope.org/ontologies/quality#AFQ_0000307> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "agglomerate association state"^^xsd:string ;
                                                           core:altLabel "agglomerate"^^xsd:string ;
                                                           core:definition "An agglomerate association state is an association state where the primary particles associate as a collection of particles tightly coupled together. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "agglomerate association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000308
<http://purl.allotrope.org/ontologies/quality#AFQ_0000308> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "conglomerate association state"^^xsd:string ;
                                                           core:altLabel "conglomerate"^^xsd:string ;
                                                           core:definition "A conglomerate association state is an association state where the primary particles associate as a collection of different types of particle. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "conglomerate association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000309
<http://purl.allotrope.org/ontologies/quality#AFQ_0000309> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "spherulite association state"^^xsd:string ;
                                                           core:altLabel "spherulite"^^xsd:string ;
                                                           core:definition "A spherulite association state is an association state where the primary particles associate as a collection of particles grouped radially about a central point. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "spherulite association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000310
<http://purl.allotrope.org/ontologies/quality#AFQ_0000310> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000304> ;
                                                           prop:AFX_0002808 "USP 30(6) Harmonization: <776> OPTICAL MICROSCOPY"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/optical-microscopy> ;
                                                           rdfs:label "drusy association state"^^xsd:string ;
                                                           core:altLabel "drusy"^^xsd:string ;
                                                           core:definition "A drusy association state is an association state where the primary particles associate as a collection of large particle covered by smaller particles. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "drusy association state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000311
<http://purl.allotrope.org/ontologies/quality#AFQ_0000311> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000052 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "particle shape (quality)"^^xsd:string ;
                                                           core:altLabel "particle shape"^^xsd:string ;
                                                           core:definition "A particle shape is a shape quality of a particle. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "particle shape (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000313
<http://purl.allotrope.org/ontologies/quality#AFQ_0000313> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000122 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "chord length (quality)"^^xsd:string ;
                                                           core:definition "A chord length is the length between any two points on the edge of a particle, with an upper bound of the diameter of the particle. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "chord length (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000314
<http://purl.allotrope.org/ontologies/quality#AFQ_0000314> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Class ;
                                                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002722 ;
                                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000049>
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002723 ;
                                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000049>
                                                                                           ]
                                                                                         )
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "current configuration"^^xsd:string ;
                                                           core:definition "A current configuration is a device configuration of a current controlling or monitoring device, that controls or monitors the target electric current at the site of some system component. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "current configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000315
<http://purl.allotrope.org/ontologies/quality#AFQ_0000315> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Class ;
                                                                             owl:unionOf ( [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002722 ;
                                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000048>
                                                                                           ]
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty prop:AFX_0002723 ;
                                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000048>
                                                                                           ]
                                                                                         )
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "voltage configuration"^^xsd:string ;
                                                           core:definition "A voltage configuration is a device configuration of a voltage controlling or monitoring device, that controls or monitors the target voltage at the site of some system component. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "voltage configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000316
<http://purl.allotrope.org/ontologies/quality#AFQ_0000316> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000295> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC Quantities, Units and Symbols in Physical Chemistry\", 1993"^^xsd:string ,
                                                                       "IUPAC Quantities, Units and Symbols in Physical Chemistry, 1993"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "circular birefringence (quality)"^^xsd:string ;
                                                           core:altLabel "angle of optical rotation"^^xsd:string ,
                                                                         "circular birefringence"^^xsd:string ,
                                                                         "polarization rotation"^^xsd:string ;
                                                           core:definition "Circular birefringence is the angle through which plane polarized light is rotated clockwise, as seen when facing the light source, in passing through an optically active medium. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "circular birefringence (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000317
<http://purl.allotrope.org/ontologies/quality#AFQ_0000317> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000295> ;
                                                           term:source <https://en.wikipedia.org/wiki/Specific_rotation> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "specific rotation (quality)"^^xsd:string ;
                                                           core:altLabel "specific rotation"^^xsd:string ;
                                                           core:definition "Specific rotation is the change in orientation of monochromatic plane-polarized light, per unit distance–concentration product, as the light passes through a sample of a compound in solution. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "specific rotation (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000318
<http://purl.allotrope.org/ontologies/quality#AFQ_0000318> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "temperature rate (quality)"^^xsd:string ;
                                                           core:altLabel "temperature rate"^^xsd:string ;
                                                           core:definition "A temperature rate is a thermal quality which describes the change in temperature over time in some material bearer. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "temperature rate (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000319
<http://purl.allotrope.org/ontologies/quality#AFQ_0000319> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "chemical shift (molecular quality)"^^xsd:string ;
                                                           core:altLabel "chemical shift"^^xsd:string ;
                                                           core:definition "The fractional variation of the resonance frequency of a nucleus in nuclear magnetic resonance (NMR) spectroscopy in consequence of its magnetic environment. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "chemical shift (molecular quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000321
<http://purl.allotrope.org/ontologies/quality#AFQ_0000321> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
