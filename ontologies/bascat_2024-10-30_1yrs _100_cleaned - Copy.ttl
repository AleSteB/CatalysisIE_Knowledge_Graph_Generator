###  http://purl.allotrope.org/ontologies/process#AFP_0003717
<http://purl.allotrope.org/ontologies/process#AFP_0003717> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003282> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/calibration> ;
                                                           rdfs:label "interpolation (calibration)"^^xsd:string ;
                                                           core:altLabel "interpolation"^^xsd:string ;
                                                           core:definition "Interpolation is a calculation that calculates a calculated measure from a primary measure by applying a measurement function that is derived from a calibration curve. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "interpolation (calibration)"^^xsd:string ;
                                                           core:scopeNote "The measurement function of a calibration curve can be got by curve fitting a function to a set of calibration points. Applying the function at abscissa coordinates that are part of the discrete calibration points, can be interpreted as interpolation. [Allotrope]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003719
<http://purl.allotrope.org/ontologies/process#AFP_0003719> rdf:type owl:Class ;
