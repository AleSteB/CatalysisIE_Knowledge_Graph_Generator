                                                         rdfs:label "formulation role"^^xsd:string ;
                                                         core:definition "A formulation role is a role of a material that is participating in a formulation process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "formulation role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000347
<http://purl.allotrope.org/ontologies/role#AFRL_0000347> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000271> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "particulate phase"^^xsd:string ;
                                                         core:definition "Particulate phase role is the role of the particles dispersed in a gel, sol or aerosol. [NIST, Allotrope]"^^xsd:string ;
                                                         core:prefLabel "particulate phase"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000351
<http://purl.allotrope.org/ontologies/role#AFRL_0000351> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000345> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "active pharmaceutical ingredient role"^^xsd:string ;
                                                         core:altLabel "API"^^xsd:string ,
                                                                       "active pharmaceutical ingredient"^^xsd:string ,
                                                                       "drug substance"^^xsd:string ,
                                                                       "drug substance role"^^xsd:string ;
                                                         core:changeNote "2020-06-22 Add alt labels. [Allotrope]"^^xsd:string ;
                                                         core:definition "The role of a material in a drug product that is biologically active when interacting with other components of the drug product, other potential drug products, or the chemistry of the body into which the drug will be applied. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "active pharmaceutical ingredient role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000352
<http://purl.allotrope.org/ontologies/role#AFRL_0000352> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000035> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "specimen role"^^xsd:string ;
                                                         core:altLabel "specimen"^^xsd:string ;
                                                         core:definition "Specimen role is the sample role of a prepared fraction of a portion of material that is analyzed in a particular experiment. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "specimen role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000359
<http://purl.allotrope.org/ontologies/role#AFRL_0000359> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000344> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:RO_0000081 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty prop:AFX_0000353 ;
                                                                                                owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0001348>
                                                                                              ]
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "by-product role"^^xsd:string ;
                                                         core:altLabel "by-product"^^xsd:string ;
                                                         core:definition "A material role of an expected but not desired product of a synthesis. [Allotrope]"^^xsd:string ;
                                                         core:example "the leaving group in a de-protection step."^^xsd:string ;
                                                         core:prefLabel "by-product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000360
<http://purl.allotrope.org/ontologies/role#AFRL_0000360> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000344> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:RO_0000081 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty prop:AFX_0000353 ;
                                                                                                owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0001348>
                                                                                              ]
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "product role"^^xsd:string ;
                                                         core:altLabel "chemical product"^^xsd:string ,
                                                                       "product"^^xsd:string ;
                                                         core:definition "A role of a material that is intended and desired to be  produced in a synthesis. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000361
<http://purl.allotrope.org/ontologies/role#AFRL_0000361> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000360> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "batch role"^^xsd:string ;
                                                         core:altLabel "batch"^^xsd:string ,
                                                                       "lot"^^xsd:string ,
                                                                       "lot role"^^xsd:string ;
                                                         core:definition "Batch role is a product role of a portion of material that is intended to have uniform character and quality, within specified limits, and is produced according to a single manufacturing order during the same cycle of manufacture. [Allotrope, CFR21]"^^xsd:string ;
                                                         core:prefLabel "batch role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000362
<http://purl.allotrope.org/ontologies/role#AFRL_0000362> rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:BFO_0000054 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0001530>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "filtration role"^^xsd:string ;
                                                         core:changeNote "2019-08-27 Fixed OWL definition, bug #694.  [Allotrope]"^^xsd:string ,
                                                                         "2022-06-23 Change to subclasses to equivalent class. [Allotrope]"^^xsd:string ;
                                                         core:definition "A filtration role is a role of a material in a filtration process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "filtration role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000363
<http://purl.allotrope.org/ontologies/role#AFRL_0000363> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000244> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "rinse solution role"^^xsd:string ;
                                                         core:altLabel "flush"^^xsd:string ,
                                                                       "rinse"^^xsd:string ,
                                                                       "rinse solution"^^xsd:string ,
                                                                       "rinsing agent"^^xsd:string ,
                                                                       "rinsing role"^^xsd:string ,
                                                                       "rinsing solution"^^xsd:string ;
                                                         core:changeNote "2019-09-20 Changed definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "The rinse solution role is a cleaning agent role of a fluid used to flush something in order to remove contaminants. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "rinse solution role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000364
<http://purl.allotrope.org/ontologies/role#AFRL_0000364> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000344> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "impurity role"^^xsd:string ;
                                                         core:altLabel "impurity"^^xsd:string ;
                                                         core:definition "A material role for any component of material that is not part of the defined product at the particular stage of manufacture or storage. [Allotrope]"^^xsd:string ;
                                                         core:example "For example a starting material is not an impurity at the start of a reaction but it is an impurity after the final purification step."^^xsd:string ;
                                                         core:prefLabel "impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000365
<http://purl.allotrope.org/ontologies/role#AFRL_0000365> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003641>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "degradation product role"^^xsd:string ;
                                                         core:altLabel "degradation product"^^xsd:string ;
                                                         core:definition "A degradation product is an impurity resulting from a chemical change in the drug substance brought about during manufacture and/or storage of the new drug product by the effect of, for example, light, temperature, pH, water, or by reaction with an excipient and/or the immediate container closure system. [ICH-Q3B]"^^xsd:string ;
                                                         core:prefLabel "degradation product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000366
<http://purl.allotrope.org/ontologies/role#AFRL_0000366> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000365> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000427> ,
                                                                         [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000365>
                                                                                                <http://purl.allotrope.org/ontologies/role#AFRL_0000427>
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "unidentified degradation product role"^^xsd:string ;
                                                         core:altLabel "unidentified degradation product"^^xsd:string ;
                                                         core:definition "A degradation product role for which a structural characterization has not been achieved and that is defined solely by qualitative analytical properties (e.g., chromatographic retention time). [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "unidentified degradation product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000367
<http://purl.allotrope.org/ontologies/role#AFRL_0000367> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000365> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000428> ,
                                                                         [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000365>
                                                                                                <http://purl.allotrope.org/ontologies/role#AFRL_0000428>
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "unspecified degradation product role"^^xsd:string ;
                                                         core:altLabel "unspecified degradation product"^^xsd:string ;
                                                         core:definition "A degradation product role that is limited by a general acceptance criterion, but not individually listed with its own specific acceptance criterion, in the new drug product specification. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "unspecified degradation product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000368
<http://purl.allotrope.org/ontologies/role#AFRL_0000368> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty prop:AFX_0002806 ;
                                                                                                owl:someValuesFrom owl:Thing
                                                                                              ]
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "classification purpose"^^xsd:string ;
                                                         core:altLabel "classification role"^^xsd:string ;
                                                         core:definition "A contextual role of information that classifies some of some entity into a category, class or schema. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "classification purpose"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000369
<http://purl.allotrope.org/ontologies/role#AFRL_0000369> rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:BFO_0000054 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003634>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "sampling role"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Change to subclasses to equivalent class. [Allotrope]"^^xsd:string ;
                                                         core:definition "A sampling role is a role of an object aggregate or a member of that aggregate that participates in a sampling process on the aggregate. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "sampling role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000370
<http://purl.allotrope.org/ontologies/role#AFRL_0000370> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000369> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "population role"^^xsd:string ;
                                                         core:altLabel "population"^^xsd:string ;
                                                         core:definition "The population role is the sampling role of the object aggregate that is object of the sampling. [Allotrope]"^^xsd:string ;
                                                         core:note "The statistical population contextual role is the related contextual role of an information object describing the population."^^xsd:string ;
                                                         core:prefLabel "population role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000371
<http://purl.allotrope.org/ontologies/role#AFRL_0000371> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000369> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "sample set role"^^xsd:string ;
                                                         core:altLabel "sample set"^^xsd:string ;
                                                         core:definition "The sample set role is the role of the partition of the population object aggregate that was selected in the sampling process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "sample set role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000373
<http://purl.allotrope.org/ontologies/role#AFRL_0000373> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "spatial role"^^xsd:string ;
                                                         core:definition "A spatial role is the contextual role of some information context object that is about spatial location, orientation, or relative positioning. [Allotrope]"^^xsd:string ;
                                                         core:example "left, right, above, below, inside, outside, parallel"^^xsd:string ;
                                                         core:prefLabel "spatial role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000402
<http://purl.allotrope.org/ontologies/role#AFRL_0000402> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                         rdfs:label "head"^^xsd:string ;
                                                         core:definition "Role that a organizational entity plays leader or formal head of the organization. [W3C ORG]"^^xsd:string ;
                                                         core:prefLabel "head"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000403
<http://purl.allotrope.org/ontologies/role#AFRL_0000403> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         prop:AFX_0002808 <http://www.w3.org/ns/org#Post> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                         rdfs:label "post"^^xsd:string ;
                                                         core:definition "A post is some position within an organization that exists independently of the person or persons filling it. Posts may be used to represent situations where a person is a member of an organization ex officio. [W3C ORG]"^^xsd:string ;
                                                         core:example "the Secretary of State for Scotland is part of UK Cabinet by virtue of being Secretary of State for Scotland, not as an individual person [W3C ORG]"^^xsd:string ;
                                                         core:note "A post can be held by multiple people and hence can be treated as a organization in its own right. [W3C ORG]"^^xsd:string ;
                                                         core:prefLabel "post"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000404
<http://purl.allotrope.org/ontologies/role#AFRL_0000404> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000434> ;
                                                         prop:AFX_0002808 <http://purl.allotrope.org/ontologies/audit/role#Approver> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "approver"^^xsd:string ;
                                                         core:definition "An approver is the role of an organizational entity that approves something. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "approver"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000405
<http://purl.allotrope.org/ontologies/role#AFRL_0000405> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         obo:BFO_0000023 ;
                                                         prop:AFX_0002808 obo:MS_1001271 ,
                                                                          <http://vivoweb.org/ontology/core#ResearcherRole> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "researcher"^^xsd:string ;
                                                         core:definition "A researcher is the role of an organizational entity that researches something. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "researcher"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000406
<http://purl.allotrope.org/ontologies/role#AFRL_0000406> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000405> ;
                                                         prop:AFX_0002808 <http://vivoweb.org/ontology/core#InvestigatorRole> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "investigator"^^xsd:string ;
                                                         core:definition "An investigator is a researcher that is doing an investigation. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "investigator"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000407
<http://purl.allotrope.org/ontologies/role#AFRL_0000407> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         obo:BFO_0000023 ;
                                                         prop:AFX_0002808 <http://purl.allotrope.org/ontologies/audit/role#Reviewer> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "reviewer"^^xsd:string ;
                                                         core:definition "A reviewer is the role of an agent that reviews some information. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "reviewer"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000409
<http://purl.allotrope.org/ontologies/role#AFRL_0000409> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000435> ;
                                                         prop:AFX_0002808 <http://purl.allotrope.org/ontologies/audit/role#Signer> ;
                                                         term:source <https://en.wikipedia.org/wiki/Signature> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signer"^^xsd:string ;
                                                         core:altLabel "signatory"^^xsd:string ;
                                                         core:definition "A signer is the role of the agent in a signing process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "signer"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000410
<http://purl.allotrope.org/ontologies/role#AFRL_0000410> rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:BFO_0000054 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0002389>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:subClassOf obo:BFO_0000023 ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0002389>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "calibration role"^^xsd:string ;
                                                         core:definition "A calibration role is role of a material entity that participates in a calibration process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "calibration role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000411
<http://purl.allotrope.org/ontologies/role#AFRL_0000411> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000410> ;
                                                         term:source <https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nbsspecialpublication260-100.pdf> ,
                                                                     "ISO Guide 30"^^xsd:string ,
                                                                     "http://www.citac.cc/CITAC_EURACHEM_GUIDE.pdf"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "reference material role"^^xsd:string ;
                                                         core:altLabel "calibration material"^^xsd:string ,
                                                                       "calibration material role"^^xsd:string ,
                                                                       "reference material"^^xsd:string ,
                                                                       "standard"^^xsd:string ,
                                                                       "standard material"^^xsd:string ,
                                                                       "standard material role"^^xsd:string ;
                                                         core:definition "A reference material role is the role of a material used in a calibration whose qualities are sufficiently homogenous and well established to be used as reference. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "reference material role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000420
<http://purl.allotrope.org/ontologies/role#AFRL_0000420> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000231> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "starting material role"^^xsd:string ;
                                                         core:definition "A role for a material used in the synthesis of a new drug substance that is incorporated as an element into the structure of an intermediate and/or of the new drug substance. [ICH-Q3A]"^^xsd:string ;
                                                         core:note "Starting materials are normally commercially available and of defined chemical and physical properties and structure. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "starting material role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000421
<http://purl.allotrope.org/ontologies/role#AFRL_0000421> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:OBI_0000086 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "limiting reagent role"^^xsd:string ;
                                                         core:definition "A reagent role of the material with the least mole quantity in a chemical process and as such limits the amount of product that can be formed. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "limiting reagent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000422
<http://purl.allotrope.org/ontologies/role#AFRL_0000422> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "enantiomeric impurity role"^^xsd:string ;
                                                         core:altLabel "enantiomere"^^xsd:string ,
                                                                       "enantiomeric impurity"^^xsd:string ;
                                                         core:definition "An enantiomeric impurity is the impurity role of a compound with the same molecular formula as the drug substance that differs in the spatial arrangement of atoms within the molecule and is a non-superimposable mirror image. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "enantiomeric impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000423
<http://purl.allotrope.org/ontologies/role#AFRL_0000423> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "extraneous contaminant role"^^xsd:string ;
                                                         core:altLabel "contaminant"^^xsd:string ,
                                                                       "contaminant role"^^xsd:string ,
                                                                       "extraneous contaminant"^^xsd:string ;
                                                         core:definition "An extraneous contaminant role is an impurity role arising from any source extraneous to the manufacturing process. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "extraneous contaminant role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000424
<http://purl.allotrope.org/ontologies/role#AFRL_0000424> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "identified impurity role"^^xsd:string ;
                                                         core:altLabel "identified impurity"^^xsd:string ;
                                                         core:definition "An impurity for which a structural characterization has been achieved. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "identified impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000425
<http://purl.allotrope.org/ontologies/role#AFRL_0000425> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "potential impurity role"^^xsd:string ;
                                                         core:altLabel "potential impurity"^^xsd:string ;
                                                         core:definition "An impurity role for a material that theoretically can arise during manufacture or storage. It may or may not actually appear in the new drug substance. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "potential impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000426
<http://purl.allotrope.org/ontologies/role#AFRL_0000426> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "specified impurity role"^^xsd:string ;
                                                         core:altLabel "specified impurity"^^xsd:string ;
                                                         core:definition "An impurity that is individually listed and limited with aspecific acceptance criterion in the new drug substance specification. A specified impurity can be either identified or unidentified. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "specified impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000427
<http://purl.allotrope.org/ontologies/role#AFRL_0000427> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "unidentified impurity role"^^xsd:string ;
                                                         core:altLabel "unidentified impurity"^^xsd:string ;
                                                         core:definition "An impurity for which a structural characterization has not been achieved and that is defined solely by qualitative analytical properties (e.g., chromatographic retention time). [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "unidentified impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000428
<http://purl.allotrope.org/ontologies/role#AFRL_0000428> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000364> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "unspecified impurity role"^^xsd:string ;
                                                         core:altLabel "unspecified impurity"^^xsd:string ;
                                                         core:definition "An impurity role that is limited by a general acceptance criterion, but not individually listed with its own specific acceptance criterion, in the new drug substance specification. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "unspecified impurity role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000429
<http://purl.allotrope.org/ontologies/role#AFRL_0000429> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000365> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "identified degradation product role"^^xsd:string ;
                                                         core:altLabel "identified degradation product"^^xsd:string ;
                                                         core:definition "A degradation product role for which a structural characterization has been achieved. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "identified degradation product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000430
<http://purl.allotrope.org/ontologies/role#AFRL_0000430> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000365> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "specified degradation product role"^^xsd:string ;
                                                         core:altLabel "specified degradation product"^^xsd:string ;
                                                         core:definition "A degradation product role that is individually listed and limited with a specific acceptance criterion in the new drug product specification. A specified degradation product can be either identified or unidentified. [ICH-Q3A]"^^xsd:string ;
                                                         core:prefLabel "specified degradation product role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000432
<http://purl.allotrope.org/ontologies/role#AFRL_0000432> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000293> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         term:source <https://en.wikipedia.org/wiki/Internal_standard> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "internal standard role"^^xsd:string ;
                                                         core:altLabel "internal standard"^^xsd:string ,
                                                                       "surrogate internal standard"^^xsd:string ;
                                                         core:definition "Internal standard role is the analysis role of a chemical substance that is added in a constant amount to samples, the blank and calibration standards in a chemical analysis. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "internal standard role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000434
<http://purl.allotrope.org/ontologies/role#AFRL_0000434> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003643>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "approving role"^^xsd:string ;
                                                         core:definition "An approving role is a role that is realized in some approving process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "approving role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000435
<http://purl.allotrope.org/ontologies/role#AFRL_0000435> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003645>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signing role"^^xsd:string ;
                                                         core:definition "A signing role is a role that is realized in some signing activity. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "signing role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000436
<http://purl.allotrope.org/ontologies/role#AFRL_0000436> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000167> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000435> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signed object"^^xsd:string ;
                                                         core:definition "The signed object is the bearer of the information content entity that is signed. [Allotrope]"^^xsd:string ;
                                                         core:example "The paper where the signature was written on."^^xsd:string ;
                                                         core:prefLabel "signed object"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000437
<http://purl.allotrope.org/ontologies/role#AFRL_0000437> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signing contextual role"^^xsd:string ;
                                                         core:definition "A signing contextual role is a contextual role of information content entities that are participants in a signing process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "signing contextual role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000438
<http://purl.allotrope.org/ontologies/role#AFRL_0000438> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000060> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000437> ;
                                                         term:source <https://en.wikipedia.org/wiki/Signature> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signature role"^^xsd:string ;
                                                         core:altLabel "signature"^^xsd:string ;
                                                         core:definition "A signature role is the role of an information object that is associated with some information and provides a proof of identity and intent of the signer. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "signature role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000439
<http://purl.allotrope.org/ontologies/role#AFRL_0000439> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000437> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "signed content role"^^xsd:string ;
                                                         core:altLabel "signed content"^^xsd:string ;
                                                         core:definition "Signed content role is the signing contextual role of the information content entity that is being signed. [Allotrope]"^^xsd:string ;
                                                         core:example "A contract signed."^^xsd:string ,
                                                                      "An approval signed."^^xsd:string ;
                                                         core:note "The signed content role is the role of the information. The physical bearer of that information has the role of a signed object."^^xsd:string ;
                                                         core:prefLabel "signed content role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000441
<http://purl.allotrope.org/ontologies/role#AFRL_0000441> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000087> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000095> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000449> ,
                                                                         [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000087>
                                                                                                <http://purl.allotrope.org/ontologies/role#AFRL_0000095>
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "submitter role"^^xsd:string ;
                                                         core:altLabel "submitter"^^xsd:string ;
                                                         core:definition "A submitter role is the role of a material entity that plays the sender of the submitted entity in a submitting process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "submitter role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000442
<http://purl.allotrope.org/ontologies/role#AFRL_0000442> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000047> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty obo:IAO_0000136 ;
                                                                                                owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                                     owl:onProperty prop:AFX_0002730 ;
                                                                                                                     owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000048>
                                                                                                                   ]
                                                                                              ]
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "aggregated datum"^^xsd:string ;
                                                         core:altLabel "summary datum"^^xsd:string ;
                                                         core:definition "An aggregated datum is the role of an information object that is about aggregated or summary information on the aggregate, such as statistics, count or sums of member data. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "aggregated datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000443
<http://purl.allotrope.org/ontologies/role#AFRL_0000443> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000264> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000442> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "product (math)"^^xsd:string ;
                                                         core:altLabel "product"^^xsd:string ,
                                                                       "product (mathematics)"^^xsd:string ;
                                                         core:definition "The product is the contextual role of numerical data that results from the multiplication of two or more numbers, amounts, or items. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "product (math)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000444
<http://purl.allotrope.org/ontologies/role#AFRL_0000444> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000047> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty prop:AFX_0002726 ;
                                                                           owl:someValuesFrom <http://purl.allotrope.org/ontologies/result#AFR_0001286>
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "aggregated feature"^^xsd:string ;
                                                         core:altLabel "aggregated feature role"^^xsd:string ;
                                                         core:definition "The aggregated feature is the role of a description or classification of a property, characteristic or facet of the members of the aggregate that is common to each member and is used to make aggregated data about the aggregate. [Allotrope]"^^xsd:string ;
                                                         core:example "the diameter quality is the aggregated feature in the 'average living cell diameter' result datum of a cell counter result"^^xsd:string ;
                                                         core:note "If the members of the aggregates are proxies for other information objects, then the aggregated feature is a feature of the information objects the proxies point to."^^xsd:string ;
                                                         core:prefLabel "aggregated feature"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000446
<http://purl.allotrope.org/ontologies/role#AFRL_0000446> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000039> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000448> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "software agent role"^^xsd:string ;
                                                         core:altLabel "software agent"^^xsd:string ;
                                                         core:definition "A software agent is the contextual role of software in the context of a process where a system executes that software and causally is an agent in the process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "software agent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000448
<http://purl.allotrope.org/ontologies/role#AFRL_0000448> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000091> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "general agent role"^^xsd:string ;
                                                         core:altLabel "agent"^^xsd:string ,
                                                                       "agent role"^^xsd:string ;
                                                         core:definition "Agentive role is a general role of a material entity or software that  influences the behavior of a process in an active way. If a material entity it is an agent role, if its is a software that is executed by a computer system, it is a software agent role. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "general agent role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000449
<http://purl.allotrope.org/ontologies/role#AFRL_0000449> rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:BFO_0000054 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003646>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000119> ,
                                                                         obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "submission role"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Change to subclasses to equivalent class. [Allotrope]"^^xsd:string ;
                                                         core:definition "A submission role is a role that is realized in a submitting process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "submission role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000450
<http://purl.allotrope.org/ontologies/role#AFRL_0000450> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "metadata role"^^xsd:string ;
                                                         core:definition "A metadata role is a contextual role of an information content entity that is not a parameter or result of a process but describes the context of the process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "metadata role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000451
<http://purl.allotrope.org/ontologies/role#AFRL_0000451> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000552> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty obo:RO_0002230 ;
                                                                                                owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003348>
                                                                                              ]
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:RO_0000081 ;
                                                                           owl:someValuesFrom obo:BFO_0000029
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "destination role"^^xsd:string ;
                                                         core:altLabel "destination"^^xsd:string ,
                                                                       "destination site"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Moved under localization role and adopted definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "Destination role is the localization role of a site where the localized object is at the end of the localization process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "destination role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000452
<http://purl.allotrope.org/ontologies/role#AFRL_0000452> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000552> ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:BFO_0000054 ;
                                                                           owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty obo:RO_0002224 ;
                                                                                                owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003348>
                                                                                              ]
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty obo:RO_0000081 ;
                                                                           owl:someValuesFrom obo:BFO_0000029
                                                                         ] ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "origin role"^^xsd:string ;
                                                         core:altLabel "origin"^^xsd:string ,
                                                                       "origin site"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Moved under localization role and adopted definition. [Allotrope]"^^xsd:string ;
                                                         core:definition "Origin role is the localization role of a site where the localized object is at the start of the localization process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "origin role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000453
<http://purl.allotrope.org/ontologies/role#AFRL_0000453> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000119> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000167> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "transferred material"^^xsd:string ;
                                                         core:altLabel "transferred object"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Changed definition and pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A transferred material is the role of the material that is being transferred from the origin site to the destination site. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "transferred material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000454
<http://purl.allotrope.org/ontologies/role#AFRL_0000454> rdf:type owl:Class ;
