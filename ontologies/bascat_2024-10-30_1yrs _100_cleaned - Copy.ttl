                                                             rdfs:label "flame ionization detector"^^xsd:string ;
                                                             core:altLabel "FID"^^xsd:string ;
                                                             core:definition "A flame ionization detector is a measurement component that measures an analyte in a gas stream through the measurement of ions created via flame ionization. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "flame ionization detector"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000217
<http://purl.allotrope.org/ontologies/equipment#AFE_0000217> rdf:type owl:Class ;
