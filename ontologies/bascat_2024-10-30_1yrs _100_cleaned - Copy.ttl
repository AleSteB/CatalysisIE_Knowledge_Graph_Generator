                                                                       "intermediate reagent role"^^xsd:string ,
                                                                       "intermediate role"^^xsd:string ,
                                                                       "reaction intermediate"^^xsd:string ;
                                                         core:definition "Intermediate role is a role of material that is formed from reactants (or preceding intermediates) and reacts further to give the directly observed products of a chemical reaction. [Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "reaction intermediate role"^^xsd:string .


