                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "refractive index"^^xsd:string ;
                                                          core:altLabel "index of refraction"^^xsd:string ,
                                                                        "refraction index"^^xsd:string ,
                                                                        "refractive index (datum)"^^xsd:string ;
                                                          core:definition "Refraction index is a quality quantification facet, that quantifies how fast light travels through a material. It is defined as n = c/v, where c is the speed of light in vacuum and v is the phase velocity of light in the medium. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "refractive index"^^xsd:string .


