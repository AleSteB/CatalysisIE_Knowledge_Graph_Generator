                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:RO_0000081 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/equipment#AFE_0000354>
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
