                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "material cleaned role"^^xsd:string ;
                                                         core:altLabel "material cleaned"^^xsd:string ,
                                                                       "part cleaned"^^xsd:string ,
                                                                       "part cleaned role"^^xsd:string ;
                                                         core:changeNote "2019-10-02 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "Material that is undergoing a cleaning process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "material cleaned role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000022
<http://purl.allotrope.org/ontologies/role#AFRL_0000022> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "reference role"^^xsd:string ;
                                                         core:altLabel "reference"^^xsd:string ;
                                                         core:definition "A role inhered by a participant that is a reference for qualitative or quantitative comparison in relation to other entities. [Allotrope]"^^xsd:string ;
                                                         core:example "measuring standard"^^xsd:string ;
                                                         core:prefLabel "reference role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000026
<http://purl.allotrope.org/ontologies/role#AFRL_0000026> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000288> ;
