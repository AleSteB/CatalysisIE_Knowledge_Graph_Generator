###  http://purl.allotrope.org/ontologies/result#AFR_0002812
<http://purl.allotrope.org/ontologies/result#AFR_0002812> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001843> ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "void volume"^^xsd:string ;
                                                          core:altLabel "V0"^^xsd:string ,
                                                                        "interparticle volume of the column"^^xsd:string ,
                                                                        "interstitial volume"^^xsd:string ;
                                                          core:definition "A void volume is the volume occupied by the mobile phase between the particles in the packed section of a column. [IUPAC]"^^xsd:string ;
                                                          core:note """In gas chromatography, the symbol V_G may be used for the interparticle volume of the column. In the ideal case, neglecting any extra-column volume, V_G is equal to the corrected gas hold-up volume (V0_M).
V_G = V0_M = V_M
[IUPAC]"""^^xsd:string ,
                                                                    "In liquid chromatography, the interparticle volume is equal to the mobile-phase hold-up volume (V_M) in the ideal case, neglecting any extra-column volume. [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "void volume"^^xsd:string .


