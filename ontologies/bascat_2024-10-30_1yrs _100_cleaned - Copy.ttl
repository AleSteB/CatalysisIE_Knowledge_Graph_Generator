                                                          core:definition "Current is a quality quantification datum that quantifies the ability to conduct an electrical charge. [PATO]"^^xsd:string ;
                                                          core:prefLabel "electric current"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001857
<http://purl.allotrope.org/ontologies/result#AFR_0001857> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001951> ,
