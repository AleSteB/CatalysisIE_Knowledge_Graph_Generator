 ] .


###  http://purl.obolibrary.org/obo/BFO_0000019
obo:BFO_0000019 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                obo:BFO_0000179 "quality"^^xsd:string ;
                obo:BFO_0000180 "Quality"^^xsd:string ;
                obo:IAO_0000112 "the ambient temperature of this portion of air"@en ,
                                "the color of a tomato"@en ,
                                "the length of the circumference of your waist"@en ,
                                "the mass of this piece of gold."@en ,
                                "the shape of your nose"@en ,
                                "the shape of your nostril"^^xsd:string ;
                obo:IAO_0000600 "a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized. (axiom label in BFO2 Reference: [055-001])"^^xsd:string ;
                obo:IAO_0000601 "If an entity is a quality at any time that it exists, then it is a quality at every time that it exists. (axiom label in BFO2 Reference: [105-001])"^^xsd:string ;
                obo:IAO_0000602 "(forall (x) (if (Quality x) (SpecificallyDependentContinuant x))) // axiom label in BFO2 CLIF: [055-001] "^^xsd:string ,
                                "(forall (x) (if (exists (t) (and (existsAt x t) (Quality x))) (forall (t_1) (if (existsAt x t_1) (Quality x))))) // axiom label in BFO2 CLIF: [105-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "quality"^^xsd:string ;
                core:definition "A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized. [BFO]"^^xsd:string ;
                core:prefLabel "quality"^^xsd:string .

[ rdf:type owl:Axiom ;
