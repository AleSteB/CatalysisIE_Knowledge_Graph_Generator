                                                                              owl:onProperty obo:RO_0000087 ;
                                                                              owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000269>
                                                                            ] ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                            rdfs:label "titration solvent"^^xsd:string ;
                                                            core:definition "A titration solvent is a solvent used in a titration to dissolve the sample. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "titration solvent"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001104
<http://purl.allotrope.org/ontologies/material#AFM_0001104> rdf:type owl:Class ;
