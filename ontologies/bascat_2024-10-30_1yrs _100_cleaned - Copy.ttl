                                                             rdfs:label "sensor"^^xsd:string ;
                                                             core:definition "A sensor is a component of a measuring system that is directly affected by a phenomenon, body, or substance carrying a quantity to be measured. [Allotrope]"^^xsd:string ;
                                                             core:editorialNote "A sensor can be a measuring device on its own, but is typically a part of it."^^xsd:string ;
                                                             core:prefLabel "sensor"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0002185
<http://purl.allotrope.org/ontologies/equipment#AFE_0002185> rdf:type owl:Class ;
