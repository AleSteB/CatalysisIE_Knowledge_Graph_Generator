###  http://purl.allotrope.org/ontologies/role#AFRL_0000155
<http://purl.allotrope.org/ontologies/role#AFRL_0000155> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000157> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "derived measure"^^xsd:string ;
                                                         core:definition "A derived measure is a measure that is the outcome of some indirect measurement. The derived value is derived from base measures by calculations following a formula or algorithm. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "derived measure"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000156
<http://purl.allotrope.org/ontologies/role#AFRL_0000156> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000157> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "base measure"^^xsd:string ;
                                                         core:definition "A base measure is a measure that is the direct output of some measurement process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "base measure"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000157
<http://purl.allotrope.org/ontologies/role#AFRL_0000157> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000080> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "measure"^^xsd:string ;
                                                         core:altLabel "measured value"^^xsd:string ;
                                                         core:definition "A measure is an actual value that is the direct or indirect outcome of some measurement and refers to some metric. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "measure"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000159
<http://purl.allotrope.org/ontologies/role#AFRL_0000159> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ,
                                                                         [ owl:intersectionOf ( obo:BFO_0000023
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty obo:RO_0000081 ;
                                                                                                  owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000040
                                                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                                                              owl:onProperty obo:RO_0000086 ;
                                                                                                                                              owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000019
                                                                                                                                                                                        [ rdf:type owl:Restriction ;
                                                                                                                                                                                          owl:onProperty obo:RO_0000059 ;
                                                                                                                                                                                          owl:someValuesFrom <http://purl.allotrope.org/ontologies/result#AFR_0001004>
                                                                                                                                                                                        ]
                                                                                                                                                                                      ) ;
                                                                                                                                                                   rdf:type owl:Class
                                                                                                                                                                 ]
                                                                                                                                            ]
                                                                                                                                          ) ;
                                                                                                                       rdf:type owl:Class
                                                                                                                     ]
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002865 <http://purl.allotrope.org/voc/afo/REC/2018/07/afo> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ,
                                                                          <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system> ;
                                                         rdfs:label "physical signal role"^^xsd:string ;
                                                         core:altLabel "signal role"^^xsd:string ;
                                                         core:definition "A signal is a role of some material entity that disposed to provide information. In the physical world, any quantity exhibiting variation in time or variation in space (such as an image) is potentially a signal that might provide information on the status of a physical system, or convey a message between observers, among other possibilities. [Allotrope, Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "physical signal role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000160
<http://purl.allotrope.org/ontologies/role#AFRL_0000160> rdf:type owl:Class ;
