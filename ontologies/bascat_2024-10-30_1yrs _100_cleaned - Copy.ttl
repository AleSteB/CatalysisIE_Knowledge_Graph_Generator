                                                                                                                        owl:onProperty obo:RO_0000087 ;
                                                                                                                        owl:someValuesFrom obo:OBI_0000571
                                                                                                                      ]
                                                                                                                    ) ;
                                                                                                 rdf:type owl:Class
                                                                                               ]
                                                                          ] ;
                                                          prop:AFX_0002811 prop:AFX_0000333 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "product manufacturer"^^xsd:string ;
                                                          core:altLabel "equipment manufacturer"^^xsd:string ,
                                                                        "manufacturer"^^xsd:string ;
                                                          core:definition "A product manufacturer is a symbol that denotes the organizational entity manufacturing some entity with a product role (economic). [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "product manufacturer"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001259
<http://purl.allotrope.org/ontologies/result#AFR_0001259> rdf:type owl:Class ;
                                                          rdfs:subClassOf obo:IAO_0000129 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "firmware version"^^xsd:string ;
                                                          core:definition "A firmware version is a version number that identifies the firmware of a device. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "firmware version"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001260
<http://purl.allotrope.org/ontologies/result#AFR_0001260> rdf:type owl:Class ;
                                                          rdfs:subClassOf obo:IAO_0000010 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "firmware"^^xsd:string ;
                                                          core:definition "In electronic systems and computing, firmware is \"the combination of a hardware device, e.g. an integrated circuit, and computer instructions and data that reside as read only software on that device\". As a result, firmware usually cannot be modified during normal operation of the device. Typical examples of devices containing firmware are embedded systems (such as traffic lights, consumer appliances, and digital watches), computers, computer peripherals, mobile phones, and digital cameras. The firmware contained in these devices provides the control program for the device. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "firmware"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001262
<http://purl.allotrope.org/ontologies/result#AFR_0001262> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000160> ;
                                                          term:source <https://en.wikipedia.org/wiki/Queue_(abstract_data_type)> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "queue"^^xsd:string ;
                                                          core:definition "In computer science, a queue is a particular kind of abstract data type or collection in which the entities in the collection are kept in order and the principal (or only) operations on the collection are the addition of entities to the rear terminal position, known as enqueue, and removal of entities from the front terminal position, known as dequeue. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "queue"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001263
<http://purl.allotrope.org/ontologies/result#AFR_0001263> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000945> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "request queue"^^xsd:string ;
                                                          core:altLabel "measurement queue"^^xsd:string ;
                                                          core:definition "A list used to sequence objects and to line up requests for a resource. [NCI]"^^xsd:string ;
                                                          core:prefLabel "request queue"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001264
<http://purl.allotrope.org/ontologies/result#AFR_0001264> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001075> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak width at baseline"^^xsd:string ;
                                                          core:definition "The peak width determined at the baseline level. The peak tangents are drawn from the turning points of the leading and trailing edges. Then the points of intersection with the baseline are calculated. The distance between the two points of intersection is the baseline level width. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak width at baseline"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001265
<http://purl.allotrope.org/ontologies/result#AFR_0001265> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001075> ;
                                                          prop:AFX_0002811 prop:AFX_0000577 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak width at 5 % of height"^^xsd:string ;
                                                          core:altLabel "peak width at 5 percent of height"^^xsd:string ,
                                                                        "peak width at 5% of height"^^xsd:string ;
                                                          core:changeNote "2022-11-28 Added alt label. [Allotrope]"^^xsd:string ;
                                                          core:definition "The peak width calculated at 5 % of its peak height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak width at 5 % of height"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001266
<http://purl.allotrope.org/ontologies/result#AFR_0001266> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001075> ;
                                                          prop:AFX_0002811 prop:AFX_0000578 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak width at half height"^^xsd:string ;
                                                          core:definition "The peak width calculated at half of the peak height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak width at half height"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001267
<http://purl.allotrope.org/ontologies/result#AFR_0001267> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001242> ,
