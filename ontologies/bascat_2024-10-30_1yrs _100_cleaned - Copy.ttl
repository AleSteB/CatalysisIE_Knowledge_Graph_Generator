                 rdfs:label "has data output"^^xsd:string ;
                 core:definition "Relates a process with an information object that participates in the process and exists the end of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has data output"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000546
prop:AFX_0000546 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000395 ;
                 owl:inverseOf prop:AFX_0002735 ;
                 rdfs:range obo:BFO_0000040 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has material output"^^xsd:string ;
                 core:definition "The material that is output of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has material output"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000551
prop:AFX_0000551 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0002351 ;
                 owl:inverseOf prop:AFX_0002720 ;
