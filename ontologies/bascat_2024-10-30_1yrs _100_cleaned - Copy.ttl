                                                            rdfs:label "liquid aerosol"^^xsd:string ;
                                                            core:definition "A solid aerosol is an colloid where the continuous phase is a gas and the dispersed phase is a liquid. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "liquid aerosol"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001037
<http://purl.allotrope.org/ontologies/material#AFM_0001037> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001044> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "molecular colloid"^^xsd:string ;
                                                            core:definition "A molecular colloid is a type of colloid that consists of many molecules that combine to structures of colloidal size. [Allotrope]"^^xsd:string ;
                                                            core:example "sulphur S8 colloid"^^xsd:string ;
                                                            core:prefLabel "molecular colloid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001038
<http://purl.allotrope.org/ontologies/material#AFM_0001038> rdf:type owl:Class ;
                                                            rdfs:subClassOf obo:CHMO_0000993 ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "portion of mixed material"^^xsd:string ;
                                                            core:altLabel "blend"^^xsd:string ,
                                                                          "mixture"^^xsd:string ,
                                                                          "portion of mixture"^^xsd:string ;
                                                            core:definition "An portion of mixed material is a material entity that consists of different kinds of grains if you inspect it at a higher level of granularity. [Allotrope]"^^xsd:string ;
                                                            core:example "portion of milk"^^xsd:string ,
                                                                         "sand"^^xsd:string ,
                                                                         "sea water"^^xsd:string ,
                                                                         "sea water with sand"^^xsd:string ;
                                                            core:prefLabel "portion of mixed material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001039
<http://purl.allotrope.org/ontologies/material#AFM_0001039> rdf:type owl:Class ;
                                                            rdfs:subClassOf obo:CHMO_0000993 ;
                                                            prop:AFX_0002796 <http://purl.allotrope.org/ontologies/result#AFR_0001223> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "portion of pure substance"^^xsd:string ;
                                                            core:definition "An portion of pure substance is a material entity that consists of one kind of grains if you inspect it at a higher level of granularity. [Allotrope]"^^xsd:string ;
                                                            core:example "solution of distilled water"^^xsd:string ;
                                                            core:prefLabel "portion of pure substance"^^xsd:string .


