                                                                         ] ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "snapshot"^^xsd:string ;
                                                         core:definition "A snapshot is the contextual role of an information object that is about a point in time within the bounds of a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "snapshot"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000030
<http://purl.allotrope.org/ontologies/role#AFRL_0000030> rdf:type owl:Class ;
