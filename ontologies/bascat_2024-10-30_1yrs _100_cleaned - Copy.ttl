###  http://purl.obolibrary.org/obo/CHEBI_22315
obo:CHEBI_22315 rdf:type owl:Class ;
                rdfs:subClassOf obo:CHEBI_35352 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty obo:RO_0000087 ;
                                  owl:someValuesFrom obo:CHEBI_25212
                                ] ;
                obo:IAO_0000115 "Any of the naturally occurring, basic nitrogen compounds (mostly heterocyclic) occurring mostly in the plant kingdom, but also found in bacteria, fungi, and animals. By extension, certain neutral compounds biogenetically related to basic alkaloids are also classed as alkaloids. Amino acids, peptides, proteins, nucleotides, nucleic acids, amino sugars and antibiotics are not normally regarded as alkaloids. Compounds in which the nitrogen is  exocyclic (dopamine, mescaline, serotonin, etc.) are usually classed as amines rather than alkaloids."^^xsd:string ;
                oboI:hasDbXref "Wikipedia:Alkaloid"^^xsd:string ;
                oboI:hasExactSynonym "Alkaloid"^^xsd:string ,
                                     "alkaloids"^^xsd:string ;
                oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                oboI:hasRelatedSynonym "Alkaloide"^^xsd:string ,
                                       "alcaloide"^^xsd:string ,
                                       "alcaloides"^^xsd:string ;
                oboI:id "CHEBI:22315"^^xsd:string ;
                oboI:inSubset <http://purl.obolibrary.org/obo/chebi#3_STAR> ;
                rdfs:label "alkaloid"^^xsd:string .

