###  http://purl.obolibrary.org/obo/BFO_0000130
obo:BFO_0000130 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain obo:BFO_0000003 ;
                rdfs:range obo:BFO_0000011 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "occupies spatiotemporal region"^^xsd:string ;
                core:definition "p occupies_spatiotemporal_region s. This is a primitive relation between an occurrent p and the spatiotemporal region s which is its spatiotemporal extent. [BFO]"^^xsd:string ;
                core:prefLabel "occupies spatiotemporal region"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000132
obo:BFO_0000132 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000050 ,
                                   obo:RO_0002222 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000003 ;
                rdfs:range obo:BFO_0000003 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "part of occurrent"^^xsd:string ;
                core:definition "b occurrent_part_of c =Def. b is a part of c & b and c are occurrents. [BFO]"^^xsd:string ;
                core:prefLabel "part of occurrent"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000133
obo:BFO_0000133 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:label "process profile of"^^xsd:string ;
                core:prefLabel "process profile of"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000138
obo:BFO_0000138 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prop:AFX_0002846 ,
                                   obo:BFO_0000132 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000003 ;
                rdfs:range obo:BFO_0000003 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "proper part of occurrent"^^xsd:string ;
                core:definition "B proper_occurrent_part_of c =Def. b occurrent_part_of c & b and c are not identical. [BFO]"^^xsd:string ;
                core:prefLabel "proper part of occurrent"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000139
obo:BFO_0000139 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf obo:BFO_0000132 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000003 ;
                rdfs:range obo:BFO_0000003 ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                rdfs:label "temporal part of"^^xsd:string ;
                core:definition "B temporal_part_of c =Def.b occurrent_part_of c & & for some temporal region t, b occupies_temporal_region t & for all occurrents d, t (if d occupies_temporal_region t & t? occurrent_part_of t then (d occurrent_part_of a iff d occurrent_part_of b)). [BFO]"^^xsd:string ;
                core:example "The 4th year of your life is a temporal part of your life. [BFO]"^^xsd:string ,
                             "The first quarter of a game of football is a temporal part of the whole game. [BFO]"^^xsd:string ,
                             "The process boundary which separates the 3rd and 4th years of your life. [BFO]"^^xsd:string ,
                             "The process of your heart beating from 4pm to 5pm today is a temporal part of the entire process of your heart beating. [BFO]"^^xsd:string ;
                core:prefLabel "temporal part of"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000157
obo:BFO_0000157 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain obo:BFO_0000008 ;
                rdfs:range obo:BFO_0000001 ;
