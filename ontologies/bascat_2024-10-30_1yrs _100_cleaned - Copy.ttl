                                                           core:prefLabel "Karl-Fischer titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000474
<http://purl.allotrope.org/ontologies/process#AFP_0000474> rdf:type owl:Class ;
