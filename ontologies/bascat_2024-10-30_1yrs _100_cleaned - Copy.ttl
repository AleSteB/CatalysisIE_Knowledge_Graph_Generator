###  http://purl.obolibrary.org/obo/IAO_0000005
obo:IAO_0000005 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty prop:AFX_0002730 ;
                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000015>
                                    ] ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000957> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "objective specification"^^xsd:string ;
                core:altLabel "goal specification"^^xsd:string ;
                core:definition "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved. [IAO]"^^xsd:string ;
                core:example "In the protocol of a ChIP assay the objective specification says to identify protein and DNA interaction."^^xsd:string ;
                core:prefLabel "objective specification"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000009
obo:IAO_0000009 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "datum label"^^xsd:string ;
                core:definition "A label is a symbol that is part of some other datum and is used to either partially define  the denotation of that datum or to provide a means for identifying the datum as a member of the set of data with the same label [IAO]"^^xsd:string ;
                core:prefLabel "datum label"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000010
obo:IAO_0000010 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001501> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "software"^^xsd:string ;
                core:definition "Software is a plan specification composed of a series of instructions that can be interpreted by or directly executed by a processing unit. [IAO]"^^xsd:string ;
                core:prefLabel "software"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000017
obo:IAO_0000017 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "model number"^^xsd:string ;
                core:altLabel "equipment model number"^^xsd:string ,
                              "instrument model number"^^xsd:string ,
                              "part number"^^xsd:string ;
                core:changeNote "2019-09-19 Add alt label part number. [Allotrope]"^^xsd:string ;
                core:definition "A model number is an information content entity specifically borne by catalogs, design specifications, advertising materials, inventory systems and similar that is about manufactured objects of the same class. The model number is an alternative term for the class. [IAO]"^^xsd:string ;
                core:prefLabel "model number"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000028
obo:IAO_0000028 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "symbol"^^xsd:string ;
                core:definition "An information content entity that is a mark(s) or character(s) used as a conventional representation of another entity. [IAO]"^^xsd:string ;
                core:example "a serial number such as \"12324X\""^^xsd:string ,
                             "a stop sign"^^xsd:string ,
                             "a written proper name such as \"OBI\""^^xsd:string ;
                core:prefLabel "symbol"^^xsd:string .


