                                                             term:source "RECOMMENDATIONS FOR TERMINOLOGY TO BE USED WITH PRECISION BALANCES, Pure and Applied Chemistry, 1(1), 171-176"^^xsd:string ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/weighing> ;
                                                             rdfs:label "analytical balance"^^xsd:string ;
                                                             rdfs:seeAlso "legal metrology definition of analytical balances"^^xsd:string ;
                                                             core:definition "An analytical balance has a capacity of 50 - 200 g with a precision of 0.01 - 0.05 mg. [IUPAC]"^^xsd:string ;
                                                             core:prefLabel "analytical balance"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000209
<http://purl.allotrope.org/ontologies/equipment#AFE_0000209> rdf:type owl:Class ;
