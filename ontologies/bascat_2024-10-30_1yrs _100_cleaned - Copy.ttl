###  http://purl.allotrope.org/ontologies/process#AFP_0003591
<http://purl.allotrope.org/ontologies/process#AFP_0003591> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003594> ;
                                                           term:source <https://en.wikipedia.org/wiki/Reflection_(physics)> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "reflection"^^xsd:string ;
                                                           core:altLabel "reflecting"^^xsd:string ;
                                                           core:definition "Reflection is the change in direction of a wavefront at an interface between two different media so that the wavefront returns into the medium from which it originated. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "reflection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003592
<http://purl.allotrope.org/ontologies/process#AFP_0003592> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003591> ;
                                                           term:source <https://en.wikipedia.org/wiki/Specular_reflection> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "specular reflection"^^xsd:string ;
                                                           core:altLabel "regular reflection"^^xsd:string ;
                                                           core:definition "Specular reflection is the mirror-like reflection of waves, such as light, from a surface. In this process, each incident ray is reflected, with the reflected ray having the same angle to the surface normal as the incident ray. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "specular reflection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003593
<http://purl.allotrope.org/ontologies/process#AFP_0003593> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003591> ;
                                                           term:source <https://en.wikipedia.org/wiki/Diffuse_reflection> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "diffuse reflection"^^xsd:string ;
                                                           core:definition "Diffuse reflection is the reflection of light or other waves or particles from a surface such that a ray incident on the surface is scattered at many angles rather than at just one angle as in the case of specular reflection. An ideal diffuse reflecting surface is said to exhibit Lambertian reflection, meaning that there is equal luminance when viewed from all directions lying in the half-space adjacent to the surface. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "diffuse reflection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003594
<http://purl.allotrope.org/ontologies/process#AFP_0003594> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003374> ;
                                                           term:source <https://en.wikipedia.org/wiki/Scattering> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "scattering"^^xsd:string ;
                                                           core:definition "Scattering is a general physical process where some forms of radiation, such as light, sound, or moving particles, are forced to deviate from a straight trajectory by one or more paths due to localized non-uniformities in the medium through which they pass. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "scattering"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003595
<http://purl.allotrope.org/ontologies/process#AFP_0003595> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003464> ;
                                                           term:source <https://en.wikipedia.org/wiki/Deflection_(physics)> ;
