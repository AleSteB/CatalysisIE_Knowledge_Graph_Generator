                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A physical quality which is equal to the distance between repeating units of a wave pattern. [PATO]"^^xsd:string ;
                 core:editorialNote "2019-07-04 Quality can be either acoustic. electromagnetic or radiation. [Allotrope]"^^xsd:string ;
                 core:prefLabel "wavelength (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001291
