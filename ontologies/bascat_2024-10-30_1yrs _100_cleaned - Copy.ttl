                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "resolution"^^xsd:string ;
                                                          core:definition "Resolution is a description of the smallest change in a quality being measured by a sensor (measurement instrument, detector) that causes a perceptible change in the corresponding indication. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "resolution"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001620
<http://purl.allotrope.org/ontologies/result#AFR_0001620> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000937> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/calibration> ;
                                                          rdfs:label "calibration time"^^xsd:string ;
                                                          core:altLabel "calibration date"^^xsd:string ;
                                                          core:definition "A calibration time is a time that indicates when a calibration is done. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "calibration time"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001622
<http://purl.allotrope.org/ontologies/result#AFR_0001622> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000980> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "inclusive gateway"^^xsd:string ;
                                                          core:definition "An inclusive gateway is a transition specification that has multiple activity successors. The process forks into each succeeding activity of the inclusive gateway where the guard condition is true. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "inclusive gateway"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001623
<http://purl.allotrope.org/ontologies/result#AFR_0001623> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000980> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "exclusive gateway"^^xsd:string ;
                                                          core:definition "An exclusive gateway is a transition specification that has multiple conditional activity successors and an optional default transition. The guard conditions on the successors are checked and at most one of them must be true at the runtime. If no guard condition is met then the optional default transition is done or the process terminates. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "exclusive gateway"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001625
<http://purl.allotrope.org/ontologies/result#AFR_0001625> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000953> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "delay"^^xsd:string ;
                                                          core:altLabel "time offset"^^xsd:string ;
                                                          core:definition "A delay is a process property that describes a difference in time between a process boundary and some other point in time. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "delay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001626
<http://purl.allotrope.org/ontologies/result#AFR_0001626> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0001299> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "stop command"^^xsd:string ;
                                                          core:altLabel "end"^^xsd:string ,
                                                                        "end command"^^xsd:string ,
                                                                        "stop"^^xsd:string ;
                                                          core:definition "A stop command is a process command that orders the procedural element to execute the stopping logic. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is valid when the procedural element is in the running, pausing, paused, holding, held, or restarting state. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "stop command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001627
<http://purl.allotrope.org/ontologies/result#AFR_0001627> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002013> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "pause command"^^xsd:string ;
                                                          core:altLabel "pause"^^xsd:string ,
                                                                        "wait"^^xsd:string ,
                                                                        "wait command"^^xsd:string ;
                                                          core:definition "A pause command is a process command that orders the procedural element to pause at the next programmed pause transition within its sequencing logic and await a resume command before proceeding. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is only valid in the running state. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "pause command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001628
<http://purl.allotrope.org/ontologies/result#AFR_0001628> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002614> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "restart command"^^xsd:string ;
                                                          core:altLabel "restart"^^xsd:string ;
                                                          core:definition "A restart command is a process command that orders the procedural element to execute the restarting logic to safely return to the running state. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is only valid when the procedural element is in the held state. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "restart command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001629
<http://purl.allotrope.org/ontologies/result#AFR_0001629> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002615> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "abort command"^^xsd:string ;
                                                          core:altLabel "abort"^^xsd:string ;
                                                          core:definition "An abort command is a process command that orders the procedural element to execute an aborting logic. [Allotrope]"^^xsd:string ;
                                                          core:note "The command is valid in every state except for idle, completed, aborting and aborted. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "abort command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001630
<http://purl.allotrope.org/ontologies/result#AFR_0001630> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002617> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "hold command"^^xsd:string ;
                                                          core:altLabel "hold"^^xsd:string ;
                                                          core:definition "A hold command is a process command that orders the procedural element to execute the holding logic. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is valid when the procedural element is in the running, pausing, paused or restarting state. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "hold command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001631
<http://purl.allotrope.org/ontologies/result#AFR_0001631> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002616> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "reset command"^^xsd:string ;
                                                          core:altLabel "reset"^^xsd:string ;
                                                          core:definition "A reset command is a process command that causes a transition to the idle state. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is valid from the complete, aborted, and stopped states. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "reset command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001632
<http://purl.allotrope.org/ontologies/result#AFR_0001632> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000942> ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/process#AFP_0002618> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "resume command"^^xsd:string ;
                                                          core:altLabel "resume"^^xsd:string ;
                                                          core:definition "A resume command is a process command that orders a procedural element that has paused at a programmed transition as the result of either a pause command or a single step mode to resume execution. [Allotrope]"^^xsd:string ;
                                                          core:note "This command is only valid when the procedural element is in the paused state. [ISA-88]"^^xsd:string ;
                                                          core:prefLabel "resume command"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001633
<http://purl.allotrope.org/ontologies/result#AFR_0001633> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
