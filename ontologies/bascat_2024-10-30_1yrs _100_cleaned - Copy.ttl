                                                         core:altLabel "destination"^^xsd:string ,
                                                                       "destination role"^^xsd:string ,
                                                                       "target"^^xsd:string ,
                                                                       "target role"^^xsd:string ,
                                                                       "to"^^xsd:string ;
                                                         core:definition "A to role is a direction role indicating that something is going into an target direction. [Allotrope]"^^xsd:string ;
                                                         core:editorialNote "This is an abstraction of direction, for spatio-temporal role use af-rl:destination datum. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "to role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000465
<http://purl.allotrope.org/ontologies/role#AFRL_0000465> rdf:type owl:Class ;
