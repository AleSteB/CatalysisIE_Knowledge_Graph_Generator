                 rdfs:label "selected in"^^xsd:string ;
                 core:altLabel "applied in"^^xsd:string ,
                               "used in"^^xsd:string ;
                 core:definition "A continuant is selected or used in planned process if the participant is chosen to influence the process towards some objective but is itself not essentially changed by a process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "selected in"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002875
prop:AFX_0002875 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000056 ;
