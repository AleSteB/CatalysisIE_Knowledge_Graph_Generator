                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "degassing"^^xsd:string ;
                                                           core:altLabel "degas"^^xsd:string ,
                                                                         "degasification"^^xsd:string ;
                                                           core:definition "Degassing is a sample preparation process whereby the adsorbed (dissolved) gas is removed from a solid or liquid. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "degassing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000611
<http://purl.allotrope.org/ontologies/process#AFP_0000611> rdf:type owl:Class ;
