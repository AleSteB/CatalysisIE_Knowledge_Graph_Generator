                                                            rdfs:label "bench (site)"^^xsd:string ;
                                                            core:altLabel "bench"^^xsd:string ;
                                                            core:definition "A bench (site) is site in a workspace or laboratory where work is being done. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "bench (site)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/spatial#AFSP_0000003
