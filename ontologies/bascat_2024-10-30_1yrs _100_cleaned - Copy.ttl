   owl:annotatedProperty obo:IAO_0000602 ;
   owl:annotatedTarget "(forall (x) (if (MaterialEntity x) (IndependentContinuant x))) // axiom label in BFO2 CLIF: [019-002] "^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/019-002>
 ] .

