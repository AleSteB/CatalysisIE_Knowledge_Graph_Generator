<http://qudt.org/schema/qudt#quantityValue> rdf:type owl:ObjectProperty ;
                                            prop:AFX_0002865 <http://qudt.org/1.1/schema/qudt> ;
                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                            rdfs:label "has quantity value"^^xsd:string ;
                                            core:altLabel "quantity value"^^xsd:string ;
                                            core:prefLabel "has quantity value"^^xsd:string .


###  http://qudt.org/schema/qudt#unit
<http://qudt.org/schema/qudt#unit> rdf:type owl:ObjectProperty ;
                                   rdfs:range <http://qudt.org/schema/qudt#Unit> ;
                                   prop:AFX_0002865 <http://qudt.org/1.1/schema/qudt> ;
                                   rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                   rdfs:label "has unit"^^xsd:string ;
                                   core:altLabel "unit"^^xsd:string ;
                                   core:prefLabel "has unit"^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#broadMatch
core:broadMatch rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf core:broader ,
                                   core:mappingRelation ;
                owl:inverseOf core:narrowMatch ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                 <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "has broader match"^^xsd:string ;
                core:definition "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#broader
core:broader rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf core:broaderTransitive ;
             owl:inverseOf core:narrower ;
             rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."^^xsd:string ;
             rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                              <http://www.w3.org/2004/02/skos/core> ;
             rdfs:label "has broader"^^xsd:string ;
             core:definition "Relates a concept to a concept that is more general in meaning."^^xsd:string ;
             core:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#broaderTransitive
core:broaderTransitive rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf core:semanticRelation ;
                       owl:inverseOf core:narrowerTransitive ;
                       rdf:type owl:TransitiveProperty ;
                       rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                        <http://www.w3.org/2004/02/skos/core> ;
                       rdfs:label "has broader transitive"^^xsd:string ;
                       core:definition "skos:broaderTransitive is a transitive superproperty of skos:broader."^^xsd:string ;
                       core:scopeNote "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#closeMatch
core:closeMatch rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf core:mappingRelation ;
                rdf:type owl:SymmetricProperty ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                 <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "has close match"^^xsd:string ;
                core:definition "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#exactMatch
core:exactMatch rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf core:closeMatch ;
                rdf:type owl:SymmetricProperty ,
                         owl:TransitiveProperty ;
                rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                 <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "has exact match"^^xsd:string ;
                core:definition "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#hasTopConcept
core:hasTopConcept rdf:type owl:ObjectProperty ;
                   owl:inverseOf core:topConceptOf ;
                   rdfs:domain core:ConceptScheme ;
                   rdfs:range core:Concept ;
                   rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                    <http://www.w3.org/2004/02/skos/core> ;
                   rdfs:label "has top concept"^^xsd:string ;
                   core:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#inScheme
core:inScheme rdf:type owl:ObjectProperty ;
              rdfs:range core:ConceptScheme ;
              rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                               <http://www.w3.org/2004/02/skos/core> ;
              rdfs:label "is in scheme"^^xsd:string ;
              core:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."^^xsd:string ;
              core:scopeNote "A concept may be a member of more than one concept scheme."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#mappingRelation
core:mappingRelation rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf core:semanticRelation ;
                     rdfs:comment "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice."^^xsd:string ;
                     rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                      <http://www.w3.org/2004/02/skos/core> ;
                     rdfs:label "is in mapping relation with"^^xsd:string ;
                     core:definition "Relates two concepts coming, by convention, from different schemes, and that have comparable meanings"^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#member
core:member rdf:type owl:ObjectProperty ;
            rdfs:domain core:Collection ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( core:Collection
                                       core:Concept
                                     )
                       ] ;
            rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                             <http://www.w3.org/2004/02/skos/core> ;
            rdfs:label "has member"^^xsd:string ;
            core:definition "Relates a collection to one of its members."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#memberList
core:memberList rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain core:OrderedCollection ;
                rdfs:comment """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                 <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "has member list"^^xsd:string ;
                core:definition "Relates an ordered collection to the RDF list containing its members."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
core:narrowMatch rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf core:mappingRelation ,
                                    core:narrower ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                  <http://www.w3.org/2004/02/skos/core> ;
                 rdfs:label "has narrower match"^^xsd:string ;
                 core:definition "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#narrower
core:narrower rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf core:narrowerTransitive ;
              rdfs:comment "Narrower concepts are typically rendered as children in a concept hierarchy (tree)."^^xsd:string ;
              rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                               <http://www.w3.org/2004/02/skos/core> ;
              rdfs:label "has narrower"^^xsd:string ;
              core:definition "Relates a concept to a concept that is more specific in meaning."^^xsd:string ;
              core:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#narrowerTransitive
core:narrowerTransitive rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf core:semanticRelation ;
                        rdf:type owl:TransitiveProperty ;
                        rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                         <http://www.w3.org/2004/02/skos/core> ;
                        rdfs:label "has narrower transitive"^^xsd:string ;
                        core:definition "skos:narrowerTransitive is a transitive superproperty of skos:narrower."^^xsd:string ;
                        core:scopeNote "By convention, skos:narrowerTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#related
core:related rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf core:semanticRelation ;
             rdf:type owl:SymmetricProperty ;
             rdfs:comment "skos:related is disjoint with skos:broaderTransitive"^^xsd:string ;
             rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                              <http://www.w3.org/2004/02/skos/core> ;
             rdfs:label "has related"^^xsd:string ;
             core:definition "Relates a concept to a concept with which there is an associative semantic relationship."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
core:relatedMatch rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf core:mappingRelation ,
                                     core:related ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                   <http://www.w3.org/2004/02/skos/core> ;
                  rdfs:label "has related match"^^xsd:string ;
                  core:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#semanticRelation
core:semanticRelation rdf:type owl:ObjectProperty ;
                      rdfs:domain core:Concept ;
                      rdfs:range core:Concept ;
                      rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                       <http://www.w3.org/2004/02/skos/core> ;
                      rdfs:label "is in semantic relation with"^^xsd:string ;
                      core:definition "Links a concept to a concept related by meaning."^^xsd:string ;
                      core:scopeNote "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#topConceptOf
core:topConceptOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf core:inScheme ;
                  rdfs:domain core:Concept ;
                  rdfs:range core:ConceptScheme ;
                  rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                   <http://www.w3.org/2004/02/skos/core> ;
                  rdfs:label "is top concept in scheme"^^xsd:string ;
                  core:definition "Relates a concept to the concept scheme that it is a top level concept of."^^xsd:string .


###  http://xmlns.com/foaf/0.1/homepage
x_0.1:homepage rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/mbox
x_0.1:mbox rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://purl.allotrope.org/ontologies/property#AFX_0000604
prop:AFX_0000604 rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:onDatatype xsd:integer ;
                              owl:withRestrictions ( [ xsd:minInclusive 0
                                                     ]
                                                   )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "count"^^xsd:string ;
                 core:altLabel "number of objects"^^xsd:string ,
                               "objects count"^^xsd:string ,
                               "size"^^xsd:string ;
                 core:definition "The number of objects counted. [Allotrope]"^^xsd:string ;
                 core:prefLabel "count"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000670
prop:AFX_0000670 rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum value"^^xsd:string ;
                 core:definition "The lowest value of a range of literals. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000671
prop:AFX_0000671 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000670 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum value exclusive"^^xsd:string ;
                 core:definition "The lowest value of a range excluding the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum value exclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000672
prop:AFX_0000672 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000670 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum value inclusive"^^xsd:string ;
                 core:definition "The lowest value of a range including the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum value inclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000674
prop:AFX_0000674 rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum value"^^xsd:string ;
                 core:definition "The highest value of a range of literals. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000675
prop:AFX_0000675 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000674 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum value exclusive"^^xsd:string ;
                 core:definition "The highest value of a range excluding the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum value exclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000676
prop:AFX_0000676 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000674 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum value inclusive"^^xsd:string ;
                 core:definition "The highest value of a range including the boundary value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum value inclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000678
prop:AFX_0000678 rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "is valid"^^xsd:string ;
                 core:altLabel "valid"^^xsd:string ;
                 core:definition "The property flags an information as correct and without errors. [Allotrope]"^^xsd:string ;
                 core:prefLabel "is valid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000684
prop:AFX_0000684 rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:onDatatype xsd:integer ;
                              owl:withRestrictions ( [ xsd:minInclusive 0
                                                     ]
                                                   )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "index"^^xsd:string ;
                 core:definition "Position in an ordered list. [Allotrope]"^^xsd:string ;
                 core:prefLabel "index"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000685
prop:AFX_0000685 rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "increment value"^^xsd:string ;
                 core:altLabel "step size value"^^xsd:string ;
                 core:definition "The difference between two discrete points next to each other in a range of discrete values. [Allotrope]"^^xsd:string ;
                 core:example "A device property can be set between a minimum and maximum value but only in steps of the increment value."^^xsd:string ;
                 core:prefLabel "increment value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000690
prop:AFX_0000690 rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has value"^^xsd:string ;
                 core:altLabel "value"^^xsd:string ;
                 core:definition "The literal piece of information as part of some information entity object. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001198
prop:AFX_0001198 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000604 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/common#AFC_0000166> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "collection size"^^xsd:string ;
                 core:altLabel "count"^^xsd:string ,
                               "length"^^xsd:string ,
                               "size"^^xsd:string ;
                 core:definition "The collection size is the number of entries in a collection. [Allotrope]"^^xsd:string ;
                 core:prefLabel "collection size"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0001732
prop:AFX_0001732 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000690 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "reference value"^^xsd:string ;
                 core:definition "A value that used as a basis for comparison. [Allotrope]"^^xsd:string ;
                 core:prefLabel "reference value"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002705
prop:AFX_0002705 rdf:type owl:DatatypeProperty ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/result#AFR_0000958> ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:onDatatype xsd:integer ;
                              owl:withRestrictions ( [ xsd:minInclusive 0
                                                     ]
                                                   )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "tensor rank"^^xsd:string ;
                 core:altLabel "degree"^^xsd:string ,
                               "order"^^xsd:string ,
                               "rank"^^xsd:string ;
                 core:definition "Tensor rank is the total number of indices required to identify each component of a tensor uniquely. It is equal to the dimension of the tensor. [Wikipedia]"^^xsd:string ;
                 core:prefLabel "tensor rank"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002742
prop:AFX_0002742 rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:onDatatype xsd:integer ;
                              owl:withRestrictions ( [ xsd:minInclusive 0
                                                     ]
                                                   )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "index 1"^^xsd:string ;
                 core:definition "The second index value in a multi-dimensional datum. [Allotrope]"^^xsd:string ;
                 core:prefLabel "index 1"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002743
prop:AFX_0002743 rdf:type owl:DatatypeProperty ;
                 rdfs:range [ rdf:type rdfs:Datatype ;
                              owl:onDatatype xsd:integer ;
                              owl:withRestrictions ( [ xsd:minInclusive 0
                                                     ]
                                                   )
                            ] ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "index 0"^^xsd:string ;
                 core:definition "The first index value in a multi-dimensional datum. [Allotrope]"^^xsd:string ;
                 core:prefLabel "index 0"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002861
prop:AFX_0002861 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000671 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum error exclusive"^^xsd:string ;
                 core:altLabel "error min exclusive"^^xsd:string ;
                 core:definition "Minimum error exclusive is the absolute error amount (exclusive) by which the actual value could be lower than the stated value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum error exclusive"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0002862
prop:AFX_0002862 rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf prop:AFX_0000675 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum error exclusive"^^xsd:string ;
                 core:altLabel "error max exclusive"^^xsd:string ;
                 core:definition "Maximum error exclusive is the absolute error amount (exclusive) by which the actual value could be higher than the stated value. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum error exclusive"^^xsd:string .


###  http://purl.allotrope.org/voc/afo/merged/REC/2023/09/merged-without-qudt-and-inferred#has_doi
merg:has_doi rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:string ;
             rdfs:label "has doi"^^xsd:string .


###  http://purl.allotrope.org/voc/afo/merged/REC/2023/09/merged-without-qudt-and-inferred#has_title
merg:has_title rdf:type owl:DatatypeProperty ;
               rdfs:range xsd:string ;
               rdfs:label "has title"^^xsd:string .


###  http://qudt.org/schema/qudt#numericValue
<http://qudt.org/schema/qudt#numericValue> rdf:type owl:DatatypeProperty ;
                                           rdfs:range xsd:double ;
                                           rdfs:label "has numeric value"^^xsd:string ;
                                           core:altLabel "numeric value"^^xsd:string ;
                                           core:prefLabel "has numeric value"^^xsd:string .


###  http://qudt.org/schema/qudt#relativeStandardUncertainty
<http://qudt.org/schema/qudt#relativeStandardUncertainty> rdf:type owl:DatatypeProperty ;
                                                          rdfs:range xsd:double ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                                          rdfs:label "has relative standard uncertainty"^^xsd:string ;
                                                          core:altLabel "relative standard uncertainty"^^xsd:string ;
                                                          core:definition "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value. [QUDT]"^^xsd:string ;
                                                          core:prefLabel "has relative standard uncertainty"^^xsd:string .


###  http://qudt.org/schema/qudt#standardUncertainty
<http://qudt.org/schema/qudt#standardUncertainty> rdf:type owl:DatatypeProperty ;
                                                  rdfs:range xsd:double ;
                                                  rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                                  rdfs:label "has standard uncertainty"^^xsd:string ;
                                                  core:altLabel "standard uncertainty"^^xsd:string ;
                                                  core:definition "The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements. [QUDT]"^^xsd:string ;
                                                  core:prefLabel "has standard uncertainty"^^xsd:string .


###  http://qudt.org/schema/qudt#symbol
<http://qudt.org/schema/qudt#symbol> rdf:type owl:DatatypeProperty ;
                                     rdfs:range xsd:string ;
                                     rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                                     rdfs:label "has symbol"^^xsd:string ;
                                     core:altLabel "symbol"^^xsd:string ;
                                     core:definition "The symbol for a unit is a glyph that is used to represent the unit in a compact form. [QUDT]"^^xsd:string ;
                                     core:example "For example, the symbol for the US Dollar is $. This contrasts with unit:abbreviation, which gives a short alphanumeric abbreviation for the unit. (I.e. USD for US Dollar). [QUDT]"^^xsd:string ;
                                     core:prefLabel "has symbol"^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#notation
core:notation rdf:type owl:DatatypeProperty ;
              prop:AFX_0002865 <http://www.w3.org/2004/02/skos/core> ;
              rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ,
                               <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                               <http://www.w3.org/2004/02/skos/core> ;
              rdfs:label "notation"^^xsd:string ;
              core:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."^^xsd:string ;
              core:prefLabel "notation"^^xsd:string ;
              core:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."^^xsd:string .


###  http://xmlns.com/foaf/0.1/name
x_0.1:name rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://org.semanticweb.owlapi/error#Error1
<http://org.semanticweb.owlapi/error#Error1> rdf:type owl:Class .


###  http://org.semanticweb.owlapi/error#Error2
<http://org.semanticweb.owlapi/error#Error2> rdf:type owl:Class .


###  http://purl.allotrope.org/ontologies/common#AFC_0000021
<http://purl.allotrope.org/ontologies/common#AFC_0000021> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "range"^^xsd:string ;
                                                          core:definition "A range is an interval of values with a lower and/or upper limit. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/common#AFC_0000036
<http://purl.allotrope.org/ontologies/common#AFC_0000036> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001059> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "codelist"^^xsd:string ;
                                                          core:definition "A set of codes in a controlled vocabulary. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "codelist"^^xsd:string .


###  http://purl.allotrope.org/ontologies/common#AFC_0000050
<http://purl.allotrope.org/ontologies/common#AFC_0000050> rdf:type owl:Class ;
                                                          rdfs:subClassOf obo:IAO_0000028 ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          term:source "2020-12-01 Changed parent to symbol. [Allotrope]"^^xsd:string ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "code"^^xsd:string ;
                                                          core:altLabel "categorical value"^^xsd:string ,
                                                                        "enumeration value"^^xsd:string ;
                                                          core:definition "An entry in a list of controlled symbols denoting a classification. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "code"^^xsd:string .


###  http://purl.allotrope.org/ontologies/common#AFC_0000090
<http://purl.allotrope.org/ontologies/common#AFC_0000090> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000991> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "condition"^^xsd:string ;
                                                          core:definition "A condition is an information content entity that is about the portion of reality under which something occurs or is valid. The condition is limited by its scope and may have preconditions. It restricts the possible realizations. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "condition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/common#AFC_0000091
<http://purl.allotrope.org/ontologies/common#AFC_0000091> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000090> ,
