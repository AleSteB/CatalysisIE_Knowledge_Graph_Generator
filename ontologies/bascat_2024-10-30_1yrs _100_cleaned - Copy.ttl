<http://purl.allotrope.org/ontologies/quality#AFQ_0000189> rdf:type owl:Class ;
                                                           owl:equivalentClass [ owl:intersectionOf ( obo:PATO_0001334
                                                                                                      [ rdf:type owl:Restriction ;
