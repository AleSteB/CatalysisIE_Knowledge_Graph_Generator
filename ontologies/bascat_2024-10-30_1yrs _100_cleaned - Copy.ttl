###  http://purl.allotrope.org/ontologies/result#AFR_0000958
<http://purl.allotrope.org/ontologies/result#AFR_0000958> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001054> ,
