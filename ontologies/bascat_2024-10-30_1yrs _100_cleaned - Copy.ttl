                                                           rdfs:label "dedusting"^^xsd:string ;
                                                           core:definition "Dedusting is the process of removal of dust. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dedusting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002691
<http://purl.allotrope.org/ontologies/process#AFP_0002691> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003599> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "fingerprinting"^^xsd:string ;
                                                           core:definition "Fingerprinting is the process of comparison or overlay of measured spectra with existing reference spectra. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "fingerprinting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002693
<http://purl.allotrope.org/ontologies/process#AFP_0002693> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002834> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "t-test"^^xsd:string ;
                                                           core:definition "The t-test is a process of quantifying the closeness of two sets of data points. It is defined as the ratio of the difference between the means of the two sets divided by the standard error of the difference. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "t-test"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002702
<http://purl.allotrope.org/ontologies/process#AFP_0002702> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002670> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "closed loop vapor generation"^^xsd:string ;
                                                           core:altLabel "closed loop"^^xsd:string ;
                                                           core:definition "The closed loop uses feedback control for the regulation of the vapor generation. The system continuously detects deviations from the target partial pressure and adjusts the vapor generation correspondingly. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "closed loop vapor generation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002715
<http://purl.allotrope.org/ontologies/process#AFP_0002715> rdf:type owl:Class ;
