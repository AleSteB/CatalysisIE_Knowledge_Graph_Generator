                                                         rdfs:label "temporal role"^^xsd:string ;
                                                         core:definition "A contextual role of information that is dependent on some temporal region or process boundary. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "temporal role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000074
<http://purl.allotrope.org/ontologies/role#AFRL_0000074> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000053> ;
