                                                         rdfs:label "direction role"^^xsd:string ;
                                                         core:definition "A direction role is a contextual role of some information content entity indicating a direction in a relation. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "direction role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000464
<http://purl.allotrope.org/ontologies/role#AFRL_0000464> rdf:type owl:Class ;
