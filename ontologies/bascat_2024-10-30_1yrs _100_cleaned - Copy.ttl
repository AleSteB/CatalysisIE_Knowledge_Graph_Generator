                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "algorithm"^^xsd:string ;
                core:definition "A plan specification which describes the inputs and output of mathematical functions as well as workflow of execution for achieving an predefined objective. Algorithms are realized usually by means of implementation as computer programs for execution by automata. [IAO]"^^xsd:string ;
                core:prefLabel "algorithm"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000088
obo:IAO_0000088 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000310 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "report"^^xsd:string ;
                core:definition "A report is a document assembled by an author for the purpose of providing information for the audience. A report is the output of a documenting process and has the objective to be consumed by a specific audience. Topic of the report is on something that has completed. A report is not a single figure. [IAO]"^^xsd:string ;
                core:example "case report (not patient record)"^^xsd:string ,
                             "grant progress report"^^xsd:string ,
                             "journal article"^^xsd:string ,
                             "patent application"^^xsd:string ;
                core:prefLabel "report"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000098
obo:IAO_0000098 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000957> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "data format specification"^^xsd:string ;
                core:definition "A data format specification is the information content borne by the document published defining the specification. [IAO]"^^xsd:string ;
                core:example "The ISO document specifying what encompasses an XML document; The instructions in a XSD file [IAO]"^^xsd:string ;
                core:prefLabel "data format specification"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000101
obo:IAO_0000101 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000308 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "image"^^xsd:string ;
                core:definition "An image is an affine projection to a two dimensional surface, of measurements of some quality of an entity or entities repeated at regular intervals across a spatial range, where the measurements are represented as color and luminosity on the projected on surface. [IAO]"^^xsd:string ;
                core:prefLabel "image"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000129
obo:IAO_0000129 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "version number"^^xsd:string ;
                core:definition "A version number is an information content entity which is a sequence of characters borne by part of each of a class of manufactured products or its packaging and indicates its order within a set of other products having the same name. [IAO]"^^xsd:string ;
                core:prefLabel "version number"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000131
obo:IAO_0000131 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "serial number"^^xsd:string ;
                core:definition "A serial number is an information content entity which is a unique sequence of characters borne by part of manufactured product or its packaging that is assigned to each individual in some class of products, and so can serve as a way to identify an individual product within the class. Serial numbers can be encoded in a variety of other information objects, such as bar codes, numerals, or patterns of dots. [IAO]"^^xsd:string ;
                core:prefLabel "serial number"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000132
obo:IAO_0000132 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "lot number"^^xsd:string ;
                core:altLabel "batch number"^^xsd:string ;
                core:definition "A lot number is an information content entity which is an identical sequence of character borne by part of manufactured product or its packaging for each instances of a product class in a discrete batch of an item. [IAO]"^^xsd:string ;
                core:prefLabel "lot number"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000178
obo:IAO_0000178 rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000040
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty obo:RO_0000053 ;
                                                             owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                  owl:onProperty obo:RO_0000059 ;
                                                                                  owl:someValuesFrom obo:IAO_0000030
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf obo:BFO_0000040 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                rdfs:label "material information bearer"^^xsd:string ;
                core:definition "A material entity in which a concretization of an information content entity inheres. [IAO]"^^xsd:string ;
                core:example "a brain"^^xsd:string ,
                             "a hard drive"^^xsd:string ,
                             "a page of a paperback novel with writing on it."^^xsd:string ;
                core:prefLabel "material information bearer"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000300
obo:IAO_0000300 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000992> ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "textual entity"^^xsd:string ;
                core:definition "A textual entity is a part of a manifestation (FRBR sense), a generically dependent continuant whose concretizations are patterns of glyphs intended to be interpreted as words, formulas, etc."^^xsd:string ;
                core:prefLabel "textual entity"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000304
obo:IAO_0000304 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "caption"^^xsd:string ;
                core:definition "A textual entity that describes a figure [IAO]"^^xsd:string ;
                core:example "Figure 1: A system diagram describing the modules of the Hanalyzer.  Reading methods (green) take external sources of knowledge (blue) and extract information from them, either by parsing structured data or biomedical language processing to extract information from unstructured data.  Reading modules are responsible for tracking the provenance of all knowledge.  Reasoning methods (yellow) enrich the knowledge that results from reading by, for example, noting two genes that are annotated to the same ontology term or database entry.  All knowledge sources, read or reasoned, are assigned a reliability score, and all are combined using that score into a knowledge network (orange) that represents the integration of all sorts of relationship between a pair of genes and a combined reliability score.  A data network (also orange) is created from experimental results to be analyzed.  The reporting modules (pink) integrate the data and knowledge networks, producing visualizations that can be queried with the associated drill-down tool."^^xsd:string ;
                core:prefLabel "caption"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000306
obo:IAO_0000306 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000300 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "table"^^xsd:string ;
                core:definition "A textual entity that contains a two-dimensional arrangement of texts repeated at regular intervals across a spatial range, such that the spatial relationships among the constituent texts expresses propositions [IAO]"^^xsd:string ;
                core:prefLabel "table"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000308
obo:IAO_0000308 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000992> ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "figure"^^xsd:string ;
                core:definition "An information content entity consisting of a two dimensional arrangement of information content entities such that the arrangement itself is about something. [IAO]"^^xsd:string ;
                core:example "Any picture, diagram or table"^^xsd:string ;
                core:prefLabel "figure"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000309
obo:IAO_0000309 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000308 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "diagram"^^xsd:string ;
                core:definition "A figure that expresses one or more propositions. [IAO]"^^xsd:string ;
                core:example "A molecular structure ribbon cartoon showing helices, turns and sheets and their relations to each other in space."^^xsd:string ;
                core:prefLabel "diagram"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000310
obo:IAO_0000310 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000992> ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "document"^^xsd:string ;
                core:definition "A collection of information content entities intended to be understood together as a whole [IAO]"^^xsd:string ;
                core:example "A journal article, patent application, laboratory notebook, or a book"^^xsd:string ;
                core:prefLabel "document"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000422
obo:IAO_0000422 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001082> ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                rdfs:label "postal address"^^xsd:string ;
                core:definition "A textual entity that is used as directive to deliver something to a person, or organization. [IAO]"^^xsd:string ;
                core:prefLabel "postal address"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000429
obo:IAO_0000429 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001082> ;
                term:source "RFC 5322"^^xsd:string ,
                            "https://en.wikipedia.org/wiki/Email_address"^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                rdfs:label "email address"^^xsd:string ;
                core:definition "An email address identifies an email box to which email messages are delivered. [Wikipedia]"^^xsd:string ;
                core:prefLabel "email address"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000573
obo:IAO_0000573 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000038 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "line graph"^^xsd:string ;
                core:definition "A line graph is a type of graph created by connecting a series of data points together with a line. [IAO]"^^xsd:string ;
                core:prefLabel "line graph"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000577
obo:IAO_0000577 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "centrally registered identifier symbol"^^xsd:string ;
                core:definition "A symbol that is part of a CRID and that is sufficient to look up a record from the CRID's registry. [IAO]"^^xsd:string ;
                core:prefLabel "centrally registered identifier symbol"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000578
obo:IAO_0000578 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000917> ;
                prop:AFX_0002818 "true"^^xsd:boolean ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "centrally registered identifier"^^xsd:string ;
                core:definition "An information content entity that consists of a CRID symbol and additional information about the CRID registry to which it belongs. [IAO]"^^xsd:string ;
                core:example "The sentence \"The article has Pubmed ID 12345.\" contains a CRID that has two parts: one part is the CRID symbol, which is '12345'; the other part denotes the CRID registry, which is Pubmed."^^xsd:string ;
                core:prefLabel "centrally registered identifier"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000579
obo:IAO_0000579 rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001059> ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "centrally registered identifier registry"^^xsd:string ;
                core:definition "A CRID registry is a dataset of CRID records, each consisting of a CRID symbol and additional information which was recorded in the dataset through a assigning a centrally registered identifier process. [IAO]"^^xsd:string ;
                core:example "PubMed is a CRID registry. It has a dataset of PubMed identifiers associated with journal articles. "^^xsd:string ;
                core:prefLabel "centrally registered identifier registry"^^xsd:string .


###  http://purl.obolibrary.org/obo/IAO_0000590
obo:IAO_0000590 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000028 ;
                prop:AFX_0002865 obo:iao.owl ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                rdfs:label "written name"^^xsd:string ;
                core:definition "A textual entity that denotes a particular in reality. [IAO]"^^xsd:string ;
                core:prefLabel "written name"^^xsd:string .


