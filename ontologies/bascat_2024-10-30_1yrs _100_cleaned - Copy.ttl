                                                         rdfs:label "ordered member"^^xsd:string ;
                                                         core:definition "Ordered member is a member role that has an ordering within the collection. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "ordered member"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000171
<http://purl.allotrope.org/ontologies/role#AFRL_0000171> rdf:type owl:Class ;
