                                                                         "reflection UV/VIS spectroscopy"^^xsd:string ,
                                                                         "reflection ultra-violet-visible spectrometry"^^xsd:string ,
                                                                         "reflection ultra-violet-visible spectroscopy"^^xsd:string ,
                                                                         "reflection ultraviolet-visible spectrometry"^^xsd:string ,
                                                                         "reflection ultraviolet-visible spectroscopy"^^xsd:string ;
                                                           core:definition "Ultraviolet-visible spectroscopy where the reflection or scattering of radiation from the sample surface is detected. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "reflectance ultraviolet-visible spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001109
<http://purl.allotrope.org/ontologies/process#AFP_0001109> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001427> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "quadrupole mass spectrometry"^^xsd:string ;
                                                           core:altLabel "QMS"^^xsd:string ,
                                                                         "quadrapole mass spectrometry"^^xsd:string ,
                                                                         "quadrupolar mass spectrometry"^^xsd:string ,
                                                                         "quadrupolar mass spectroscopy"^^xsd:string ,
                                                                         "quadrupole mass spectroscopy"^^xsd:string ;
                                                           core:definition "Quadrapole mass spectrometry is a type of mass spectrometry where the mass-to-charge ratio of the sample ions is measured using an electric field generated by four parallel electrodes. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "quadrupole mass spectrometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001113
<http://purl.allotrope.org/ontologies/process#AFP_0001113> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000925> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           term:source "https://en.wikipedia.org/wiki/Electron_capture_detector#Gas_chromatograph_detector"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electron capture measurement"^^xsd:string ;
                                                           core:altLabel "ECD"^^xsd:string ,
                                                                         "electron capture detection"^^xsd:string ,
                                                                         "electron capture dissociation"^^xsd:string ;
                                                           core:definition "Electron capture measurement is a measurement that is sensitive to electronegative compounds (e.g. halogenated compounds). A beta-particle emitter (e.g. 63Ni) is used to produce an electron beam, which is passed between two electrodes. As the sample is passed through the e-beam, organic functional groups interact with the electrons, interrupting the current. [Allotrope, CHMO]"^^xsd:string ;
                                                           core:prefLabel "electron capture measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001114
<http://purl.allotrope.org/ontologies/process#AFP_0001114> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002212> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "blood measurement method"^^xsd:string ;
                                                           core:definition "A measurement of the blood, it's contents, cells or other factors contained within the blood. [CMO]"^^xsd:string ;
                                                           core:prefLabel "blood measurement method"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001116
<http://purl.allotrope.org/ontologies/process#AFP_0001116> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002680> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "biological measurement method"^^xsd:string ;
                                                           core:definition "The determination of the relative strength of a substance (e.g., a drug or hormone or toxicant) by comparing its effect on a test organism with that of a standard preparation. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "biological measurement method"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001134
<http://purl.allotrope.org/ontologies/process#AFP_0001134> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "polarimetry"^^xsd:string ;
                                                           core:altLabel "optical rotation measurement"^^xsd:string ;
                                                           core:changeNote "2020-11-12 Changed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Polarimetry is a measurement of the extent to which a sample interacts with polarized electromagnetic radiation by transmission, reflection, refraction, or diffraction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "polarimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001135
<http://purl.allotrope.org/ontologies/process#AFP_0001135> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003354> ,
                                                                           [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0003275>
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty prop:AFX_0000395 ;
                                                                                                    owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000275>
                                                                                                  ]
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty prop:AFX_0000399 ;
                                                                                                    owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000275>
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mixing"^^xsd:string ;
                                                           core:altLabel "mixing material"^^xsd:string ;
                                                           core:definition "The combining of components, particles or layers into a more homogeneous state. The mixing may be achieved manually or mechanically by shifting the material with stirrers or pumps or by revolving or shaking the container. The process must not permit segregation of particles of different size or properties. Homogeneity may be considered to have been achieved in a practical sense when the sampling error of the processed portion is negligible compared to the total error of the measurement system. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "mixing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001146
<http://purl.allotrope.org/ontologies/process#AFP_0001146> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "scanning"^^xsd:string ;
                                                           core:altLabel "scan"^^xsd:string ;
                                                           core:definition "Scanning is measuring repeatedly or sweepingly. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "scanning"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001159
<http://purl.allotrope.org/ontologies/process#AFP_0001159> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           obo:OBI_0000011 ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0000546 ;
                                                                             owl:someValuesFrom [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0000275>
                                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                                         owl:onProperty obo:RO_0000087 ;
                                                                                                                         owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000035>
                                                                                                                       ]
                                                                                                                     ) ;
                                                                                                  rdf:type owl:Class
                                                                                                ]
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:BFO_0000063 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003634>
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "sample preparation"^^xsd:string ;
                                                           core:altLabel "preparative method"^^xsd:string ,
                                                                         "sample preparation step"^^xsd:string ,
                                                                         "sample preparative method"^^xsd:string ,
                                                                         "sample processing"^^xsd:string ,
                                                                         "sample transformation method"^^xsd:string ;
                                                           core:changeNote "2019-08-20 Changed pref label and definition. Fixed formal definition not to use equivalence. [Allotrope]"^^xsd:string ;
                                                           core:definition "Sample preparation is a planned preparation process that synthesizes, converts or changes a sample. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "sample preparation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001183
<http://purl.allotrope.org/ontologies/process#AFP_0001183> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "normal-phase chromatography"^^xsd:string ;
                                                           core:altLabel "NPC"^^xsd:string ,
                                                                         "normal phase chromatography"^^xsd:string ;
                                                           core:definition "A separation method where the components are distributed between two phases, one of which is stationary and polar, while the other is non-polar and moves in a definite direction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "normal-phase chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001185
<http://purl.allotrope.org/ontologies/process#AFP_0001185> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003491> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 1995, 67, 1699 (Nomenclature in evaluation of analytical methods including detection and quantification capabilities (IUPAC Recommendations 1995)) on page 1701"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "quantitative analysis assay"^^xsd:string ;
                                                           core:altLabel "quantitative analysis"^^xsd:string ,
                                                                         "quantitative determination method"^^xsd:string ;
                                                           core:definition "A measurement method which obtains the concentration or quantity of a specified substance in an analyte. [CHMO]"^^xsd:string ;
                                                           core:note "Analyses in which the amount or concentration of an analyte may be determined (estimated) and expressed as a numerical value in appropriate units. Qualitative analysis may take place without quantitative analysis, but quantitative analysis requires the identification (qualification) of the analytes for which numerical estimates are given. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "quantitative analysis assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001192
<http://purl.allotrope.org/ontologies/process#AFP_0001192> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ;
                                                           prop:AFX_0002809 obo:CHMO_0002318 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "liquid-solid chromatography"^^xsd:string ;
                                                           core:altLabel "LSC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid and the stationary phase is a solid. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "liquid-solid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001227
<http://purl.allotrope.org/ontologies/process#AFP_0001227> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "charge transport measurement"^^xsd:string ;
                                                           core:definition "Any technique for measuring charge transport. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "charge transport measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001266
<http://purl.allotrope.org/ontologies/process#AFP_0001266> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "magnetometry"^^xsd:string ;
                                                           core:altLabel "magnetic susceptibility measurements"^^xsd:string ;
                                                           core:definition "The measurement of the strength and/or direction of magnetic fields, or the magnetic susceptibility of a sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "magnetometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001292
<http://purl.allotrope.org/ontologies/process#AFP_0001292> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "oxidation-reduction titration"^^xsd:string ;
                                                           core:altLabel "oxidation-reduction titration"^^xsd:string ,
                                                                         "redox titration"^^xsd:string ;
                                                           core:definition "Oxidation-reduction titration is the process of determining the quantity of a sample by monitoring a redox process until the endpoint, at which essentially all of the sample has reacted, is reached. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "oxidation-reduction titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001319
<http://purl.allotrope.org/ontologies/process#AFP_0001319> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003634> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "sampling material"^^xsd:string ;
                                                           core:altLabel "sample taking"^^xsd:string ,
                                                                         "sampling"^^xsd:string ;
                                                           core:definition "Sampling material is sampling of a material of interest for studying. [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "sampling can be both separating or partitioning or a combination of it"^^xsd:string ;
                                                           core:example "pulling a small sample outside a bioreactor"^^xsd:string ;
                                                           core:prefLabel "sampling material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001321
<http://purl.allotrope.org/ontologies/process#AFP_0001321> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003335> ,
                                                                           obo:OBI_0000011 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "chromatography"^^xsd:string ;
                                                           core:definition "A chromatography is a separation where the components are distributed between two phases, one of which is stationary, while the other moves in a definite direction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001348
<http://purl.allotrope.org/ontologies/process#AFP_0001348> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003315> ,
                                                                           obo:OBI_0000011 ,
                                                                           [ rdf:type owl:Class ;
                                                                             owl:unionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0003566>
                                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003716>
                                                                                         )
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0000395 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000275>
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "synthesis"^^xsd:string ;
                                                           core:changeNote "2019-09-20 Changed subclassing. [Allotrope]"^^xsd:string ;
                                                           core:definition "Synthesis is a planned material process that combines, changes or converts material to produce a new material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "synthesis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001367
<http://purl.allotrope.org/ontologies/process#AFP_0001367> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003312> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003469> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electroporation"^^xsd:string ;
                                                           core:altLabel "electropermeabilization"^^xsd:string ;
                                                           core:definition "A method for introducing polar molecules into a host cell through the cell membrane. A large electric pulse (300-400 mV for <1 ms) temporarily disturbs the phospholipid bilayer, allowing molecules like DNA to pass into the cell. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "electroporation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001404
<http://purl.allotrope.org/ontologies/process#AFP_0001404> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000044> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "optical microscopy"^^xsd:string ;
                                                           core:altLabel "OM"^^xsd:string ,
                                                                         "light microscopy"^^xsd:string ;
                                                           core:definition "A type of microscopy where the specimen is illuminated with visible light and a system of lenses is used to produce an image. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "optical microscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001405
<http://purl.allotrope.org/ontologies/process#AFP_0001405> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "chelatometric titration"^^xsd:string ;
                                                           core:definition "Chelatometric titration is the process of determining the quantity of a sample (metal cation) by adding measured increments of a titrant (a chelating agent) until the end-point, at which essentially all of the sample has reacted, is reached. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "chelatometric titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001410
<http://purl.allotrope.org/ontologies/process#AFP_0001410> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0002361> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "reversed-phase liquid chromatography"^^xsd:string ;
                                                           core:altLabel "RPLC"^^xsd:string ,
                                                                         "reversed phase liquid chromatography"^^xsd:string ;
                                                           core:changeNote "2016-02-03 Removed altLabel [OSTHUS]"^^xsd:string ;
                                                           core:definition "Liquid chromatography where the mobile phase is significantly more polar than the stationary phase, for example a microporous silica-based material with chemically bonded alkyl chains. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "reversed-phase liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001426
<http://purl.allotrope.org/ontologies/process#AFP_0001426> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001348> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "formulation process"^^xsd:string ;
                                                           core:altLabel "formulation"^^xsd:string ;
                                                           core:definition "The process of formulation allows the preparation of mixtures of components in accordance with a formula and documents the composition. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "formulation process"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001427
<http://purl.allotrope.org/ontologies/process#AFP_0001427> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000527> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0002567> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "Murray, K., Boyd, R., Eberlin, M., et al. (2013). Definitions of terms relating to mass spectrometry (IUPAC Recommendations 2013). Pure and Applied Chemistry, 85(7), pp. 1515-1609."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mass spectrometry"^^xsd:string ;
                                                           core:altLabel "MS"^^xsd:string ,
                                                                         "mass spectroscopy"^^xsd:string ;
                                                           core:definition "Mass spectrometry is a spectrometry that studies matter through the formation of gas-phase ions that are characterized using mass spectrometers by their mass, charge, structure, and/or physico-chemical properties. [IUPAC]"^^xsd:string ;
                                                           core:note "Mass spectroscopy is an obsolete synonym for mass spectrometry that should not be used to avoid confusion with spectroscopies in which the measured quantity is the absorption or emission of electromagnetic radiation. [IUPAC]"^^xsd:string ,
                                                                     "The term is a misnomer because it is m/z rather than mass that is the independent variable in a mass spectrum. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "mass spectrometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001457
<http://purl.allotrope.org/ontologies/process#AFP_0001457> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "physical blending"^^xsd:string ;
                                                           core:definition "The process of making a polymer blend by mechanically mixing different polymers together in the melt. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "physical blending"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001462
<http://purl.allotrope.org/ontologies/process#AFP_0001462> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000527> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "scattering spectroscopy"^^xsd:string ;
                                                           core:definition "Any method that measures the amount of light that a substance scatters at certain wavelengths, incident angles, and polarization angles. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "scattering spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001478
<http://purl.allotrope.org/ontologies/process#AFP_0001478> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003367> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "cooling"^^xsd:string ;
                                                           core:definition "The transfer of thermal energy from a material to its surrounding environment. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "cooling"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001499
<http://purl.allotrope.org/ontologies/process#AFP_0001499> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003282> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "differentiation"^^xsd:string ;
                                                           core:definition "The method to obtain the derivative of a function or curve. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "differentiation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001510
<http://purl.allotrope.org/ontologies/process#AFP_0001510> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "acid-base titration"^^xsd:string ;
                                                           core:altLabel "acid/base titration"^^xsd:string ;
                                                           core:definition "Acid-base titration is the process of determining the quantity of a sample (an acid or base) by adding measured increments of a titrant (a base or acid) until the endpoint, at which essentially all of the sample has reacted, is reached. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "acid-base titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001530
<http://purl.allotrope.org/ontologies/process#AFP_0001530> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003336> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "filtration"^^xsd:string ;
                                                           core:definition "The process of segregation of phases; the separation of suspended solids from a liquid or gas, usually by forcing a carrier gas or liquid through a porous medium. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "filtration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001543
<http://purl.allotrope.org/ontologies/process#AFP_0001543> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "liquid-liquid chromatography"^^xsd:string ;
                                                           core:altLabel "LLC"^^xsd:string ,
                                                                         "liquid-liquid chromatography"^^xsd:string ;
                                                           core:definition "Column chromatography where both the mobile phase and the stationary phase are liquids. The stationary phase must be immiscible and insoluble in the mobile phase and is usually supported on a suitable material such as a diatomaceous earth. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "liquid-liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001606
<http://purl.allotrope.org/ontologies/process#AFP_0001606> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003486> ,
                                                                           obo:OBI_0000011 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "equilibration"^^xsd:string ;
                                                           core:definition "Equilibration is the process of bring the state of a system to an equilibrium. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "equilibration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001611
<http://purl.allotrope.org/ontologies/process#AFP_0001611> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003666> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003813> ,
                                                                           [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0003666>
                                                                                                  <http://purl.allotrope.org/ontologies/process#AFP_0003813>
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "injection (chromatography)"^^xsd:string ;
                                                           core:altLabel "injection"^^xsd:string ,
                                                                         "sample introduction"^^xsd:string ;
                                                           core:changeNote "2018-10-24 Moved to chromatography domain ontology, subclassed under loading [Allotrope]"^^xsd:string ,
                                                                           "2022-06-20 Subclassed under sample introduction [Allotrope]"^^xsd:string ;
                                                           core:definition "Process of loading a sample into a chromatography system. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "injection (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001640
<http://purl.allotrope.org/ontologies/process#AFP_0001640> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003357> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "assembling"^^xsd:string ;
                                                           core:altLabel "assembly"^^xsd:string ;
                                                           core:definition "The process of fitting device components together to form a system. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "assembling"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001645
<http://purl.allotrope.org/ontologies/process#AFP_0001645> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "piece counting"^^xsd:string ;
                                                           core:definition "Piece counting is determining the number of objects in an object aggregate. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "piece counting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001649
<http://purl.allotrope.org/ontologies/process#AFP_0001649> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "homogenization"^^xsd:string ;
                                                           core:definition "The intensive mixing of mutually insoluble phases (sometimes with addition of surfactants) to obtain a soluble suspension or emulsion. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "homogenization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001650
<http://purl.allotrope.org/ontologies/process#AFP_0001650> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dielectrometry"^^xsd:string ;
                                                           core:definition "The measurement of the relative permittivity of a solution as a function of concentration. Measurements are made indirectly across the resistance of the solution with alternating current. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "dielectrometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001655
<http://purl.allotrope.org/ontologies/process#AFP_0001655> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000527> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electronic spectroscopy"^^xsd:string ;
                                                           core:definition "Any spectroscopic method which probes the electronic degrees of freedom of an atom or molecule. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "electronic spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001657
<http://purl.allotrope.org/ontologies/process#AFP_0001657> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002421> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "Fourier transform near infrared absorption spectrometry"^^xsd:string ;
                                                           core:altLabel "FT NIRS"^^xsd:string ,
                                                                         "FT-NIRS"^^xsd:string ,
                                                                         "FTNIRS"^^xsd:string ,
                                                                         "Fourier transform near infra-red absorbance spectrometry"^^xsd:string ,
                                                                         "Fourier transform near infra-red absorption spectrometry"^^xsd:string ,
                                                                         "Fourier transform near infra-red spectrometry"^^xsd:string ,
                                                                         "Fourier transform near infra-red spectroscopy"^^xsd:string ,
                                                                         "Fourier transform near infrared absorbance spectrometry"^^xsd:string ,
                                                                         "Fourier transform near infrared absorbance spectroscopy"^^xsd:string ,
                                                                         "Fourier transform near infrared absorption spectroscopy"^^xsd:string ;
                                                           core:definition "A type of spectroscopy where the sample absorbs a single pulse of radiation from the near infrared region (0.8-2 µm) and the spectrum obtained is subject to a Fourier transform. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "Fourier transform near infrared absorption spectrometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001666
<http://purl.allotrope.org/ontologies/process#AFP_0001666> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "densitometry"^^xsd:string ;
                                                           core:altLabel "densiometric measurements"^^xsd:string ,
                                                                         "densiometry"^^xsd:string ,
                                                                         "densitometric measurements"^^xsd:string ;
                                                           core:definition "The measurement of the density of a sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "densitometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001677
<http://purl.allotrope.org/ontologies/process#AFP_0001677> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "chiral chromatography"^^xsd:string ;
                                                           core:definition "A separation method where the components (in this case stereoisomers) are distributed between two chiral phases, one of which is stationary, while the other moves in a definite direction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "chiral chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001698
<http://purl.allotrope.org/ontologies/process#AFP_0001698> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "stirring"^^xsd:string ;
                                                           core:changeNote "2020-06-18 Changed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Stirring is a mixing involving the agitation of a solution through circular motion. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "stirring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001701
<http://purl.allotrope.org/ontologies/process#AFP_0001701> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001993> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "electron ionization"^^xsd:string ;
                                                           core:altLabel "EI"^^xsd:string ,
                                                                         "electron impact"^^xsd:string ,
                                                                         "electron impact ionization"^^xsd:string ;
                                                           core:definition "Electron ionization is a ionization that removes one or more electrons from an atom or molecule through interactions with electrons that are typically accelerated to energies between 10 and 150 eV. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "electron ionization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001707
<http://purl.allotrope.org/ontologies/process#AFP_0001707> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001427> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "G. L. Glish. Analyst 119, 533 (1994)."^^xsd:string ,
                                                                       "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "multiple-stage mass spectrometry"^^xsd:string ;
                                                           core:altLabel "MSn"^^xsd:string ,
                                                                         "MSn spectrometry"^^xsd:string ,
                                                                         "MSn spectroscopy"^^xsd:string ,
                                                                         "multiple-stage mass spectroscopy"^^xsd:string ;
                                                           core:definition "Multiple-stage mass spectrometry is a mass spectrometry where multiple stages of precursor ion m/z selection are followed by product ion detection for successive nth-generation product ions. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "multiple-stage mass spectrometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001719
<http://purl.allotrope.org/ontologies/process#AFP_0001719> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "reversed-phase high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "RHPLC"^^xsd:string ,
                                                                         "RP-HPLC"^^xsd:string ,
                                                                         "gradient reverse HPLC"^^xsd:string ,
                                                                         "gradient reverse high-performance liquid chromatography"^^xsd:string ,
                                                                         "reverse phase  high performance liquid chromatography"^^xsd:string ,
                                                                         "reversed phase high-performance liquid chromatography"^^xsd:string ,
                                                                         "reversed-phase HPLC"^^xsd:string ,
                                                                         "reversed-phase high pressure liquid chromatography"^^xsd:string ,
                                                                         "reversed-phase high-pressure liquid chromatography"^^xsd:string ;
                                                           core:definition "Liquid chromatography where the inlet pressure is relatively high and the mobile phase is significantly more polar than the stationary phase (which consists of very small particles), for example a microporous silica-based material with chemically bonded alkyl chains. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "reversed-phase high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001750
<http://purl.allotrope.org/ontologies/process#AFP_0001750> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001878> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "rinsing"^^xsd:string ;
                                                           core:altLabel "flushing"^^xsd:string ,
                                                                         "purging"^^xsd:string ;
                                                           core:definition "Rinsing is the process of washing quickly a device with a solution. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "rinsing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001756
<http://purl.allotrope.org/ontologies/process#AFP_0001756> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003282> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "Fourier transformation"^^xsd:string ;
                                                           core:altLabel "fourier transformation"^^xsd:string ;
                                                           core:definition "The Fourier transformation decomposes a function of time (e.g. a signal) into the frequencies that make it up. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "Fourier transformation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001760
<http://purl.allotrope.org/ontologies/process#AFP_0001760> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000955> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
                                                           rdfs:label "visible spectrophotometry"^^xsd:string ;
                                                           core:altLabel "optical absorption spectroscopy"^^xsd:string ,
                                                                         "visible spectrometry"^^xsd:string ,
                                                                         "visible spectroscopy"^^xsd:string ;
                                                           core:definition "Spectroscopy where the sample absorbs radiation from the visible region (380-800 nm) resulting in electronic transitions within the sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "visible spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001763
<http://purl.allotrope.org/ontologies/process#AFP_0001763> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "capillary high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "capillary HPLC"^^xsd:string ,
                                                                         "capillary high performance liquid chromatography"^^xsd:string ,
                                                                         "capillary high pressure liquid chromatography"^^xsd:string ,
                                                                         "capillary high-pressure liquid chromatography"^^xsd:string ,
                                                                         "capillary-HPLC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles held in a tube of diameter less than a millimeter, and the inlet pressure is relatively high. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "capillary high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001787
<http://purl.allotrope.org/ontologies/process#AFP_0001787> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002016> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "Fourier transform infrared absorption spectroscopy"^^xsd:string ;
                                                           core:altLabel "FT-IR"^^xsd:string ,
                                                                         "FT-IR spectroscopy"^^xsd:string ,
                                                                         "FTIR"^^xsd:string ,
                                                                         "FTIR spectrometry"^^xsd:string ,
                                                                         "FTIR spectroscopy"^^xsd:string ,
                                                                         "Fourier transform infra-red absorption spectroscopy"^^xsd:string ,
                                                                         "Fourier transform infra-red spectrometry"^^xsd:string ,
                                                                         "Fourier transform infrared (FT-IR)"^^xsd:string ,
                                                                         "Fourier transform infrared (FT-IR) spectroscopy"^^xsd:string ,
                                                                         "Fourier transform infrared spectrometry"^^xsd:string ,
                                                                         "Fourier transform infrared spectroscopy"^^xsd:string ,
                                                                         "Fourier-transform infrared (FTIR) absorption spectroscopy"^^xsd:string ;
                                                           core:definition "Fourier transform infrared spectroscopy is a type of vibrational spectroscopy where the sample absorbs radiation from the infrared region (0.78-1000 µm) and the spectrum obtained is subject to a Fourier transform. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "Fourier transform infrared absorption spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001801
<http://purl.allotrope.org/ontologies/process#AFP_0001801> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003556> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:BFO_0000117 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0003774>
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "imaging assay"^^xsd:string ;
                                                           core:definition "An imaging assay is a physical characterization assay to produce a picture of an entity. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "imaging assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001824
<http://purl.allotrope.org/ontologies/process#AFP_0001824> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003312> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003469> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "aspirating"^^xsd:string ;
                                                           core:altLabel "aspiration"^^xsd:string ;
                                                           core:definition "Aspirating is the process of sample preparation that is to draw an amount of a liquid by suction and then expel the liquid. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "aspirating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001861
<http://purl.allotrope.org/ontologies/process#AFP_0001861> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom obo:PATO_0001842
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "pH measurement"^^xsd:string ;
                                                           core:altLabel "measurement of pH"^^xsd:string ,
                                                                         "pH sensing"^^xsd:string ,
                                                                         "sensing of pH"^^xsd:string ;
                                                           core:definition "The measurement of pH is the negative logarithm to base ten of the hydrogen ion activity in a solution, this measures the degree of acidity or alkalinity. Operationally the pH of a solution X, pH(X), is measured relative to that of a standard reference solution, pH(S), and defined as pH(X) = pH(S) - (E(X) - E(S))/(RT/F)ln 10, where E(X) and E(S) are the electromotive forces measured in cells containing the solution X and the reference solution respectively. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "pH measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001876
<http://purl.allotrope.org/ontologies/process#AFP_0001876> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003473> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "drying"^^xsd:string ;
                                                           core:altLabel "drying"^^xsd:string ,
                                                                         "sample drying"^^xsd:string ;
                                                           core:definition "The process of removing a solvent from a substance. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "drying"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001878
<http://purl.allotrope.org/ontologies/process#AFP_0001878> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000161> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "washing"^^xsd:string ;
                                                           core:definition "Washing is a process by which a material entity acting as contaminant (e.g. excess staining reagent) is removed by application of one or more cycles of solution in flow. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "washing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001909
<http://purl.allotrope.org/ontologies/process#AFP_0001909> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "luminescence measurement"^^xsd:string ;
                                                           core:altLabel "luminescence detection"^^xsd:string ;
                                                           core:changeNote "2018-08-09 Changed definition and pref label. [Allotrope]"^^xsd:string ;
                                                           core:definition "The measurement of luminescence from a material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "luminescence measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001916
<http://purl.allotrope.org/ontologies/process#AFP_0001916> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001185> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "titration"^^xsd:string ;
                                                           core:altLabel "titrimetic analysis"^^xsd:string ,
                                                                         "titrimetry"^^xsd:string ;
                                                           core:definition "Titration is the process of determining the quantity of a sample by adding measured increments of a titrant until the end-point, at which essentially all of the sample has reacted, is reached. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001936
<http://purl.allotrope.org/ontologies/process#AFP_0001936> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000611> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "scanning calorimetry"^^xsd:string ;
                                                           core:definition "The measurement of thermodynamic parameters (e.g. enthalpy) during a chemical or biochemical reaction by the known variation (step-wise or linear) of one variable, whilst a second is kept constant. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "scanning calorimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001951
<http://purl.allotrope.org/ontologies/process#AFP_0001951> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000161> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "priming"^^xsd:string ;
                                                           core:definition "Priming is a type of cleaning that happens at the beginning of a period of time and results in the device being filled with the appropriate reagents. [Allotrope]"^^xsd:string ;
                                                           core:example "prime of a cell counter analyzer at the beginning of a day"^^xsd:string ;
                                                           core:prefLabel "priming"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001953
<http://purl.allotrope.org/ontologies/process#AFP_0001953> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001135> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "inverting"^^xsd:string ;
                                                           core:definition "Inverting is a sample preparation step of mixing. It is homogenization by switching the y-axis of a sample several times, turning it upside down using a syringe. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "inverting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001955
<http://purl.allotrope.org/ontologies/process#AFP_0001955> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000273>
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "coulometry"^^xsd:string ;
                                                           core:definition "An electrochemical technique where the total Coulombs of electricity required to complete (fully oxidize or fully reduce the sample in) an electrochemical reaction is measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "coulometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001986
<http://purl.allotrope.org/ontologies/process#AFP_0001986> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003746> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "coating"^^xsd:string ;
                                                           core:altLabel "coating method"^^xsd:string ;
                                                           core:definition "The application of a thin cover to a material. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "coating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001993
<http://purl.allotrope.org/ontologies/process#AFP_0001993> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003566> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003712> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0000546 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000077>
                                                                           ] ;
                                                           term:source <https://en.wikipedia.org/wiki/Ionization> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "ionization"^^xsd:string ;
                                                           core:altLabel "ionization method"^^xsd:string ;
                                                           core:definition "Ionization is a converting chemical reaction by which an atom or a molecule acquires a negative or positive charge by gaining or losing electrons, often in conjunction with other chemical changes. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "ionization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001994
<http://purl.allotrope.org/ontologies/process#AFP_0001994> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003598> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "trending"^^xsd:string ;
                                                           core:altLabel "monitor"^^xsd:string ,
                                                                         "trend analysis"^^xsd:string ;
                                                           core:definition "Trending is a process of monitoring that consists of collecting information and identifying underlying patterns. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "trending"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002008
<http://purl.allotrope.org/ontologies/process#AFP_0002008> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001707> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "E. de Hoffmann (1996). Tandem Mass Spectrometry: a Primer. Journal of Mass Spectrometry 31: 129–137."^^xsd:string ,
                                                                       "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "selected reaction monitoring"^^xsd:string ;
                                                           core:altLabel "SRM"^^xsd:string ;
                                                           core:definition "Selected reaction monitoring is a multiple-stage mass spectrometry where data acquired from one or more specific product ions corresponding to m/z selected precursor ions are recorded via two or more stages of mass spectrometry. [IUPAC]"^^xsd:string ;
                                                           core:note "Selected reaction monitoring applied to multiple product ions from one or more precursor ions is known as multiple reaction monitoring. [IUPAC]"^^xsd:string ,
                                                                     "Selected reaction monitoring in multiple-stage mass spectrometry is known as consecutive reaction monitoring. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "selected reaction monitoring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002014
<http://purl.allotrope.org/ontologies/process#AFP_0002014> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "planar chromatography"^^xsd:string ;
                                                           core:altLabel "open bed chromatography"^^xsd:string ,
                                                                         "open-bed chromatography"^^xsd:string ;
                                                           core:definition "A chromatography method where the stationary phase is present as or on a plane. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "planar chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002016
<http://purl.allotrope.org/ontologies/process#AFP_0002016> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000780> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "infrared absorption spectroscopy"^^xsd:string ;
                                                           core:altLabel "IR"^^xsd:string ,
                                                                         "IR absorption spectrometry"^^xsd:string ,
                                                                         "IR absorption spectroscopy"^^xsd:string ,
                                                                         "IR spectrometry"^^xsd:string ,
                                                                         "IR spectrophotometry"^^xsd:string ,
                                                                         "IR spectroscopy"^^xsd:string ,
                                                                         "infra-red absorption spectrometry"^^xsd:string ,
                                                                         "infra-red absorption spectroscopy"^^xsd:string ,
                                                                         "infra-red spectrometry"^^xsd:string ,
                                                                         "infra-red spectrophotometry"^^xsd:string ,
                                                                         "infrared (IR) spectroscopy"^^xsd:string ,
                                                                         "infrared absorption spectrometry"^^xsd:string ,
                                                                         "infrared spectrometry"^^xsd:string ,
                                                                         "infrared spectrophotometry"^^xsd:string ,
                                                                         "infrared spectroscopy"^^xsd:string ;
                                                           core:definition "Infrared absorption spectroscopy is a type of vibrational spectroscopy where the sample absorbs radiation from the infrared region. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "infrared absorption spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002033
<http://purl.allotrope.org/ontologies/process#AFP_0002033> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "normal-phase high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "NP-HPLC"^^xsd:string ,
                                                                         "normal phase HPLC"^^xsd:string ,
                                                                         "normal-phase HPLC"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid,  the stationary phase consists of very small particles, and the inlet pressure is relatively high. In normal-phase HPLC, the stationary phase is more polar than the mobile phase. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "normal-phase high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002059
<http://purl.allotrope.org/ontologies/process#AFP_0002059> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "ultra high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "RRLC"^^xsd:string ,
                                                                         "RSLC"^^xsd:string ,
                                                                         "UFLC"^^xsd:string ,
                                                                         "UHPLC"^^xsd:string ,
                                                                         "UPLC"^^xsd:string ,
                                                                         "rapid resolution liquid chromatography"^^xsd:string ,
                                                                         "rapid separation liquid chromatography"^^xsd:string ,
                                                                         "ultra fast liquid chromatography"^^xsd:string ,
                                                                         "ultra performance liquid chromatography"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small (< 2 µm) particles and the inlet pressure is relatively high. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "ultra high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002065
<http://purl.allotrope.org/ontologies/process#AFP_0002065> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "interferometry"^^xsd:string ;
                                                           core:altLabel "laser interferometry"^^xsd:string ,
                                                                         "optical interferometry"^^xsd:string ;
                                                           core:definition "The measurement of the properties of two or more lasers or waves by studying the pattern of interference created by their superposition. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "interferometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002089
<http://purl.allotrope.org/ontologies/process#AFP_0002089> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003598> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "chromatography data processing"^^xsd:string ;
                                                           core:changeNote "2019-09-09 Moved under data transformation and fixed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Chromatography data processing is a data transformation on chromatograms. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "chromatography data processing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002103
<http://purl.allotrope.org/ontologies/process#AFP_0002103> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002573> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "J. B. Fenn, M. Mann, C. K. Meng, S. F. Wong, C. M. Whitehouse. Science 246, 64 (1989)."^^xsd:string ,
                                                                       "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ,
                                                                       "M. Dole, L. L. Mack, R. L. Hines, R. C. Mobley, L. D. Ferguson, M. B. Alice. J. Chem. Phys. 49, 2240 (1968)."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "electrospray ionization"^^xsd:string ;
                                                           core:altLabel "ESI"^^xsd:string ,
                                                                         "ionspray"^^xsd:string ;
                                                           core:definition "Spray ionization process in which either cations or anions in solution are transferred to the gas phase via formation and desolvation at atmospheric pressure of a stream of highly charged droplets that result from applying a potential difference between the tip of the electrospray needle containing the solution and a counter electrode. [IUPAC]"^^xsd:string ;
                                                           core:note "The term ionspray is deprecated unless describing the commercial product."^^xsd:string ;
                                                           core:prefLabel "electrospray ionization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002122
<http://purl.allotrope.org/ontologies/process#AFP_0002122> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "tensiometry"^^xsd:string ;
                                                           core:altLabel "surface tensiometry"^^xsd:string ;
                                                           core:definition "The measurement of the surface tension of a liquid. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "tensiometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002124
<http://purl.allotrope.org/ontologies/process#AFP_0002124> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001936> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\"). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997). Online version (2019-) created by S. J. Chalk. ISBN 0-9678550-9-8. https://doi.org/10.1351/goldbook."^^xsd:string ,
                                                                       "Nomenclature for thermal analysis - IV (Recommendations 1985), Mackenzie, R.C., Pure and Applied Chemistry 1985, 57(11), 1737"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "differential scanning calorimetry"^^xsd:string ;
                                                           core:altLabel "DSC"^^xsd:string ,
                                                                         "differential scanning calorimetric (DSC) analysis"^^xsd:string ,
                                                                         "differential scanning calorimetric analysis"^^xsd:string ;
                                                           core:definition "Differential scanning calorimetry is a thermal analysis method in which the difference in energy inputs into a substance and a reference material is measured as a function of temperature whilst the substance and reference material are subjected to a controlled temperature program. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "differential scanning calorimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002142
<http://purl.allotrope.org/ontologies/process#AFP_0002142> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "hydrophobic interaction chromatography"^^xsd:string ;
                                                           core:altLabel "HIC"^^xsd:string ;
                                                           core:definition "Separation using HIC is based on the reversible interaction between a protein and the hydrophobic ligand bound to the chromatography matrix. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "hydrophobic interaction chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002171
<http://purl.allotrope.org/ontologies/process#AFP_0002171> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "viscometry"^^xsd:string ;
                                                           core:definition "The measurement of the viscosity of fluids by observing the relative motion of the fluid and an object. Viscometry is used to measure the molecular weight of polymers. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "viscometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002185
<http://purl.allotrope.org/ontologies/process#AFP_0002185> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003368> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "concentrating"^^xsd:string ;
                                                           core:altLabel "preconcentration"^^xsd:string ;
                                                           core:definition "A preparative step where the concentration of one component is increased. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "concentrating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002188
<http://purl.allotrope.org/ontologies/process#AFP_0002188> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electronic absorbance measurement"^^xsd:string ;
                                                           core:altLabel "electronic absorbance measuring"^^xsd:string ,
                                                                         "electronic absorption detection"^^xsd:string ;
                                                           core:definition "Electronic absorption measurement is a measurement that is based on the absorption of energy by electronic transitions. [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "Detecting has some overlap with measuring. Usually measuring is the way detecting works, but detection as response from a sensor without quantitation is also possible. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "electronic absorbance measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002204
<http://purl.allotrope.org/ontologies/process#AFP_0002204> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003312> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "passaging"^^xsd:string ;
                                                           core:altLabel "subculturing"^^xsd:string ;
                                                           core:definition "In biology, a subculture is a new cell or microbiological culture made by transferring some or all cells from a previous culture to fresh growth medium. This action is called subculturing or passaging the cells. Subculture is used to prolong the life and/or expand the number of cells or microorganisms in the culture. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "passaging"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002206
<http://purl.allotrope.org/ontologies/process#AFP_0002206> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000057>
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "thermal conductivity measurement"^^xsd:string ;
                                                           core:altLabel "TCD"^^xsd:string ,
                                                                         "thermal conductivity detection"^^xsd:string ,
                                                                         "thermal conductivity measuring"^^xsd:string ;
                                                           core:changeNote "2018-08-09 Moved under measurement, and changed pref label [Allotrope]"^^xsd:string ;
                                                           core:definition "A measuring that is sensitive to inorganic gases. A hot (450 deg. C) filament is used to heat a carrier gas containing the sample and the difference in thermal conductivity caused by the presence of the sample is measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "thermal conductivity measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002211
<http://purl.allotrope.org/ontologies/process#AFP_0002211> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002680> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "magnetic resonance assay"^^xsd:string ;
                                                           core:altLabel "magnetic resonance method"^^xsd:string ;
                                                           core:definition "A magnetic resonance assay is an assay that applies a technique which detects the response of spins to a perturbing magnetic field. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "magnetic resonance assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002212
<http://purl.allotrope.org/ontologies/process#AFP_0002212> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003556> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "clinical measurement method"^^xsd:string ;
                                                           core:altLabel "clinical measurement"^^xsd:string ;
                                                           core:definition "A quantitative or qualitative value which is the result of an act of assessing a morphological or physiological state or property in a single individual or sample or a group of individuals or samples, based on direct observation or experimental manipulation. [CMO]"^^xsd:string ;
                                                           core:prefLabel "clinical measurement method"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002216
<http://purl.allotrope.org/ontologies/process#AFP_0002216> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001185> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "oximetry"^^xsd:string ;
                                                           core:definition "Any technique used to measure the levels of oxygen in a sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "oximetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002224
<http://purl.allotrope.org/ontologies/process#AFP_0002224> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000925> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "separation method-detection method"^^xsd:string ;
                                                           core:definition "An experiment in which a separation method is coupled to a detection method in order to detect one or more different components of a sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "separation method-detection method"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002228
<http://purl.allotrope.org/ontologies/process#AFP_0002228> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000266> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
                                                           rdfs:label "ultraviolet-visible-near infrared spectrophotometry"^^xsd:string ;
                                                           core:altLabel "UV-VIS-NIR"^^xsd:string ,
                                                                         "UV-VIS-NIR spectrophotometry"^^xsd:string ,
                                                                         "UV-Vis-NIR"^^xsd:string ,
                                                                         "UV-Vis-NIR absorption spectroscopy"^^xsd:string ,
                                                                         "UV-Vis-NIR spectroscopy"^^xsd:string ,
                                                                         "UV-vis-NIR absorption spectroscopy"^^xsd:string ,
                                                                         "UV-visible-near IR absorption spectroscopy"^^xsd:string ,
                                                                         "UV-visible-near IR spectroscopy"^^xsd:string ,
                                                                         "ultraviolet-visible-near infrared absorption spectroscopy"^^xsd:string ,
                                                                         "ultraviolet-visible-near infrared spectrophotometry"^^xsd:string ,
                                                                         "ultraviolet-visible-near infrared spectroscopy"^^xsd:string ;
                                                           core:definition "Spectroscopy where the sample absorbs radiation in the range ultraviolet to near-infrared (190-2000 nm) resulting in electronic transitions within the sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "ultraviolet-visible-near infrared spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002239
<http://purl.allotrope.org/ontologies/process#AFP_0002239> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000292>
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "refractive index measurement"^^xsd:string ;
                                                           core:altLabel "RI detection"^^xsd:string ,
                                                                         "RID"^^xsd:string ,
                                                                         "refractive index detection"^^xsd:string ,
                                                                         "refractive index measuring"^^xsd:string ;
                                                           core:changeNote "2018-08-09 Moved under measurement, and changed pref label [Allotrope]"^^xsd:string ,
                                                                           "2020-11-12 Changed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "A refractive index measurement is a measuring based on the change in refractive index of a solution. Light is passed through a hollow prism and focused on a photocell. When a liquid containing the sample is allowed to flow through the prism, the light diverges from its original path and the change in intensity and angle of the transmitted light is measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "refractive index measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002243
<http://purl.allotrope.org/ontologies/process#AFP_0002243> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "chiral stationary phase high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "CSP HPLC"^^xsd:string ,
                                                                         "CSP-HPLC"^^xsd:string ,
                                                                         "HPLC on a chiral stationary phase"^^xsd:string ,
                                                                         "chiral HPLC"^^xsd:string ,
                                                                         "chiral stationary phase high-pressure liquid chromatography"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small chiral particles and the inlet pressure is relatively high. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "chiral stationary phase high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002276
<http://purl.allotrope.org/ontologies/process#AFP_0002276> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000780> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "infrared transmission spectroscopy"^^xsd:string ;
                                                           core:altLabel "IR transmission spectroscopy"^^xsd:string ,
                                                                         "IR transmittance spectroscopy"^^xsd:string ,
                                                                         "infrared transmittance spectroscopy"^^xsd:string ,
                                                                         "transmission IR"^^xsd:string ;
                                                           core:definition "Infrared transmission spectroscopy is a type of vibrational spectroscopy where the transmission of infrared radiation (0.78-1000 µm) through a sample is detected. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "infrared transmission spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002293
<http://purl.allotrope.org/ontologies/process#AFP_0002293> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003349> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "sonication"^^xsd:string ;
                                                           core:definition "The irradiation of a liquid sample with sound (20-20 000 Hz) waves resulting in agitation. Sound waves propagate into the liquid media result in alternating high-pressure (compression) and low-pressure (rarefaction) cycles. During rarefaction, high-intensity sonic waves create small vacuum bubbles or voids in the liquid, which then collapse violently (cavitation) during compression, creating very high local temperatures. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "sonication"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002294
<http://purl.allotrope.org/ontologies/process#AFP_0002294> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002849> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003305> ,
                                                                           obo:OBI_0000011 ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0000395 ;
                                                                             owl:someValuesFrom obo:IAO_0000030
                                                                           ] ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0000399 ;
                                                                             owl:someValuesFrom obo:BFO_0000001
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source <https://jcgm.bipm.org/vim/en/2.1.html> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "measuring"^^xsd:string ;
                                                           core:altLabel "measurement"^^xsd:string ;
                                                           core:changeNote "2018-08-09 Changed definition [Allotrope]"^^xsd:string ;
                                                           core:definition "Measuring is observing a property of an entity called a quantity, that has a magnitude that can be expressed as a number and a reference to another entity, and obtaining one or more quantity values for it. The observed entity is a quality or a disposition for a continuant, for a process it is a process property such as duration. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "measuring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002296
<http://purl.allotrope.org/ontologies/process#AFP_0002296> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000307> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003598> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "data apodization"^^xsd:string ;
                                                           core:altLabel "data massaging"^^xsd:string ;
                                                           core:definition "A term used meaning the processing and manipulation of the spectral data produced for the purposes of improving spectral appearance, change the signal to noise ratio (S/N), or resolution. The term is often collectively used in conjunction with line broadening, sharpening, averaging, smoothing. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "data apodization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002305
<http://purl.allotrope.org/ontologies/process#AFP_0002305> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "capillary liquid chromatography"^^xsd:string ;
                                                           core:altLabel "cap-LC"^^xsd:string ,
                                                                         "capLC"^^xsd:string ;
                                                           core:definition "Chromatography which takes place in a separation capillary and where the mobile phase is a liquid. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "capillary liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002309
<http://purl.allotrope.org/ontologies/process#AFP_0002309> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "colorimetry"^^xsd:string ;
                                                           core:altLabel "colorimetric method"^^xsd:string ,
                                                                         "colourimetry"^^xsd:string ;
                                                           core:definition "The determination of the spectral absorbance of a solution. This method is often used to determine the concentration of a chemical in a solution. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "colorimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002313
<http://purl.allotrope.org/ontologies/process#AFP_0002313> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003556> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "thermal analysis"^^xsd:string ;
                                                           core:altLabel "thermal analysis method"^^xsd:string ;
                                                           core:definition "Thermal analysis is any measurement technique in which a physical property of the sample is measured as a function of temperature. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "thermal analysis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002314
<http://purl.allotrope.org/ontologies/process#AFP_0002314> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "displacement chromatography"^^xsd:string ;
                                                           core:definition "Chromatography where the mobile phase contains a compound (the displacer) more strongly retained than the components of the sample under examination. The sample is fed into the system as a finite slug. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "displacement chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002328
<http://purl.allotrope.org/ontologies/process#AFP_0002328> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0001183> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "normal-phase liquid chromatography"^^xsd:string ;
                                                           core:definition "Liquid chromatography where the stationary phase is more polar than the mobile phase. This is the default for liquid chromatography. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "normal-phase liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002361
<http://purl.allotrope.org/ontologies/process#AFP_0002361> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "reversed-phase chromatography"^^xsd:string ;
                                                           core:altLabel "RPC"^^xsd:string ,
                                                                         "reverse phase chromatography"^^xsd:string ,
                                                                         "reverse-phase chromatography"^^xsd:string ,
                                                                         "reversed phase chromatography"^^xsd:string ;
                                                           core:definition "A separation method where the components are distributed between two phases, one of which is stationary and non-polar, while the other is polar and moves in a definite direction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "reversed-phase chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002389
<http://purl.allotrope.org/ontologies/process#AFP_0002389> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003599> ,
                                                                           obo:OBI_0000011 ;
                                                           term:source <https://en.wikipedia.org/wiki/Calibration> ,
                                                                       "JCGM 200:2008 International vocabulary of metrology — Basic and general concepts and associated terms (VIM)"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "calibration"^^xsd:string ;
                                                           core:definition "Calibration is the comparison of measurement values delivered by a device under test with those of a calibration standard of known accuracy. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "calibration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002397
<http://purl.allotrope.org/ontologies/process#AFP_0002397> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003838> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "pipeting"^^xsd:string ;
                                                           core:definition "Pipeting transfers a given amount of liquid solution using a pipette, dropper or pipettor. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "pipeting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002421
<http://purl.allotrope.org/ontologies/process#AFP_0002421> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000780> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "near infrared absorption spectroscopy"^^xsd:string ;
                                                           core:altLabel "NIR absorbance spectrometry"^^xsd:string ,
                                                                         "NIR absorbance spectroscopy"^^xsd:string ,
                                                                         "NIRS"^^xsd:string ,
                                                                         "near infra-red absorbance spectrometry"^^xsd:string ,
                                                                         "near infra-red absorbance spectroscopy"^^xsd:string ,
                                                                         "near infra-red absorption spectrometry"^^xsd:string ,
                                                                         "near infra-red spectrometry"^^xsd:string ,
                                                                         "near infrared absorbance spectrometry"^^xsd:string ,
                                                                         "near infrared absorbance spectroscopy"^^xsd:string ,
                                                                         "near infrared absorption spectrometry"^^xsd:string ,
                                                                         "near infrared spectrometry"^^xsd:string ,
                                                                         "near infrared spectroscopy"^^xsd:string ,
                                                                         "near-infrared absorption spectroscopy"^^xsd:string ;
                                                           core:definition "Near infrared absorption spectroscopy is a type of vibrational spectroscopy where the sample absorbs radiation from the near infrared region (0.8-2 µm). [CHMO]"^^xsd:string ;
                                                           core:prefLabel "near infrared absorption spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002423
<http://purl.allotrope.org/ontologies/process#AFP_0002423> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000748> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "ion-exchange high-performance liquid chromatography"^^xsd:string ;
                                                           core:altLabel "IE-HPLC"^^xsd:string ,
                                                                         "IEX-HPLC"^^xsd:string ,
                                                                         "ion exchange HPLC"^^xsd:string ,
                                                                         "ion exchange high performance liquid chromatography"^^xsd:string ,
                                                                         "ion-exchange HPLC"^^xsd:string ,
                                                                         "ion-exchange high-pressure liquid chromatography"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles, the inlet pressure is relatively high and the separation is caused by differences in ion-exchange affinity. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "ion-exchange high-performance liquid chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002434
<http://purl.allotrope.org/ontologies/process#AFP_0002434> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "velocimetry"^^xsd:string ;
                                                           core:definition "The measurement of the velocity of a moving object or medium. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "velocimetry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002437
<http://purl.allotrope.org/ontologies/process#AFP_0002437> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001427> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "selected ion monitoring"^^xsd:string ;
                                                           core:altLabel "SIM"^^xsd:string ,
                                                                         "SIR"^^xsd:string ,
                                                                         "selected ion recording"^^xsd:string ;
                                                           core:definition "Selected ion monitoring is mass spectrometry where the abundances of ions of one or more specific m/z values are recorded rather than the entire mass spectrum. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "selected ion monitoring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002484
<http://purl.allotrope.org/ontologies/process#AFP_0002484> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "headspace chromatography"^^xsd:string ;
                                                           core:definition "Headspace chromatography is a type of chromatography that uses the gaseous headspace above a sample for analysis because very light volatiles can be efficiently partitioned as they diffuse to the gas volume above. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "headspace chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002515
<http://purl.allotrope.org/ontologies/process#AFP_0002515> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001146> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "mass spectrometry scan"^^xsd:string ;
                                                           core:definition "A mass spectrometry scan is a scan in a mass spectrometry run. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "mass spectrometry scan"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002535
<http://purl.allotrope.org/ontologies/process#AFP_0002535> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002008> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "multiple reaction monitoring"^^xsd:string ;
                                                           core:altLabel "MRM"^^xsd:string ;
                                                           core:definition "Multiple reaction monitoring is a selected reaction monitoring applied to multiple product ions from one or more precursor ions. [IUPAC]"^^xsd:string ;
                                                           core:note "This term should not be confused with consecutive reaction monitoring, which involves the serial application of three or more stages of selected reaction monitoring. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "multiple reaction monitoring"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002541
<http://purl.allotrope.org/ontologies/process#AFP_0002541> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000925> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "ion detection"^^xsd:string ;
                                                           core:definition "Ion detection is detecting the presence of ions. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ion detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002567
<http://purl.allotrope.org/ontologies/process#AFP_0002567> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC. Analytical Division. Compendium of Analytical Nomenclature (the Orange Book). Definitive Rules, 1979"^^xsd:string ,
                                                                       "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the Gold Book). Compiled by A. D. McNaught and A.Wilkinson. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ,
                                                                       "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "mass analysis"^^xsd:string ;
                                                           core:definition "Mass analysis is a measuring process by which a mixture of ionic or neutral species is identified according to their m/z values (ions), or their aggregate atomic masses (neutrals), and their relative abundances. The analysis may be qualitative and/or quantitative. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "mass analysis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002573
<http://purl.allotrope.org/ontologies/process#AFP_0002573> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001993> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "spray ionization"^^xsd:string ;
                                                           core:definition "Spray ionization is a ionization that involve dispersing the liquid into fine droplets as a component step. [IUPAC]"^^xsd:string ;
                                                           core:note "Most of these techniques are examples of atmospheric pressure ionization. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "spray ionization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002655
<http://purl.allotrope.org/ontologies/process#AFP_0002655> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001321> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "mixed-mode chromatography"^^xsd:string ;
                                                           core:altLabel "multimodal chromatography"^^xsd:string ;
                                                           core:definition "Mixed-mode chromatography (MMC), or multimodal chromatography, refers to chromatographic methods that utilize more than one form of interaction between the stationary phase and analytes in order to achieve separation. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "mixed-mode chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002662
<http://purl.allotrope.org/ontologies/process#AFP_0002662> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000307> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "signal averaging"^^xsd:string ;
                                                           core:definition "Signal averaging is a process of combining spectra of repeated measurements in order to improve the signal-to-noise ratio. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "signal averaging"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002666
<http://purl.allotrope.org/ontologies/process#AFP_0002666> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "background measurement"^^xsd:string ;
                                                           core:definition "Background measurement is the process of determination of the base level of signals without presence of a sample. [Allotrope]"^^xsd:string ;
                                                           core:example "background measurement of particle sizing in order to measure the electrical noise as well as laser scattering due to contamination of the optical parts or the dispersant"^^xsd:string ;
                                                           core:prefLabel "background measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002668
<http://purl.allotrope.org/ontologies/process#AFP_0002668> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003490> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "hardness test"^^xsd:string ;
                                                           core:altLabel "tablet hardness testing"^^xsd:string ;
                                                           core:definition "Tablet hardness testing is a laboratory technique used by the pharmaceutical industry to test the breaking point and structural integrity of a tablet under conditions of storage, transportation, and handling before usage. [Wikipedia]"^^xsd:string ;
                                                           core:note "Tablet hardness is a measure of robustness to further processing such as film coating. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "hardness test"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0002670
<http://purl.allotrope.org/ontologies/process#AFP_0002670> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003321> ,
