###  http://purl.obolibrary.org/obo/PATO_0002070
obo:PATO_0002070 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "affinity"^^xsd:string ;
                 core:definition "Affinity is a molecular quality that arises from the molecular attraction exerted between two atoms or compounds. [PATO]"^^xsd:string ;
                 core:prefLabel "affinity"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002186
obo:PATO_0002186 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "polarity (molecular quality)"^^xsd:string ;
                 core:altLabel "polarity"^^xsd:string ;
                 core:definition "Polarity is a  molecular quality that inheres in a molecular entity by virtue of whether or not the molecular entity has a separation of electric charge which leads to the molecule having an electric dipole. [PATO]"^^xsd:string ;
                 core:prefLabel "polarity (molecular quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002193
obo:PATO_0002193 rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( obo:PATO_0002194
                                                     obo:PATO_0002195
                                                     obo:PATO_0002196
                                                   )
                                     ] ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "electric charge (molecular quality)"^^xsd:string ;
                 core:altLabel "charge"^^xsd:string ,
                               "electric charge"^^xsd:string ;
                 core:definition "Electric charge is a molecular quality that inheres in a molecular entity by virtue of the overall electric charge of the molecule, which is due to a comparison between the total number of electrons and the total number of protons. [PATO]"^^xsd:string ;
                 core:prefLabel "electric charge (molecular quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002194
obo:PATO_0002194 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0002193 ;
                 owl:disjointWith obo:PATO_0002195 ,
                                  obo:PATO_0002196 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "neutral charge"^^xsd:string ;
                 core:altLabel "neutral"^^xsd:string ;
                 core:definition "Neutral charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing the same amount of electrons overall as protons, thus having an overall neutral charge. [PATO]"^^xsd:string ;
                 core:prefLabel "neutral charge"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002195
obo:PATO_0002195 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0002193 ;
                 owl:disjointWith obo:PATO_0002196 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "positive charge"^^xsd:string ;
                 core:altLabel "positive"^^xsd:string ;
                 core:definition "Positive charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more protons overall than electrons, thus having an overall positive charge. [PATO]"^^xsd:string ;
                 core:prefLabel "positive charge"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002196
obo:PATO_0002196 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0002193 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                 rdfs:label "negative charge"^^xsd:string ;
                 core:altLabel "negative"^^xsd:string ;
                 core:definition "Negative charge is a quality which inheres in a molecular entity by virtue of the molecular entity possessing more electrons overall than protons, thus having an overall negative charge. [PATO]"^^xsd:string ;
                 core:prefLabel "negative charge"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002242
obo:PATO_0002242 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001906 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "velocity"^^xsd:string ;
                 core:definition "A physical quality inhering in a bearer by virtue of the bearer's rate of change of the position. [PATO]"^^xsd:string ;
                 core:prefLabel "velocity"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002243
obo:PATO_0002243 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001574 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "fluid flow rate (quality)"^^xsd:string ;
                 core:altLabel "fluid flow rate"^^xsd:string ,
                               "volume flow rate"^^xsd:string ,
                               "volumetric flow rate"^^xsd:string ;
                 core:changeNote "2019-09-20 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ;
                 core:definition "A physical quality inhering in a fluid (liquid or gas) by virtue of the amount of fluid which passes through a given surface per unit time. [PATO]"^^xsd:string ;
                 core:prefLabel "fluid flow rate (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002244
obo:PATO_0002244 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001574 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "mass flow rate (quality)"^^xsd:string ;
                 core:altLabel "mass flow rate"^^xsd:string ;
                 core:changeNote "2019-09-20 Changed pref label for uniqueness. [Allotrope]"^^xsd:string ;
                 core:definition "A flow rate quality inhering in a substance by virtue of the mass of substance which passes through a given surface per unit time. [PATO]"^^xsd:string ;
                 core:prefLabel "mass flow rate (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0002390
obo:PATO_0002390 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000122 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "radius (quality)"^^xsd:string ;
                 core:altLabel "radius"^^xsd:string ;
                 core:changeNote "2019-08-19 Changed pref label. [Allotrope]"^^xsd:string ;
                 core:definition "A length quality which is equal to the length of any straight line segment that passes from the center of a circle to any endpoint on the circular boundary. The radius is half of the diameter. [PATO]"^^xsd:string ;
                 core:prefLabel "radius (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0015009
obo:PATO_0015009 rdf:type owl:Class ;
                 rdfs:subClassOf obo:BFO_0000019 ;
                 prop:AFX_0002865 obo:pato.owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "humidity (quality)"^^xsd:string ;
                 core:altLabel "humidity"^^xsd:string ;
                 core:definition "A quality inhering in air by virtue of the partial pressure exerted by the bearer's water vapour content. [PATO]"^^xsd:string ;
                 core:prefLabel "humidity (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/RO_0002577
obo:RO_0002577 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000040 ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/system> ;
               rdfs:label "system"^^xsd:string ;
               core:definition "A material entity consisting of multiple components that are causally integrated. [RO]"^^xsd:string ;
               core:prefLabel "system"^^xsd:string .


