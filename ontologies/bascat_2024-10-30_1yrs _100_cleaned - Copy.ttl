                                                          rdfs:label "temporal coordination"^^xsd:string ;
                                                          core:definition "A temporal coordination is a class coordination that coordinates a class with a temporal aspect. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "temporal coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001634
<http://purl.allotrope.org/ontologies/result#AFR_0001634> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
