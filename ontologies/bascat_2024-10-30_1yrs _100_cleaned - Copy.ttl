   owl:annotatedProperty obo:IAO_0000601 ;
   owl:annotatedTarget "if b is a continuant and if, for some t, cis continuant_part of b at t, then c is a continuant. (axiom label in BFO2 Reference: [009-002])"^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/009-002>
 ] .

