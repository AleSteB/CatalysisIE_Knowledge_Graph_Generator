<http://purl.obolibrary.org/obo/chebi#has_parent_hydride> rdf:type owl:ObjectProperty ;
                                                          oboI:hasOBONamespace "chebi_ontology"^^xsd:string ;
                                                          oboI:id "has_parent_hydride"^^xsd:string ;
                                                          oboI:is_cyclic "false"^^xsd:boolean ;
                                                          oboI:is_transitive "false"^^xsd:boolean ;
                                                          rdfs:label "has parent hydride"^^xsd:string .


###  http://purl.obolibrary.org/obo/chebi#is_conjugate_acid_of
