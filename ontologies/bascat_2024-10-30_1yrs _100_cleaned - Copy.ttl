obo:CHEBI_77182 rdf:type owl:Class ;
                rdfs:subClassOf obo:CHEBI_64047 ;
                obo:IAO_0000115 "A food additive that imparts colour to food. In European countries, E-numbers for permitted food colours are from E 100 to E 199, divided into yellows (E 100-109), oranges (E 110-119), reds (E 120-129), blues and violets (E 130-139), greens (E 140-149), browns and blacks (E 150-159), and others (E 160-199)."^^xsd:string ;
