                                                                           "liquid chromatography device"^^xsd:string ,
                                                                           "low pressure liquid chromatography device"^^xsd:string ;
                                                             core:changeNote "2019-07-03 Changed alt labels from system to device [Allotrope]"^^xsd:string ,
                                                                             "2020-03-20 Changed equivalentClass to subClass. [Allotrope]"^^xsd:string ;
                                                             core:definition "A liquid chromatograph is a system used to perform bioseparation techniques that are based on interactions of the sample with the mobile and stationary phases. [Allotrope]"^^xsd:string ;
