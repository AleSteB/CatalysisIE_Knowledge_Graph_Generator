                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                             rdfs:label "electrolytic conductivity detector"^^xsd:string ;
                                                             core:altLabel "ECD"^^xsd:string ,
                                                                           "Hall electrolytic conductivity detector"^^xsd:string ;
                                                             core:changeNote "2018-08-09 Moved under measuring device, detection is only secondary. [Allotrope]"^^xsd:string ;
                                                             core:definition "A conductivity probe to calculate the conductance value of a material at the selected reference temperature. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "electrolytic conductivity detector"^^xsd:string .


