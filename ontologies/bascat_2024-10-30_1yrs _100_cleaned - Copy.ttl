                 core:prefLabel "electromagnetic radiation quality"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001300
obo:PATO_0001300 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0001291 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
