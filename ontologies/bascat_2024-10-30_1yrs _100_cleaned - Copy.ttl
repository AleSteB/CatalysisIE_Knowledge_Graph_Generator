                                                           core:prefLabel "circularity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000361
<http://purl.allotrope.org/ontologies/quality#AFQ_0000361> rdf:type owl:Class ;
