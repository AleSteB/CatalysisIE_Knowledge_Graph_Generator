                                                           core:altLabel "specular reflection"^^xsd:string ;
                                                           core:definition "Gloss is an optical property which indicates how well a surface reflects light in a specular (mirror-like) direction. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "gloss (quality)"^^xsd:string .


