                                                                        "inelastic tunnelling spectra"^^xsd:string ,
                                                                        "inelastic tunnelling spectrum"^^xsd:string ;
                                                          core:definition "A plot of current (or a first or higher derivative of current with respect to voltage) vs. voltage obtained by measuring the tunneling current through a metal-oxide-metal sandwich. Molecules are adsorbed onto the oxide and these molecules can affect the tunneling via the excitation of vibrational states. [CHMO]"^^xsd:string ;
                                                          core:prefLabel "inelastic tunneling spectrum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000297
<http://purl.allotrope.org/ontologies/result#AFR_0000297> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
