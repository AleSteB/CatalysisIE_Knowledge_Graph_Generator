                                                                             ] ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "dilution role"^^xsd:string ;
                                                         core:changeNote "2022-06-23 Change to subclasses to equivalent class. [Allotrope]"^^xsd:string ;
                                                         core:definition "The role of a portion of material that participates in a dilution process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "dilution role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000299
<http://purl.allotrope.org/ontologies/role#AFRL_0000299> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000043> ;
