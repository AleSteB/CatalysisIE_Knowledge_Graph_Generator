                                                           rdfs:label "membership"^^xsd:string ;
                                                           core:definition "Membership is the relational quality between a group or organization and its members. [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "This is the structural aspect of membership. There is also a temporal aspect of being member of (membership state)."^^xsd:string ;
                                                           core:prefLabel "membership"^^xsd:string .


