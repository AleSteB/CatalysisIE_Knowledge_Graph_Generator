###  http://www.w3.org/2004/02/skos/core#Collection
core:Collection rdf:type owl:Class ;
                rdfs:subClassOf owl:Thing ;
                owl:disjointWith core:Concept ,
                                 core:ConceptScheme ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                 <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "Collection"^^xsd:string ;
                core:definition "A meaningful collection of concepts."^^xsd:string ;
                core:scopeNote "Labelled collections can be used where you would like a set of concepts to be displayed under a 'node label' in the hierarchy."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#Concept
core:Concept rdf:type owl:Class ;
             rdfs:subClassOf owl:Thing ;
             owl:disjointWith core:ConceptScheme ;
             rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                              <http://www.w3.org/2004/02/skos/core> ;
             rdfs:label "Concept"^^xsd:string ;
             core:definition "An idea or notion; a unit of thought."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
core:ConceptScheme rdf:type owl:Class ;
                   rdfs:subClassOf owl:Thing ;
                   rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                    <http://www.w3.org/2004/02/skos/core> ;
                   rdfs:label "Concept Scheme"^^xsd:string ;
                   core:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."^^xsd:string ;
                   core:example "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."^^xsd:string ;
                   core:scopeNote "A concept scheme may be defined to include concepts from different sources."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#OrderedCollection
core:OrderedCollection rdf:type owl:Class ;
                       rdfs:subClassOf core:Collection ;
                       rdfs:isDefinedBy <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                        <http://www.w3.org/2004/02/skos/core> ;
                       rdfs:label "Ordered Collection"^^xsd:string ;
                       core:definition "An ordered collection of concepts, where both the grouping and the ordering are meaningful."^^xsd:string ;
                       core:scopeNote "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."^^xsd:string .


