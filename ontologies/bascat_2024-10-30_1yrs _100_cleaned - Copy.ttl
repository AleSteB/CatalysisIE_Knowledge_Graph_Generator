                                                          rdfs:label "parameter specification"^^xsd:string ;
                                                          core:definition "A participant specification which specifies an information object that has the contextual role of a parameter in the realized process. [Allotrope]"^^xsd:string ;
                                                          core:example "A parameter specification can include a formal name, a datatype, a shape or range of values if the parameter is a datum."^^xsd:string ;
                                                          core:note "A parameter specification is about a parameter. It is a parameter itself only in the context of a specification process."^^xsd:string ;
                                                          core:prefLabel "parameter specification"^^xsd:string .


