                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "portion of compound"^^xsd:string ;
                                                            core:altLabel "compound"^^xsd:string ;
                                                            core:definition "A portion of material that has grain only the same kind of molecules, ignoring minor impurities. [Allotrope]"^^xsd:string ;
                                                            core:example "portion of tablesugar"^^xsd:string ,
                                                                         "portion of water"^^xsd:string ;
                                                            core:prefLabel "portion of compound"^^xsd:string .


