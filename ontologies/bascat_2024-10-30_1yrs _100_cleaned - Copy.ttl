                                                         rdfs:label "specified profile"^^xsd:string ;
                                                         core:definition "Specified profile is the contextual role of an information object that specifies a process profile. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "specified profile"^^xsd:string .


