                                                          core:prefLabel "ion facet"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001859
<http://purl.allotrope.org/ontologies/result#AFR_0001859> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001857> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty obo:IAO_0000136 ;
                                                                            owl:someValuesFrom obo:PATO_0002193
                                                                          ] ;
                                                          prop:AFX_0002808 obo:MS_1000041 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                          rdfs:label "charge state"^^xsd:string ;
                                                          core:definition "Charge state is a facet that is about the electrical charge of an ion. It is single or multiple and positive or negatively charged. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "charge state"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001861
<http://purl.allotrope.org/ontologies/result#AFR_0001861> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000922> ;
                                                          prop:AFX_0002808 obo:MS_1000908 ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                          rdfs:label "ion transition"^^xsd:string ;
                                                          core:altLabel "multiple reaction monitoring transition"^^xsd:string ,
                                                                        "transition"^^xsd:string ;
                                                          core:definition "An ion transition is a description of the transition from precursor ion to product ions. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "ion transition"^^xsd:string ;
                                                          core:scopeNote "A set of two m/z values corresponding to the precursor m/z and a fragment m/z that in combination can be used to identify or quantify a specific ion, although not necessarily uniquely. [PSI/MS]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001863
<http://purl.allotrope.org/ontologies/result#AFR_0001863> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000166> ,
