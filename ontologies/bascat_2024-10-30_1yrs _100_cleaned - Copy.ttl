                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000947> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "signal-to-noise ratio"^^xsd:string ;
                                                          core:definition "A peak facet that ratios the peak height value with background level of noise.  It is an indication of the sensitivity of a particular method toward the analyte that the peak represents. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "signal-to-noise ratio"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001196
<http://purl.allotrope.org/ontologies/result#AFR_0001196> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001195> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "signal-to-noise ratio (RMS)"^^xsd:string ;
                                                          core:definition "A signal-to-noise ratio calculated using the Root Mean Square noise method. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "signal-to-noise ratio (RMS)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001197
<http://purl.allotrope.org/ontologies/result#AFR_0001197> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001195> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "signal-to-noise ratio (peak-to-peak)"^^xsd:string ;
                                                          core:altLabel "signal-to-noise (peak-to-peak, EP 2.2.46)"^^xsd:string ,
                                                                        "signal-to-noise (peak-to-peak, JP-G20)"^^xsd:string ,
                                                                        "signal-to-noise (peak-to-peak, USP 621)"^^xsd:string ;
                                                          core:changeNote "2019-09-26 Removed alt labels, now their own subclasses. [Allotrope]"^^xsd:string ;
                                                          core:definition "A signal-to-noise ratio calculated using the peak-to-peak noise method. This includes JP-G20 (measured over optimally 20 X peak width at half height but at least 5 times the peak width at half height), EP 2.2.46 (measured over at least 5 times the peak width at half height), USP 621 (measured over at least 5 times the peak width at half height). [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "signal-to-noise ratio (peak-to-peak)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001198
<http://purl.allotrope.org/ontologies/result#AFR_0001198> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001195> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "signal-to-noise ratio (ASTM E1657-98)"^^xsd:string ;
                                                          core:definition "A signal-to-noise ratio calculated using the ASTM E1657-98 method. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "signal-to-noise ratio (ASTM E1657-98)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001199
<http://purl.allotrope.org/ontologies/result#AFR_0001199> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000947> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak resolution"^^xsd:string ;
                                                          core:definition "A peak facet that measures the degree of separation between the peak and another specified peak. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak resolution"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001201
<http://purl.allotrope.org/ontologies/result#AFR_0001201> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001202> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak minimum point"^^xsd:string ;
                                                          core:definition "The peak minimum point is the data point of the peak with the smallest ordinate value. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak minimum point"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001202
<http://purl.allotrope.org/ontologies/result#AFR_0001202> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001186> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001518> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "peak extremum point"^^xsd:string ;
                                                          core:definition "The peak extremum point is the data point of the peak with the largest or smallest ordinate value. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak extremum point"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001209
<http://purl.allotrope.org/ontologies/result#AFR_0001209> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000168> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0000922> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001852> ,
                                                                          [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/common#AFC_0000168>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty prop:AFX_0002730 ;
                                                                                                   owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000325>
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          term:source <https://en.wikipedia.org/wiki/Statistical_population> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "statistical population"^^xsd:string ;
                                                          core:altLabel "population"^^xsd:string ,
                                                                        "population (statistics)"^^xsd:string ;
                                                          core:changeNote "2019-08-19 Moved under statistical facet. [Allotrope]"^^xsd:string ;
                                                          core:definition "In statistics, a population is a set of similar items or events which is of interest for some question or experiment. A statistical population can be a group of existing objects or a hypothetical and potentially infinite group of objects conceived as a generalization from experience. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "statistical population"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001210
<http://purl.allotrope.org/ontologies/result#AFR_0001210> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000168> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0000922> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001211> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001852> ,
                                                                          [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/common#AFC_0000168>
                                                                                                 <http://purl.allotrope.org/ontologies/result#AFR_0001211>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty prop:AFX_0002730 ;
                                                                                                   owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000324>
                                                                                                 ]
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty obo:BFO_0000050 ;
                                                                                                   owl:someValuesFrom <http://purl.allotrope.org/ontologies/result#AFR_0001209>
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          term:source <https://en.wikipedia.org/wiki/Statistical_population> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "statistical sample set"^^xsd:string ;
                                                          core:altLabel "statistical sample"^^xsd:string ;
                                                          core:changeNote "2019-08-19 Moved under statistical facet. [Allotrope]"^^xsd:string ;
                                                          core:definition "A statistical sample set is a description of a subset of the statistical population, that is chosen to represent the population in a statistical analysis. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "statistical sample set"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001211
<http://purl.allotrope.org/ontologies/result#AFR_0001211> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/common#AFC_0000166> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty obo:BFO_0000050 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/common#AFC_0000166>
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "partition"^^xsd:string ;
                                                          core:definition "A partition is a collection that is an aggregate part of a larger collection. Each member of the partition is also a member of the larger collection. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "partition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001212
<http://purl.allotrope.org/ontologies/result#AFR_0001212> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000922> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001852> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty prop:AFX_0002730 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/role#AFRL_0000328>
                                                                          ] ;
                                                          term:source <https://en.wikipedia.org/wiki/Descriptive_statistics> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "descriptive statistic"^^xsd:string ;
                                                          core:changeNote "2019-08-19 Moved under statistical facet. [Allotrope]"^^xsd:string ;
                                                          core:definition "A descriptive statistic is a summary statistic that quantitatively describes or summarizes features of a collection of information. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "descriptive statistic"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001213
<http://purl.allotrope.org/ontologies/result#AFR_0001213> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty prop:AFX_0002800 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/common#AFC_0000166>
                                                                          ] ;
                                                          term:subject <https://en.wikipedia.org/wiki/Summary_statistics> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "summary datum"^^xsd:string ;
                                                          core:altLabel "aggregate facet"^^xsd:string ,
                                                                        "summary facet"^^xsd:string ;
                                                          core:definition "A summary datum is a facet of a collection that is about summary information about features of the members of the collection, such as descriptive statistics in order to communicate the largest amount of information as simply as possible. [Allotrope]"^^xsd:string ;
                                                          core:example "maximum height of a peak - peak is a collection of peak points, peak height is a facet of each peak point."^^xsd:string ;
                                                          core:prefLabel "summary datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001216
<http://purl.allotrope.org/ontologies/result#AFR_0001216> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          term:replaces <http://purl.allotrope.org/ontologies/equipment#AFE_0001866> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "position"^^xsd:string ;
                                                          core:definition "The position is the location of a physical entity. [Allotrope]"^^xsd:string ;
                                                          core:example "Geolocation expressed as geographic coordinates"^^xsd:string ,
                                                                       "Position expressed with respect to a given coordinate system at some time t."^^xsd:string ,
                                                                       "Position of a vial on a tray expressed as indexed number."^^xsd:string ;
                                                          core:prefLabel "position"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001217
<http://purl.allotrope.org/ontologies/result#AFR_0001217> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000186> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001839> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "calibration point"^^xsd:string ;
                                                          core:changeNote "2018-07-23 Replaced deprecated af-p:AFP_0001083"^^xsd:string ,
                                                                          "2019-08-19 Changed definition. [Allotrope]"^^xsd:string ,
                                                                          "2019-08-19 Moved under data point. [Allotrope]"^^xsd:string ,
                                                                          "2020-04-28 Add subclass of calibration result."^^xsd:string ;
                                                          core:definition "A calibration point is a single calibration result at a specific test point (one or more reference values). [Allotrope]"^^xsd:string ;
                                                          core:example "In pH calibration a point with a set pH and buffer solution."^^xsd:string ;
                                                          core:prefLabel "calibration point"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001218
<http://purl.allotrope.org/ontologies/result#AFR_0001218> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000922> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "formulation description"^^xsd:string ;
                                                          core:altLabel "composition"^^xsd:string ,
                                                                        "formulation"^^xsd:string ;
                                                          core:definition "The formulation of a material is a data object that describes its composition of ingredients. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "formulation description"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001219
<http://purl.allotrope.org/ontologies/result#AFR_0001219> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000922> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "baseline"^^xsd:string ;
                                                          core:altLabel "blank reading"^^xsd:string ;
                                                          core:changeNote "2020-12-11 Add label. [Allotrope]"^^xsd:string ;
                                                          core:definition "An information content entity that describes the background (offset) component of a signal not due to the analyte (peak) of interest. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "baseline"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001220
<http://purl.allotrope.org/ontologies/result#AFR_0001220> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001219> ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          term:source "PAC, 1990, 62, 2167 (Glossary of atmospheric chemistry terms (Recommendations 1990))"^^xsd:string ,
                                                                      "PAC, 1993, 65, 819 (Nomenclature for chromatography (IUPAC Recommendations 1993))"^^xsd:string ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "baseline (chromatography)"^^xsd:string ;
                                                          core:altLabel "baseline"^^xsd:string ;
                                                          core:definition "The portion of the chromatogram recording the detector response when only the mobile phase emerges from the column. [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "baseline (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001221
<http://purl.allotrope.org/ontologies/result#AFR_0001221> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000923> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ;
                                                          rdfs:label "term granularity"^^xsd:string ;
                                                          core:definition "Term granularity relates an entity to an instance of granularity that describes the level of granularity that a term belongs to. [Allotrope]"^^xsd:string ;
                                                          core:example "A vial is a container that exists in macroscopic scale."^^xsd:string ;
                                                          core:prefLabel "term granularity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001230
<http://purl.allotrope.org/ontologies/result#AFR_0001230> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001177> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001199> ,
                                                                          [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/result#AFR_0001177>
                                                                                                 <http://purl.allotrope.org/ontologies/result#AFR_0001199>
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatographic peak resolution"^^xsd:string ;
                                                          core:definition "A chromatographic peak facet that quantitates the degree of separation between two peaks of a chromatogram. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatographic peak resolution"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001231
<http://purl.allotrope.org/ontologies/result#AFR_0001231> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001230> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatographic peak resolution using baseline peak widths"^^xsd:string ;
                                                          core:altLabel "chromatographic peak resolution by USP <621> using widths at baseline"^^xsd:string ,
                                                                        "chromatographic peak resolution calculated by the ASTM method"^^xsd:string ;
                                                          core:definition "Chromatographic peak resolution that is calculated by the USP <621> method using peak widths measured at the baseline. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatographic peak resolution using baseline peak widths"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001232
<http://purl.allotrope.org/ontologies/result#AFR_0001232> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001230> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatographic peak resolution using peak width at half-height"^^xsd:string ;
                                                          core:altLabel "chromatographic peak resolution by USP using widths at half-height"^^xsd:string ,
                                                                        "chromatographic peak resolution calculated by EP"^^xsd:string ,
                                                                        "chromatographic peak resolution calculated by JP-27"^^xsd:string ;
                                                          core:definition "Chromatographic peak resolution that is calculated using peak widths measured at the half height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatographic peak resolution using peak width at half-height"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001233
<http://purl.allotrope.org/ontologies/result#AFR_0001233> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001230> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatographic peak resolution using statistical moments"^^xsd:string ;
                                                          core:definition "Chromatographic peak resolution that is calculated based on peak widths derived from the second statistical moment (peak variance). [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatographic peak resolution using statistical moments"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001234
<http://purl.allotrope.org/ontologies/result#AFR_0001234> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001177> ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "capacity factor (chromatography)"^^xsd:string ;
                                                          core:altLabel "capacity ratio"^^xsd:string ,
                                                                        "mass distribution ratio"^^xsd:string ,
                                                                        "partition ratio"^^xsd:string ,
                                                                        "retention factor"^^xsd:string ;
                                                          core:definition "The capacity factor is a chromatography peak facet that is a measure of the time the sample component resides in the stationary phase relative to the time it resides in the mobile phase: it expresses how much longer a sample component is retarded by the stationary phase than it would take to travel through the column with the velocity of the mobile phase. [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "capacity factor (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001235
<http://purl.allotrope.org/ontologies/result#AFR_0001235> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001177> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "peak selectivity (chromatography)"^^xsd:string ;
                                                          core:altLabel "peak selectivity"^^xsd:string ;
                                                          core:definition "A chromatography peak facet that denotes the ratio of the peak's capacity factor to that of another specified peak. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak selectivity (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001236
<http://purl.allotrope.org/ontologies/result#AFR_0001236> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001088> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0001177> ,
                                                                          [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/result#AFR_0001088>
                                                                                                 <http://purl.allotrope.org/ontologies/result#AFR_0001177>
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatographic peak asymmetry factor"^^xsd:string ;
                                                          core:altLabel "tailing factor"^^xsd:string ;
                                                          core:changeNote "2022-012-07 Changed definition. [Allotrope]"^^xsd:string ;
                                                          core:definition "A chromatographic peak asymmetry factor is a chromatography peak facet that is equivalent to the ratio of the time or volume from the center point of a peak to its trailing edge to that of its fronting edge at a specified peak height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatographic peak asymmetry factor"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001237
<http://purl.allotrope.org/ontologies/result#AFR_0001237> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001236> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "asymmetry factor measured at 5 % height"^^xsd:string ;
                                                          core:altLabel "asymmetry factor by EP"^^xsd:string ,
                                                                        "asymmetry factor by JP-27"^^xsd:string ,
                                                                        "asymmetry factor measured at 5 percent height"^^xsd:string ,
                                                                        "asymmetry factor measured at 5% height"^^xsd:string ,
                                                                        "tailing factor by USP <621> method"^^xsd:string ;
                                                          core:definition "A quantitative asymmetry factor using 5% peak height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "asymmetry factor measured at 5 % height"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001238
<http://purl.allotrope.org/ontologies/result#AFR_0001238> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001236> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "statistical skew (chromatography)"^^xsd:string ;
                                                          core:altLabel "statistical skew"^^xsd:string ;
                                                          core:definition "A quantitative asymmetry factor using the third statistical moment calculated from the peak. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "statistical skew (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001239
<http://purl.allotrope.org/ontologies/result#AFR_0001239> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001177> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "number of theoretical plates (chromatography)"^^xsd:string ;
                                                          core:altLabel "number of theoretical plates"^^xsd:string ;
                                                          core:definition "A chromatography peak facet that measures the amount of band broadening that occurs during the separation and thus the efficiency of the chromatographic system. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "number of theoretical plates (chromatography)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001240
<http://purl.allotrope.org/ontologies/result#AFR_0001240> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001239> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "number of theoretical plates by tangent method"^^xsd:string ;
                                                          core:altLabel "number of theoretical plates by ASTM"^^xsd:string ,
                                                                        "number of theoretical plates by USP method"^^xsd:string ;
                                                          core:definition "The number of theoretical plates calculated based on the peak width measured at the baseline. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "number of theoretical plates by tangent method"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001241
<http://purl.allotrope.org/ontologies/result#AFR_0001241> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001239> ;
