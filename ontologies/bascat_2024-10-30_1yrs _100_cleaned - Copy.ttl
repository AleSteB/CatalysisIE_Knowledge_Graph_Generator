                                                           rdfs:label "communicating"^^xsd:string ;
                                                           core:altLabel "transferring signal"^^xsd:string ,
                                                                         "transmitting signal"^^xsd:string ;
                                                           core:definition "Communicating is transferring information from one material entity to another. This can be by way of a material or energy connecting the entity or by transporting the material bearing the information between the locations. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "communicating"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003315
<http://purl.allotrope.org/ontologies/process#AFP_0003315> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003620> ;
                                                           prop:AFX_0002808 <http://semanticscience.org/resource/SIO_000588> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "producing"^^xsd:string ;
                                                           core:altLabel "creating"^^xsd:string ,
                                                                         "creation"^^xsd:string ,
                                                                         "production"^^xsd:string ;
                                                           core:definition "A process where some new material entity or information content entity does not exists at the start of the process but is existing at the end by way of the process. [Allotrope]"^^xsd:string ;
                                                           core:note "Producing is dependent on the granularity and perspective. Many producing processes are converting processes in a different granulary or perspective."^^xsd:string ;
                                                           core:prefLabel "producing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003316
<http://purl.allotrope.org/ontologies/process#AFP_0003316> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003620> ;
