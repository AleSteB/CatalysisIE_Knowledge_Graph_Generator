                                                            rdfs:label "material"^^xsd:string ;
                                                            core:altLabel "matter"^^xsd:string ;
                                                            core:definition "A material entity that occupies space and possesses a rest mass. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000341
