                                                           rdfs:label "importing"^^xsd:string ;
                                                           core:changeNote "2020-06-18 Changed definition. [Allotrope]"^^xsd:string ,
                                                                           "2022-06-23 Added assertions. [Allotrope]"^^xsd:string ;
                                                           core:definition "Importing is a localization that brings in a flow (material, energy, signal) from outside of a boundary to the inside. [Allotrope, NIST]"^^xsd:string ;
                                                           core:prefLabel "importing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003350
<http://purl.allotrope.org/ontologies/process#AFP_0003350> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003348> ,
