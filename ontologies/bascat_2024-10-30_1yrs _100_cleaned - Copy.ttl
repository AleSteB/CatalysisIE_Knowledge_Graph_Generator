                 core:prefLabel "area (quality)"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0001334
obo:PATO_0001334 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000122 ;
                 prop:AFX_0002818 "true"^^xsd:boolean ;
                 prop:AFX_0002865 obo:pato-owl ;
