                                                           rdfs:label "adsorption chromatography"^^xsd:string ;
                                                           core:definition "Chromatography in which separation is based mainly on differences between the adsorption affinities of the sample components for the surface of an active solid. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "adsorption chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001026
<http://purl.allotrope.org/ontologies/process#AFP_0001026> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001993> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "chemical ionization"^^xsd:string ;
                                                           core:altLabel "CI"^^xsd:string ;
                                                           core:definition "Formation of a new ion in the gas phase by the reaction of a neutral with an ion. The process may involve transfer of an electron, a proton, or other charged species between the reactants. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "chemical ionization"^^xsd:string ;
                                                           core:scopeNote "This term is not synonymous with chemi-ionization. [IUPAC]"^^xsd:string ,
                                                                          "When a positive ion results from chemical ionization, the term may be used without qualification. When a negative ion results, the term negative ion chemical ionization should be used. [IUPAC]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001046
<http://purl.allotrope.org/ontologies/process#AFP_0001046> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000225> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                           rdfs:label "liquid chromatography at the critical condition"^^xsd:string ;
                                                           core:altLabel "LCCC"^^xsd:string ,
                                                                         "liquid chromatography at critical conditions"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a liquid held at or near its critical point. Liquid chromatography at the critical condition is used to determine functionality distributions in polymers. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "liquid chromatography at the critical condition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0001047
<http://purl.allotrope.org/ontologies/process#AFP_0001047> rdf:type owl:Class ;
