                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has item"^^xsd:string ;
                 core:altLabel "item"^^xsd:string ,
                               "member"^^xsd:string ;
                 core:definition "This property links a collection to a member item. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has item"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000553
prop:AFX_0000553 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0000354 ;
                 rdfs:domain obo:IAO_0000030 ;
