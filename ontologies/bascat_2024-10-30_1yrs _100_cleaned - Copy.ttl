                                                                         "reflectance ultra-violet-visible spectrometry"^^xsd:string ,
                                                                         "reflectance ultra-violet-visible spectrophotometry"^^xsd:string ,
                                                                         "reflectance ultra-violet-visible spectroscopy"^^xsd:string ,
