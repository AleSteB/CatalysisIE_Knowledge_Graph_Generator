                                                          rdfs:label "member coordination"^^xsd:string ;
                                                          core:definition "A member coordination is a class coordination that coordinates a collection class with the class of its members. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "member coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001573
<http://purl.allotrope.org/ontologies/result#AFR_0001573> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "feature coordination"^^xsd:string ;
                                                          core:definition "A feature coordination is a class coordination that coordinates with a quality or facet class that exists in all members of a collection. [Allotrope]"^^xsd:string ;
                                                          core:example "Average cell diameter is a coordination of 'cell' which is the member class of the population, the feature 'diameter' and the statistic 'arithmetic mean'."^^xsd:string ;
                                                          core:prefLabel "feature coordination"^^xsd:string .


