                                                           rdfs:label "background correction"^^xsd:string ;
                                                           core:definition "Background correction is a data transformation designed to remove irrelevant contributions from the measured signal, e.g. those due to instrument noise or sample preparation. [BAO]"^^xsd:string ;
                                                           core:prefLabel "background correction"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003722
