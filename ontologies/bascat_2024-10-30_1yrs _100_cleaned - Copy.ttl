                                                             core:altLabel "stopping function"^^xsd:string ;
                                                             core:definition "To cease, or prevent, the transfer of a flow (material, energy, signal). [NIST]"^^xsd:string ;
                                                             core:example "A reflective coating on a window stops the transmission of UV radiation through a window. [NIST]"^^xsd:string ;
                                                             core:prefLabel "to stop"^^xsd:string .


###  http://purl.allotrope.org/ontologies/function#AFFN_0000134
<http://purl.allotrope.org/ontologies/function#AFFN_0000134> rdf:type owl:Class ;
