                                                           core:prefLabel "velocity configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000352
<http://purl.allotrope.org/ontologies/quality#AFQ_0000352> rdf:type owl:Class ;
