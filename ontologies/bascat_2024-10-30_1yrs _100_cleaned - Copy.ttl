                                                                        "number of theoretical plates by JP method"^^xsd:string ;
                                                          core:definition "The number of theoretical plates calculated based on the peak width measured at half height. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "number of theoretical plates by peak width at half height"^^xsd:string .


