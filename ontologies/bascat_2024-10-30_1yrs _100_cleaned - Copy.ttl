                                                         rdfs:label "qualifier transition role"^^xsd:string ;
                                                         core:altLabel "qualifier transition"^^xsd:string ;
                                                         core:definition "A qualifier transition is the contextual role of an ion transition which when compared to the quantifier transition is used to determine the validity of the result. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "qualifier transition role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000501
<http://purl.allotrope.org/ontologies/role#AFRL_0000501> rdf:type owl:Class ;
