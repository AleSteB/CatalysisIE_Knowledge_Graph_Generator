###  http://purl.allotrope.org/ontologies/quality#AFQ_0000285
<http://purl.allotrope.org/ontologies/quality#AFQ_0000285> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000280> ;
