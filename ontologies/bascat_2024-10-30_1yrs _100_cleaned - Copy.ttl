                core:prefLabel "has occurrent part"^^xsd:string .


###  http://purl.obolibrary.org/obo/BFO_0000118
obo:BFO_0000118 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf prop:AFX_0002793 ,
                                   obo:BFO_0000117 ;
                owl:inverseOf obo:BFO_0000138 ;
