   owl:annotatedTarget "(forall (x) (if (and (Entity x) (exists (y t) (and (MaterialEntity y) (continuantPartOfAt x y t)))) (MaterialEntity x))) // axiom label in BFO2 CLIF: [021-002] "^^xsd:string ;
   obo:IAO_0010000 <http://purl.obolibrary.org/obo/bfo/axiom/021-002>
 ] .

