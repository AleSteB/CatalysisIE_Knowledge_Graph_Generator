                                                           rdfs:label "packed injection"^^xsd:string ;
                                                           core:definition "Packed injection is a GC injection type whereby all of the volatilized sample is swept onto the GC column. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "packed injection"^^xsd:string .


