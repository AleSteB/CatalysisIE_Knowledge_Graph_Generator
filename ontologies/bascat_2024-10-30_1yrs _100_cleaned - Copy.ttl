                                                                             <http://purl.allotrope.org/ontologies/equipment#AFE_0000734> ,
                                                                             <http://purl.allotrope.org/ontologies/equipment#AFE_0002200> ;
                                                             prop:AFX_0002798 "true"^^xsd:boolean ;
                                                             prop:AFX_0002809 obo:CHMO_0002503 ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
                                                             rdfs:label "diode array detector"^^xsd:string ;
                                                             core:altLabel "DAD"^^xsd:string ,
                                                                           "PDA"^^xsd:string ,
                                                                           "PDAD"^^xsd:string ,
                                                                           "photodiode array detector"^^xsd:string ;
                                                             core:definition "A piece of apparatus, consisting of a two-dimensional pattern of diodes and a prism, that is used to detect organic compounds. As the sample passes through a cell or cuvette it is illuminated with light in the region 190-1100 nm and any light transmitted through the sample is dispersed by the prism, so that light of different wavelengths falls on different diodes. The output from the array is used to construct an absorption spectrum that can be compared with standard spectra for identification purposes. Alternatively, a single diode can be used to monitor a specific wavelength at which there is maximum absorption. [CHMO]"^^xsd:string ;
                                                             core:prefLabel "diode array detector"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000097
<http://purl.allotrope.org/ontologies/equipment#AFE_0000097> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0002250> ;
                                                             prop:AFX_0002818 "true"^^xsd:boolean ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                             rdfs:label "electromagnetic radiation source"^^xsd:string ;
                                                             core:altLabel "EMR source"^^xsd:string ,
                                                                           "light source"^^xsd:string ;
                                                             core:definition "A source of a range of electromagnetic waves. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "electromagnetic radiation source"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000105
<http://purl.allotrope.org/ontologies/equipment#AFE_0000105> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000646> ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                             rdfs:label "flow cell"^^xsd:string ;
                                                             core:definition "A flow cell is a measurement chamber that allows the sample to flow through. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "flow cell"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000107
<http://purl.allotrope.org/ontologies/equipment#AFE_0000107> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000085> ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                             rdfs:label "Karl-Fischer coulometer"^^xsd:string ;
                                                             core:altLabel "Karl Fischer coulometer"^^xsd:string ,
                                                                           "Karl Fischer coulometric titrator"^^xsd:string ;
                                                             core:definition "A Karl-Fischer coulometer is a piece of apparatus, consisting of an electrolytic cell with an anodic compartment containing sulfur dioxide (SO2), iodide and a cathodic compartment containing the sample, which is used to determine trace amounts of water in a sample by measuring the time and current flow required to reach the titration end-point. [CHMO]"^^xsd:string ;
                                                             core:prefLabel "Karl-Fischer coulometer"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000112
<http://purl.allotrope.org/ontologies/equipment#AFE_0000112> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000691> ;
                                                             prop:AFX_0002798 "true"^^xsd:boolean ;
                                                             prop:AFX_0002808 obo:CHMO_0000972 ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                             rdfs:label "porous-layer open-tubular column"^^xsd:string ;
                                                             core:altLabel "PLOT column"^^xsd:string ;
                                                             core:definition "An open-tubular column in which a porous layer, achieved by either etching a non-porous layer or by deposition of porous particles from a suspension, coats the inner wall and may serve as a support for a liquid stationary phase or as the stationary phase itself. [CHMO]"^^xsd:string ;
                                                             core:prefLabel "porous-layer open-tubular column"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000114
<http://purl.allotrope.org/ontologies/equipment#AFE_0000114> rdf:type owl:Class ;
