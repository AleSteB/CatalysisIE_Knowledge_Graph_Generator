                                                            rdfs:label "liquid"^^xsd:string ;
                                                            core:definition "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "liquid"^^xsd:string .


