                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "molecular entity quality"^^xsd:string ;
                                                           core:altLabel "molecular quality"^^xsd:string ;
                                                           core:definition "A molecular quality is a chemical quality which inheres in a molecular entity, a single molecule, atom, ion, radical etc. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "molecular entity quality"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000253
<http://purl.allotrope.org/ontologies/quality#AFQ_0000253> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "energy (quality)"^^xsd:string ;
                                                           core:altLabel "energy"^^xsd:string ;
                                                           core:definition "Energy (quality) is the amount of energy that a material entity contains. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "energy (quality)"^^xsd:string ;
                                                           core:scopeNote "Energy is in BFO considered a material entity."^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000254
<http://purl.allotrope.org/ontologies/quality#AFQ_0000254> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000036> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/equipment#AFE_0002205>
                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                           rdfs:label "mass spectrometry system configuration"^^xsd:string ;
                                                           core:definition "A mass spectrometry system configuration is a device configuration of a mass spectrometry system, that influences the operation of the system. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "mass spectrometry system configuration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000256
<http://purl.allotrope.org/ontologies/quality#AFQ_0000256> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ,
                                                                           obo:PATO_0000125 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "molecular mass (molecular quality)"^^xsd:string ;
                                                           core:altLabel "atomic mass"^^xsd:string ;
                                                           core:changeNote "2020-03-16 Changed pref label. [Allotrope]"^^xsd:string ,
                                                                           "2020-03-16 Subclassed under pato:mass. [Allotrope]"^^xsd:string ;
                                                           core:definition "Molecular mass is a molecular quality inhered in a molecular entity that expresses its mass relative to 1/12 of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state and at rest. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "molecular mass (molecular quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000257
<http://purl.allotrope.org/ontologies/quality#AFQ_0000257> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "mass-to-charge ratio (molecular quality)"^^xsd:string ;
                                                           core:altLabel "m/z"^^xsd:string ,
                                                                         "m/z (molecular quality)"^^xsd:string ,
                                                                         "m/z ratio"^^xsd:string ,
                                                                         "mass-to-charge ratio"^^xsd:string ;
                                                           core:definition "Mass-to-charge ratio is a molecular quality that expresses the ratio of the molecular mass to the charge number of a molecular entity. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "mass-to-charge ratio (molecular quality)"^^xsd:string ;
                                                           core:scopeNote "This quality is itself a ratio of relative qualities, the molecular mass is relative to the unified atomic mass unit and the electric charge to the elementary charge. [Allotrope]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000263
<http://purl.allotrope.org/ontologies/quality#AFQ_0000263> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                                                           prop:AFX_0002808 <http://semanticscience.org/resource/CHEMINF_000042> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "molecular formula (molecular quality)"^^xsd:string ;
                                                           core:altLabel "molecular formula"^^xsd:string ;
                                                           core:definition "A molecular formula is a molecular quality that inheres in a molecular entity by the relative amount of component atoms. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "molecular formula (molecular quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000264
<http://purl.allotrope.org/ontologies/quality#AFQ_0000264> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000253> ,
                                                                           obo:BFO_0000019 ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000418>
                                                                           ] ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC. Analytical Division. Compendium of Analytical Nomenclature (the Orange Book). Definitive Rules, 1979. Compiled by J. Inczédy, T. Lengyel, A. M. Ure. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ,
                                                                       "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the Gold Book). Compiled by A. D. McNaught and A.Wilkinson. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ,
                                                                       "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "electron energy"^^xsd:string ;
                                                           core:definition "Electron energy is the translational energy that electrons acquire when accelerated in an electric field. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "electron energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000265
<http://purl.allotrope.org/ontologies/quality#AFQ_0000265> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000252> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                           rdfs:label "isotopic distribution (molecular quality)"^^xsd:string ;
                                                           core:altLabel "isotopic distribution"^^xsd:string ;
                                                           core:definition "Isotopic distribution is a molecular quality inhered in a molecule by the distribution of different isotopes in the molecule. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "isotopic distribution (molecular quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000266
<http://purl.allotrope.org/ontologies/quality#AFQ_0000266> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 1996, 68, 957. (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electric resistivity (quality)"^^xsd:string ;
                                                           core:altLabel "electric resistivity"^^xsd:string ,
                                                                         "resistivity"^^xsd:string ,
                                                                         "resistivity (quality)"^^xsd:string ;
                                                           core:definition "Electric resistivity is the quality of the electric field strength divided by the current density when there is no electromotive force in a conductor. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "electric resistivity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000267
<http://purl.allotrope.org/ontologies/quality#AFQ_0000267> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source <https://en.wikipedia.org/wiki/Electrical_resistance_and_conductance> ,
                                                                       "PAC, 1996, 68, 957. (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996))"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electric conductance (quality)"^^xsd:string ;
                                                           core:altLabel "conductance"^^xsd:string ,
                                                                         "conductance (quality)"^^xsd:string ,
                                                                         "electric conductance"^^xsd:string ;
                                                           core:definition "Electric conductance is the quality inhered in a conductor that is the reciprocal of a the electric resistance. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "electric conductance (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000268
<http://purl.allotrope.org/ontologies/quality#AFQ_0000268> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000122 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "cell path length (quality)"^^xsd:string ;
                                                           core:altLabel "cell path length"^^xsd:string ,
                                                                         "path length"^^xsd:string ,
                                                                         "path length (quality)"^^xsd:string ;
                                                           core:definition "The cell path length is the length of the radiation path through the absorbing medium in a single-pass cell. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "cell path length (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000269
<http://purl.allotrope.org/ontologies/quality#AFQ_0000269> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000019 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "enthalpy (quality)"^^xsd:string ;
                                                           core:altLabel "enthalpy"^^xsd:string ;
                                                           core:definition "Enthalpy (quality) is the quality of a system that is the internal energy of the system plus the product of pressure and volume. Its change in a system is equal to the heat brought to the system at constant pressure. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "enthalpy (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000271
<http://purl.allotrope.org/ontologies/quality#AFQ_0000271> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000058> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "specific heat capacity (quality)"^^xsd:string ;
                                                           core:altLabel "specific heat capacity"^^xsd:string ;
                                                           core:definition "A specific heat capacity (quality) is a heat capacity of a pure substance by virtue of the amount of heat necessary to raise the temperature per amount of mass. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "specific heat capacity (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000273
<http://purl.allotrope.org/ontologies/quality#AFQ_0000273> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "electric charge (quality)"^^xsd:string ;
                                                           core:altLabel "charge"^^xsd:string ,
                                                                         "electric charge"^^xsd:string ;
                                                           core:definition "Electric charge is the electrical quality of matter that causes it to experience a force when placed in an electromagnetic field. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "electric charge (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000275
<http://purl.allotrope.org/ontologies/quality#AFQ_0000275> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001025 ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "PAC, 1990, 62, 2167. (Glossary of atmospheric chemistry terms (Recommendations 1990)) on page 2212"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "saturation vapor pressure (quality)"^^xsd:string ;
                                                           core:altLabel "saturation vapor pressure"^^xsd:string ;
                                                           core:definition "The pressure exerted by a pure substance (at a given temperature) in a system containing only the vapor and condensed phase (liquid or solid) of the substance. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "saturation vapor pressure (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000276
<http://purl.allotrope.org/ontologies/quality#AFQ_0000276> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0001574 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "evacuation rate (quality)"^^xsd:string ;
                                                           core:definition "An evacuation rate is a flow rate indicating the rate at which gas is removed from a chamber. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "evacuation rate (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000277
<http://purl.allotrope.org/ontologies/quality#AFQ_0000277> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:PATO_0000918 ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000080 ;
