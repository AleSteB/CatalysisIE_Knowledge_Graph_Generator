                                                           core:changeNote "2020-06-15 Changed labels and definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "A pressure process profile is a quality process profile that tracks some pressure. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "pressure process profile"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003297
<http://purl.allotrope.org/ontologies/process#AFP_0003297> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003282> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "ratio calculation"^^xsd:string ;
                                                           core:definition "A ratio calculation is the process of performing the mathematical exercise of dividing a quotient of one quantity by another quotient to demonstrate the quantitative relation between two amounts showing the number of times one value contains or is contained within the other. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ratio calculation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003298
<http://purl.allotrope.org/ontologies/process#AFP_0003298> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003282> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                           rdfs:label "relative retention calculation"^^xsd:string ;
                                                           core:definition "The relative retention calculation is a process of performing the mathematical ratio quantification of the time a substance and a standard that remain in the stationary phase of a chromatography process. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "relative retention calculation"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003299
<http://purl.allotrope.org/ontologies/process#AFP_0003299> rdf:type owl:Class ;
