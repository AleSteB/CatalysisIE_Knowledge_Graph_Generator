###  http://purl.allotrope.org/ontologies/result#AFR_0001562
<http://purl.allotrope.org/ontologies/result#AFR_0001562> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "subject coordination"^^xsd:string ;
                                                          core:altLabel "aboutness coordination"^^xsd:string ;
                                                          core:definition "A subject coordination is a class coordination of a subclass of information content entity with the subject the class is about. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "subject coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001564
<http://purl.allotrope.org/ontologies/result#AFR_0001564> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "role coordination"^^xsd:string ;
                                                          core:definition "A role coordination is a class coordination of a class with the class of general role its instances have. [Allotrope]"^^xsd:string ;
                                                          core:example "A reference column is a class of columns that have an reference role. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "role coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001565
<http://purl.allotrope.org/ontologies/result#AFR_0001565> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "material coordination"^^xsd:string ;
                                                          core:definition "A material coordination is a class coordination of a subclass of material. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "material coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001566
<http://purl.allotrope.org/ontologies/result#AFR_0001566> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001565> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "ingredient coordination"^^xsd:string ;
                                                          core:altLabel "component coordination"^^xsd:string ,
                                                                        "material component coordination"^^xsd:string ;
                                                          core:changeNote "2021-09-17 Fix example, alt label, definition. [Allotrope]"^^xsd:string ;
                                                          core:definition "An ingredient coordination is a material coordination that coordinates a material class with its ingredients (components) (of the same level of granularity). [Allotrope]"^^xsd:string ;
                                                          core:example "Hydrochloric acid solution is a solution coordinated with its component compounds water and hydrochloric acid. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "ingredient coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001567
<http://purl.allotrope.org/ontologies/result#AFR_0001567> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001565> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "substance coordination"^^xsd:string ;
                                                          core:definition "A substance coordination is a material coordination that coordinates the material class with the class of its granular parts of molecular scope. [Allotrope]"^^xsd:string ;
                                                          core:example "Potion of water is a compound with a substance coordination to water (molecules). [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "substance coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001568
<http://purl.allotrope.org/ontologies/result#AFR_0001568> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "index coordination"^^xsd:string ;
                                                          core:definition "An index coordination is a class coordination that coordinates a class of individuals that are denoted by a common index. [Allotrope]"^^xsd:string ;
                                                          core:example "Column 1"^^xsd:string ;
                                                          core:prefLabel "index coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001569
<http://purl.allotrope.org/ontologies/result#AFR_0001569> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "bearer coordination"^^xsd:string ;
                                                          core:altLabel "inherence coordination"^^xsd:string ;
                                                          core:definition "A bearer coordination is a class coordination that coordinates a specifically dependent continuant class of individuals with the bearer that inheres it. [Allotrope]"^^xsd:string ;
                                                          core:example "Column temperature is a coordination of the quality temperature with column."^^xsd:string ;
                                                          core:prefLabel "bearer coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001570
<http://purl.allotrope.org/ontologies/result#AFR_0001570> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001562> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/class-coordination> ;
                                                          rdfs:label "specification coordination"^^xsd:string ;
                                                          core:definition "A specification coordination is a subject coordination of a subclass of directive information class. [Allotrope]"^^xsd:string ;
                                                          core:example "Volume concentration setting is a setting that specifies the volume concentration."^^xsd:string ;
                                                          core:prefLabel "specification coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001571
<http://purl.allotrope.org/ontologies/result#AFR_0001571> rdf:type owl:Class ;
