                                                           rdfs:label "relative response (quality)"^^xsd:string ;
                                                           core:definition "A relative response is the ratio of an analytes device response signal to the device response signal of some reference material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "relative response (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000359
