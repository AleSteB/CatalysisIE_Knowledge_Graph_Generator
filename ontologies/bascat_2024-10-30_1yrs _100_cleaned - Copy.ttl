                                                          rdfs:label "very hygroscopic"^^xsd:string ;
                                                          core:changeNote "2021-09-29 Moved under hygroscopicity code. [Allotrope]"^^xsd:string ;
                                                          core:definition "Very hygroscopic is a hygroscopicity type that denotes the increase in mass as equal to or greater than 15%. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "very hygroscopic"^^xsd:string .


