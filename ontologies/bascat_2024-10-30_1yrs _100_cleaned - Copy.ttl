                                                                           "restraining function"^^xsd:string ,
                                                                           "to restrain"^^xsd:string ;
                                                             core:definition "To significantly restrain a flow, though a portion of the flow continues to be transferred. [NIST]"^^xsd:string ;
                                                             core:example "The structures of space vehicles inhibits the flow of radiation to protect crew and cargo.  [NIST]"^^xsd:string ;
                                                             core:prefLabel "to inhibit"^^xsd:string .


