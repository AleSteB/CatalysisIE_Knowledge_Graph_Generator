                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting> ;
                                                           rdfs:label "cell diameter"^^xsd:string ;
                                                           core:definition "A cell diameter is the diameter of a cell. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "cell diameter"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000195
<http://purl.allotrope.org/ontologies/quality#AFQ_0000195> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000208> ;
