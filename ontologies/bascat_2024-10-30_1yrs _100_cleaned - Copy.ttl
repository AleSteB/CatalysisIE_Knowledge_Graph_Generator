                                                                        "tolerance"^^xsd:string ;
                                                          core:definition "Range of values of allowed deviation for a given value. [Allotrope]"^^xsd:string ;
                                                          core:example "Tolerance range of +/- 1 °C of a temperature value."^^xsd:string ;
                                                          core:prefLabel "tolerance range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001648
