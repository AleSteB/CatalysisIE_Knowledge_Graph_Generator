                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "peak picking"^^xsd:string ;
                                                           core:definition "Peak picking is a data transformation to convert profile spectral data into centroided spectral data. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "peak picking"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000525
<http://purl.allotrope.org/ontologies/process#AFP_0000525> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000267>
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "conductometry"^^xsd:string ;
                                                           core:altLabel "conductimetry"^^xsd:string ;
                                                           core:changeNote "2020-11-12 Changed definition. [Allotrope]"^^xsd:string ;
                                                           core:definition "Conductometry is the measurement of the conductance of a solution as a function of concentration. Measurements are made indirectly across the resistance of the solution with alternating current. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "conductometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000527
<http://purl.allotrope.org/ontologies/process#AFP_0000527> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003556> ;
