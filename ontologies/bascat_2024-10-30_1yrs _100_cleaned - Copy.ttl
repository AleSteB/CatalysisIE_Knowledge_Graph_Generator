core:note rdf:type owl:AnnotationProperty ;
          prop:AFX_0002865 <http://www.w3.org/2004/02/skos/core> ;
          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ,
                           <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                           <http://www.w3.org/2004/02/skos/core> ;
          rdfs:label "note"^^xsd:string ;
          core:definition "A general note, for any purpose."^^xsd:string ;
          core:scopeNote "This property may be used directly, or as a super-property for more specific note types."^^xsd:string .


###  http://www.w3.org/2004/02/skos/core#prefLabel
core:prefLabel rdf:type owl:AnnotationProperty ;
               prop:AFX_0002865 <http://www.w3.org/2004/02/skos/core> ;
               rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en ,
                            "The range of skos:prefLabel is the class of RDF plain literals."@en ,
                            """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""^^xsd:string ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ,
                                <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                <http://www.w3.org/2004/02/skos/core> ;
               rdfs:label "preferred label"^^xsd:string ;
               core:definition "The preferred lexical label for a resource, in a given language."^^xsd:string ;
               rdfs:subPropertyOf rdfs:label .


###  http://www.w3.org/2004/02/skos/core#scopeNote
core:scopeNote rdf:type owl:AnnotationProperty ;
               prop:AFX_0002865 <http://www.w3.org/2004/02/skos/core> ;
               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/curation> ,
                                <http://purl.allotrope.org/voc/skos/REC/2018/10/skos> ,
                                <http://www.w3.org/2004/02/skos/core> ;
               rdfs:label "scope note"^^xsd:string ;
               core:definition "A note that helps to clarify the meaning and/or the use of a concept."^^xsd:string ;
               rdfs:subPropertyOf core:note .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
x_0.1:name rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.allotrope.org/ontologies/property#AFX_0000072
prop:AFX_0000072 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002686 ;
                 prop:AFX_0002811 <http://purl.allotrope.org/ontologies/result#AFR_0000951> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has duration"^^xsd:string ;
                 core:altLabel "duration"^^xsd:string ,
                               "time"^^xsd:string ;
                 core:definition "Time is a measure in which events can be ordered from the past through the present into the future, and also the measure of durations of events and the intervals between them. [Wikipedia]"^^xsd:string ;
                 core:prefLabel "has duration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000180
prop:AFX_0000180 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "increment"^^xsd:string ;
                 core:altLabel "step size"^^xsd:string ;
                 core:definition "The difference between two discrete points next to each other in a range of discrete values. [Allotrope]"^^xsd:string ;
                 core:example "A device property can be set between a minimum and maximum value but only in steps of the increment value."^^xsd:string ,
                              "Step size of sweeping over 2Theta, unit °"^^xsd:string ;
                 core:prefLabel "increment"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000197
prop:AFX_0000197 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:inverseOf prop:AFX_0002864 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "selects"^^xsd:string ;
                 core:altLabel "applies"^^xsd:string ,
                               "uses"^^xsd:string ;
                 core:changeNote "2020-11-12 Added alternative label and changed definition. [Allotrope]"^^xsd:string ;
                 core:definition "A planned process selects a participant if the participant is chosen to influence the process towards some objective but is itself not essentially changed by a process. [Allotrope]"^^xsd:string ;
                 core:example "For the process of titration a pH meter is used as well as a sample and a standard solution. [Allotrope]"^^xsd:string ;
                 core:prefLabel "selects"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000234
prop:AFX_0000234 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "refines"^^xsd:string ;
                 core:definition "This relation indicates that the subject is a more concrete instance of the object. [Allotrope]"^^xsd:string ;
                 core:prefLabel "refines"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000314
prop:AFX_0000314 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "minimum"^^xsd:string ;
                 core:definition "The lowest value of a range or a set of values. [Allotrope]"^^xsd:string ;
                 core:prefLabel "minimum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000331
prop:AFX_0000331 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "maximum"^^xsd:string ;
                 core:definition "Highest value of a range. [Allotrope]"^^xsd:string ;
                 core:prefLabel "maximum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000353
prop:AFX_0000353 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000056 ;
                 owl:inverseOf prop:AFX_0000395 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "output of"^^xsd:string ;
                 core:altLabel "is output of"^^xsd:string ;
                 core:definition "Relates an output entity such as a material or information object with a process that exists at the end of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "output of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000354
prop:AFX_0000354 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000056 ;
                 owl:inverseOf prop:AFX_0000399 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "input of"^^xsd:string ;
                 core:altLabel "is input of"^^xsd:string ;
                 core:definition "Relates an input entity such a material entity or information object with a process that exists at the start of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "input of"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000355
prop:AFX_0000355 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 owl:inverseOf prop:AFX_0000408 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/common#AFC_0000090> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "is condition for"^^xsd:string ;
                 core:definition "A condition that restricts an entity. [Allotrope]"^^xsd:string ;
                 core:prefLabel "is condition for"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000365
prop:AFX_0000365 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf prop:AFX_0002793 ;
                 owl:inverseOf prop:AFX_0002845 ;
                 rdfs:domain <http://purl.allotrope.org/ontologies/material#AFM_0001038> ;
                 rdfs:range obo:CHMO_0000993 ;
                 prop:AFX_0002811 <http://purl.allotrope.org/ontologies/role#AFRL_0000249> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has ingredient"^^xsd:string ;
                 core:altLabel "component"^^xsd:string ,
                               "has component"^^xsd:string ,
                               "ingredient"^^xsd:string ;
                 core:definition "An ingredient is a material that enters into a compound or is part of any combination or mixture. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has ingredient"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000386
prop:AFX_0000386 rdf:type owl:ObjectProperty ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has shape"^^xsd:string ;
                 core:altLabel "shape"^^xsd:string ;
                 core:definition "Inverse of SHACL targets e.g. sh:targetClass or sh:targetNode. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has shape"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000388
prop:AFX_0000388 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:IAO_0000136 ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has scope"^^xsd:string ;
                 core:altLabel "in context"^^xsd:string ,
                               "in scope"^^xsd:string ,
                               "in situation"^^xsd:string ,
                               "scope"^^xsd:string ;
                 core:definition "A scope defines a situation or context in which a dependent entity such as a condition or contextual role occurs or is valid. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has scope"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000395
prop:AFX_0000395 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:propertyChainAxiom ( obo:RO_0002230
                                          prop:AFX_0000395
                                        ) ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has output"^^xsd:string ;
                 core:changeNote "2020-06-08 Removed super property functionally related to. [Allotrope]"^^xsd:string ;
                 core:definition "Relates a process with a continuant that participates in the process and exists at the end of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has output"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000399
prop:AFX_0000399 rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf obo:RO_0000057 ;
                 owl:propertyChainAxiom ( obo:RO_0002224
                                          prop:AFX_0000399
                                        ) ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has input"^^xsd:string ;
                 core:changeNote "2020-06-08 Removed super property functionally related to. [Allotrope]"^^xsd:string ;
                 core:definition "Relates a process with a continuant that participates in the process and exists at the start of the process. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has input"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000408
prop:AFX_0000408 rdf:type owl:ObjectProperty ;
                 rdfs:range <http://purl.allotrope.org/ontologies/common#AFC_0000090> ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/relation> ;
                 rdfs:label "has condition"^^xsd:string ;
                 core:definition "An entity has a condition that restricts the entity in some way. [Allotrope]"^^xsd:string ;
                 core:prefLabel "has condition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/property#AFX_0000542
prop:AFX_0000542 rdf:type owl:ObjectProperty ;
