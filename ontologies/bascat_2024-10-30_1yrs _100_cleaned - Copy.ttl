                                                         rdfs:label "indexed member"^^xsd:string ;
                                                         core:definition "Indexed member is the member role that has an index facet. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "indexed member"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000170
<http://purl.allotrope.org/ontologies/role#AFRL_0000170> rdf:type owl:Class ;
