###  http://purl.allotrope.org/ontologies/material#AFM_0001096
<http://purl.allotrope.org/ontologies/material#AFM_0001096> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001042> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                            rdfs:label "chromatographic packing"^^xsd:string ;
                                                            core:definition "A chromatographic packing is a solid heterogeneous mixture consisting of a substrate and stationary phase used in a chromatographic separation. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "chromatographic packing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001097
<http://purl.allotrope.org/ontologies/material#AFM_0001097> rdf:type owl:Class ;
                                                            owl:equivalentClass obo:CHEBI_59999 ;
                                                            rdfs:subClassOf obo:CHMO_0000993 ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\"). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ;
                                                            rdfs:comment "Equivalence with http://purl.obolibrary.org/obo/CHEBI_59999 added automatically"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "chemical substance"^^xsd:string ;
                                                            core:definition "A chemical substance is a portion of material that is matter of constant composition best characterized by the entities (molecules, formula units, atoms) it is composed of. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "chemical substance"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001099
<http://purl.allotrope.org/ontologies/material#AFM_0001099> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001038> ,
