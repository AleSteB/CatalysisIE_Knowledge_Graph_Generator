                                                             core:definition "A differential scanning calorimetry pan is a pan for use in a differential scanning calorimeter that contains the sample under investigation. [Allotrope]"^^xsd:string ;
                                                             core:example "TZero pan, TZero hermetic pan"^^xsd:string ;
                                                             core:prefLabel "differential scanning calorimetry pan"^^xsd:string .


