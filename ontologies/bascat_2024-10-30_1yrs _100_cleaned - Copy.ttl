                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          term:source <https://en.wikipedia.org/wiki/Isobar_(nuclide)> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "isobar (nuclide)"^^xsd:string ;
                                                          core:altLabel "isobar"^^xsd:string ;
                                                          core:changeNote "2019-05-09 Moved under classification datum. [Allotrope]"^^xsd:string ;
                                                          core:definition "Isobar is a classification facet that classifies atoms (nuclides) of different chemical elements that have the same number of nucleons. Correspondingly, isobars differ in atomic number (or number of protons) but have the same mass number. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "isobar (nuclide)"^^xsd:string .


