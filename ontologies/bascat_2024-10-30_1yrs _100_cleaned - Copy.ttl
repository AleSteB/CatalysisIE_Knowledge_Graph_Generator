                                                           rdfs:label "fraction collection"^^xsd:string ;
                                                           core:definition "Fraction collection is the collection of fractional volumes of the column effluent. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "fraction collection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000266
<http://purl.allotrope.org/ontologies/process#AFP_0000266> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001655> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "spectrophotometry"^^xsd:string ;
                                                           core:altLabel "MAS"^^xsd:string ,
                                                                         "molecular absorption spectrophotometry"^^xsd:string ,
                                                                         "molecular electronic absorption spectroscopy"^^xsd:string ;
                                                           core:definition "A type of spectroscopy where the sample absorbs radiation in the range ultraviolet to near-infrared (0.1-2.5 µm) resulting in electronic transitions within the sample. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "spectrophotometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000304
<http://purl.allotrope.org/ontologies/process#AFP_0000304> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001916> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                           rdfs:label "coulometric titration"^^xsd:string ;
                                                           core:definition "Coulometric titration is the process of determining the quantity of a sample by adding measured increments of a titrant until the end-point, at which essentially all of the sample has reacted, is reached. In a coulometric titration the titrant is generated electrochemically by passing a constant current through an electrolyte. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "coulometric titration"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000307
<http://purl.allotrope.org/ontologies/process#AFP_0000307> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000015 ,
                                                                           [ owl:intersectionOf ( obo:BFO_0000015
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty obo:RO_0000057 ;
                                                                                                    owl:someValuesFrom obo:IAO_0000030
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002798 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "information process"^^xsd:string ;
                                                           core:definition "A process that affects, creates or destroys information content. [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "information processing is often dependent on a signal processing, but abstracts the bearer of information from the content [OSTHUS]"^^xsd:string ;
                                                           core:prefLabel "information process"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000310
<http://purl.allotrope.org/ontologies/process#AFP_0000310> rdf:type owl:Class ;
