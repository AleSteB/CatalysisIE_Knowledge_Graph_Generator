                                                             core:definition "To prevent a flow from changing course or location. [NIST]"^^xsd:string ;
                                                             core:example "On a typical canister vacuum, the center of gravity is placed at a low elevation to stabilize the vacuum when it is pulled by the hose. [NIST]"^^xsd:string ;
                                                             core:prefLabel "to stabilize"^^xsd:string .


