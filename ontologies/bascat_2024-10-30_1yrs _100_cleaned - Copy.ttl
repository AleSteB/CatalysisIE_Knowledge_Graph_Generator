                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "data input role"^^xsd:string ;
                                                         core:altLabel "data input"^^xsd:string ;
                                                         core:definition "Data input role is a type of contextual role of an information artifact that is the input of a process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "data input role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000047
<http://purl.allotrope.org/ontologies/role#AFRL_0000047> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
