                                                          rdfs:label "slightly hygroscopic"^^xsd:string ;
                                                          core:changeNote "2021-09-29 Moved under hygroscopicity code. [Allotrope]"^^xsd:string ;
                                                          core:definition "Slightly hygroscopic is a hygroscopicity type that denotes the increase in mass as equal to or greater than 0.2% and less than 2%. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "slightly hygroscopic"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002174
<http://purl.allotrope.org/ontologies/result#AFR_0002174> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002552> ;
