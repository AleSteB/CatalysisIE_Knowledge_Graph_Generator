###  http://purl.allotrope.org/ontologies/result#AFR_0002807
<http://purl.allotrope.org/ontologies/result#AFR_0002807> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001239> ;
