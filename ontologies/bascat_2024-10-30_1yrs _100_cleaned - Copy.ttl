                                                                              owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001097>
                                                                            ] ;
                                                            term:source <https://en.wikipedia.org/wiki/Chemical_substance> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "chemical mixture"^^xsd:string ;
                                                            core:altLabel "mixed chemical substances"^^xsd:string ,
                                                                          "portion of mixed chemical substances"^^xsd:string ;
                                                            core:definition "A portion of chemical mixture is a chemical substance that is composed of chemical substances. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "chemical mixture"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001101
<http://purl.allotrope.org/ontologies/material#AFM_0001101> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                            rdfs:label "collision energy (material entity)"^^xsd:string ;
                                                            core:altLabel "collision energy"^^xsd:string ;
                                                            core:definition "Collision energy is energy for an ion experiencing collision with a stationary gas particle resulting in dissociation of the ion. [PSI/MS]"^^xsd:string ;
                                                            core:prefLabel "collision energy (material entity)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001103
<http://purl.allotrope.org/ontologies/material#AFM_0001103> rdf:type owl:Class ;
