                                                            core:altLabel "building"^^xsd:string ,
                                                                          "building site"^^xsd:string ;
                                                            core:definition "A building (site) is a site located in a structure with a roof and walls. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "building (site)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/spatial#AFSP_0000004
<http://purl.allotrope.org/ontologies/spatial#AFSP_0000004> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/spatial#AFSP_0000005> ,
