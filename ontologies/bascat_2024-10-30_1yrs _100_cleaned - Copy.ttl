                                                          rdfs:label "machine direction"^^xsd:string ;
                                                          core:definition "Machine direction is a sampling orientation code that denotes a sample cut parallel to the direction of extrusion of the material being sampled. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "machine direction"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002598
<http://purl.allotrope.org/ontologies/result#AFR_0002598> rdf:type owl:NamedIndividual ,
                                                                   <http://purl.allotrope.org/ontologies/result#AFR_0002596> ;
