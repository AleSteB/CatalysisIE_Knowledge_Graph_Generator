                                                            core:altLabel "EMR"^^xsd:string ,
                                                                          "electro-magnetic energy"^^xsd:string ,
                                                                          "electro-magnetic radiation"^^xsd:string ,
                                                                          "electromagnetic radiation"^^xsd:string ,
                                                                          "radiation energy"^^xsd:string ;
                                                            core:definition "Energy that is propagated through free space or through a material medium in the form of electro-magnetic waves. [NIST]"^^xsd:string ;
                                                            core:prefLabel "electromagnetic energy"^^xsd:string .


