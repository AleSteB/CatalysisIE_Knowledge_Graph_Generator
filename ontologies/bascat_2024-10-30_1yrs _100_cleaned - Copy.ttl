                                       "NMDA receptor antagonists"^^xsd:string ,
                                       "NMDAR antagonist"^^xsd:string ,
                                       "NMDAR antagonists"^^xsd:string ;
                oboI:id "CHEBI:60643"^^xsd:string ;
                oboI:inSubset <http://purl.obolibrary.org/obo/chebi#3_STAR> ;
