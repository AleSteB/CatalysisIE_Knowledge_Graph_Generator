                                                           rdfs:label "compression"^^xsd:string ;
                                                           core:definition "Compression is the act of reducing volume by applying a force. [Allotrope]"^^xsd:string ;
                                                           core:example "In the case of tablets it is the act of forming a solid plug from individual powder / granule components."^^xsd:string ;
                                                           core:prefLabel "compression"^^xsd:string .


