                                                               prop:AFX_0002808 obo:CHEBI_27780 ,
                                                                                obo:OMIT_0005178 ;
                                                               rdfs:comment "Equivalence with http://purl.obolibrary.org/obo/CHEBI_27780 added automatically"^^xsd:string ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "detergent"^^xsd:string ;
                                                               core:definition "A surfactant (or a mixture containing one or more surfactants) disposed to having cleaning properties in dilute solutions. [ChEBI]"^^xsd:string ;
                                                               core:prefLabel "detergent"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000013
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000013> rdf:type owl:Class ;
                                                               owl:equivalentClass obo:CHEBI_35195 ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000014> ;
                                                               prop:AFX_0002808 obo:CHEBI_35195 ;
                                                               rdfs:comment "Equivalence with http://purl.obolibrary.org/obo/CHEBI_35195 added automatically"^^xsd:string ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "surfactant"^^xsd:string ;
                                                               core:definition "The disposition to lower the surface tension of the medium in which the material is dissolved, and/or the interfacial tension with other phases, and, accordingly, is positively adsorbed at the liquid/vapor and/or at other interfaces. [ChEBI]"^^xsd:string ;
                                                               core:prefLabel "surfactant"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000014
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000014> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000011> ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "surface-active disposition"^^xsd:string ;
                                                               core:altLabel "surface-active agent"^^xsd:string ;
                                                               core:definition "A surface-active agent is a disposition of a portion of material to react or interact with the surface of other materials. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "surface-active disposition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000015
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000015> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000011> ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "chemical reaction disposition"^^xsd:string ;
                                                               core:definition "A chemical reaction disposition is a disposition inhered in a reaction mixture. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "chemical reaction disposition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000016
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000016> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000015> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty obo:RO_0000092 ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty obo:RO_0000086 ;
                                                                                                      owl:someValuesFrom <http://purl.allotrope.org/ontologies/quality#AFQ_0000228>
                                                                                                    ]
                                                                               ] ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                               rdfs:label "reaction selectivity disposition"^^xsd:string ;
                                                               core:definition "A reaction selectivity disposition is a disposition of a reaction mixture to have a reaction selectivity. [Allotrope]"^^xsd:string ;
                                                               core:prefLabel "reaction selectivity disposition"^^xsd:string .


###  http://purl.allotrope.org/ontologies/realizable#AFRE_0000019
<http://purl.allotrope.org/ontologies/realizable#AFRE_0000019> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.allotrope.org/ontologies/realizable#AFRE_0000004> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty obo:BFO_0000054 ;
                                                                                 owl:someValuesFrom obo:BFO_0000182
                                                                               ] ;
                                                               term:source <https://en.wikipedia.org/wiki/Hysteresis> ;
                                                               rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ,
                                                                                <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/dynamic-vapor-sorption> ;
                                                               rdfs:label "hysteresis"^^xsd:string ;
                                                               core:definition "Hysteresis is the time-based dependence of a system's output on present and past inputs. The dependence arises because the history affects the value of an internal state. To predict its future outputs, either its internal state or its history must be known. [Wikipedia]"^^xsd:string ;
                                                               core:prefLabel "hysteresis"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000001
<http://purl.allotrope.org/ontologies/result#AFR_0000001> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "Auger spectrum"^^xsd:string ;
                                                          core:definition "A plot of intensity vs. kinetic energy obtained when a high energy photon ionizes a core electron and an electron from a higher energy level descends to take its place, releasing sufficient energy to eject a second so-called 'Auger' electron. [CHMO]"^^xsd:string ;
                                                          core:prefLabel "Auger spectrum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000007
<http://purl.allotrope.org/ontologies/result#AFR_0000007> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "differential scanning calorimetry curve"^^xsd:string ;
                                                          core:altLabel "DSC curve"^^xsd:string ,
                                                                        "DSC heating curve"^^xsd:string ,
                                                                        "DSC plot"^^xsd:string ,
                                                                        "DSC thermogram"^^xsd:string ,
                                                                        "DSC thermograms"^^xsd:string ;
                                                          core:definition "A plot of enthalpy vs. temperature obtained by measuring the enthalpy required to increase the temperature of a sample as a function of temperature. [CHMO]"^^xsd:string ;
                                                          core:prefLabel "differential scanning calorimetry curve"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000015
<http://purl.allotrope.org/ontologies/result#AFR_0000015> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000413> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography> ;
                                                          rdfs:label "chromatography peak"^^xsd:string ;
                                                          core:definition "A chromatography peak is a peak that results from a detector's response to the presence of an analyte in the mobile phase eluting from a column in chromatography. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "chromatography peak"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000020
<http://purl.allotrope.org/ontologies/result#AFR_0000020> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "microwave spectrum"^^xsd:string ;
                                                          core:altLabel "microwave spectra"^^xsd:string ;
                                                          core:definition "A plot of emission vs. wavelength obtained through a Fourier transform of the time series of the radiation emitted by a sample of gas phase molecules that have been excited by a microwave-frequency pulse. [CHMO]"^^xsd:string ;
                                                          core:prefLabel "microwave spectrum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000023
<http://purl.allotrope.org/ontologies/result#AFR_0000023> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000490> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/titration> ;
                                                          rdfs:label "Karl-Fischer titration curve"^^xsd:string ;
                                                          core:altLabel "Karl Fischer titration curve"^^xsd:string ;
                                                          core:definition "A Karl-Fischer titration curve is a titration curve of mass of water over time. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "Karl-Fischer titration curve"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000024
<http://purl.allotrope.org/ontologies/result#AFR_0000024> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000207> ,
                                                                          [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/result#AFR_0000207>
                                                                                                 <http://purl.allotrope.org/ontologies/result#AFR_0000922>
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                          rdfs:label "peak assignment target"^^xsd:string ;
                                                          core:definition "The description of a chemical moiety or material that is assigned to a peak. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "peak assignment target"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000035
<http://purl.allotrope.org/ontologies/result#AFR_0000035> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000160> ,
                                                                          <http://purl.allotrope.org/ontologies/result#AFR_0002543> ;
                                                          prop:AFX_0002808 obo:MS_1001472 ;
                                                          term:source <https://en.wikipedia.org/wiki/Mass_chromatogram> ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/chromatography-ms> ;
                                                          rdfs:label "selected ion monitoring chromatogram"^^xsd:string ;
                                                          core:altLabel "SIM chromatogram"^^xsd:string ,
                                                                        "SIM spectrum"^^xsd:string ;
                                                          core:definition "A selected-ion monitoring (SIM) chromatogram is similar to an XIC, with the exception that the mass spectrometer is operated in SIM mode, such that only preselected m/z values are detected in the analysis. [Wikipedia]"^^xsd:string ;
                                                          core:prefLabel "selected ion monitoring chromatogram"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000044
<http://purl.allotrope.org/ontologies/result#AFR_0000044> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "conversion spectrum"^^xsd:string ;
                                                          core:altLabel "conversion spectra"^^xsd:string ;
                                                          core:definition "A plot of a quantity related to the absorption, for example absorbance or cross section, multiplied by the quantum yield for the process considered against a measure of photon energy such as frequency, wavenumber or wavelength. [CHMO]"^^xsd:string ;
                                                          core:prefLabel "conversion spectrum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000046
<http://purl.allotrope.org/ontologies/result#AFR_0000046> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001060> ;
                                                          prop:AFX_0002818 "true"^^xsd:boolean ;
