                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/gc> ;
                                                           rdfs:label "split injection"^^xsd:string ;
                                                           core:definition "Split injection is a GC injection whereby a fraction of the volatilized sample is swept onto the GC column with the remaining split/swept to waste. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "split injection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003686
<http://purl.allotrope.org/ontologies/process#AFP_0003686> rdf:type owl:Class ;
