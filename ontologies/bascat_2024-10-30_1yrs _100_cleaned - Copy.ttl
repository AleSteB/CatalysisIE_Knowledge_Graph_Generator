                                       "alkanoyl group"^^xsd:string ,
                                       "groupe acyle"^^xsd:string ;
                oboI:id "CHEBI:22221"^^xsd:string ;
                oboI:inSubset <http://purl.obolibrary.org/obo/chebi#3_STAR> ;
                rdfs:label "acyl group"^^xsd:string .

