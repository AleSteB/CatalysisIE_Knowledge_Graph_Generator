                                                           rdfs:label "consuming energy"^^xsd:string ;
                                                           core:altLabel "collecting energy"^^xsd:string ,
                                                                         "energy consumption"^^xsd:string ;
                                                           core:definition "Consuming energy is a consuming that consumes energy. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "consuming energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003319
<http://purl.allotrope.org/ontologies/process#AFP_0003319> rdf:type owl:Class ;
