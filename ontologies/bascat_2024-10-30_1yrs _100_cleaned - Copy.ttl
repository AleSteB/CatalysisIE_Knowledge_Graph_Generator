###  http://purl.allotrope.org/ontologies/material#AFM_0000877
<http://purl.allotrope.org/ontologies/material#AFM_0000877> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000275> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "natural material"^^xsd:string ;
                                                            core:definition "A natural material is any product or physical matter that comes from plants, animals, or the ground. Minerals and the metals that can be extracted from them (without further modification) are also considered to belong into this category. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "natural material"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000880
<http://purl.allotrope.org/ontologies/material#AFM_0000880> rdf:type owl:Class ;
                                                            rdfs:subClassOf obo:BFO_0000040 ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "energy"^^xsd:string ;
                                                            core:definition "Energy must be transferred to an object in order to perform work on, or to heat the object. It can be converted in form, but not created or destroyed. [Wikipedia]"^^xsd:string ;
                                                            core:editorialNote "According to the annotations on material entity, energy is considered a material entity in BFO"^^xsd:string ;
                                                            core:prefLabel "energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000881
<http://purl.allotrope.org/ontologies/material#AFM_0000881> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
