###  http://purl.obolibrary.org/obo/BFO_0000011
obo:BFO_0000011 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000117 ;
                                                         owl:allValuesFrom obo:BFO_0000011
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty obo:BFO_0000132 ;
                                                         owl:allValuesFrom obo:BFO_0000011
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                obo:BFO_0000179 "st-region"^^xsd:string ;
                obo:BFO_0000180 "SpatiotemporalRegion"^^xsd:string ;
                obo:IAO_0000112 "the spatiotemporal region occupied by a human life"@en ,
                                "the spatiotemporal region occupied by a process of cellular meiosis."@en ,
                                "the spatiotemporal region occupied by the development of a cancer tumor"^^xsd:string ;
                obo:IAO_0000600 "A spatiotemporal region is an occurrent entity that is part of spacetime. (axiom label in BFO2 Reference: [095-001])"^^xsd:string ;
                obo:IAO_0000601 "All parts of spatiotemporal regions are spatiotemporal regions. (axiom label in BFO2 Reference: [096-001])"@en ,
                                "All parts of spatiotemporal regions are spatiotemporal regions. (axiom label in BFO2 Reference: [096-001])"^^xsd:string ,
                                "Each spatiotemporal region at any time t projects_onto some spatial region at t. (axiom label in BFO2 Reference: [099-001])"@en ,
                                "Each spatiotemporal region at any time t projects_onto some spatial region at t. (axiom label in BFO2 Reference: [099-001])"^^xsd:string ,
                                "Each spatiotemporal region projects_onto some temporal region. (axiom label in BFO2 Reference: [098-001])"@en ,
                                "Each spatiotemporal region projects_onto some temporal region. (axiom label in BFO2 Reference: [098-001])"^^xsd:string ,
                                "Every spatiotemporal region occupies_spatiotemporal_region itself."@en ,
                                "Every spatiotemporal region s is such that s occupies_spatiotemporal_region s. (axiom label in BFO2 Reference: [107-002])"^^xsd:string ;
                obo:IAO_0000602 "(forall (r) (if (SpatioTemporalRegion r) (occupiesSpatioTemporalRegion r r))) // axiom label in BFO2 CLIF: [107-002] "^^xsd:string ,
                                "(forall (x t) (if (SpatioTemporalRegion x) (exists (y) (and (SpatialRegion y) (spatiallyProjectsOntoAt x y t))))) // axiom label in BFO2 CLIF: [099-001] "^^xsd:string ,
                                "(forall (x y) (if (and (SpatioTemporalRegion x) (occurrentPartOf y x)) (SpatioTemporalRegion y))) // axiom label in BFO2 CLIF: [096-001] "^^xsd:string ,
                                "(forall (x) (if (SpatioTemporalRegion x) (Occurrent x))) // axiom label in BFO2 CLIF: [095-001] "^^xsd:string ,
                                "(forall (x) (if (SpatioTemporalRegion x) (exists (y) (and (TemporalRegion y) (temporallyProjectsOnto x y))))) // axiom label in BFO2 CLIF: [098-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "spatiotemporal region"^^xsd:string ;
                core:definition "A spatiotemporal region is an occurrent entity that is part of spacetime. [BFO]"^^xsd:string ;
                core:prefLabel "spatiotemporal region"^^xsd:string .

