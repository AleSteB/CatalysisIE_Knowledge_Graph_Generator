                                                           core:definition "A changing quality process profile is a quality process profile where the tracked quality changes over time. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "changing quality process profile"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003822
<http://purl.allotrope.org/ontologies/process#AFP_0003822> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003821> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "proper changing quality process profile"^^xsd:string ;
                                                           core:definition "A proper changing quality process profile is a changing process profile where the tracked quality at the start of the process is different from the tracked quality at the end of the process. [Allotrope]"^^xsd:string ;
                                                           core:note "Disjoint with a constant quality process profile that tracks the same quality. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "proper changing quality process profile"^^xsd:string .


