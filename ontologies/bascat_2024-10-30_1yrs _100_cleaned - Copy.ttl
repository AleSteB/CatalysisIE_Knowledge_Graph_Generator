                                                         rdfs:label "coordinate role"^^xsd:string ;
                                                         core:altLabel "coordinate"^^xsd:string ;
                                                         core:changeNote "2021-06-17 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A coordinate role is a contextual role of a scalar as component of a vector or tuple in a coordinate system specifying a point in space. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "coordinate role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000281
<http://purl.allotrope.org/ontologies/role#AFRL_0000281> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000280> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         term:source <https://en.wikipedia.org/wiki/Cartesian_coordinate_system> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "Cartesian coordinate role"^^xsd:string ;
                                                         core:altLabel "Cartesian coordinate"^^xsd:string ;
                                                         core:changeNote "2021-06-17 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A Cartesian coordinate role is a coordinate role of a scalar in a Cartesian coordinate system, that specifies each point uniquely in an n-dimensional Euclidean space . These coordinates are equal, up to sign, to distances from the point to n mutually perpendicular hyperplanes. [Allotrope, Wikipedia]"^^xsd:string ;
                                                         core:prefLabel "Cartesian coordinate role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000285
