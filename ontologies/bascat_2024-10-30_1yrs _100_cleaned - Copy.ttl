                                                         rdfs:label "mobile phase"^^xsd:string ;
                                                         core:altLabel "mobile phase role"^^xsd:string ;
                                                         core:definition "Mobile phase is the chromatographic phase role of a fluid material entity in a chromatography process to act as the fluid that percolates through or along the stationary bed in chromatography. [Allotrope, CHMO]"^^xsd:string ;
                                                         core:prefLabel "mobile phase"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000012
<http://purl.allotrope.org/ontologies/role#AFRL_0000012> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000060> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "name role"^^xsd:string ;
                                                         core:definition "Name role is a contextual role of an information content entity that refers to an entity by a non-identifying designation. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "name role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000013
<http://purl.allotrope.org/ontologies/role#AFRL_0000013> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000053> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "nominal datum"^^xsd:string ;
                                                         core:altLabel "nominal value"^^xsd:string ;
                                                         core:changeNote "2018-07-19 Changed pref label. [Allotrope]"^^xsd:string ;
                                                         core:definition "A nominal value is a contextual role of an information content entity that states an asserted value, that is assumed to be true. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "nominal datum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000014
<http://purl.allotrope.org/ontologies/role#AFRL_0000014> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000264> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "numerator"^^xsd:string ;
                                                         core:definition "Numerator is the conceptual role of a scalar that indicates the number which is to be divided into equal parts. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "numerator"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000015
<http://purl.allotrope.org/ontologies/role#AFRL_0000015> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000064> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "objective role"^^xsd:string ;
                                                         core:altLabel "objective"^^xsd:string ;
                                                         core:definition "Objective role is the contextual role of an information object that describes an intent or purpose which is a situation at the process end point. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "objective role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000016
<http://purl.allotrope.org/ontologies/role#AFRL_0000016> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000017> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000042> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "operating maximum"^^xsd:string ;
                                                         core:altLabel "upper operating limit"^^xsd:string ;
                                                         core:changeNote "2018-07-31 Changed pref label. [Allotrope]"^^xsd:string ,
                                                                         "2019-09-20 Added alt label. [Allotrope]"^^xsd:string ;
                                                         core:definition "An operating maximum is the contextual role of a description or specification of an upper bound of quality of a system or environment during the operation of the system. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "operating maximum"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000017
<http://purl.allotrope.org/ontologies/role#AFRL_0000017> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000166> ,
                                                                         [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000166>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty obo:IAO_0000136 ;
                                                                                                  owl:someValuesFrom <http://purl.allotrope.org/ontologies/realizable#AFRE_0000006>
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         prop:AFX_0002808 "http://purl.oclc.org/NET/ssnx/ssn#OperatingRange"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "operating range"^^xsd:string ;
                                                         core:changeNote "2018-07-31 Changed pref label and definition, and moved to AFO. [Allotrope]"^^xsd:string ;
                                                         core:definition "An operating range is the contextual role of a description or specification about a operating situation (qualities of a system or its environment) during the normal operation of the system. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "operating range"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000018
<http://purl.allotrope.org/ontologies/role#AFRL_0000018> rdf:type owl:Class ;
                                                         owl:equivalentClass [ rdf:type owl:Class ;
                                                                               owl:unionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000043>
                                                                                             <http://purl.allotrope.org/ontologies/role#AFRL_0000161>
                                                                                           )
                                                                             ] ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000091> ,
                                                                         [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000091>
                                                                                                [ rdf:type owl:Class ;
                                                                                                  owl:unionOf ( <http://purl.allotrope.org/ontologies/role#AFRL_0000166>
                                                                                                                obo:BFO_0000023
                                                                                                              )
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         prop:AFX_0002798 "true"^^xsd:boolean ;
                                                         term:source "Sowa, Knowledge Representation, Brooks Cole Publishing Co., 2000"^^xsd:string ,
                                                                     "http://www.jfsowa.com/ontology/thematic.htm"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "output role"^^xsd:string ;
                                                         core:altLabel "output"^^xsd:string ,
                                                                       "product"^^xsd:string ,
                                                                       "product role"^^xsd:string ;
                                                         core:changeNote "2018-07-23 Removed parent class, same as this. [Allotrope]"^^xsd:string ;
                                                         core:definition "A general role if its bearer is the output of the process that realizes the role. The bearer exists at the end of the process but not necessarily at its beginning. [Allotrope]"^^xsd:string ;
                                                         core:editorialNote "formal definition needs FOL"^^xsd:string ;
                                                         core:prefLabel "output role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000019
<http://purl.allotrope.org/ontologies/role#AFRL_0000019> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000044> ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         term:source <https://en.wikipedia.org/wiki/Parameter> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "parameter role"^^xsd:string ;
                                                         core:altLabel "parameter"^^xsd:string ,
                                                                       "parameter (process)"^^xsd:string ,
                                                                       "process parameter"^^xsd:string ;
                                                         core:changeNote "2018-12-19 Added alt labels. [Allotrope]"^^xsd:string ;
                                                         core:definition "Parameter role is a data input role that is about some useful or critical characteristic of a particular system, for the purpose of identification, controlling, or evaluating the performance, status or conditions in the process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "parameter role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000020
<http://purl.allotrope.org/ontologies/role#AFRL_0000020> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000167> ,
