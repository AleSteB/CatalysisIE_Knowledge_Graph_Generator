                                                            rdfs:subClassOf obo:CHEBI_33253 ,
                                                                            obo:CHEBI_36347 ;
                                                            prop:AFX_0002796 <http://purl.allotrope.org/ontologies/result#AFR_0001222> ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "IUPAC Green Book, 2nd ed., p. 93"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                            rdfs:label "neutron"^^xsd:string ;
                                                            core:definition "A neutron is a nuclear particle of zero charge, spin quantum number 1/2 and a mass of 1.00866490414 u. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "neutron"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001028
<http://purl.allotrope.org/ontologies/material#AFM_0001028> rdf:type owl:Class ;
                                                            owl:equivalentClass obo:CHEBI_33250 ;
                                                            rdfs:subClassOf obo:CHEBI_23367 ,
                                                                            obo:CHEBI_33253 ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty obo:OBI_0000643 ;
                                                                              owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0000418>
                                                                            ] ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty obo:OBI_0000643 ;
                                                                              owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001023>
                                                                            ] ;
                                                            prop:AFX_0002796 <http://purl.allotrope.org/ontologies/result#AFR_0001222> ;
                                                            prop:AFX_0002809 obo:CHEBI_33250 ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "IUPAC Red Book, p. 35"^^xsd:string ;
                                                            rdfs:comment "Equivalence with http://purl.obolibrary.org/obo/CHEBI_33250 added automatically"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/molecular-scale> ;
                                                            rdfs:label "atom"^^xsd:string ;
                                                            core:definition "An atom is a smallest particle still characterizing a chemical element. It consists of a nucleus of a positive charge carrying almost all its mass (more than 99.9%) and Z electrons determining its size. [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "atom"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001030
<http://purl.allotrope.org/ontologies/material#AFM_0001030> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001044> ;
                                                            term:source "Myers, D. (2002) Association Colloids: Micelles, Vesicles, and Membranes, in Surfaces, Interfaces, and Colloids: Principles and Applications, Second Edition, John Wiley & Sons, Inc., New York, USA. doi: 10.1002/0471234990.ch15"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "association colloid"^^xsd:string ;
                                                            core:definition "An association colloid is a homogeneous, non-structured substance composed of large molecules or ultramicroscopic suspended in a separate medium, which is largely comprised or reversible aggregations formed by the thermodynamics of molecular interactions. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "association colloid"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001031
<http://purl.allotrope.org/ontologies/material#AFM_0001031> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001044> ;
                                                            term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                            term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                            term:source "PAC, 1972, 31, 577 (Manual of Symbols and Terminology for Physicochemical Quantities and Units, Appendix II: Definitions, Terminology and Symbols in Colloid and Surface Chemistry) on page 605"^^xsd:string ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "dispersion colloid"^^xsd:string ;
                                                            core:altLabel "colloid dispersion"^^xsd:string ,
                                                                          "colloidal dispersion"^^xsd:string ;
                                                            core:definition "A dispersion colloid is a colloid that is a system in which particles of colloidal size of any nature (e.g. solid, liquid or gas) are dispersed in a continuous phase of a different composition (or state). [IUPAC]"^^xsd:string ;
                                                            core:prefLabel "dispersion colloid"^^xsd:string .


