                                ] ;
                obo:BFO_0000179 "p-boundary"^^xsd:string ;
                obo:BFO_0000180 "ProcessBoundary"^^xsd:string ;
                obo:IAO_0000112 "the boundary between the 2nd and 3rd year of your life."^^xsd:string ;
                obo:IAO_0000115 "p is a process boundary =Def. p is a temporal part of a process & p has no proper temporal parts. (axiom label in BFO2 Reference: [084-001])"^^xsd:string ;
                obo:IAO_0000601 "Every process boundary occupies_temporal_region a zero-dimensional temporal region. (axiom label in BFO2 Reference: [085-002])"^^xsd:string ;
                obo:IAO_0000602 "(forall (x) (if (ProcessBoundary x) (exists (y) (and (ZeroDimensionalTemporalRegion y) (occupiesTemporalRegion x y))))) // axiom label in BFO2 CLIF: [085-002] "^^xsd:string ,
                                "(iff (ProcessBoundary a) (exists (p) (and (Process p) (temporalPartOf a p) (not (exists (b) (properTemporalPartOf b a)))))) // axiom label in BFO2 CLIF: [084-001] "^^xsd:string ;
                rdfs:isDefinedBy <http://purl.allotrope.org/voc/bfo/REC/2018/04/bfo-2-0> ,
                                 obo:bfo.owl ;
                rdfs:label "process boundary"^^xsd:string ;
                core:definition "p is a process boundary if p is a temporal part of a process and p has no proper temporal parts. [BFO]"^^xsd:string ;
                core:prefLabel "process boundary"^^xsd:string .

