                                                         rdfs:label "upper bound"^^xsd:string ;
                                                         core:definition "The role of a datum that is greater than all data in an ordered range or collection. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "upper bound"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000043
<http://purl.allotrope.org/ontologies/role#AFRL_0000043> rdf:type owl:Class ;
