                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002808 <http://semanticscience.org/resource/SIO_001007> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
