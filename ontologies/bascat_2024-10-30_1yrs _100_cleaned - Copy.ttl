###  http://purl.allotrope.org/ontologies/role#AFRL_0000166
<http://purl.allotrope.org/ontologies/role#AFRL_0000166> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000091> ,
                                                                         obo:IAO_0000030 ,
                                                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty prop:AFX_0002726 ;
                                                                                                  owl:someValuesFrom obo:IAO_0000030
                                                                                                ]
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty prop:AFX_0002731 ;
                                                                                                  owl:someValuesFrom obo:BFO_0000015
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                         owl:disjointWith obo:BFO_0000023 ;
                                                         prop:AFX_0002818 "true"^^xsd:boolean ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "contextual role"^^xsd:string ;
                                                         core:definition "A contextual role is a representation of a specific interpretation of the information content object or of the circumstances that the information content object is referencing to. [Allotrope]"^^xsd:string ;
                                                         core:example "objective of a specification"^^xsd:string ,
                                                                      "parameter of a calculation"^^xsd:string ,
                                                                      "result of a measurement"^^xsd:string ;
                                                         core:prefLabel "contextual role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000167
<http://purl.allotrope.org/ontologies/role#AFRL_0000167> rdf:type owl:Class ;
                                                         rdfs:subClassOf obo:BFO_0000023 ;
                                                         term:source "Hubka, Eder, Ernst, Design Science, Springer, 1996"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                         rdfs:label "operand role"^^xsd:string ;
                                                         core:altLabel "operand"^^xsd:string ;
                                                         core:definition "The role of a participant that is being changed in the process (passive participant) from an input state to an output state. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "operand role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000169
<http://purl.allotrope.org/ontologies/role#AFRL_0000169> rdf:type owl:Class ;
