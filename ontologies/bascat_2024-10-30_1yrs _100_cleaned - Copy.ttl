                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting> ;
                                                           rdfs:label "dead cell count (quality)"^^xsd:string ;
                                                           core:altLabel "dead cell count"^^xsd:string ;
                                                           core:definition "Dead cell count is the cell count of the partition of dead cells. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dead cell count (quality)"^^xsd:string .


