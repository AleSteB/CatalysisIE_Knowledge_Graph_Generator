###  http://purl.allotrope.org/ontologies/result#AFR_0001061
<http://purl.allotrope.org/ontologies/result#AFR_0001061> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001682> ,
                                                                          obo:IAO_0000590 ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty obo:IAO_0000219 ;
                                                                            owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001083>
                                                                          ] ;
                                                          prop:AFX_0002808 x_0.1:familyName ,
                                                                           <https://www.w3.org/2006/vcard/ns#family-name> ;
                                                          term:source "https://en.wikipedia.org/wiki/Surname"^^xsd:string ;
                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                          rdfs:label "family name"^^xsd:string ;
                                                          core:altLabel "last name"^^xsd:string ,
                                                                        "surname"^^xsd:string ;
                                                          core:changeNote "2019-05-10 Moved under written name [Allotrope]"^^xsd:string ;
                                                          core:definition "A family name is a name that is the portion (in some cultures) of a personal name that indicates a person's family (or tribe or community, depending on the culture). [Wikipedia]"^^xsd:string ;
                                                          core:editorialNote "The family name is provided (alongside given name) for use when describing parts of people's names. Although these concepts do not capture the full range of personal naming styles found world-wide, they are commonly used and have some value. [FoaF]"^^xsd:string ;
                                                          core:prefLabel "family name"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001062
<http://purl.allotrope.org/ontologies/result#AFR_0001062> rdf:type owl:Class ;
