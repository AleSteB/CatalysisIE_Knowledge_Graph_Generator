                                                           rdfs:label "producing energy"^^xsd:string ;
                                                           core:altLabel "energy production"^^xsd:string ;
                                                           core:definition "Producing energy is the producing of energy (from an unspecified energy source). [Allotrope]"^^xsd:string ;
                                                           core:editorialNote "This is a black box perspective on the process only focussing on the energy flow out of the system. Within the system, this is a conversion process because of the physical laws of conservation. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "producing energy"^^xsd:string .


