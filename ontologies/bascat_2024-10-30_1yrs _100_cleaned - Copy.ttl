###  http://purl.allotrope.org/ontologies/equipment#AFE_0000185
<http://purl.allotrope.org/ontologies/equipment#AFE_0000185> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0001515> ;
