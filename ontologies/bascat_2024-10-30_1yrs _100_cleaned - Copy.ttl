                                                           core:altLabel "channeling"^^xsd:string ,
                                                                         "localization"^^xsd:string ,
                                                                         "spatial process"^^xsd:string ;
                                                           core:definition "A processing that affects the spatial location or orientation of some participants. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "localizing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003349
<http://purl.allotrope.org/ontologies/process#AFP_0003349> rdf:type owl:Class ;
