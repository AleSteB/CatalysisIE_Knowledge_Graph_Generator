                                                          rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                          rdfs:label "enthalpy"^^xsd:string ;
                                                          core:altLabel "enthalpy (datum)"^^xsd:string ;
                                                          core:definition "Enthalpy (datum) is a quantification datum that quantifies the internal energy of a system plus the product of pressure and volume. Its change in a system is equal to the heat brought to the system at constant pressure. [IUPAC]"^^xsd:string ;
                                                          core:prefLabel "enthalpy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0002022
