                                                                         "modulus of elasticity"^^xsd:string ,
                                                                         "modulus of elasticity (quality)"^^xsd:string ;
                                                           core:definition "A Young modulus is the ratio of tensile stress to tensile strain of a material. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "Young modulus (quality)"^^xsd:string .


