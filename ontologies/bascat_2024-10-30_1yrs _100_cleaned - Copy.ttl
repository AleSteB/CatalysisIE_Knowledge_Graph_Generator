                                                            rdfs:label "fluid"^^xsd:string ;
                                                            core:definition "A fluid is a substance that continually deforms (flows) under an applied shear stress. Fluids are a subset of the phases of matter and include liquids, gases, plasmas and, to some extent, plastic solids. [Wikipedia]"^^xsd:string ;
                                                            core:prefLabel "fluid"^^xsd:string .


