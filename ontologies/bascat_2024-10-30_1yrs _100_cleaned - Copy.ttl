                                                         core:altLabel "dried material"^^xsd:string ,
                                                                       "dried material role"^^xsd:string ,
                                                                       "material dried"^^xsd:string ;
                                                         core:definition "Material dried role is the drying role of the material being dried. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "material dried role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000516
<http://purl.allotrope.org/ontologies/role#AFRL_0000516> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000085> ,
                                                                         <http://purl.allotrope.org/ontologies/role#AFRL_0000495> ;
                                                         term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                         term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                         term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                         rdfs:label "reagent role (ms)"^^xsd:string ;
                                                         core:altLabel "chemical ionization reagent gas"^^xsd:string ,
                                                                       "reagent role"^^xsd:string ;
                                                         core:definition "Reagent role is the role of a gas that reacts with ions to produce product ions through ion/molecule reactions; for example, a gas such as methane, ammonia, or isobutane used in chemical ionization to create reagent ions or a gas used in ion traps or collision cells to perform gas-phase ion/molecule reactions. [IUPAC]"^^xsd:string ;
                                                         core:prefLabel "reagent role (ms)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000517
<http://purl.allotrope.org/ontologies/role#AFRL_0000517> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000495> ;
                                                         term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                         term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                         term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                         rdfs:label "adduct ion role"^^xsd:string ;
                                                         core:altLabel "adduct"^^xsd:string ,
                                                                       "adduct ion"^^xsd:string ,
                                                                       "adduct role"^^xsd:string ;
                                                         core:definition "Adduct ion role is the role of an ion formed by the interaction of a precursor ion with one or more atoms or molecules to form an ion containing all the constituent atoms of the precursor ion as well as the additional atoms from the associated atoms or molecules. [IUPAC]"^^xsd:string ;
                                                         core:example "For example, a Na+ adduct of a molecule (M) that is represented as [M + Na]+."^^xsd:string ;
                                                         core:prefLabel "adduct ion role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000518
<http://purl.allotrope.org/ontologies/role#AFRL_0000518> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000496> ;
                                                         term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                         term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                         term:source "K. K. Murray, R. K. Boyd, M. N. Eberlin, G. J. Langley, L. Li and Y. Naito, Pure Appl. Chem., 2013, 85, 1515-1609"^^xsd:string ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                         rdfs:label "fragment ion role"^^xsd:string ;
                                                         core:altLabel "fragment"^^xsd:string ,
                                                                       "fragment ion"^^xsd:string ;
                                                         core:definition "A fragment ion role is a product ion role of an ion that results from the dissociation of a precursor ion. [IUPAC]"^^xsd:string ;
                                                         core:prefLabel "fragment ion role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000519
<http://purl.allotrope.org/ontologies/role#AFRL_0000519> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000004> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "default condition role"^^xsd:string ;
                                                         core:altLabel "default"^^xsd:string ,
                                                                       "default condition"^^xsd:string ,
                                                                       "default role"^^xsd:string ,
                                                                       "fallback"^^xsd:string ,
                                                                       "fallback condition"^^xsd:string ,
                                                                       "fallback condition role"^^xsd:string ,
                                                                       "fallback role"^^xsd:string ;
                                                         core:definition "A default condition role is the condition role of an item in a collection of information content entities that applies (is true) if no other items apply (are false). [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "default condition role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000520
<http://purl.allotrope.org/ontologies/role#AFRL_0000520> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000064> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                         rdfs:label "default role"^^xsd:string ;
                                                         core:altLabel "default"^^xsd:string ,
                                                                       "fallback"^^xsd:string ,
                                                                       "fallback role"^^xsd:string ;
                                                         core:definition "A default role is a directive purpose that assigns a specification to be applied to a context if no other specification is asserted in that context. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "default role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000521
<http://purl.allotrope.org/ontologies/role#AFRL_0000521> rdf:type owl:Class ;
