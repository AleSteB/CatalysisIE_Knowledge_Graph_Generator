                                                            rdfs:label "electrical energy"^^xsd:string ;
                                                            core:definition "Work resulting from the flow of electrons from a negative to a positive source. [NIST]"^^xsd:string ;
                                                            core:prefLabel "electrical energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000885
<http://purl.allotrope.org/ontologies/material#AFM_0000885> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "mechanic rotational energy"^^xsd:string ;
                                                            core:definition "Energy that results from a rotation or a virtual rotation. [NIST]"^^xsd:string ;
                                                            core:prefLabel "mechanic rotational energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000886
<http://purl.allotrope.org/ontologies/material#AFM_0000886> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0000880> ;
                                                            prop:AFX_0002818 "true"^^xsd:boolean ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                            rdfs:label "hydraulic energy"^^xsd:string ;
                                                            core:definition "Work that results from the movement or force of a liquid, including hydrostatic forces. [NIST]"^^xsd:string ;
                                                            core:prefLabel "hydraulic energy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0000888
<http://purl.allotrope.org/ontologies/material#AFM_0000888> rdf:type owl:Class ;
