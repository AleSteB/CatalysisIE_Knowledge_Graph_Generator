                                                             rdfs:label "channel (communication)"^^xsd:string ;
                                                             core:altLabel "channel"^^xsd:string ,
                                                                           "communication channel"^^xsd:string ;
                                                             core:definition "A communication channel or channel, refers either to a physical transmission medium such as a wire, or to a logical connection over a multiplexed medium such as a radio channel. A channel is used to convey an information signal, for example a digital bit stream, from one or several senders (or transmitters) to one or several receivers. [Wikipedia]"^^xsd:string ;
                                                             core:prefLabel "channel (communication)"^^xsd:string .


