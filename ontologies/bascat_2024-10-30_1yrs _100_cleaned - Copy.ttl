                                                                           ] ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "measurement chamber free space volume (quality)"^^xsd:string ;
                                                           core:altLabel "free space"^^xsd:string ,
                                                                         "measurement chamber free space"^^xsd:string ,
                                                                         "measurement chamber free space (quality)"^^xsd:string ,
                                                                         "measurement chamber free space volume"^^xsd:string ;
                                                           core:definition "A measurement chamber free space volume (quality) is the volume within a sample measurement chamber that is not occupied by the sample. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "measurement chamber free space volume (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000279
<http://purl.allotrope.org/ontologies/quality#AFQ_0000279> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000250> ;
                                                           term:source <https://en.wikipedia.org/wiki/Hygroscopy> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "hygroscopicity"^^xsd:string ;
                                                           core:definition "Hygroscopicity is a quality inhered in a compound by virtue of its ability to readily take up and retain water, especially from the atmosphere. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "hygroscopicity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000280
<http://purl.allotrope.org/ontologies/quality#AFQ_0000280> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           term:source <https://en.wikipedia.org/wiki/Enthalpy_of_fusion> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "enthalpy of fusion (quality)"^^xsd:string ;
                                                           core:altLabel "enthalpy of fusion"^^xsd:string ,
                                                                         "enthalpy of melting"^^xsd:string ,
                                                                         "enthalpy of melting (quality)"^^xsd:string ,
                                                                         "heat of fusion"^^xsd:string ,
                                                                         "latent heat of fusion"^^xsd:string ;
                                                           core:definition "The enthalpy of fusion is a quality inhered in of a solid substance that is the change in its enthalpy resulting from providing energy, typically heat, to a specific quantity of the substance to change its state from a solid to a liquid, at constant pressure. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "enthalpy of fusion (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000281
<http://purl.allotrope.org/ontologies/quality#AFQ_0000281> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000056> ;
                                                           term:source <https://en.wikipedia.org/wiki/Enthalpy_of_vaporization> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "enthalpy of vaporization (quality)"^^xsd:string ;
                                                           core:altLabel "enthalpy of vaporization"^^xsd:string ,
                                                                         "heat of evaporation"^^xsd:string ,
                                                                         "heat of vaporization"^^xsd:string ,
                                                                         "latent heat of vaporization"^^xsd:string ;
                                                           core:definition "The enthalpy of vaporization is a quality inhered in a liquid substance that is the amount of energy (enthalpy) that must be added to the liquid substance, to transform a quantity of that substance into a gas. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "enthalpy of vaporization (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000282
<http://purl.allotrope.org/ontologies/quality#AFQ_0000282> rdf:type owl:Class ;
