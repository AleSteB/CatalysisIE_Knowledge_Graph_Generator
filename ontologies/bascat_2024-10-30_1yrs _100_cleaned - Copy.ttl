                                                           rdfs:label "sieve analysis"^^xsd:string ;
                                                           core:definition "Sieve analysis is a process of particle sizing by filtering particles according to their size through sieves with decreasing pore size. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "sieve analysis"^^xsd:string .


