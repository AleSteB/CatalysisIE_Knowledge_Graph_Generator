                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/cell-counting> ;
                                                           rdfs:label "total cell count (quality)"^^xsd:string ;
                                                           core:altLabel "total cell count"^^xsd:string ;
                                                           core:definition "Total cell count is the cell count over a mereological sum of a partitioned aggregate of cells. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "total cell count (quality)"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000187
<http://purl.allotrope.org/ontologies/quality#AFQ_0000187> rdf:type owl:Class ;
