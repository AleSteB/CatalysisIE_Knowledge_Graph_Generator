                                                          core:prefLabel "interval scale"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0000912
<http://purl.allotrope.org/ontologies/result#AFR_0000912> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0000908> ;
