                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                             rdfs:label "to convert"^^xsd:string ;
                                                             core:altLabel "changing function"^^xsd:string ,
                                                                           "converting function"^^xsd:string ,
                                                                           "to change"^^xsd:string ;
                                                             core:definition "To change from one form of a flow (material, energy, signal) to another. [NIST]"^^xsd:string ;
                                                             core:editorialNote "For completeness, any type of flow conversion is valid. In practice, conversions such as convert electricity to torque will be more common than convert solid to optical energy. [NIST]"^^xsd:string ;
                                                             core:example "An electrical motor converts electricity to rotational energy. [NIST]"^^xsd:string ;
                                                             core:prefLabel "to convert"^^xsd:string .


