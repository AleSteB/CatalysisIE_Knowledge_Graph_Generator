###  http://purl.allotrope.org/ontologies/result#AFR_0001845
<http://purl.allotrope.org/ontologies/result#AFR_0001845> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001583> ,
