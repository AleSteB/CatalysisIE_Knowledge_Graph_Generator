###  http://purl.allotrope.org/ontologies/quality#AFQ_0000348
<http://purl.allotrope.org/ontologies/quality#AFQ_0000348> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000065> ;
