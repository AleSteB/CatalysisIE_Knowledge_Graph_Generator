###  http://purl.obolibrary.org/obo/NCIT_C142533
obo:NCIT_C142533 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001963> ;
                 prop:AFX_0002865 obo:ncit.owl ;
