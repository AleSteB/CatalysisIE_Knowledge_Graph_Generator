                                                                         "conductance (quality)"^^xsd:string ,
                                                                         "thermal conductance"^^xsd:string ;
                                                           core:definition "Thermal conductance is the quality inhered in a conductor that is the reciprocal of the thermal resistance. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "thermal conductance (quality)"^^xsd:string .


