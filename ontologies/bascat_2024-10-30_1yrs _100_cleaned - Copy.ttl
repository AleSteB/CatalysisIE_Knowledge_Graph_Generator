                                                                           [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/process#AFP_0000307>
                                                                                                  <http://purl.allotrope.org/ontologies/process#AFP_0003452>
                                                                                                  obo:OBI_0000011
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "planning"^^xsd:string ;
                                                           core:definition "A process of creating or modifying a plan specification. [OBI]"^^xsd:string ;
                                                           core:example "The process of a scientist thinking about and deciding what reagents to use as part of a protocol for an experiment. Note that the scientist could be human or a robot scientist executing software. [OBI]"^^xsd:string ;
                                                           core:prefLabel "planning"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000503
<http://purl.allotrope.org/ontologies/process#AFP_0000503> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty prop:AFX_0002750 ;
                                                                             owl:someValuesFrom obo:PATO_0000125
                                                                           ] ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           term:source <https://en.wikipedia.org/wiki/Weight> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "weighing"^^xsd:string ;
                                                           core:altLabel "weighment"^^xsd:string ,
                                                                         "weight check"^^xsd:string ;
                                                           core:definition "Weighing is the measuring of weight of an object. Weight related to the amount of force acting on the object, either due to gravity or to a reaction force that holds it in place. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "weighing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000516
<http://purl.allotrope.org/ontologies/process#AFP_0000516> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000307> ,
