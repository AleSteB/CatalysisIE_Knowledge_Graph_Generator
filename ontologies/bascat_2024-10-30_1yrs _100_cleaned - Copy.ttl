###  http://purl.allotrope.org/ontologies/material#AFM_0001085
<http://purl.allotrope.org/ontologies/material#AFM_0001085> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001090> ,
                                                                            obo:BFO_0000027 ,
                                                                            [ owl:intersectionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0001090>
                                                                                                   [ rdf:type owl:Restriction ;
                                                                                                     owl:onProperty obo:RO_0002351 ;
                                                                                                     owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001090>
                                                                                                   ]
                                                                                                 ) ;
                                                                              rdf:type owl:Class
                                                                            ] ;
                                                            prop:AFX_0002808 <http://www.w3.org/ns/org#Organization> ,
                                                                             x_0.1:Organization ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                            rdfs:label "organization"^^xsd:string ;
                                                            core:definition "A collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an agent. [W3C ORG]"^^xsd:string ;
                                                            core:editorialNote "By this hierarchy organizations are built of physical people, so no pure legal persons can be members of an organization."^^xsd:string ;
                                                            core:prefLabel "organization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001086
<http://purl.allotrope.org/ontologies/material#AFM_0001086> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001085> ;
                                                            owl:disjointWith <http://purl.allotrope.org/ontologies/material#AFM_0001087> ;
                                                            prop:AFX_0002808 <http://www.w3.org/ns/org#FormalOrganization> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                            rdfs:label "formal organization"^^xsd:string ;
                                                            core:definition "A formal organization is an organization which is recognized in the world at large, in particular in legal jurisdictions, with associated rights and responsibilities. [W3C ORG]"^^xsd:string ;
                                                            core:prefLabel "formal organization"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001087
<http://purl.allotrope.org/ontologies/material#AFM_0001087> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/material#AFM_0001085> ,
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty obo:BFO_0000050 ;
                                                                              owl:someValuesFrom <http://purl.allotrope.org/ontologies/material#AFM_0001086>
                                                                            ] ;
                                                            prop:AFX_0002808 <http://www.w3.org/ns/org#OrganizationalUnit> ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/organization> ;
                                                            rdfs:label "organizational unit"^^xsd:string ;
                                                            core:definition "An organization such as a department or support unit which is part of some larger organization and only has full recognition within the context of that organization. In particular the unit would not be regarded as a legal entity in its own right. [W3C ORG]"^^xsd:string ;
                                                            core:prefLabel "organizational unit"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001090
<http://purl.allotrope.org/ontologies/material#AFM_0001090> rdf:type owl:Class ;
                                                            owl:equivalentClass [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( <http://purl.allotrope.org/ontologies/material#AFM_0001083>
                                                                                                <http://purl.allotrope.org/ontologies/material#AFM_0001084>
                                                                                                <http://purl.allotrope.org/ontologies/material#AFM_0001085>
                                                                                              )
                                                                                ] ;
                                                            rdfs:subClassOf obo:BFO_0000040 ;
                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                            rdfs:label "organizational entity"^^xsd:string ;
                                                            core:definition "An organizational entity is a person, group or organization that is defined by some social contract between humans. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "organizational entity"^^xsd:string .


###  http://purl.allotrope.org/ontologies/material#AFM_0001095
