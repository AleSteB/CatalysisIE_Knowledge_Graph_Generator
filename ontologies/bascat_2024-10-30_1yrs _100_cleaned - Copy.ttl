                                                             core:definition "To keep a flow from happening. [NIST]"^^xsd:string ;
                                                             core:example "A submerged gate on a dam wall prevents water from flowing to the other side. [NIST]"^^xsd:string ;
                                                             core:prefLabel "to prevent"^^xsd:string .


