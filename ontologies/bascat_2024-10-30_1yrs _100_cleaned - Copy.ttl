                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dielectric polarization measurement"^^xsd:string ;
                                                           core:altLabel "dielectric polarization sensing"^^xsd:string ,
                                                                         "measurement of dielectric polarization"^^xsd:string ,
                                                                         "sensing of dielectric polarization"^^xsd:string ;
                                                           core:definition "A dielectric polarization measurement is a measuring of the difference between the electric displacement vector and the product of the electric field strength with the permittivity of vacuum. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "dielectric polarization measurement"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003830
<http://purl.allotrope.org/ontologies/process#AFP_0003830> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003275> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "abrading"^^xsd:string ;
                                                           core:definition "Abrading is a material process of scuffing, scratching, wearing down, marring, or rubbing away. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "abrading"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003831
<http://purl.allotrope.org/ontologies/process#AFP_0003831> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003357> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/hot-tack> ;
                                                           rdfs:label "heat sealing"^^xsd:string ;
                                                           core:definition "Heat sealing is the process of sealing one thermoplastic to another thermoplastic using heat and pressure. [Wikipedia]"^^xsd:string ;
                                                           core:prefLabel "heat sealing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003832
<http://purl.allotrope.org/ontologies/process#AFP_0003832> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003351> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "gripping"^^xsd:string ;
                                                           core:definition "Gripping is a guiding process by applying friction or pressure to prevent movement. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "gripping"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003833
<http://purl.allotrope.org/ontologies/process#AFP_0003833> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002808 obo:CHMO_0001726 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "nitrogen-phosphorus detection"^^xsd:string ;
                                                           core:altLabel "NPD"^^xsd:string ,
                                                                         "nitrogen phosphorus detection"^^xsd:string ,
                                                                         "nitrogen phosphorus measurement"^^xsd:string ,
                                                                         "nitrogen phosphorus process"^^xsd:string ,
                                                                         "nitrogen-phosphorus measurement"^^xsd:string ,
                                                                         "nitrogen-phosphorus process"^^xsd:string ;
                                                           core:definition "A detection method that is sensitive to compounds containing N and P. A flow of carrier gas containing the sample is mixed with H2 and air in the presence of a small, heated bead of an alkali salt such as Rb2SO4. Any positively-charged radicals resulting from this process are collected at a cathode allowing the current to be measured. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "nitrogen-phosphorus detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003834
<http://purl.allotrope.org/ontologies/process#AFP_0003834> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002808 obo:CHMO_0000058 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "nitrogen chemiluminescence detection"^^xsd:string ;
                                                           core:altLabel "NCD"^^xsd:string ,
                                                                         "nitrogen chemiluminescence measurement"^^xsd:string ,
                                                                         "nitrogen chemiluminescence process"^^xsd:string ;
                                                           core:definition "The detection of luminescence emitted from nitrogen in a sample as a result of a chemical reaction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "nitrogen chemiluminescence detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003835
<http://purl.allotrope.org/ontologies/process#AFP_0003835> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002808 obo:CHMO_00001720 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "sulfur chemiluminescence detection"^^xsd:string ;
                                                           core:altLabel "SCD"^^xsd:string ,
                                                                         "sulfur chemiluminescence measurement"^^xsd:string ,
                                                                         "sulfur chemiluminescence process"^^xsd:string ;
                                                           core:definition "The detection of luminescence emitted from sulfur in a sample as a result of a chemical reaction. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "sulfur chemiluminescence detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003836
<http://purl.allotrope.org/ontologies/process#AFP_0003836> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002808 obo:CHMO_00001720 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "flame photometric detection"^^xsd:string ;
                                                           core:altLabel "FPD"^^xsd:string ,
                                                                         "flame photometric measurement"^^xsd:string ,
                                                                         "flame photometric process"^^xsd:string ;
                                                           core:definition "A detection method that is sensitive to sulfur- and phosphorus-containing compounds. A flow of carrier gas containing the sample is mixed with oxygen or air and ignited. Any chemiluminescence due to these compounds is then detected. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "flame photometric detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003837
<http://purl.allotrope.org/ontologies/process#AFP_0003837> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002808 obo:CHMO_00001718 ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "evaporative light scattering detection"^^xsd:string ;
                                                           core:altLabel "ELSD"^^xsd:string ,
                                                                         "evaporative light scattering measurement"^^xsd:string ,
                                                                         "evaporative light scattering process"^^xsd:string ;
                                                           core:definition "A detection method where a liquid containing the sample is atomized in a gas, forming small droplets which are allowed to evaporate leaving the sample as fine particles. The suspended particles pass through a light beam and the scattered light transmitted by the particles is sensed by a photodiode or photomultiplier tube. The response can be quantitative and relative to the amount of molecules eluting. [Allotrope, CHMO]"^^xsd:string ;
                                                           core:prefLabel "evaporative light scattering detection"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003838
<http://purl.allotrope.org/ontologies/process#AFP_0003838> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003312> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0003469> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dispensing"^^xsd:string ;
                                                           core:altLabel "dispension"^^xsd:string ;
                                                           core:definition "Dispensing is giving out material in discrete portions. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dispensing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003840
<http://purl.allotrope.org/ontologies/process#AFP_0003840> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003566> ;
                                                           term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                           term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                           term:source "IUPAC. Compendium of Chemical Terminology, 2nd ed. (the \"Gold Book\"). Compiled by A. D. McNaught and A. Wilkinson. Blackwell Scientific Publications, Oxford (1997)."^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "denaturing"^^xsd:string ;
                                                           core:definition "Denaturing is the process of partial or total alteration of the native structure of a macromolecule resulting from the loss of tertiary or tertiary and secondary structure that is a consequence of the disruption of stabilizing weak bonds. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "denaturing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003841
<http://purl.allotrope.org/ontologies/process#AFP_0003841> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000378> ;
                                                           prop:AFX_0002808 "http://purl.obolibrary.org/obo/NCIT_C20614"^^xsd:string ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/afo> ;
                                                           rdfs:label "primer extension"^^xsd:string ;
                                                           core:definition "Primer extension is a method to synthesize cDNA for determining the 5'-untranslated region of a specific mRNA molecule through reverse transcription reaction using complementary oligonucleotides as primers. [NCI]"^^xsd:string ;
                                                           core:prefLabel "primer extension"^^xsd:string .


###  http://purl.allotrope.org/ontologies/quality#AFQ_0000005
<http://purl.allotrope.org/ontologies/quality#AFQ_0000005> rdf:type owl:Class ;
                                                           rdfs:subClassOf obo:BFO_0000145 ;
                                                           prop:AFX_0002811 prop:AFX_0000245 ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "ratio"^^xsd:string ;
                                                           core:altLabel "factor"^^xsd:string ,
                                                                         "fraction"^^xsd:string ,
                                                                         "proportion"^^xsd:string ,
                                                                         "relative amount"^^xsd:string ;
                                                           core:definition "A ratio is a relational quality that is the proportion of the magnitude of two qualities of the same kind. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "ratio"^^xsd:string .


