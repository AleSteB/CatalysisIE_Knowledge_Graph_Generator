                                                                          ] ;
                                                          term:license <http://purl.allotrope.org/voc/iupac-license> ;
                                                          term:rights <http://purl.allotrope.org/voc/iupac-copyright> ;
                                                          term:source <https://en.wikipedia.org/wiki/Volume_fraction> ,
                                                                      "PAC, 1996, 68, 957. (Glossary of terms in quantities and units in Clinical Chemistry (IUPAC-IFCC Recommendations 1996)) on page 998"^^xsd:string ;
