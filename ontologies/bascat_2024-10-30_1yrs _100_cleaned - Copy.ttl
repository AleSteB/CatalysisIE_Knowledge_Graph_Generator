                                                                                                                     [ rdf:type owl:Restriction ;
                                                                                                                       owl:onProperty prop:AFX_0000354 ;
                                                                                                                       owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0002680>
                                                                                                                     ]
