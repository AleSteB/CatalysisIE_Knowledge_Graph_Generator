                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/sec> ;
                                                         rdfs:label "broad standard role (size-exclusion chromatography)"^^xsd:string ;
                                                         core:definition "A broad standard role is a standard sample role used in size-exclusion chromatography that has a broad molecular-weight distribution and are usually the same polymer as the sample being analyzed. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "broad standard role (size-exclusion chromatography)"^^xsd:string .


