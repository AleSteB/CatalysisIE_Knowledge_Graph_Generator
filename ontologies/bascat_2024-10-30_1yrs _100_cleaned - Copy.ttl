                                                                       "drying agent role"^^xsd:string ,
                                                                       "drying medium"^^xsd:string ;
                                                         core:definition "A drying medium role is a drying role of a material that takes or transports the solvent from the material being dried. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "drying medium role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000513
<http://purl.allotrope.org/ontologies/role#AFRL_0000513> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000511> ;
