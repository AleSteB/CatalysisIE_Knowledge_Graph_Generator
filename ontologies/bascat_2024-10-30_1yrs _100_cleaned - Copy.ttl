                 rdfs:label "fully porous"^^xsd:string ;
                 core:altLabel "porous"^^xsd:string ;
                 core:definition "A porosity quality inhering in a bearer by virtue of the bearer's being capable of admitting the passage of gas or liquid through pores or interstices. [PATO]"^^xsd:string ;
                 core:prefLabel "fully porous"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000985
obo:PATO_0000985 rdf:type owl:Class ;
                 rdfs:subClassOf obo:PATO_0000973 ;
                 prop:AFX_0002865 obo:pato-owl ;
                 rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                 rdfs:label "non-porous"^^xsd:string ;
                 core:definition "A porosity quality inhering in a bearer by virtue of the bearer's being incapable of admitting the passage of gas or liquid through pores or interstices. [PATO]"^^xsd:string ;
                 core:prefLabel "non-porous"^^xsd:string .


###  http://purl.obolibrary.org/obo/PATO_0000992
obo:PATO_0000992 rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.allotrope.org/ontologies/quality#AFQ_0000144> ;
