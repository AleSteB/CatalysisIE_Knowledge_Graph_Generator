                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "gas chromatography"^^xsd:string ;
                                                           core:altLabel "GC"^^xsd:string ,
                                                                         "GC run"^^xsd:string ,
                                                                         "gas chromatography run"^^xsd:string ;
                                                           core:definition "Column chromatography where the mobile phase is a gas. [CHMO]"^^xsd:string ;
                                                           core:example "An instance of gas chromatography can be a single-injection GC run."^^xsd:string ;
                                                           core:prefLabel "gas chromatography"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000326
<http://purl.allotrope.org/ontologies/process#AFP_0000326> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000527> ,
                                                                           <http://purl.allotrope.org/ontologies/process#AFP_0000759> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "nuclear magnetic resonance spectroscopy"^^xsd:string ;
                                                           core:altLabel "NMR"^^xsd:string ,
                                                                         "NMR spectrometry"^^xsd:string ,
                                                                         "NMR spectroscopy"^^xsd:string ,
                                                                         "nuclear magnetic resonance (NMR) spectroscopy"^^xsd:string ,
                                                                         "nuclear magnetic resonance spectrometry"^^xsd:string ;
                                                           core:definition "A type of spectroscopy where the energy states of spin-active nuclei placed in a static magnetic field are interrogated by inducing transitions between the states via radio frequency irradiation. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "nuclear magnetic resonance spectroscopy"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000373
<http://purl.allotrope.org/ontologies/process#AFP_0000373> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0002294> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dilatometry"^^xsd:string ;
                                                           core:definition "The measurement and study of dimensional changes in polymers as a function of temperature, fluid absorption, mechanical stress or chemical reaction. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "dilatometry"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000378
<http://purl.allotrope.org/ontologies/process#AFP_0000378> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0001116> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "cellular assay"^^xsd:string ;
                                                           core:definition "An assay that generates data about the presence, quantity, structure, function, behavior, or activity of cells, or a process that occurs at a cellular level of anatomical granularity (includes subcellular structures and organelles). [VIVO-ISF]"^^xsd:string ;
                                                           core:prefLabel "cellular assay"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0000391
<http://purl.allotrope.org/ontologies/process#AFP_0000391> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000955> ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/uv> ;
