                                                            rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/perspective/REC/2023/09/portion-of-material> ;
                                                            rdfs:label "foam"^^xsd:string ;
                                                            core:definition "A foam is a colloid where the continuous phase is a liquid and the dispersed phase is a gas. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "foam"^^xsd:string .


