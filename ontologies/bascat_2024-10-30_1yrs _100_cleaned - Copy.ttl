                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "sorption-desorption measurements"^^xsd:string ;
                                                           core:altLabel "adsorption-desorption"^^xsd:string ,
                                                                         "adsorption/desorption"^^xsd:string ,
                                                                         "sorption-desorption"^^xsd:string ,
                                                                         "sorption/desorption"^^xsd:string ;
                                                           core:definition "A method for determining surface area by measuring the amount of an inert gaseous or liquid substance (the 'sorbent', usually H2 or N2) which adsorbs onto the surface of interest (the 'sorbate'), and the subsequent amount that desorbs at a constant temperature. Regression analysis is then applied to the data, resulting in an isotherm. [CHMO]"^^xsd:string ;
                                                           core:prefLabel "sorption-desorption measurements"^^xsd:string .


