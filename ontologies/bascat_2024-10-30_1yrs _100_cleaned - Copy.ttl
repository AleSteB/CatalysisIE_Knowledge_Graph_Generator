                                                            rdfs:label "site (organization)"^^xsd:string ;
                                                            core:altLabel "site"^^xsd:string ;
                                                            core:changeNote "2019-09-04 Added restriction. [Allotrope]"^^xsd:string ,
                                                                            "2019-09-04 Changed pref label and definition. [Allotrope]"^^xsd:string ;
                                                            core:definition "A site (organization) is a site where organizational entities are located such as an office or premise. [Allotrope]"^^xsd:string ;
                                                            core:prefLabel "site (organization)"^^xsd:string ;
                                                            core:scopeNote "An office or other premise at which the organization is located. Many organizations are spread across multiple sites and many sites will host multiple locations. [W3C ORG]"^^xsd:string .


###  http://purl.allotrope.org/ontologies/spatial#AFSP_0000002
<http://purl.allotrope.org/ontologies/spatial#AFSP_0000002> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.allotrope.org/ontologies/spatial#AFSP_0000005> ,
