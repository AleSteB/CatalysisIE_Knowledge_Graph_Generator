                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "relative permittivity (quality)"^^xsd:string ;
                                                           core:altLabel "dielectric constant"^^xsd:string ,
                                                                         "relative permittivity"^^xsd:string ,
                                                                         "εr"^^xsd:string ;
                                                           core:definition "Relative permittivity is an electrical and magnetic quality inhered in a medium that is the ratio of the electric field strength in vacuum to that in the medium. [IUPAC]"^^xsd:string ;
                                                           core:prefLabel "relative permittivity (quality)"^^xsd:string .


