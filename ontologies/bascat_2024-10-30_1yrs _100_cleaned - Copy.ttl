                                                         core:definition "A drying role role is a role realized in some drying process. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "drying role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000512
<http://purl.allotrope.org/ontologies/role#AFRL_0000512> rdf:type owl:Class ;
                                                         rdfs:subClassOf <http://purl.allotrope.org/ontologies/role#AFRL_0000511> ;
                                                         rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
