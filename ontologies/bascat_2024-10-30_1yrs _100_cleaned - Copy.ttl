                                                         rdfs:label "from role"^^xsd:string ;
                                                         core:altLabel "from"^^xsd:string ,
                                                                       "origin"^^xsd:string ,
                                                                       "origin role"^^xsd:string ,
                                                                       "source"^^xsd:string ,
                                                                       "source role"^^xsd:string ;
                                                         core:definition "A from role is a direction role indicating that something is coming from a source. [Allotrope]"^^xsd:string ;
                                                         core:editorialNote "This is an abstraction of direction, for spatio-temporal role use af-rl:origin datum. [Allotrope]"^^xsd:string ;
                                                         core:example "A specification of a material that is a material output of a process has the contextual role of from role in the material flow specification. [Allotrope]"^^xsd:string ;
                                                         core:prefLabel "from role"^^xsd:string .


###  http://purl.allotrope.org/ontologies/role#AFRL_0000466
<http://purl.allotrope.org/ontologies/role#AFRL_0000466> rdf:type owl:Class ;
