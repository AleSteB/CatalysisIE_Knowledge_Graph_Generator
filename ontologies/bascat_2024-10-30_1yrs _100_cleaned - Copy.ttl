                                                          rdfs:label "statistic coordination"^^xsd:string ;
                                                          core:definition "A statistic coordination is a class coordination that coordinates a class with a statistic contextual role. [Allotrope]"^^xsd:string ;
                                                          core:prefLabel "statistic coordination"^^xsd:string .


###  http://purl.allotrope.org/ontologies/result#AFR_0001572
<http://purl.allotrope.org/ontologies/result#AFR_0001572> rdf:type owl:Class ;
                                                          rdfs:subClassOf <http://purl.allotrope.org/ontologies/result#AFR_0001552> ;
