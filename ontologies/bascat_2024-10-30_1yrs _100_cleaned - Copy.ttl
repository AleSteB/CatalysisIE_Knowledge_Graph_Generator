                                                           core:example "The structures of space vehicles inhibits the flow of radiation to protect crew and cargo."^^xsd:string ;
                                                           core:prefLabel "inhibiting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003597
<http://purl.allotrope.org/ontologies/process#AFP_0003597> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0003424> ;
