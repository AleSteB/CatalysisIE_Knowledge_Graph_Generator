                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "branching"^^xsd:string ;
                                                           core:altLabel "disconnecting"^^xsd:string ;
                                                           core:definition "The process of causing a flow to no longer be topologically connected. [NIST]"^^xsd:string ;
                                                           core:editorialNote "1 input flow to n output flows"^^xsd:string ,
                                                                              "For data flows, branching does not mean that the input flow fully ceases to exist. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "branching"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003335
<http://purl.allotrope.org/ontologies/process#AFP_0003335> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000422> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "dividing"^^xsd:string ;
                                                           core:altLabel "partioning"^^xsd:string ,
                                                                         "portioning"^^xsd:string ,
                                                                         "splitting"^^xsd:string ;
                                                           core:definition "Dividing is a separating of flows focused on all parts of the flow. [Allotrope]"^^xsd:string ;
                                                           core:prefLabel "dividing"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003336
<http://purl.allotrope.org/ontologies/process#AFP_0003336> rdf:type owl:Class ;
                                                           rdfs:subClassOf <http://purl.allotrope.org/ontologies/process#AFP_0000422> ;
                                                           prop:AFX_0002818 "true"^^xsd:boolean ;
                                                           rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/REC/2023/09/aft> ;
                                                           rdfs:label "extracting"^^xsd:string ;
                                                           core:definition "Separating by drawing, or forcibly pulling out, a flow that is of a different kind than that of the input flow. [Allotrope, NIST]"^^xsd:string ;
                                                           core:example "A vacuum cleaner extracts debris from the imported mixture and exports clean air to the environment. [NIST]"^^xsd:string ;
                                                           core:prefLabel "extracting"^^xsd:string .


###  http://purl.allotrope.org/ontologies/process#AFP_0003348
<http://purl.allotrope.org/ontologies/process#AFP_0003348> rdf:type owl:Class ;
