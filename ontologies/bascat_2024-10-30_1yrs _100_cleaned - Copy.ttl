   owl:annotatedSource obo:BFO_0000011 ;
   owl:annotatedProperty obo:IAO_0000602 ;
   owl:annotatedTarget "(forall (x t) (if (SpatioTemporalRegion x) (exists (y) (and (SpatialRegion y) (spatiallyProjectsOntoAt x y t))))) // axiom label in BFO2 CLIF: [099-001] "^^xsd:string ;
