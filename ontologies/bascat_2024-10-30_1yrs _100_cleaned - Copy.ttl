                                                             rdfs:label "chromatography column"^^xsd:string ;
                                                             core:altLabel "column"^^xsd:string ;
                                                             core:definition "A chromatography column is a type of column that contains a stationary phase for chromatographic separation of compounds. [Allotrope]"^^xsd:string ;
                                                             core:prefLabel "chromatography column"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000223
<http://purl.allotrope.org/ontologies/equipment#AFE_0000223> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000004> ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/mass-spectrometry> ;
                                                             rdfs:label "electron ionization source"^^xsd:string ;
                                                             core:altLabel "EI source"^^xsd:string ,
                                                                           "electron impact source"^^xsd:string ;
                                                             core:definition "An electron ionization source is an ion source that consists of an ionization chamber and a thin strip of metal that is heated electrically to incandescence or a temperature at which it emits free electrons that are accelerated through a potential to an energy where they ionize the sample. [CHMO]"^^xsd:string ;
                                                             core:prefLabel "electron ionization source"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000224
<http://purl.allotrope.org/ontologies/equipment#AFE_0000224> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000808> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty obo:RO_0000056 ;
                                                                               owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0000748>
                                                                             ] ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                             rdfs:label "high-performance liquid chromatograph"^^xsd:string ;
                                                             core:altLabel "HPLC system"^^xsd:string ,
                                                                           "high-performance liquid chromatography system"^^xsd:string ;
                                                             core:changeNote "2020-03-20 Changed equivalentClass to subClass. [Allotrope]"^^xsd:string ;
                                                             core:definition "A high-performance liquid chromatograph is an instrument used for HPLC that is a technique in analytical chemistry used to separate the components in a mixture, to identify each component, and to quantify each component. It has pumps to pass a pressurized liquid solvent containing the sample mixture through a column filled with a solid adsorbent material. Each component in the sample interacts slightly differently with the adsorbent material, causing different flow rates for the different components and leading to the separation of the components as they flow out the column. [Wikipedia]"^^xsd:string ;
                                                             core:prefLabel "high-performance liquid chromatograph"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000231
<http://purl.allotrope.org/ontologies/equipment#AFE_0000231> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000217> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty obo:RO_0000056 ;
                                                                               owl:someValuesFrom <http://purl.allotrope.org/ontologies/process#AFP_0000748>
                                                                             ] ;
                                                             prop:AFX_0002798 "true"^^xsd:boolean ;
                                                             prop:AFX_0002809 obo:CHMO_0000976 ;
                                                             rdfs:isDefinedBy <http://purl.allotrope.org/voc/afo/domain/REC/2023/09/lc> ;
                                                             rdfs:label "high-performance liquid chromatography column"^^xsd:string ;
                                                             core:altLabel "HPLC column"^^xsd:string ;
                                                             core:definition "A chromatography column that contains very small particles and is capable of taking a high inlet pressure. [CHMO]"^^xsd:string ;
                                                             core:prefLabel "high-performance liquid chromatography column"^^xsd:string .


###  http://purl.allotrope.org/ontologies/equipment#AFE_0000246
<http://purl.allotrope.org/ontologies/equipment#AFE_0000246> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://purl.allotrope.org/ontologies/equipment#AFE_0000317> ,
